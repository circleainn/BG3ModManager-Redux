<UserControl x:Class="DivinityModManager.Controls.ReduxWindowTitleBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	Height="40"
	Focusable="False">
	<UserControl.Resources>
		<Style x:Key="ReduxCaptionButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="36" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Margin" Value="2,0,0,0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ButtonSurface"
							Background="{TemplateBinding Background}"
							CornerRadius="{DynamicResource Redux.CornerRadius.Small}"
							util:ReduxWindowBehavior.HoverLift="1"
							RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<TranslateTransform Y="0" />
							</Border.RenderTransform>
							<ContentPresenter
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ReduxPressedBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>
	<UserControl.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
			<GradientStop Color="{DynamicResource ReduxSurfaceElevatedColor}" Offset="0" />
			<GradientStop Color="{DynamicResource ReduxWindowColor}" Offset="1" />
		</LinearGradientBrush>
	</UserControl.Background>

	<Border
		Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:ReduxWindowTitleBar}}}"
		BorderBrush="{DynamicResource ReduxBorderBrush}"
		BorderThickness="{Binding BottomBorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:ReduxWindowTitleBar}}}">
		<Grid>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Grid x:Name="DragSurface"
					Background="Transparent"
					MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid Width="24"
						Height="24"
						Margin="9,0,0,0"
						VerticalAlignment="Center">
						<local:ReduxIcon Width="15"
							Height="15"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxAccentHoverBrush}"
							StrokeData="{Binding IconData, RelativeSource={RelativeSource AncestorType={x:Type local:ReduxWindowTitleBar}}}" />
						<Image Width="20"
							Height="20"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RenderOptions.BitmapScalingMode="HighQuality"
							Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType={x:Type local:ReduxWindowTitleBar}}}"
							Stretch="Uniform" />
					</Grid>
					<TextBlock Grid.Column="1"
						Margin="9,0,8,0"
						VerticalAlignment="Center"
						FontSize="{DynamicResource Redux.FontSize.12}"
						FontWeight="{DynamicResource Redux.FontWeight.Control}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
						TextTrimming="CharacterEllipsis" />
				</Grid>

				<StackPanel Grid.Column="1"
					Margin="0,5,5,5"
					Orientation="Horizontal">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Visible" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShowWindowControls, RelativeSource={RelativeSource AncestorType={x:Type local:ReduxWindowTitleBar}}}" Value="False">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>
					<Button x:Name="MinimizeButton"
						Click="MinimizeButton_Click"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Style="{StaticResource ReduxCaptionButtonStyle}"
						ToolTip="Minimize">
						<local:ReduxIcon Width="13"
							Height="13"
							StrokeData="{DynamicResource Redux.Icon.WindowMinimize}" />
					</Button>
					<Button x:Name="MaximizeButton"
						Click="MaximizeButton_Click"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Style="{StaticResource ReduxCaptionButtonStyle}"
						ToolTip="Maximize or restore">
						<Grid>
							<local:ReduxIcon x:Name="MaximizeIcon"
								Width="13"
								Height="13"
								StrokeData="{DynamicResource Redux.Icon.WindowMaximize}" />
							<local:ReduxIcon x:Name="RestoreIcon"
								Width="13"
								Height="13"
								StrokeData="{DynamicResource Redux.Icon.WindowRestore}"
								Visibility="Collapsed" />
						</Grid>
					</Button>
					<Button x:Name="CloseButton"
						Click="CloseButton_Click"
						shell:WindowChrome.IsHitTestVisibleInChrome="True"
						Style="{StaticResource ReduxCaptionButtonStyle}"
						ToolTip="Close">
						<local:ReduxIcon Width="13"
							Height="13"
							StrokeData="{DynamicResource Redux.Icon.Close}" />
					</Button>
				</StackPanel>
			</Grid>
		</Grid>
	</Border>
</UserControl>
