<UserControl x:Class="DivinityModManager.Controls.ReduxOperationProgress"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	x:Name="Root"
	Width="500">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolVisibility" />
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<controls:ReduxIcon Width="22"
				Height="22"
				Margin="0,0,12,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Foreground="{Binding IconBrush, ElementName=Root}"
				IconKey="{Binding IconKey, ElementName=Root}" />
			<StackPanel Grid.Column="1" VerticalAlignment="Center">
				<TextBlock Style="{DynamicResource Redux.Text.SectionTitle}"
					Text="{Binding Title, ElementName=Root}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock Margin="0,3,0,0"
					Style="{DynamicResource Redux.Text.Metadata}"
					Text="{Binding Status, ElementName=Root}"
					TextTrimming="CharacterEllipsis" />
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" Margin="0,18,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<ProgressBar Height="8"
				Margin="0,0,12,0"
				VerticalAlignment="Center"
				Maximum="1"
				Style="{DynamicResource ReduxProgressBarStyle}"
				Value="{Binding ProgressValue, ElementName=Root}" />
			<TextBlock Grid.Column="1"
				MinWidth="34"
				VerticalAlignment="Center"
				Style="{DynamicResource Redux.Text.Metadata}"
				Text="{Binding ProgressValue, ElementName=Root, StringFormat={}{0:P0}}"
				TextAlignment="Right" />
		</Grid>

		<Button Grid.Row="2"
			Margin="0,16,0,0"
			HorizontalAlignment="Right"
			Command="{Binding CancelCommand, ElementName=Root}"
			Style="{DynamicResource ReduxSecondaryActionButtonStyle}"
			Visibility="{Binding CanCancel, ElementName=Root, Converter={StaticResource BoolVisibility}}">
			<StackPanel Orientation="Horizontal">
				<controls:ReduxIcon Width="14"
					Height="14"
					Margin="0,0,7,0"
					Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
					StrokeData="{DynamicResource Redux.Icon.Close}" />
				<TextBlock Text="Cancel" />
			</StackPanel>
		</Button>
	</Grid>
</UserControl>
