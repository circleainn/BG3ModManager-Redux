<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxPackagePreflightWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:health="clr-namespace:DivinityModManager.Models.Health;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Package Preflight"
	Width="800" Height="680" MinWidth="660" MinHeight="540" MaxWidth="1060" MaxHeight="900"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<DataTemplate x:Key="PackagePreflightFindingTemplate">
				<Border Margin="0,0,0,7"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
					ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Border x:Name="FindingRail" Background="{DynamicResource ReduxInfoBrush}" />
						<controls:ReduxIcon x:Name="FindingIcon" Grid.Column="1"
							Width="16" Height="16" Margin="12,12,0,0"
							VerticalAlignment="Top"
							Foreground="{DynamicResource ReduxInfoBrush}"
							StrokeData="{StaticResource Redux.Icon.Information}" />
						<StackPanel Grid.Column="2" Margin="10,10,14,11">
							<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="{Binding Title}" />
							<TextBlock Margin="0,3,0,0"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding Message}"
								TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Severity}" Value="{x:Static health:ModHealthSeverity.Warning}">
						<Setter TargetName="FindingRail" Property="Background" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="FindingIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="FindingIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Severity}" Value="{x:Static health:ModHealthSeverity.Error}">
						<Setter TargetName="FindingRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="FindingIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="FindingIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.CloseCircle}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Package}" />
		<Border Grid.Row="1"
			Padding="22,18"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="Package preflight" />
					<TextBlock Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="Inspect release metadata, dependencies, embedded Redux data, and package contents without installing or changing the file."
						TextWrapping="Wrap" />
				</StackPanel>

				<Border x:Name="StatusCard" Grid.Row="1" Margin="0,15,0,13"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
					ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="4" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border x:Name="StatusRail" Background="{DynamicResource ReduxInfoBrush}" />
						<controls:ReduxIcon x:Name="StatusIcon" Grid.Column="1"
							Width="22" Height="22" Margin="15,15,0,0"
							VerticalAlignment="Top"
							Foreground="{DynamicResource ReduxInfoBrush}"
							StrokeData="{StaticResource Redux.Icon.Package}" />
						<StackPanel Grid.Column="2" Margin="12,12,16,13">
							<TextBlock x:Name="StatusTitleText"
								Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								FontSize="{DynamicResource Redux.FontSize.14}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="Inspecting package" />
							<TextBlock x:Name="StatusDescriptionText" Margin="0,3,0,0"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="Reading the package file table and module metadata."
								TextWrapping="Wrap" />
						</StackPanel>
						<TextBlock x:Name="FindingSummaryText" Grid.Column="3" Margin="12,0,16,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}" />
					</Grid>
				</Border>

				<Grid Grid.Row="2" Margin="0,0,0,13">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3*" />
						<ColumnDefinition Width="2*" />
					</Grid.ColumnDefinitions>
					<Border Margin="0,0,7,0" Padding="13,11"
						Style="{StaticResource ReduxDialogSummaryCardStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Margin="0,0,16,0">
								<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding IdentityHeader}" />
								<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding AuthorLabel}" />
								<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding VersionLabel}" />
								<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding UuidLabel}" />
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
									FontWeight="{DynamicResource Redux.FontWeight.Control}"
									Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
								<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
								<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Version}" />
								<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Uuid}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Uuid}" />
							</StackPanel>
						</Grid>
					</Border>
					<Border Grid.Column="1" Margin="7,0,0,0" Padding="13,11"
						Style="{StaticResource ReduxDialogSummaryCardStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock FontSize="{DynamicResource Redux.FontSize.18}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
									Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding InternalFileCountText}" />
								<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Files" />
							</StackPanel>
							<StackPanel Grid.Column="1">
								<TextBlock FontSize="{DynamicResource Redux.FontSize.18}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
									Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding DeclaredDependencyCountText}" />
								<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Dependencies" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock FontSize="{DynamicResource Redux.FontSize.18}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
									Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding PackageSizeText}" />
								<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Package size" />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>

				<Grid Grid.Row="3">
					<Border Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
					<Grid Margin="8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock x:Name="DetectedFeaturesText" Margin="6,4,6,9"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							TextWrapping="Wrap" />
						<ListBox x:Name="FindingsList" Grid.Row="1"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							HorizontalContentAlignment="Stretch"
							ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}"
							ItemTemplate="{StaticResource PackagePreflightFindingTemplate}"
							ScrollViewer.CanContentScroll="True"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							VirtualizingPanel.IsVirtualizing="True"
							VirtualizingPanel.VirtualizationMode="Recycling" />
						<StackPanel x:Name="ClearState" Grid.Row="1"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Visibility="Collapsed">
							<controls:ReduxIcon Width="28" Height="28" HorizontalAlignment="Center"
								Foreground="{DynamicResource ReduxSuccessBrush}"
								StrokeData="{StaticResource Redux.Icon.CircleCheck}" />
							<TextBlock Margin="0,8,0,0"
								Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="No findings to review" />
							<TextBlock Margin="0,3,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="This is a conservative preflight, not a guarantee of in-game compatibility." />
						</StackPanel>
					</Grid>
				</Grid>

				<Grid Grid.Row="4" Margin="0,13,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock x:Name="PackagePathText"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						TextTrimming="CharacterEllipsis" />
					<Button x:Name="ScanActionButton" Grid.Column="1" MinWidth="84" Margin="14,0,0,0"
						Content="Cancel"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CloseButton_Click" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
