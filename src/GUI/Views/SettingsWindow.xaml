<local:SettingsWindowBase x:Class="DivinityModManager.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:behavior="clr-namespace:DivinityModManager.Controls.Behavior"
    xmlns:c="clr-namespace:DivinityModManager.Controls"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:conv="clr-namespace:DivinityModManager.Converters"
    xmlns:core="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:extdata="clr-namespace:DivinityModManager.Models.Extender;assembly=DivinityModManagerCore"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mv="clr-namespace:DivinityModManager.Models.View"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:util="clr-namespace:DivinityModManager.Util"
    xmlns:vm="clr-namespace:DivinityModManager.ViewModels"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="{loc:Text Preferences_66962f72}"
	Width="860"
	Height="720"
	MinWidth="780"
	MinHeight="600"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="SettingsActionButtonStyle" BasedOn="{StaticResource ReduxSecondaryActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="MinHeight" Value="32" />
				<Setter Property="Margin" Value="0,0,6,0" />
				<Setter Property="Padding" Value="12,5" />
			</Style>
			<Style x:Key="SettingsPrimaryActionButtonStyle" BasedOn="{StaticResource ReduxPrimaryActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="MinHeight" Value="32" />
				<Setter Property="Margin" Value="0,0,6,0" />
				<Setter Property="Padding" Value="13,5" />
			</Style>
			<Style x:Key="SettingsDestructiveActionButtonStyle" BasedOn="{StaticResource ReduxMinorDestructiveActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="MinHeight" Value="32" />
				<Setter Property="Margin" Value="0,0,6,0" />
				<Setter Property="Padding" Value="12,5" />
			</Style>
			<Style x:Key="SettingsIconActionButtonStyle" BasedOn="{StaticResource SettingsActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Width" Value="32" />
				<Setter Property="MinWidth" Value="32" />
				<Setter Property="Padding" Value="7" />
			</Style>
			<Style x:Key="SettingsDestructiveIconActionButtonStyle" BasedOn="{StaticResource SettingsDestructiveActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Width" Value="32" />
				<Setter Property="MinWidth" Value="32" />
				<Setter Property="Padding" Value="7" />
			</Style>
			<Style x:Key="LaunchParameterMenuItemStyle" TargetType="{x:Type MenuItem}">
				<Setter Property="MinHeight" Value="28" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type MenuItem}">
							<Grid MinWidth="210" SnapsToDevicePixels="False">
								<Border x:Name="HoverSurface"
									Margin="1"
									Background="{DynamicResource ReduxAccentSoftBrush}"
									CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
									OpacityMask="{StaticResource Redux.Hover.WashMask}"
									IsHitTestVisible="False"
									Opacity="0" />
								<Border x:Name="HoverRail"
									Margin="1"
									BorderBrush="{DynamicResource ReduxAccentBrush}"
									BorderThickness="{DynamicResource Redux.Rail.Thickness}"
									CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
									IsHitTestVisible="False"
									Opacity="0" />
								<TextBlock Margin="11,5"
									VerticalAlignment="Center"
									Foreground="{TemplateBinding Foreground}"
									Text="{Binding Name}"
									TextTrimming="CharacterEllipsis" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsHighlighted" Value="True">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="HoverSurface"
													Storyboard.TargetProperty="Opacity" To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												<DoubleAnimation Storyboard.TargetName="HoverRail"
													Storyboard.TargetProperty="Opacity" To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="HoverSurface"
													Storyboard.TargetProperty="Opacity" To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
												<DoubleAnimation Storyboard.TargetName="HoverRail"
													Storyboard.TargetProperty="Opacity" To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="HotkeyRowActionButtonStyle" BasedOn="{StaticResource ReduxAccentPillButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Width" Value="24" />
				<Setter Property="Height" Value="24" />
				<Setter Property="Margin" Value="2,0,0,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
			</Style>
			<Style x:Key="ShortcutGroupExpanderStyle" TargetType="{x:Type Expander}">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Expander}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<ToggleButton x:Name="HeaderButton"
									HorizontalContentAlignment="Stretch"
									Background="Transparent"
									BorderThickness="0"
									Content="{TemplateBinding Header}"
									ContentTemplate="{TemplateBinding HeaderTemplate}"
									Cursor="Hand"
									FocusVisualStyle="{x:Null}"
									IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
									<ToggleButton.Template>
										<ControlTemplate TargetType="{x:Type ToggleButton}">
											<Border x:Name="HeaderSurface"
												Margin="6,10,6,4"
												Padding="5,3"
												Background="Transparent"
												CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<controls:ReduxIcon Width="12" Height="12" Margin="3,0,0,0"
														Foreground="{DynamicResource ReduxAccentHoverBrush}">
															<controls:ReduxIcon.Style>
																<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
																	<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ChevronRightStroke}" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
																			<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ChevronDownStroke}" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</controls:ReduxIcon.Style>
													</controls:ReduxIcon>
													<ContentPresenter Grid.Column="1" Margin="8,0,0,0"
														VerticalAlignment="Center"
														TextElement.Foreground="{DynamicResource ReduxAccentHoverBrush}"
														ContentSource="Content" />
													<Border Grid.Column="2" Height="1" Margin="11,0"
														VerticalAlignment="Center"
														Background="{DynamicResource ReduxAccentBrush}"
														Opacity="0.55" />
													<Border Grid.Column="3" MinWidth="25" Padding="7,2"
														Background="{DynamicResource ReduxAccentPillBackground}"
														BorderBrush="{DynamicResource ReduxAccentBrush}"
														BorderThickness="1"
														CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
														<TextBlock HorizontalAlignment="Center"
															Foreground="{DynamicResource ReduxAccentHoverBrush}"
															Text="{Binding Content.ItemCount, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" />
													</Border>
												</Grid>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</ToggleButton.Template>
								</ToggleButton>
								<Border x:Name="AnimatedContentHost" Grid.Row="1" ClipToBounds="True">
									<ContentPresenter x:Name="ExpandSite"
										ContentSource="Content"
										KeyboardNavigation.TabNavigation="Continue" />
								</Border>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsTabControlStyle" TargetType="{x:Type TabControl}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabControl}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<Border Margin="12,0,12,5"
									Background="Transparent"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="0,0,0,1">
								<TabPanel Margin="0,0,0,3" ClipToBounds="False" IsItemsHost="True" />
								</Border>
								<Border Grid.Row="1"
									Margin="12,0,12,12"
									Background="{DynamicResource ReduxSurfaceBrush}"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
									<ContentPresenter x:Name="PART_SelectedContentHost"
										ContentSource="SelectedContent"
										KeyboardNavigation.DirectionalNavigation="Contained"
										TextElement.Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
								</Border>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsTabItemStyle" TargetType="{x:Type TabItem}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="ClipToBounds" Value="False" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="Padding" Value="{DynamicResource Redux.TabHeader.Padding}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabItem}">
							<!--
								Inter-tab gap lives on the template root, NOT on TabItem.Margin:
								TabPanel double-counts external child margins and applies a layout
								clip 4px narrower than the tab, shearing the hover pill's right
								corner (the same clip caused the original selected-pill clipping).
							-->
							<Grid x:Name="HeaderHost"
								Margin="0,0,4,0"
								Background="Transparent"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5"
								TextElement.Foreground="{DynamicResource ReduxTextMutedBrush}">
								<Grid.RenderTransform>
									<TranslateTransform Y="0" />
								</Grid.RenderTransform>
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="2" />
								</Grid.RowDefinitions>
								<Border x:Name="TabHoverSurface"
									Grid.RowSpan="2"
									Margin="{DynamicResource Redux.TabHeader.HoverMargin}"
									Background="{DynamicResource ReduxAccentSoftBrush}"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									IsHitTestVisible="False"
									Opacity="0" />
								<ContentPresenter Margin="{TemplateBinding Padding}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									ContentSource="Header"
									RecognizesAccessKey="True" />
								<Border x:Name="SelectionUnderline"
									Grid.Row="1"
									Margin="5,0"
									Background="{DynamicResource ReduxAccentBrush}"
									CornerRadius="1"
									Opacity="0"
									RenderTransformOrigin="0.5,0.5">
									<Border.RenderTransform>
										<ScaleTransform ScaleX="0.4" />
									</Border.RenderTransform>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Panel.ZIndex" Value="1" />
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="HeaderHost" Property="TextElement.FontWeight" Value="SemiBold" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="1" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="1" Duration="0:0:0.14">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="0" Duration="0:0:0.10" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="0.4" Duration="0:0:0.10" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsPageTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.20}" />
				<Setter Property="FontWeight" Value="Bold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="SettingsPageDescriptionStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="Margin" Value="0,4,0,0" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="SettingsSectionCardStyle" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0,10,0,0" />
				<Setter Property="Padding" Value="12,10" />
				<Setter Property="Background" Value="{DynamicResource ReduxListInteriorBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Card}" />
			</Style>
			<Style x:Key="CompactThemeSectionCardStyle" BasedOn="{StaticResource SettingsSectionCardStyle}" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0,10,0,0" />
				<Setter Property="Padding" Value="12,10" />
			</Style>
			<Style x:Key="SettingsSectionTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.13}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="SettingsSubsectionTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="Margin" Value="0,12,0,4" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxAccentBrush}" />
			</Style>
			<Style x:Key="ThemeCardRadioStyle" TargetType="{x:Type RadioButton}">
				<Setter Property="Margin" Value="0,0,10,0" />
				<Setter Property="Padding" Value="10" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type RadioButton}">
							<Border x:Name="CardSurface"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform>
									<TranslateTransform x:Name="ThemeCardTranslate" Y="0" />
								</Border.RenderTransform>
								<Grid>
									<ContentPresenter />
									<Border x:Name="ThemeCardHoverSurface"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
										IsHitTestVisible="False"
										Opacity="0" />
									<Border x:Name="SelectionIndicator" Width="18" Height="18"
										HorizontalAlignment="Right" VerticalAlignment="Top"
										Background="{DynamicResource ReduxSurfaceBrush}"
										BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
										BorderThickness="1" CornerRadius="9">
										<TextBlock x:Name="SelectionCheck" HorizontalAlignment="Center" VerticalAlignment="Center"
											FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="Bold" Foreground="{DynamicResource ReduxAccentForegroundBrush}"
											Text="✓" Visibility="Collapsed" />
									</Border>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ThemeCardHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0.38" Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ThemeCardHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="SelectionIndicator" Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsWarningButtonStyle" BasedOn="{StaticResource ReduxMinorWarningActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="MinHeight" Value="32" />
				<Setter Property="Margin" Value="0,0,6,0" />
				<Setter Property="Padding" Value="12,5" />
			</Style>
			<Style x:Key="SettingsListViewStyle" BasedOn="{StaticResource {x:Type ListView}}" TargetType="{x:Type ListView}">
				<Setter Property="Background" Value="{DynamicResource ReduxListInteriorBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<controls:AutomationTooltip x:Key="ExtenderUpdateEntryToolTip" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
				<controls:AutomationTooltip.Resources>
					<DataTemplate x:Key="RegularVersionTooltip">
						<controls:AutoGrid Margin="10,0"
						    ChildMargin="4"
						    ColumnCount="2"
						    Columns="auto,*"
						    RowCount="4"
						    RowHeight="*"
						    Rows="auto,auto,auto,auto">
							<TextBlock Text="{loc:Text Build_Date_4698e7b0}" />
							<TextBlock Text="{Binding BuildDateDisplayString}" />
							<TextBlock Text="{loc:Text Game_Version_e69bd9db}" />
							<TextBlock Text="{Binding MinGameVersion}" />
							<TextBlock Text="{loc:Text Extender_Version_886f7269}" />
							<TextBlock Text="{Binding Version}" />
							<TextBlock Text="{loc:Text URL_734fd77b}" />
							<TextBlock Text="{Binding URL}" />
						</controls:AutoGrid>
					</DataTemplate>
					<DataTemplate x:Key="EmptyVersionTooltip">
