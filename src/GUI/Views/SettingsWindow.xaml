<local:SettingsWindowBase x:Class="DivinityModManager.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:behavior="clr-namespace:DivinityModManager.Controls.Behavior"
    xmlns:c="clr-namespace:DivinityModManager.Controls"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:conv="clr-namespace:DivinityModManager.Converters"
    xmlns:core="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:extdata="clr-namespace:DivinityModManager.Models.Extender;assembly=DivinityModManagerCore"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mv="clr-namespace:DivinityModManager.Models.View"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:util="clr-namespace:DivinityModManager.Util"
    xmlns:vm="clr-namespace:DivinityModManager.ViewModels"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="Preferences"
	Width="860"
	Height="720"
	MinWidth="780"
	MinHeight="600"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
    mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="SettingsActionButtonStyle" BasedOn="{StaticResource ReduxAccentPillButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Height" Value="30" />
				<Setter Property="Margin" Value="0,0,6,0" />
				<Setter Property="Padding" Value="11,4" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceMutedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="SettingsPrimaryActionButtonStyle" BasedOn="{StaticResource SettingsActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxAccentForegroundBrush}" />
			</Style>
			<Style x:Key="HotkeyRowActionButtonStyle" BasedOn="{StaticResource ReduxAccentPillButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Width" Value="24" />
				<Setter Property="Height" Value="24" />
				<Setter Property="Margin" Value="2,0,0,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
			</Style>
			<Style x:Key="SettingsTabControlStyle" TargetType="{x:Type TabControl}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabControl}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="37" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<Border Margin="12,0,12,5"
									Background="Transparent"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="0,0,0,1">
								<TabPanel Margin="0,0,0,3" ClipToBounds="False" IsItemsHost="True" />
								</Border>
								<Border Grid.Row="1"
									Margin="12,0,12,12"
									Background="{DynamicResource ReduxSurfaceBrush}"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
									<ContentPresenter x:Name="PART_SelectedContentHost"
										ContentSource="SelectedContent"
										KeyboardNavigation.DirectionalNavigation="Contained"
										TextElement.Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
								</Border>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsTabItemStyle" TargetType="{x:Type TabItem}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="ClipToBounds" Value="False" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="Padding" Value="{DynamicResource Redux.TabHeader.Padding}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabItem}">
							<!--
								Inter-tab gap lives on the template root, NOT on TabItem.Margin:
								TabPanel double-counts external child margins and applies a layout
								clip 4px narrower than the tab, shearing the hover pill's right
								corner (the same clip caused the original selected-pill clipping).
							-->
							<Grid x:Name="HeaderHost"
								Margin="0,0,4,0"
								Background="Transparent"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5"
								TextElement.Foreground="{DynamicResource ReduxTextMutedBrush}">
								<Grid.RenderTransform>
									<TranslateTransform Y="0" />
								</Grid.RenderTransform>
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="2" />
								</Grid.RowDefinitions>
								<Border x:Name="TabHoverSurface"
									Grid.RowSpan="2"
									Margin="{DynamicResource Redux.TabHeader.HoverMargin}"
									Background="{DynamicResource ReduxAccentSoftBrush}"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									IsHitTestVisible="False"
									Opacity="0" />
								<ContentPresenter Margin="{TemplateBinding Padding}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									ContentSource="Header"
									RecognizesAccessKey="True" />
								<Border x:Name="SelectionUnderline"
									Grid.Row="1"
									Margin="5,0"
									Background="{DynamicResource ReduxAccentBrush}"
									CornerRadius="1"
									Opacity="0"
									RenderTransformOrigin="0.5,0.5">
									<Border.RenderTransform>
										<ScaleTransform ScaleX="0.4" />
									</Border.RenderTransform>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Panel.ZIndex" Value="1" />
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="HeaderHost" Property="TextElement.FontWeight" Value="SemiBold" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="1" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="1" Duration="0:0:0.14">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="0" Duration="0:0:0.10" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="0.4" Duration="0:0:0.10" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsPageTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.20}" />
				<Setter Property="FontWeight" Value="Bold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="SettingsPageDescriptionStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="Margin" Value="0,4,0,0" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="SettingsSectionCardStyle" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0,14,0,0" />
				<Setter Property="Padding" Value="16,14" />
				<Setter Property="Background" Value="{DynamicResource ReduxListInteriorBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Card}" />
			</Style>
			<Style x:Key="CompactThemeSectionCardStyle" BasedOn="{StaticResource SettingsSectionCardStyle}" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0,10,0,0" />
				<Setter Property="Padding" Value="12,10" />
			</Style>
			<Style x:Key="SettingsSectionTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.13}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="SettingsSubsectionTitleStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="Margin" Value="0,12,0,4" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxAccentBrush}" />
			</Style>
			<Style x:Key="ThemeCardRadioStyle" TargetType="{x:Type RadioButton}">
				<Setter Property="Margin" Value="0,0,10,0" />
				<Setter Property="Padding" Value="10" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type RadioButton}">
							<Border x:Name="CardSurface"
								Padding="{TemplateBinding Padding}"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform>
									<TranslateTransform x:Name="ThemeCardTranslate" Y="0" />
								</Border.RenderTransform>
								<Grid>
									<ContentPresenter />
									<Border x:Name="ThemeCardHoverSurface"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
										IsHitTestVisible="False"
										Opacity="0" />
									<Border x:Name="SelectionIndicator" Width="18" Height="18"
										HorizontalAlignment="Right" VerticalAlignment="Top"
										Background="{DynamicResource ReduxSurfaceBrush}"
										BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
										BorderThickness="1" CornerRadius="9">
										<TextBlock x:Name="SelectionCheck" HorizontalAlignment="Center" VerticalAlignment="Center"
											FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="Bold" Foreground="{DynamicResource ReduxAccentForegroundBrush}"
											Text="✓" Visibility="Collapsed" />
									</Border>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ThemeCardHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0.38" Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ThemeCardHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="SelectionIndicator" Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="SelectionIndicator" Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="SelectionCheck" Property="Visibility" Value="Visible" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="SettingsWarningButtonStyle" BasedOn="{StaticResource SettingsActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
			</Style>
			<Style x:Key="SettingsListViewStyle" BasedOn="{StaticResource {x:Type ListView}}" TargetType="{x:Type ListView}">
				<Setter Property="Background" Value="{DynamicResource ReduxListInteriorBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<controls:AutomationTooltip x:Key="ExtenderUpdateEntryToolTip" DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
				<controls:AutomationTooltip.Resources>
					<DataTemplate x:Key="RegularVersionTooltip">
						<controls:AutoGrid Margin="10,0"
						    ChildMargin="4"
						    ColumnCount="2"
						    Columns="auto,*"
						    RowCount="4"
						    RowHeight="*"
						    Rows="auto,auto,auto,auto">
							<TextBlock Text="Build Date:" />
							<TextBlock Text="{Binding BuildDateDisplayString}" />
							<TextBlock Text="Game Version:" />
							<TextBlock Text="{Binding MinGameVersion}" />
							<TextBlock Text="Extender Version:" />
							<TextBlock Text="{Binding Version}" />
							<TextBlock Text="URL:" />
							<TextBlock Text="{Binding URL}" />
						</controls:AutoGrid>
					</DataTemplate>
					<DataTemplate x:Key="EmptyVersionTooltip">
						<TextBlock Text="The extender will automatically update to the latest version of the selected UpdateChannel" />
					</DataTemplate>
				</controls:AutomationTooltip.Resources>
				<controls:AutomationTooltip.Style>
					<Style BasedOn="{StaticResource {x:Type ToolTip}}" TargetType="controls:AutomationTooltip" />
				</controls:AutomationTooltip.Style>
				<ContentControl Content="{Binding}">
					<ContentControl.Style>
						<Style TargetType="{x:Type ContentControl}">
							<Setter Property="ContentTemplate" Value="{StaticResource RegularVersionTooltip}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEmpty}" Value="True">
									<Setter Property="ContentTemplate" Value="{StaticResource EmptyVersionTooltip}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ContentControl.Style>
				</ContentControl>
			</controls:AutomationTooltip>
			<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
				<Setter Property="MinHeight" Value="30" />
				<Setter Property="Padding" Value="12,4" />
				<Setter Property="Margin" Value="2,0,2,0" />
			</Style>
			<Style TargetType="StackPanel">
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Orientation" Value="Horizontal" />
				<Setter Property="Margin" Value="10" />
			</Style>
			<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style BasedOn="{StaticResource ReduxCheckBoxStyle}" TargetType="CheckBox">
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="0,1" />
			</Style>
			<Style TargetType="controls:AutoGrid">
				<Setter Property="Margin" Value="10,0" />
				<Setter Property="ChildMargin" Value="4" />
				<Setter Property="ColumnCount" Value="2" />
				<Setter Property="Columns" Value="*,*" />
				<Setter Property="RowCount" Value="1" />
				<Setter Property="RowHeight" Value="*" />
				<Setter Property="Rows" Value="auto" />
			</Style>
			<Style x:Key="TabItemWithContextMenu" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
				<Setter Property="ContextMenu">
					<Setter.Value>
						<ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
							<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding}" Header="Open in File Explorer...">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding}" Header="Copy Path to Clipboard">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
							</MenuItem>
						</ContextMenu>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="EnumEntryTemplate" DataType="mv:EnumEntry">
				<TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar
			Background="{DynamicResource ReduxWindowBrush}"
			BottomBorderThickness="0"
			IconData="{DynamicResource Redux.Icon.Settings}" />
		<Grid Grid.Row="1" Background="{DynamicResource ReduxWindowBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Border Margin="12,7,12,5"
			Padding="0,4"
			Background="Transparent"
			BorderThickness="0">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>
			<StackPanel Margin="0" HorizontalAlignment="Left" Orientation="Horizontal">
				<Button x:Name="SaveSettingsButton" Style="{StaticResource SettingsPrimaryActionButtonStyle}" ToolTip="Save all Preferences now (Ctrl+S)">
					<StackPanel Margin="0" Orientation="Horizontal">
						<controls:ReduxIcon
							Margin="0,0,6,0"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
							StrokeData="{StaticResource Redux.Icon.Save}" />
						<TextBlock Text="Save Preferences" />
					</StackPanel>
				</Button>
				<Button x:Name="OpenSettingsFolderButton" Style="{StaticResource SettingsActionButtonStyle}" ToolTip="Open Settings Folder">
					<StackPanel Margin="0" Orientation="Horizontal">
						<controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.FolderOpen}" />
						<TextBlock Text="Settings Folder" />
					</StackPanel>
				</Button>
			</StackPanel>
			<Button x:Name="ResetSettingsButton"
			    Grid.Column="1"
			    HorizontalAlignment="Right"
			    Style="{StaticResource SettingsWarningButtonStyle}">
				<StackPanel Margin="0" Orientation="Horizontal">
					<controls:ReduxIcon Margin="0,0,6,0" Foreground="{DynamicResource ReduxWarningBrush}" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
					<TextBlock Text="Reset" />
				</StackPanel>
			</Button>
		</Grid>
		</Border>

		<TabControl x:Name="PreferencesTabControl"
			Grid.Row="1"
			ItemContainerStyle="{StaticResource SettingsTabItemStyle}"
			Style="{StaticResource SettingsTabControlStyle}">
			<TabItem x:Name="GeneralSettingssTab" FocusManager.FocusedElement="{Binding ElementName=SettingsAutoGrid}">
				<TabItem.Header>
					<TextBlock x:Name="GeneralSettingsTabHeader"
					    Style="{StaticResource TabItemWithContextMenu}"
					    Text="General"
					    ToolTip="Mod Manager Settings (Data/settings.json)" />
				</TabItem.Header>
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Grid Margin="18,14">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="General preferences" />
						<TextBlock Grid.Row="1"
							Style="{StaticResource SettingsPageDescriptionStyle}"
							Text="Core mod manager behavior, paths, integrations, and everyday workflow." />
						<Border Grid.Row="2" Style="{StaticResource SettingsSectionCardStyle}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="1" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="General settings" />
								<Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource ReduxBorderBrush}" />
								<controls:AutoGrid x:Name="SettingsAutoGrid" Grid.Row="2" Margin="0,12,0,0" Columns="2*,3*" />
							</Grid>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
			<TabItem x:Name="AppearanceSettingsTab">
				<TabItem.Header><TextBlock Text="Theme &amp; Appearance" ToolTip="Redux colors and appearance" /></TabItem.Header>
				<TabItem.Resources>
					<Style TargetType="{x:Type StackPanel}">
						<Setter Property="Margin" Value="0" />
						<Setter Property="Orientation" Value="Vertical" />
					</Style>
				</TabItem.Resources>
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Grid Margin="18,12">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="1" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Theme &amp; Appearance" />
						<TextBlock Grid.Row="1" Style="{StaticResource SettingsPageDescriptionStyle}"
							Text="Choose a built-in look or create reusable themes with their own colors, typeface, and text scale." />
						<Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource ReduxBorderBrush}" />

						<StackPanel Grid.Row="3" Margin="0,12,0,0">
							<Grid Margin="0,0,0,8">
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Built-in themes" />
								<TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Ctrl+L cycles built-in themes" />
							</Grid>
							<ComboBox x:Name="ThemeComboBox" Width="1" Height="1" HorizontalAlignment="Left" Opacity="0"
								IsHitTestVisible="False" IsTabStop="False" DisplayMemberPath="Description"
								ItemsSource="{Binding Source={ext:EnumExtension {x:Type data:ReduxThemeType}}}" SelectedValuePath="Value"
								SelectionChanged="ThemeComboBox_SelectionChanged" />
							<UniformGrid Columns="3">
								<RadioButton x:Name="ReduxDarkThemeCard" GroupName="BuiltInThemes" Style="{StaticResource ThemeCardRadioStyle}"
									Tag="{x:Static data:ReduxThemeType.ReduxDark}" Click="ThemeCard_Click">
									<StackPanel>
										<Border Height="76" Margin="0,0,0,8" Padding="8" Background="#17151C" BorderBrush="#3A3346" BorderThickness="1" CornerRadius="6">
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<Border Margin="0,0,7,0" Background="#211D28" CornerRadius="4" />
												<StackPanel Grid.Column="1">
													<Border Height="13" Margin="0,0,0,7" Background="#2A2433" CornerRadius="3" />
													<Border Height="21" Margin="0,0,0,6" Background="#342B49" CornerRadius="3" />
													<Border Height="7" Width="54" HorizontalAlignment="Left" Background="#8A6AF1" CornerRadius="3" />
												</StackPanel>
											</Grid>
										</Border>
										<TextBlock FontSize="{DynamicResource Redux.FontSize.14}" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Redux Dark" />
										<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.11}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Deep, focused, and easy on the eyes." TextWrapping="Wrap" />
									</StackPanel>
								</RadioButton>
								<RadioButton x:Name="ReduxLightThemeCard" GroupName="BuiltInThemes" Style="{StaticResource ThemeCardRadioStyle}"
									Tag="{x:Static data:ReduxThemeType.ReduxLight}" Click="ThemeCard_Click">
									<StackPanel>
										<Border Height="76" Margin="0,0,0,8" Padding="8" Background="#F5F3FA" BorderBrush="#C9C4D7" BorderThickness="1" CornerRadius="6">
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<Border Margin="0,0,7,0" Background="#EAE6F2" CornerRadius="4" />
												<StackPanel Grid.Column="1">
													<Border Height="13" Margin="0,0,0,7" Background="#FFFFFF" CornerRadius="3" />
													<Border Height="21" Margin="0,0,0,6" Background="#EAE6FF" CornerRadius="3" />
													<Border Height="7" Width="54" HorizontalAlignment="Left" Background="#6755E8" CornerRadius="3" />
												</StackPanel>
											</Grid>
										</Border>
										<TextBlock FontSize="{DynamicResource Redux.FontSize.14}" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Redux Light" />
										<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.11}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Clean and bright for daytime use." TextWrapping="Wrap" />
									</StackPanel>
								</RadioButton>
								<RadioButton x:Name="ParchmentThemeCard" GroupName="BuiltInThemes" Margin="0" Style="{StaticResource ThemeCardRadioStyle}"
									Tag="{x:Static data:ReduxThemeType.Parchment}" Click="ThemeCard_Click">
									<StackPanel>
										<Border Height="76" Margin="0,0,0,8" Padding="8" Background="#E6DCC6" BorderBrush="#A89980" BorderThickness="1" CornerRadius="6">
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<Border Margin="0,0,7,0" Background="#D8CCB2" CornerRadius="4" />
												<StackPanel Grid.Column="1">
													<Border Height="13" Margin="0,0,0,7" Background="#EDE2CC" CornerRadius="3" />
													<Border Height="21" Margin="0,0,0,6" Background="#D5B4A8" CornerRadius="3" />
													<Border Height="7" Width="54" HorizontalAlignment="Left" Background="#7B1E1E" CornerRadius="3" />
												</StackPanel>
											</Grid>
										</Border>
										<TextBlock FontSize="{DynamicResource Redux.FontSize.14}" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Parchment" />
										<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.11}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Warm parchment tones for a classic feel." TextWrapping="Wrap" />
									</StackPanel>
								</RadioButton>
							</UniformGrid>
						</StackPanel>

						<Border Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource CompactThemeSectionCardStyle}">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,14,0">
									<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Current appearance" />
									<TextBlock Margin="0,3,0,7" Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="{Binding SelectedItem.Description, ElementName=ThemeComboBox}" />
									<StackPanel Orientation="Horizontal" ToolTip="Current theme palette">
										<Border Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource ReduxWindowBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="9" />
										<Border Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="9" />
										<Border Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource ReduxAccentBrush}" CornerRadius="9" />
										<Border Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource ReduxSuccessBrush}" CornerRadius="9" />
										<Border Width="18" Height="18" Margin="0,0,6,0" Background="{DynamicResource ReduxWarningBrush}" CornerRadius="9" />
										<Border Width="18" Height="18" Background="{DynamicResource ReduxErrorBrush}" CornerRadius="9" />
									</StackPanel>
								</StackPanel>
								<Border Grid.Column="1" Background="{DynamicResource ReduxBorderBrush}" />
								<UniformGrid Grid.Column="2" Margin="14,0,0,0" Columns="2" VerticalAlignment="Center">
									<CheckBox Margin="0,0,10,0" ToolTip="Use category colors for hover and selection throughout Redux"
										IsChecked="{Binding Settings.UseCategoryColorsForInteractions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
										<StackPanel Margin="6,0,0,0">
											<TextBlock FontWeight="SemiBold" Text="Category-colored interactions" />
											<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Use assigned category colors for hover and selection across mod lists, separators, and the Categories pane." TextWrapping="Wrap" />
										</StackPanel>
									</CheckBox>
									<CheckBox x:Name="InterfaceIconsCheckBox" Margin="0,0,10,0"
										ToolTip="Show category and source icons throughout Redux"
										IsChecked="{Binding Settings.ShowCategoryIconsInPills, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										Unchecked="InterfaceIconsCheckBox_Unchecked">
										<StackPanel Margin="6,0,0,0">
											<TextBlock FontWeight="SemiBold" Text="Interface icons" />
											<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Show category, source, and status icons in lists, cards, and details." TextWrapping="Wrap" />
										</StackPanel>
									</CheckBox>
									<CheckBox ToolTip="Match sidebar category names to their assigned colors"
										IsChecked="{Binding Settings.UseCategoryColorsForSidebarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
										<StackPanel Margin="6,0,0,0">
											<TextBlock FontWeight="SemiBold" Text="Colored text" />
											<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Use contextual category and source colors for text throughout lists, cards, and details." TextWrapping="Wrap" />
										</StackPanel>
									</CheckBox>
									<CheckBox Margin="0,8,10,0" ToolTip="Use compact icon-only category, source, and status labels"
										IsChecked="{Binding Settings.UseIconsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										IsEnabled="{Binding IsChecked, ElementName=InterfaceIconsCheckBox}">
										<StackPanel Margin="6,0,0,0">
											<TextBlock FontWeight="SemiBold" Text="Icons only" />
											<TextBlock Margin="0,3,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Show compact category, source, and status icons without persistent label text." TextWrapping="Wrap" />
										</StackPanel>
									</CheckBox>
								</UniformGrid>
							</Grid>
						</Border>

						<Border Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource CompactThemeSectionCardStyle}">
							<Grid>
								<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel VerticalAlignment="Center">
									<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Typography" />
									<TextBlock Margin="0,3,0,7" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Typeface and scale apply throughout Redux." TextWrapping="Wrap" />
									<TextBlock x:Name="TypographyPreviewText" FontFamily="{DynamicResource Redux.FontFamily.UI}"
										FontSize="{DynamicResource Redux.FontSize.20}" Text="Aa Qg 0O 1l" />
								</StackPanel>
								<Grid Grid.Column="2" VerticalAlignment="Center">
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Typeface" />
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
											<ComboBox x:Name="TypographyComboBox" Grid.Column="0" MinWidth="170" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
												SelectionChanged="TypographyComboBox_SelectionChanged" ToolTip="Choose a bundled or imported typeface" />
											<Button Grid.Column="1" Width="32" MinWidth="32" Margin="6,0,0,0" Padding="7" Style="{StaticResource SettingsActionButtonStyle}" Click="ImportCustomFont_Click" ToolTip="Import a TrueType or OpenType font"><controls:ReduxIcon Width="14" Height="14" StrokeData="{StaticResource Redux.Icon.Download}" /></Button>
											<Button x:Name="DeleteCustomFontButton" Grid.Column="2" Width="32" MinWidth="32" Margin="6,0,0,0" Padding="7" Style="{StaticResource SettingsActionButtonStyle}" Click="DeleteCustomFont_Click" ToolTip="Remove the selected imported font"><controls:ReduxIcon Width="14" Height="14" StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" /></Button>
											<Button Grid.Column="3" Width="32" MinWidth="32" Margin="6,0,0,0" Padding="7" Style="{StaticResource SettingsActionButtonStyle}" Click="OpenCustomFontsFolder_Click" ToolTip="Open the custom fonts folder"><controls:ReduxIcon Width="14" Height="14" StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></Button>
										</Grid>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Text size" />
										<ComboBox x:Name="TextSizeComboBox" DisplayMemberPath="Description"
												ItemsSource="{Binding Source={ext:EnumExtension {x:Type data:ReduxTextSize}}}" SelectedValuePath="Value"
												ToolTip="Choose Compact, Default, or Large interface text" />
									</StackPanel>
									<TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
										FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="Imported fonts are provided as-is; some files may render differently or may not be compatible with Redux." TextWrapping="Wrap" />
									</Grid>
							</Grid>
						</Border>

						<Border Grid.Row="6" Margin="0,10,0,0" Style="{StaticResource CompactThemeSectionCardStyle}">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel VerticalAlignment="Center">
									<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Custom themes" />
									<TextBlock Margin="0,3,0,7" Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="Save a palette, typeface, and text scale as one reusable theme." TextWrapping="Wrap" />
									<TextBlock x:Name="CustomThemeStatusText" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="No custom themes yet." TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<ComboBox x:Name="CustomThemeComboBox" MinWidth="240" DisplayMemberPath="Name"
										SelectionChanged="CustomThemeComboBox_SelectionChanged" ToolTip="Select and apply a custom theme" />
									<WrapPanel Margin="0,8,0,0">
										<Button Margin="0,0,6,6" Style="{StaticResource SettingsActionButtonStyle}" Click="CreateCustomTheme_Click"><StackPanel Margin="0" Orientation="Horizontal"><controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.AddCircle}" /><TextBlock Text="Create" /></StackPanel></Button>
										<Button x:Name="EditCustomThemeButton" Margin="0,0,6,6" Style="{StaticResource SettingsActionButtonStyle}" Click="EditCustomTheme_Click"><StackPanel Margin="0" Orientation="Horizontal"><controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Create}" /><TextBlock Text="Edit" /></StackPanel></Button>
										<Button x:Name="DuplicateCustomThemeButton" Margin="0,0,6,6" Style="{StaticResource SettingsActionButtonStyle}" Click="DuplicateCustomTheme_Click" Content="Duplicate" />
										<Button x:Name="DeleteCustomThemeButton" Margin="0,0,6,6" Style="{StaticResource SettingsActionButtonStyle}" Click="DeleteCustomTheme_Click"><StackPanel Margin="0" Orientation="Horizontal"><controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" /><TextBlock Text="Delete" /></StackPanel></Button>
										<Button Margin="0,0,6,6" Style="{StaticResource SettingsActionButtonStyle}" Click="ImportCustomTheme_Click" ToolTip="Import a shared Redux theme"><StackPanel Margin="0" Orientation="Horizontal"><controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Download}" /><TextBlock Text="Import" /></StackPanel></Button>
										<Button x:Name="ExportCustomThemeButton" Margin="0,0,0,6" Style="{StaticResource SettingsActionButtonStyle}" Click="ExportCustomTheme_Click" ToolTip="Export the selected theme"><StackPanel Margin="0" Orientation="Horizontal"><controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.CloudUpload}" /><TextBlock Text="Export" /></StackPanel></Button>
									</WrapPanel>
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
			<TabItem x:Name="ScriptExtenderTab" FocusManager.FocusedElement="{Binding ElementName=ExtenderSettingsAutoGrid}">
				<TabItem.Header>
					<TextBlock x:Name="ScriptExtenderTabHeader"
					    Style="{StaticResource TabItemWithContextMenu}"
					    Text="Script Extender"
					    ToolTip="Script Extender Settings (ScriptExtenderSettings.json)" />
				</TabItem.Header>
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Grid Margin="18,14">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Script Extender" />
						<TextBlock Grid.Row="1"
							Style="{StaticResource SettingsPageDescriptionStyle}"
							Text="Configure Script Extender behavior without changing your installed mods or load order." />
						<Border Grid.Row="2" Style="{StaticResource SettingsSectionCardStyle}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="1" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Extender settings" />
								<Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource ReduxBorderBrush}" />
								<controls:AutoGrid x:Name="ExtenderSettingsAutoGrid" Grid.Row="2" Margin="0,12,0,0" />
							</Grid>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
			<TabItem x:Name="ScriptExtenderUpdaterTab" FocusManager.FocusedElement="{Binding ElementName=ExtenderUpdaterSettingsAutoGrid}">
				<TabItem.Header>
					<TextBlock x:Name="UpdaterTabHeader"
					    Style="{StaticResource TabItemWithContextMenu}"
					    Text="Updater"
					    ToolTip="Script Extender Updater Settings (ScriptExtenderUpdaterConfig.json)" />
				</TabItem.Header>
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Grid Margin="18,14">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Extender updater" />
						<TextBlock Grid.Row="1"
							Style="{StaticResource SettingsPageDescriptionStyle}"
							Text="Choose how Script Extender update information is retrieved and which version is targeted." />
						<Border Grid.Row="2" Style="{StaticResource SettingsSectionCardStyle}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="1" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Update source and version" />
								<Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource ReduxBorderBrush}" />
								<controls:AutoGrid x:Name="ExtenderUpdaterSettingsAutoGrid" Grid.Row="2" Margin="0,12,0,0">
							<TextBlock x:Name="UpdateChannelTextBlock"
							    Grid.Column="0"
							    behavior:TextBlockSettingsEntryAttributeBehavior.Property="UpdateChannel"
							    behavior:TextBlockSettingsEntryAttributeBehavior.TargetType="{x:Type extdata:ScriptExtenderUpdateConfig}"
							    Text="Update Channel" />
							<ComboBox x:Name="UpdateChannelComboBox"
							    DisplayMemberPath="Description"
							    ItemsSource="{Binding Source={ext:EnumExtension {x:Type core:ExtenderUpdateChannel}}}"
							    SelectedValuePath="Value"
							    ToolTip="{Binding ElementName=UpdateChannelTextBlock, Path=ToolTip}" />
							<TextBlock x:Name="SelectVersionTextBlock"
							    Grid.Column="0"
							    Text="Select Version"
							    ToolTip="Select a version to automatically set the Target Version and Target Digest&#x0a;This list is automatically populated from the online extender manifest data, using the selected Update Channel" />
							<ComboBox x:Name="UpdaterTargetVersionComboBox"
							    Grid.Column="1"
							    DisplayMemberPath="DisplayName"
							    ToolTip="{StaticResource ExtenderUpdateEntryToolTip}" />
								</controls:AutoGrid>
							</Grid>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
			<TabItem x:Name="KeybindingsTabItem" FocusManager.FocusedElement="{Binding ElementName=KeybindingsListView}">
				<TabItem.Header>
					<TextBlock x:Name="KeybindingsTabHeader"
					    Style="{StaticResource TabItemWithContextMenu}"
					    Text="Keyboard Shortcuts"
					    ToolTip="Mod Manager Settings (Data/keybindings.json)" />
				</TabItem.Header>
				<Grid Margin="18,14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="216" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Keyboard shortcuts" />
					<TextBlock Grid.Row="1"
						Style="{StaticResource SettingsPageDescriptionStyle}"
						Text="Select a shortcut and press Enter, or double-click its row to record a new key combination." />
					<Grid Grid.Column="1"
						Grid.RowSpan="2"
						MinHeight="30"
						Margin="12,0,8,10"
						VerticalAlignment="Center">
						<TextBox x:Name="KeybindingsSearchTextBox"
							Padding="8,2"
							VerticalContentAlignment="Center"
							adonisExtensions:CornerRadiusExtension.CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
							Background="{DynamicResource ReduxSurfaceMutedBrush}"
							BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
							TextChanged="KeybindingsSearchTextBox_TextChanged"
							ToolTip="Filter commands, categories, or shortcuts" />
						<TextBlock Margin="9,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							IsHitTestVisible="False"
							Text="Filter shortcuts">
							<TextBlock.Style>
								<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Text, ElementName=KeybindingsSearchTextBox}" Value="">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
					<Border Grid.Row="2"
						Grid.ColumnSpan="2"
						Padding="0"
						ClipToBounds="True"
						Style="{StaticResource SettingsSectionCardStyle}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="1" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Grid Margin="12,6,8,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="166" />
									<ColumnDefinition Width="54" />
								</Grid.ColumnDefinitions>
								<TextBlock Style="{StaticResource Redux.Text.Overline}" Text="Command" />
								<TextBlock Grid.Column="1" Style="{StaticResource Redux.Text.Overline}" Text="Shortcut" />
								<TextBlock Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource Redux.Text.Overline}" Text="Actions" />
							</Grid>
							<Border Grid.Row="1" Background="{DynamicResource ReduxBorderBrush}" />
							<ListView x:Name="KeybindingsListView"
								Grid.Row="2"
								KeyboardNavigation.TabNavigation="Continue"
								MouseDoubleClick="HotkeyListViewItem_MouseDoubleClick"
								ScrollViewer.CanContentScroll="True"
								ScrollViewer.VerticalScrollBarVisibility="Auto"
								Style="{StaticResource SettingsListViewStyle}"
								VirtualizingPanel.IsVirtualizing="True"
								VirtualizingPanel.IsVirtualizingWhenGrouping="True"
								VirtualizingPanel.VirtualizationMode="Recycling">
								<ListView.GroupStyle>
									<GroupStyle>
										<GroupStyle.HeaderTemplate>
											<DataTemplate>
												<Grid Margin="4,5,4,2">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Margin="8,2"
														Foreground="{DynamicResource ReduxTextSecondaryBrush}"
														Style="{StaticResource Redux.Text.Overline}"
														Text="{Binding Name}" />
													<Border Grid.Column="1"
														MinWidth="22"
														Margin="0,0,6,0"
														Padding="5,1"
														Background="{DynamicResource ReduxSurfaceMutedBrush}"
														CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
														<TextBlock HorizontalAlignment="Center"
															Foreground="{DynamicResource ReduxTextMutedBrush}"
															Text="{Binding ItemCount}" />
													</Border>
												</Grid>
											</DataTemplate>
										</GroupStyle.HeaderTemplate>
									</GroupStyle>
								</ListView.GroupStyle>
								<ListView.ItemContainerStyle>
									<Style BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
										<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
										<Setter Property="Tag" Value="{Binding}" />
										<Setter Property="Background" Value="Transparent" />
										<Setter Property="BorderBrush" Value="Transparent" />
										<Setter Property="BorderThickness" Value="0" />
										<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
										<Setter Property="HorizontalContentAlignment" Value="Stretch" />
										<Setter Property="VerticalContentAlignment" Value="Center" />
										<Setter Property="ToolTip" Value="{Binding ToolTip}" />
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="{x:Type ListViewItem}">
											<Grid x:Name="HotkeyRowRoot" Background="Transparent"
												util:ReduxWindowBehavior.HoverLift="1"
												SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
												<Grid.RenderTransform>
													<TranslateTransform x:Name="HotkeyRowTranslate" Y="0" />
												</Grid.RenderTransform>
												<Border x:Name="RowChrome"
													Margin="4,1"
															Background="{TemplateBinding Background}"
															BorderBrush="{TemplateBinding BorderBrush}"
													BorderThickness="{TemplateBinding BorderThickness}"
													CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" />
												<Border x:Name="RowHoverSurface"
													Margin="4,1"
													Background="{DynamicResource ReduxAccentSoftBrush}"
													BorderBrush="{DynamicResource ReduxAccentBrush}"
													BorderThickness="{DynamicResource Redux.Rail.Thickness}"
													CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
													OpacityMask="{StaticResource Redux.Hover.WashMask}"
													IsHitTestVisible="False"
													Opacity="0" />
												<Border x:Name="SelectionRail"
															Width="2"
															Margin="4,5,0,5"
															HorizontalAlignment="Left"
															Background="{DynamicResource ReduxAccentBrush}"
															CornerRadius="1"
															Opacity="0" />
														<ContentPresenter
															HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
															Content="{TemplateBinding Content}"
															ContentTemplate="{TemplateBinding ContentTemplate}"
															ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
													</Grid>
												<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
														<Trigger.EnterActions>
															<BeginStoryboard>
																<Storyboard>
																	<DoubleAnimation Storyboard.TargetName="RowHoverSurface" Storyboard.TargetProperty="Opacity"
																		To="0.62" Duration="{StaticResource Redux.Motion.Fast}"
																		EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
																</Storyboard>
															</BeginStoryboard>
														</Trigger.EnterActions>
														<Trigger.ExitActions>
															<BeginStoryboard>
																<Storyboard>
																	<DoubleAnimation Storyboard.TargetName="RowHoverSurface" Storyboard.TargetProperty="Opacity"
																		To="0" Duration="{StaticResource Redux.Motion.Standard}"
																		EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
																</Storyboard>
															</BeginStoryboard>
														</Trigger.ExitActions>
												</Trigger>
														<Trigger Property="IsSelected" Value="True">
															<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
															<Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
															<Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
														</Trigger>
														<Trigger Property="IsEnabled" Value="False">
															<Setter Property="Opacity" Value="0.55" />
														</Trigger>
													</ControlTemplate.Triggers>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Setter Property="ContextMenu">
											<Setter.Value>
												<ContextMenu>
													<MenuItem x:Name="ResetHotkeyMenuItem" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}, Path=PlacementTarget.DataContext.ResetCommand}" Header="Reset Keybinding">
														<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.RefreshStroke}" /></MenuItem.Icon>
													</MenuItem>
													<MenuItem x:Name="ClearHotkeyMenuItem" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}, Path=PlacementTarget.DataContext.ClearCommand}" Header="Remove Keybinding">
														<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.RemoveCircle}" Foreground="{DynamicResource ReduxErrorBrush}" /></MenuItem.Icon>
													</MenuItem>
												</ContextMenu>
											</Setter.Value>
										</Setter>
									</Style>
								</ListView.ItemContainerStyle>
								<ListView.ItemTemplate>
									<DataTemplate>
										<Grid MinHeight="32" Margin="12,0,8,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="166" />
												<ColumnDefinition Width="27" />
												<ColumnDefinition Width="27" />
											</Grid.ColumnDefinitions>
											<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
												<TextBlock Margin="0,0,5,0" Foreground="{DynamicResource ReduxSuccessBrush}" FontWeight="Bold"
													Text="{Binding ModifiedText, Mode=OneWay}" />
												<TextBlock VerticalAlignment="Center"
													Foreground="{DynamicResource ReduxTextPrimaryBrush}"
													Text="{Binding DisplayName, Mode=OneWay}"
													TextTrimming="CharacterEllipsis" />
											</StackPanel>
											<controls:HotkeyEditorControl Grid.Column="1"
												Margin="0,0,8,0"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Center"
												FocusReturnTarget="{Binding ElementName=KeybindingsListView}"
												GotFocus="HotkeyEditorControl_GotFocus"
												Hotkey="{Binding}"
												LostFocus="HotkeyEditorControl_LostFocus" />
											<Button Grid.Column="2"
												Command="{Binding ResetCommand}"
												Style="{StaticResource HotkeyRowActionButtonStyle}"
												ToolTip="Reset to default">
												<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
											</Button>
											<Button Grid.Column="3"
												Command="{Binding ClearCommand}"
												Style="{StaticResource HotkeyRowActionButtonStyle}"
												ToolTip="Remove shortcut">
												<controls:ReduxIcon Foreground="{DynamicResource ReduxErrorBrush}" StrokeData="{StaticResource Redux.Icon.RemoveCircle}" />
											</Button>
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
							<StackPanel Grid.Row="2"
								Margin="24"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								IsHitTestVisible="False">
								<StackPanel.Style>
									<Style TargetType="{x:Type StackPanel}">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding Items.Count, ElementName=KeybindingsListView}" Value="0">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>
								<controls:ReduxIcon Width="20"
									Height="20"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									StrokeData="{StaticResource Redux.Icon.Funnel}" />
								<TextBlock Margin="0,8,0,0"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="No matching shortcuts" />
								<TextBlock Margin="0,3,0,0"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Try a command name, category, or key combination." />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
			<TabItem x:Name="AdvancedSettingsTab" FocusManager.FocusedElement="{Binding ElementName=AdvancedSettingsAutoGrid}">
				<TabItem.Header>
					<TextBlock x:Name="AdvancedSettingsTabHeader"
					    Style="{StaticResource TabItemWithContextMenu}"
					    Text="Advanced"
					    ToolTip="Advanced Mod Manager Settings (Data/settings.json)" />
				</TabItem.Header>
				<TabItem.Resources>
					<Style TargetType="{x:Type StackPanel}">
						<Setter Property="Margin" Value="0" />
						<Setter Property="Orientation" Value="Vertical" />
					</Style>
				</TabItem.Resources>
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Grid Margin="20,16">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Advanced tools" />
						<TextBlock Grid.Row="1"
							Style="{StaticResource SettingsPageDescriptionStyle}"
							Text="Diagnostics, launch arguments, and maintenance options. Change these only when needed." />
						<Border Grid.Row="2" Style="{StaticResource SettingsSectionCardStyle}">
							<StackPanel x:Name="AdvancedSettingsAutoGrid">
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Diagnostics" />
								<TextBlock Margin="0,3,0,10"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Logging and developer information used when investigating unexpected behavior."
									TextWrapping="Wrap" />
								<Grid Margin="0,4">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock x:Name="DebugModeTextBlock"
											FontWeight="SemiBold"
											behavior:TextBlockSettingsEntryAttributeBehavior.Property="DebugModeEnabled"
											behavior:TextBlockSettingsEntryAttributeBehavior.TargetType="{x:Type data:DivinityModManagerSettings}" />
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}"
											Text="Show additional diagnostics and experimental advisor details."
											TextWrapping="Wrap" />
									</StackPanel>
									<CheckBox x:Name="DebugModeCheckBox" Grid.Column="1"
										Margin="16,0,0,0"
										VerticalAlignment="Center"
										Style="{StaticResource ReduxCheckBoxStyle}"
										ToolTip="{Binding ElementName=DebugModeTextBlock, Path=ToolTip}" />
								</Grid>
								<Grid Margin="0,8,0,4">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock FontWeight="SemiBold" Text="Mod Manager logs" />
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}"
											Text="Automatically save diagnostic output in the _Logs folder."
											TextWrapping="Wrap" />
									</StackPanel>
									<CheckBox x:Name="LogEnabledCheckBox" Grid.Column="1"
										Margin="16,0,0,0"
										VerticalAlignment="Center"
										Style="{StaticResource ReduxCheckBoxStyle}" />
								</Grid>
							</StackPanel>
						</Border>
						<Border Grid.Row="3" Style="{StaticResource SettingsSectionCardStyle}">
							<StackPanel>
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Launch behavior" />
								<TextBlock Margin="0,3,0,10"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Optional command-line arguments passed to Baldur's Gate 3 when launched through Redux."
									TextWrapping="Wrap" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Button x:Name="GameLaunchParamsMainButton"
										Margin="0,0,8,0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsActionButtonStyle}"
										ToolTip="Choose a common launch parameter">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
												Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
												StrokeData="{StaticResource Redux.Icon.Terminal}" />
											<TextBlock Text="Add parameter" />
										</StackPanel>
						<Button.ContextMenu>
							<ContextMenu x:Name="GameLaunchParamsMainMenu">
								<ContextMenu.ItemTemplate>
									<DataTemplate DataType="vm:GameLaunchParamEntry">
										<TextBlock Text="{Binding}" />
									</DataTemplate>
								</ContextMenu.ItemTemplate>
								<ContextMenu.ItemContainerStyle>
									<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
										<Setter Property="Header" Value="{Binding Name}" />
										<Setter Property="ToolTip" Value="{Binding Description}" />
										<Setter Property="ToolTipService.IsEnabled" Value="{Binding HasToolTip, FallbackValue=False}" />
										<Setter Property="ToolTipService.InitialShowDelay" Value="250" />
										<Setter Property="Command" Value="{Binding Path=DataContext.AddLaunchParamCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SettingsWindow}}}" />
										<Setter Property="CommandParameter" Value="{Binding Name}" />
									</Style>
								</ContextMenu.ItemContainerStyle>
							</ContextMenu>
						</Button.ContextMenu>
									</Button>
									<TextBox x:Name="GameLaunchParamsTextBox"
										Grid.Column="1"
										MinHeight="30"
										VerticalAlignment="Center"
										adonisExtensions:CornerRadiusExtension.CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										Background="{DynamicResource ReduxSurfaceMutedBrush}"
										BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
										TextWrapping="Wrap"
										ToolTip="Parameters to pass to the game executable when launching the game through the mod manager" />
									<Button x:Name="ClearLaunchParamsMenuItem"
										Grid.Column="2"
										Margin="6,0,0,0"
										Style="{StaticResource IconButtonStyle}"
										ToolTip="Clear current parameters">
										<controls:ReduxIcon
											Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
											StrokeData="{StaticResource Redux.Icon.Close}" />
									</Button>
								</Grid>
								<Border Height="1" Margin="0,16,0,12" Background="{DynamicResource ReduxBorderBrush}" />
								<TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="Maintenance" />
								<TextBlock Margin="0,3,0,10"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Repair cached state without changing installed packages or load orders."
									TextWrapping="Wrap" />
								<Grid Margin="0,4">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock FontWeight="SemiBold" Text="Local caches" />
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Remove generated local cache files; Redux rebuilds them when needed." TextWrapping="Wrap" />
									</StackPanel>
									<Button x:Name="ClearCacheButton" Grid.Column="1"
										Margin="16,0,0,0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsWarningButtonStyle}"
										ToolTip="Delete the local mod cache, located in the mod manager's Data folder">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
												Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
												StrokeData="{StaticResource Redux.Icon.Trash}" />
											<TextBlock Text="Delete Cache" />
										</StackPanel>
									</Button>
								</Grid>
								<Grid Margin="0,8,0,4">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock FontWeight="SemiBold" Text="Source links and metadata" />
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Discard manual choices and rebuild reviewed automatic source associations." TextWrapping="Wrap" />
									</StackPanel>
									<Button x:Name="ResetSourceCacheButton" Grid.Column="1"
										Margin="16,0,0,0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsWarningButtonStyle}"
										ToolTip="Clear manual source choices and restore Redux's native, manifest, and reviewed metadata-database associations">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
												Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
												StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
											<TextBlock Text="Restore Automatic Links" />
										</StackPanel>
									</Button>
								</Grid>
								<Grid Margin="0,8,0,0">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<StackPanel>
										<TextBlock FontWeight="SemiBold" Text="Source-link history" />
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Forget all remembered Nexus Mods and mod.io associations for clean retesting." TextWrapping="Wrap" />
									</StackPanel>
									<Button x:Name="ClearSourceHistoryButton" Grid.Column="1"
										Margin="16,0,0,0"
										VerticalAlignment="Center"
										Style="{StaticResource SettingsWarningButtonStyle}"
										ToolTip="Forget all cached Nexus Mods and mod.io associations without deleting installed mods, load orders, API keys, or preferences">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
												Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
												StrokeData="{StaticResource Redux.Icon.UnlinkStroke}" />
											<TextBlock Text="Clear Source History" />
										</StackPanel>
									</Button>
								</Grid>
							</StackPanel>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
		</TabControl>
		<StatusBar Grid.Row="2"
			MinHeight="16"
			Background="{DynamicResource ReduxSurfaceElevatedBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="0,1,0,0"
			Foreground="{DynamicResource ReduxTextSecondaryBrush}">
			<StatusBarItem HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<controls:AlertBar x:Name="AlertBar" Theme="Standard" />
			</StatusBarItem>
		</StatusBar>
		</Grid>
	</Grid>
</local:SettingsWindowBase>
