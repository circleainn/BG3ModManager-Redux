<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxModContentWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="1000" Height="780" MinWidth="720" MinHeight="560"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}"
	Background="{DynamicResource ReduxWindowBrush}"
	Template="{DynamicResource ReduxWindowTemplate}"
	ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow" UseLayoutRounding="True" SnapsToDevicePixels="True"
	FocusManager.FocusedElement="{Binding ElementName=ScanActionButton}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="ContentCellTextStyle" TargetType="TextBlock">
				<Setter Property="Margin" Value="7,5" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
				<Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
			</Style>
			<Style x:Key="ContentValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ContentCellTextStyle}">
				<Setter Property="TextWrapping" Value="Wrap" />
				<Setter Property="MaxHeight" Value="100" />
			</Style>
			<Style x:Key="ContentGridStyle" TargetType="DataGrid">
				<Setter Property="AutoGenerateColumns" Value="False" />
				<Setter Property="IsReadOnly" Value="True" />
				<Setter Property="CanUserAddRows" Value="False" />
				<Setter Property="CanUserDeleteRows" Value="False" />
				<Setter Property="CanUserResizeRows" Value="False" />
				<Setter Property="CanUserReorderColumns" Value="False" />
				<Setter Property="EnableRowVirtualization" Value="True" />
				<Setter Property="EnableColumnVirtualization" Value="True" />
				<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
				<Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
				<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
				<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
				<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
				<Setter Property="HeadersVisibility" Value="Column" />
				<Setter Property="GridLinesVisibility" Value="None" />
				<Setter Property="SelectionMode" Value="Single" />
				<Setter Property="SelectionUnit" Value="FullRow" />
				<Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="RowBackground" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="AlternatingRowBackground" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="ColumnHeaderStyle">
					<Setter.Value>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
							<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
							<Setter Property="BorderThickness" Value="0,0,1,1" />
							<Setter Property="Padding" Value="7,7" />
							<Setter Property="HorizontalContentAlignment" Value="Left" />
							<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Control}" />
							<Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
							<Setter Property="ContentTemplate">
								<Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
							</Setter>
						</Style>
					</Setter.Value>
				</Setter>
				<Setter Property="CellStyle">
					<Setter.Value>
						<Style TargetType="DataGridCell">
							<Setter Property="BorderThickness" Value="1" />
							<Setter Property="BorderBrush" Value="Transparent" />
							<Setter Property="FocusVisualStyle" Value="{StaticResource ReduxManagerKeyboardFocusStyle}" />
							<Style.Triggers>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocusWithin" Value="True">
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Package}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
					<RowDefinition Height="*" /><RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel Orientation="Vertical">
					<TextBlock x:Name="HeadingText" Style="{StaticResource ReduxWindowHeadingStyle}" TextWrapping="Wrap" />
					<TextBlock x:Name="ModNameText" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
					<TextBlock x:Name="ScopeText" Margin="0,7,0,0" TextWrapping="Wrap"
						Foreground="{DynamicResource ReduxTextMutedBrush}" />
				</StackPanel>
				<Grid Grid.Row="1" Margin="0,12,0,10">
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<TextBox x:Name="SearchTextBox" MinHeight="32" IsEnabled="False" VerticalContentAlignment="Center"
						TextChanged="SearchTextBox_TextChanged" />
					<TextBlock x:Name="SearchHintText" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
						TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ReduxTextMutedBrush}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger></Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<Button x:Name="ClearSearchButton" Grid.Column="1" Margin="7,0,0,0" MinHeight="32" Padding="10,4"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" IsEnabled="False" Click="ClearSearchButton_Click">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
								Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Close}" />
							<TextBlock x:Name="ClearSearchText" />
						</StackPanel>
					</Button>
					<TextBlock x:Name="SummaryText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
				</Grid>
				<TabControl x:Name="ContentTabs" Grid.Row="2">
					<TabItem x:Name="RecordsTab">
						<Grid Margin="0,9,0,0">
							<Grid.RowDefinitions>
								<RowDefinition Height="2*" /><RowDefinition Height="7" />
								<RowDefinition Height="3*" />
							</Grid.RowDefinitions>
							<DataGrid x:Name="RecordsGrid" Style="{StaticResource ContentGridStyle}"
								SelectionChanged="RecordsGrid_SelectionChanged">
								<DataGrid.Columns>
									<DataGridTextColumn x:Name="RecordNameColumn" Binding="{Binding Name}" Width="2*" MinWidth="130" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="RecordTypeColumn" Binding="{Binding Type}" Width="*" MinWidth="90" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="RecordParentColumn" Binding="{Binding ParentName}" Width="*" MinWidth="110" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="RecordSourceColumn" Binding="{Binding SourcePath}" Width="2*" MinWidth="150" ElementStyle="{StaticResource ContentCellTextStyle}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="EmptyRecordsText" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
								TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}" IsHitTestVisible="False" />
							<GridSplitter x:Name="RecordsSplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
								ResizeBehavior="PreviousAndNext" Background="{DynamicResource ReduxBorderBrush}" Focusable="True" KeyboardIncrement="10"
								FocusVisualStyle="{StaticResource ReduxManagerKeyboardFocusStyle}" />
							<Grid Grid.Row="2">
								<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
								<TextBlock x:Name="RecordDetailText" Margin="0,4,0,8" TextWrapping="Wrap" MaxHeight="100"
									TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
							<DataGrid x:Name="FieldsGrid" Grid.Row="1" Style="{StaticResource ContentGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn x:Name="FieldNameColumn" Binding="{Binding Name}" Width="*" MinWidth="110" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="FieldValueColumn" Binding="{Binding Value}" Width="3*" MinWidth="170" ElementStyle="{StaticResource ContentValueTextStyle}" />
									<DataGridTextColumn x:Name="FieldOriginColumn" Binding="{loc:BoundText Path=Origin}" Width="*" MinWidth="90" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="FieldSourceColumn" Binding="{Binding SourceRecord}" Width="*" MinWidth="130" ElementStyle="{StaticResource ContentCellTextStyle}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="EmptyFieldsText" Grid.Row="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
								TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}" IsHitTestVisible="False" />
							</Grid>
						</Grid>
					</TabItem>
					<TabItem x:Name="FilesTab">
						<Grid Margin="0,9,0,0">
							<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
							<TextBlock x:Name="FileCategoryText" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
							<DataGrid x:Name="FilesGrid" Grid.Row="1" Style="{StaticResource ContentGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn x:Name="FilePathColumn" Binding="{Binding SourcePath}" Width="4*" MinWidth="220" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="FileCategoryColumn" Binding="{loc:BoundText Path=Category}" Width="*" MinWidth="100" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="FileSizeColumn" Binding="{Binding SizeBytes, StringFormat=N0}" Width="*" MinWidth="90" ElementStyle="{StaticResource ContentCellTextStyle}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="EmptyFilesText" Grid.Row="1" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
								TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}" IsHitTestVisible="False" />
						</Grid>
					</TabItem>
					<TabItem x:Name="IssuesTab">
						<Grid Margin="0,9,0,0">
							<DataGrid x:Name="IssuesGrid" Style="{StaticResource ContentGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn x:Name="IssueMessageColumn" Binding="{loc:BoundText Path=Message}" Width="3*" MinWidth="220" ElementStyle="{StaticResource ContentValueTextStyle}" />
									<DataGridTextColumn x:Name="IssueSourceColumn" Binding="{Binding SourcePath}" Width="2*" MinWidth="140" ElementStyle="{StaticResource ContentCellTextStyle}" />
									<DataGridTextColumn x:Name="IssueLineColumn" Binding="{Binding Line}" Width="Auto" MinWidth="60" ElementStyle="{StaticResource ContentCellTextStyle}" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock x:Name="EmptyIssuesText" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
								TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}" IsHitTestVisible="False" />
						</Grid>
					</TabItem>
				</TabControl>
				<Grid Grid.Row="3" Margin="0,12,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<StackPanel Orientation="Vertical" VerticalAlignment="Center">
						<ProgressBar x:Name="ScanProgress" Height="4" IsIndeterminate="True" Maximum="1" Margin="0,0,0,6" />
						<TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							AutomationProperties.LiveSetting="Polite" />
					</StackPanel>
					<Button x:Name="ScanActionButton" Grid.Column="1" MinWidth="90" Margin="14,0,0,0" VerticalAlignment="Center"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="ScanActionButton_Click"
						AutomationProperties.Name="{Binding Text, ElementName=ScanActionText}">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
								Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Close}" />
							<TextBlock x:Name="ScanActionText" />
						</StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
