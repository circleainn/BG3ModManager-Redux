<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxSaveManagerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Save Game Manager" Width="1080" Height="680" MinWidth="680" MinHeight="480"
	AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="SaveListItemStyle" TargetType="{x:Type ListBoxItem}">

				<Setter Property="Margin" Value="0,0,0,7" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FocusVisualStyle" Value="{StaticResource ReduxManagerKeyboardFocusStyle}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="Card" Background="{DynamicResource ReduxSurfaceBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True"
								RenderTransformOrigin="0.5,0.5" util:ReduxWindowBehavior.HoverLift="1">
								<Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
								<Grid>
									<Border x:Name="SelectionSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="SelectionRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<ContentPresenter Margin="{DynamicResource Redux.Manager.RowPadding}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasModWarning}" Value="True">
                                    <Setter TargetName="SelectionSurface" Property="Background" Value="{DynamicResource ReduxWarningPillBackground}"/>
                                    <Setter TargetName="SelectionRail" Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}"/>
                                    <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ReduxWarningPillBackground}"/>
                                    <Setter TargetName="HoverRail" Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}"/>
                                </DataTrigger>

								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Card" Property="BorderBrush" Value="Transparent" />
									<Trigger.EnterActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0.62"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="1"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
									</Storyboard></BeginStoryboard></Trigger.EnterActions>
									<Trigger.ExitActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Redux.Motion.Standard}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Redux.Motion.Standard}" />
									</Storyboard></BeginStoryboard></Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="Card" Property="BorderBrush" Value="Transparent" />
									<Setter TargetName="SelectionSurface" Property="Opacity" Value="0.62" />
									<Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
									<Setter TargetName="HoverSurface" Property="Background" Value="Transparent" />
									<Setter TargetName="HoverRail" Property="BorderBrush" Value="Transparent" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="CampaignBulkActionButtonStyle" BasedOn="{StaticResource ReduxPaneHeaderActionButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="7,0,0,0" />
            </Style>
			<Style x:Key="CampaignExpanderStyle" TargetType="{x:Type Expander}">
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Expander}">
							<Grid>
								<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<ToggleButton x:Name="HeaderButton" HorizontalContentAlignment="Stretch"
									IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
									Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
									<ToggleButton.Template>
										<ControlTemplate TargetType="{x:Type ToggleButton}">
										<Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
											RenderTransformOrigin="0.5,0.5" util:ReduxWindowBehavior.HoverLift="1">
											<Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
											<Grid>
												<Border x:Name="HeaderHoverSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
													Background="{DynamicResource ReduxAccentSoftBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
													OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
												<Grid Margin="7,6">
													<Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
													<controls:ReduxIcon Width="14" Height="14" VerticalAlignment="Center"
													Foreground="{DynamicResource ReduxTextSecondaryBrush}" StrokeData="{StaticResource Redux.Icon.ChevronRightStroke}"
													RenderTransformOrigin="0.5,0.5">
														<controls:ReduxIcon.Style>
															<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
																<Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
															<Style.Triggers>
																<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True">
																	<DataTrigger.EnterActions>
																		<BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
																			To="90" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" /></Storyboard></BeginStoryboard>
																	</DataTrigger.EnterActions>
																	<DataTrigger.ExitActions>
																		<BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
																			To="0" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" /></Storyboard></BeginStoryboard>
																	</DataTrigger.ExitActions>
																</DataTrigger>
																</Style.Triggers>
															</Style>
														</controls:ReduxIcon.Style>
													</controls:ReduxIcon>
													<ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Content" />
												</Grid>
											</Grid>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Trigger.EnterActions><BeginStoryboard><Storyboard>
													<DoubleAnimation Storyboard.TargetName="HeaderHoverSurface" Storyboard.TargetProperty="Opacity" To="0.45"
														Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard></BeginStoryboard></Trigger.EnterActions>
												<Trigger.ExitActions><BeginStoryboard><Storyboard>
													<DoubleAnimation Storyboard.TargetName="HeaderHoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Redux.Motion.Standard}" />
												</Storyboard></BeginStoryboard></Trigger.ExitActions>
											</Trigger>
										</ControlTemplate.Triggers>
										</ControlTemplate>
									</ToggleButton.Template>
									<ContentPresenter ContentSource="Header" />
								</ToggleButton>
								<ContentPresenter x:Name="ExpandSite" Grid.Row="1" ContentSource="Content"
									RenderTransformOrigin="0.5,0">
									<ContentPresenter.RenderTransform><TranslateTransform Y="0" /></ContentPresenter.RenderTransform>
								</ContentPresenter>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.BookOpen}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<Grid>
					<StackPanel>
						<TextBlock Style="{StaticResource ReduxWindowHeadingStyle}" Text="Save Game Manager" />
						<TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="Manage this profile’s saves. Drop a save file, folder, or ZIP to install." TextWrapping="Wrap" />
					</StackPanel>
				</Grid>

				<WrapPanel Grid.Row="1" Margin="{DynamicResource Redux.Manager.ToolbarMargin}" Orientation="Horizontal">
                    <Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Install save" Click="InstallSaveButton_Click" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem util:ReduxMenuItemExtension.UseSemanticHover="True" util:ReduxMenuItemExtension.SemanticHoverBrush="{DynamicResource ReduxSuccessPillBackground}" util:ReduxMenuItemExtension.SemanticRailBrush="{DynamicResource ReduxSuccessBrush}" Header="File or Archive..." Click="ImportArchiveButton_Click">
                                <MenuItem.Icon><controls:ReduxIcon Width="16" Height="16" StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem util:ReduxMenuItemExtension.UseSemanticHover="True" util:ReduxMenuItemExtension.SemanticHoverBrush="{DynamicResource ReduxSuccessPillBackground}" util:ReduxMenuItemExtension.SemanticRailBrush="{DynamicResource ReduxSuccessBrush}" Header="Folder..." Click="ImportFolderButton_Click">
                                <MenuItem.Icon><controls:ReduxIcon Width="16" Height="16" StrokeData="{StaticResource Redux.Icon.FolderOpen}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu></Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <controls:ReduxIcon Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Download}"/>
                            <TextBlock Text="Install Save..."/>
                        </StackPanel>
                    </Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Open saves folder" Click="OpenFolderButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.FolderOpen}" /><TextBlock Text="Saves Folder" /></StackPanel>
					</Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Refresh saves" Click="RefreshButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" /><TextBlock Text="{loc:Text Refresh_0e916101}" /></StackPanel>
					</Button>

                    <Button x:Name="ReviewModsButton" IsEnabled="False" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="ReviewModsButton_Click" AutomationProperties.Name="Review mods for selected save" Style="{StaticResource ReduxMinorActionButtonStyle}">
<StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.ReorderStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="ReviewModsLabel" Text="Review Mods..."/></StackPanel></Button>
<Button x:Name="CampaignBulkToggleButton" IsEnabled="False" Visibility="Collapsed"
						AutomationProperties.Name="Collapse all campaigns" ToolTip="Collapse all campaigns"
						Click="CampaignBulkToggleButton_Click" MouseEnter="CampaignBulkToggleButton_MouseEnter"
						Style="{StaticResource CampaignBulkActionButtonStyle}">
						<controls:ReduxIcon VerticalAlignment="Center" x:Name="CampaignBulkToggleIcon" Width="14" Height="14"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
							StrokeData="{StaticResource Redux.Icon.ChevronUpStroke}" />
					</Button>
				</WrapPanel>

				<Border x:Name="SaveModWarning" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,9"
                    Background="{DynamicResource ReduxSurfaceMutedBrush}" BorderBrush="{DynamicResource ReduxWarningBrush}" BorderThickness="4,0,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <controls:ReduxIcon Width="15" Height="15" Margin="0,0,9,0" Foreground="{DynamicResource ReduxWarningBrush}" StrokeData="{StaticResource Redux.Icon.Warning}"/>
                        <TextBlock x:Name="SaveModWarningText" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.6*" MinWidth="220"/></Grid.ColumnDefinitions>
					<Border Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
					<ListBox x:Name="SaveList" Margin="8" Background="Transparent" BorderThickness="0"
						HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource SaveListItemStyle}"
						SelectionChanged="SaveList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ContextMenu><ContextMenu Style="{StaticResource ReduxContextMenuStyle}" ItemContainerStyle="{StaticResource ReduxPopupMenuItemStyle}">
                            <MenuItem x:Name="SaveReviewMenu" Header="Review Mods…" Click="ReviewModsButton_Click"><MenuItem.Icon><controls:ReduxIcon StrokeData="{DynamicResource Redux.Icon.ReorderStroke}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Export This Save…" Click="ExportThisSave_Click"><MenuItem.Icon><controls:ReduxIcon StrokeData="{DynamicResource Redux.Icon.Save}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Export Campaign…" Click="ExportCampaignSaves_Click"><MenuItem.Icon><controls:ReduxIcon StrokeData="{DynamicResource Redux.Icon.BookOpen}"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Show in Folder" Click="ShowSelectedSaveFolder_Click"><MenuItem.Icon><controls:ReduxIcon StrokeData="{DynamicResource Redux.Icon.FolderOpen}"/></MenuItem.Icon></MenuItem>
                        </ContextMenu></ListBox.ContextMenu>
						<ListBox.GroupStyle>
							<GroupStyle>
								<GroupStyle.ContainerStyle>
									<Style TargetType="{x:Type GroupItem}">
										<Setter Property="Margin" Value="0,0,0,6" />
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="{x:Type GroupItem}">
											<Expander IsExpanded="True" Style="{StaticResource CampaignExpanderStyle}"
												Loaded="CampaignExpander_Loaded"
												Unloaded="CampaignExpander_Unloaded"
												Expanded="CampaignExpander_Expanded" Collapsed="CampaignExpander_Collapsed">
													<Expander.Header>
														<Grid>
															<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
															<controls:ReduxIcon Width="15" Height="15" Margin="0,0,8,0" Foreground="{DynamicResource ReduxAccentHoverBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.BookOpen}" />
															<TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding Name}" />
																									<Border Grid.Column="2" Margin="10,0,0,0" MinWidth="25" Padding="6,2" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" Background="{DynamicResource ReduxSurfaceMutedBrush}"
																										BorderThickness="0">
																										<TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding ItemCount}" />
																									</Border>
															</Grid>
														</Expander.Header>
														<ItemsPresenter Margin="0,4,0,0" />
													</Expander>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</GroupStyle.ContainerStyle>
							</GroupStyle>
						</ListBox.GroupStyle>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid MinHeight="72">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="{DynamicResource Redux.Manager.ThumbnailWidth}" Height="{DynamicResource Redux.Manager.ThumbnailHeight}" Background="{DynamicResource ReduxSurfaceMutedBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True" VerticalAlignment="Center">
                                        <Grid>
                                            <controls:ReduxIcon Width="25" Height="25" Foreground="{DynamicResource ReduxTextMutedBrush}" StrokeData="{StaticResource Redux.Icon.Camera}"/>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToBitmapImageConverter}}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="{DynamicResource Redux.Manager.ThumbnailGap}" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource ReduxManagerRowTitleStyle}" Text="{Binding DisplayName}" TextWrapping="Wrap" ToolTip="{Binding DetailsText}"/>
                                            <Border Grid.Column="1" MaxWidth="180" VerticalAlignment="Top" Margin="12,1,0,0" Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding HasModWarning, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="{Binding ModWarning}">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <controls:ReduxIcon Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource ReduxWarningBrush}" StrokeData="{StaticResource Redux.Icon.Warning}"/>
                                                    <TextBlock Style="{StaticResource ReduxManagerStatusStyle}" Grid.Column="1" Text="{Binding ModWarning}" VerticalAlignment="Center" Foreground="{DynamicResource ReduxWarningBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding CampaignGroupName}" Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource ReduxManagerMetadataStyle}" Text="{Binding MetadataText}" Margin="0,5,0,0" TextWrapping="Wrap"/>


                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
						<Border Width="48" Height="48" HorizontalAlignment="Center" Background="{DynamicResource ReduxAccentPillBackground}" CornerRadius="24"
							Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
							<controls:ReduxIcon Width="22" Height="22" Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="folder" />
						</Border>
						<TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No story saves found" />
						<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Install a save or create one in game, then refresh." TextWrapping="Wrap" TextAlignment="Center" />
					</StackPanel>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Style="{StaticResource ReduxManagerPaneSplitterStyle}" AutomationProperties.Name="Resize save list and details"/>
                    <Border x:Name="SaveDetailsPanel" Grid.Column="2" Padding="12,10"
                        Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
                        <Grid>
                        <TextBlock x:Name="SaveDetailsPlaceholder" Text="Select a save to view its details." Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="SaveDetailsContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ReduxManagerRowTitleStyle}"/>
                                    <TextBlock Text="{Binding LocationText}" Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" ToolTip="{Binding Save.Location}"/>
                                    <TextBlock Text="{Binding SaveFacts}" Margin="0,8,0,0" Style="{StaticResource ReduxManagerMetadataStyle}"/>
                                    <TextBlock Text="{Binding SavedDateText}" Margin="0,3,0,0" Style="{StaticResource ReduxManagerMetadataStyle}"/>
                                    <TextBlock Text="{Binding GameVersionText}" Margin="0,3,0,0" Style="{StaticResource ReduxManagerMetadataStyle}"/>
                                    <TextBlock Text="Mods" Margin="0,14,0,5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ModSummary}" Style="{StaticResource ReduxManagerMetadataStyle}"/>

                                    <TextBlock Text="{Binding PartyHeading}" Margin="0,10,0,5" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding Party}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid Width="44" Height="44" VerticalAlignment="Top" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
                                                <controls:ReduxIcon Width="24" Height="24" Foreground="{DynamicResource ReduxTextMutedBrush}" StrokeData="{StaticResource Redux.Icon.Person}">
                                                    <controls:ReduxIcon.Style><Style TargetType="{x:Type controls:ReduxIcon}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PortraitPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:ReduxIcon.Style>
                                                </controls:ReduxIcon>
                                                <Image Source="{Binding PortraitPath}" ToolTip="{Binding PortraitToolTip}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource ReduxManagerMetadataStyle}"/>
                                            <TextBlock Text="{Binding Subregion}" Style="{StaticResource ReduxManagerMetadataStyle}" Visibility="{Binding Subregion, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                        </StackPanel></Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
</Grid>

				<Grid Grid.Row="4" Margin="0,10,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<TextBlock x:Name="ProfilePathText" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}" TextTrimming="CharacterEllipsis" />
					<Button x:Name="DeleteButton" Grid.Column="1" MinWidth="88" Margin="8,0" IsEnabled="False"
