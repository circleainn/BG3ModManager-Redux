<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxMessageBoxWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="480" MinWidth="480" MaxWidth="480"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}" FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="NoResize" SizeToContent="Height" ShowInTaskbar="False"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner"
	KeyDown="Window_KeyDown">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="0"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
	</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
	<Grid
		RenderTransformOrigin="0.5,0.5">
		<Grid.RenderTransform>
			<ScaleTransform x:Name="DialogEntranceScale" ScaleX="0.98" ScaleY="0.98" />
		</Grid.RenderTransform>
		<Grid.Opacity>0</Grid.Opacity>
		<!--  Entrance only: doesn't delay focus/default-button behavior, which runs independently of this storyboard.  -->
		<Grid.Triggers>
			<EventTrigger RoutedEvent="FrameworkElement.Loaded">
				<BeginStoryboard>
					<Storyboard>
						<DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
						<DoubleAnimation Storyboard.TargetName="DialogEntranceScale" Storyboard.TargetProperty="ScaleX" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
						<DoubleAnimation Storyboard.TargetName="DialogEntranceScale" Storyboard.TargetProperty="ScaleY" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Grid.Triggers>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.HelpCircle}" />
		<Border Grid.Row="1"
			Padding="22"
			Background="{DynamicResource ReduxSurfaceBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="0,1,0,0">
			<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<controls:ReduxIcon x:Name="SeverityIcon" Width="24" Height="24" Margin="0,0,14,0"
					HorizontalAlignment="Center" VerticalAlignment="Center" />
				<TextBlock x:Name="CaptionText" Grid.Column="1"
					FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
					Foreground="{DynamicResource ReduxTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
			</Grid>

			<Border Grid.Row="1" Margin="0,16,0,0" Padding="14,12"
				Background="{DynamicResource ReduxSurfaceElevatedBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
				BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
				<ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
					<TextBox x:Name="MessageTextBox"
						Background="Transparent" BorderThickness="0"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						IsReadOnly="True" IsReadOnlyCaretVisible="True"
						TextWrapping="Wrap" />
				</ScrollViewer>
			</Border>

			<StackPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
				<StackPanel x:Name="ExtraActionsPanel" Orientation="Horizontal" />
				<Button x:Name="NoButton" MinWidth="80" Margin="8,0,0,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="NoButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock Text="No" />
					</StackPanel>
				</Button>
				<Button x:Name="CancelButton" MinWidth="80" Margin="8,0,0,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click" Visibility="Collapsed" IsCancel="True">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock Text="Cancel" />
					</StackPanel>
				</Button>
				<Button x:Name="YesButton" MinWidth="80" Margin="8,0,0,0" Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="YesButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							StrokeData="{StaticResource Redux.Icon.Check}" />
						<TextBlock Text="Yes" />
					</StackPanel>
				</Button>
				<Button x:Name="OkButton" MinWidth="80" Margin="8,0,0,0" Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="OkButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							StrokeData="{StaticResource Redux.Icon.Check}" />
						<TextBlock Text="OK" />
					</StackPanel>
				</Button>
			</StackPanel>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
