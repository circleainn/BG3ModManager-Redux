<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxMessageBoxWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="560" MinWidth="360" MaxWidth="840"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}" FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize" SizeToContent="Height" ShowInTaskbar="False"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner"
	KeyDown="Window_KeyDown">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
	</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
	<Grid
		RenderTransformOrigin="0.5,0.5">
		<Grid.RenderTransform>
			<ScaleTransform x:Name="DialogEntranceScale" ScaleX="0.98" ScaleY="0.98" />
		</Grid.RenderTransform>
		<Grid.Opacity>0</Grid.Opacity>
		<!--  Entrance only: doesn't delay focus/default-button behavior, which runs independently of this storyboard.  -->
		<Grid.Triggers>
			<EventTrigger RoutedEvent="FrameworkElement.Loaded">
				<BeginStoryboard>
					<Storyboard>
						<DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
						<DoubleAnimation Storyboard.TargetName="DialogEntranceScale" Storyboard.TargetProperty="ScaleX" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
						<DoubleAnimation Storyboard.TargetName="DialogEntranceScale" Storyboard.TargetProperty="ScaleY" To="1"
							Duration="{StaticResource Redux.Motion.DialogEnter}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
					</Storyboard>
				</BeginStoryboard>
			</EventTrigger>
		</Grid.Triggers>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.HelpCircle}" />
		<Border Grid.Row="1"
			Padding="22"
			Background="{DynamicResource ReduxSurfaceBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="0,1,0,0">
			<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<controls:ReduxIcon x:Name="SeverityIcon" Width="24" Height="24" Margin="0,0,14,0"
					HorizontalAlignment="Center" VerticalAlignment="Center" />
				<TextBlock x:Name="CaptionText" Grid.Column="1"
					FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
					Foreground="{DynamicResource ReduxTextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
			</Grid>

			<Border Grid.Row="1" Margin="0,16,0,0" Padding="0"
				Background="Transparent" BorderBrush="{DynamicResource ReduxBorderBrush}"
				BorderThickness="0" CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
				<ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
					<TextBox x:Name="MessageTextBox"
						Background="Transparent" BorderThickness="0"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						IsReadOnly="True" IsReadOnlyCaretVisible="True"
						TextWrapping="Wrap" />
				</ScrollViewer>
			</Border>

			<WrapPanel Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Right">
				<WrapPanel x:Name="ExtraActionsPanel" />
				<Button x:Name="NoButton" MinWidth="80" Margin="8,4,0,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="NoButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock x:Name="NoButtonLabel" Text="{loc:Text No_1ea442a1}" />
					</StackPanel>
				</Button>
				<Button x:Name="CancelButton" MinWidth="80" Margin="8,4,0,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click" Visibility="Collapsed" IsCancel="True">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock x:Name="CancelButtonLabel" Text="{loc:Text Cancel_19766ed6}" />
					</StackPanel>
				</Button>
				<Button x:Name="YesButton" MinWidth="80" Margin="8,4,0,4" Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="YesButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							StrokeData="{StaticResource Redux.Icon.Check}" />
						<TextBlock x:Name="YesButtonLabel" Text="{loc:Text Yes_85a39ab3}" />
					</StackPanel>
				</Button>
				<Button x:Name="OkButton" MinWidth="80" Margin="8,4,0,4" Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="OkButton_Click" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							StrokeData="{StaticResource Redux.Icon.Check}" />
						<TextBlock x:Name="OkButtonLabel" Text="{loc:Text OK_565339bc}" />
					</StackPanel>
				</Button>
			</WrapPanel>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
