<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.NxmDownloadConfirmationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="{loc:Text Add_Nexus_Download_57c71278}"
	Width="590" Height="460" MinWidth="520" MinHeight="420" MaxWidth="760" MaxHeight="620"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Download}" />
		<Border Grid.Row="1" Padding="24,20" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{loc:Text Review_Nexus_download_09468139}" />
					<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="{Binding InstallationDescription}"
						TextWrapping="Wrap" />
				</StackPanel>
				<Border Grid.Row="1" Margin="0,18,0,18" Padding="18,16"
					Style="{StaticResource ReduxDialogSummaryCardStyle}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="100" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{loc:Text Project_98595978}" />
						<TextBlock Grid.Column="1" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
						<TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{loc:Text File_50009ce1}" />
						<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
						<TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{loc:Text Author_d95082a2}" />
						<TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding Author}" />
						<TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{loc:Text Version_dd167905}" />
						<TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding Version}" />
						<TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{loc:Text Download_d6eafe82}" />
						<TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding Size}" />
						<Button Grid.Row="5" Grid.Column="1" Margin="0,13,0,0" HorizontalAlignment="Left"
							Style="{StaticResource ReduxMinorNexusActionButtonStyle}" Click="NexusPage_Click">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.LinkStroke}" />
								<TextBlock Text="{loc:Text View_exact_file_on_Nexus_Mods_1f4264db}" />
							</StackPanel>
						</Button>
					</Grid>
				</Border>
				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<CheckBox x:Name="SkipCleanConfirmationCheckBox" VerticalAlignment="Center"
						Content="{loc:Text Don_t_ask_again_for_clean_downloads_b7119966}" />
				<StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
					<Button x:Name="CancelButton" MinWidth="88" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Cancel_19766ed6}" /></StackPanel>
					</Button>
					<Button MinWidth="150" Margin="9,0,0,0" IsDefault="True"
						Style="{StaticResource ReduxMinorSuccessActionButtonStyle}" Click="Install_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Download}" /><TextBlock Text="{loc:Text Add_to_Downloads_0d97d5e4}" /></StackPanel>
					</Button>
				</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
