<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxNexusDownloadsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonis="clr-namespace:AdonisUI;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Download Manager" Width="940" Height="700" MinWidth="760" MinHeight="540"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
	AllowDrop="True" PreviewDrop="Window_PreviewDrop">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<CollectionViewSource x:Key="PendingDownloadsView" Source="{Binding NxmDownloads}" Filter="PendingDownloads_Filter" />
			<CollectionViewSource x:Key="InstalledDownloadsView" Source="{Binding NxmDownloads}" Filter="InstalledDownloads_Filter" />
			<Style x:Key="DownloadListItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,5" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FocusVisualStyle" Value="{StaticResource ReduxManagerKeyboardFocusStyle}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="RowChrome" MinHeight="80" Background="{DynamicResource ReduxSurfaceBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True"
								util:ReduxWindowBehavior.HoverLift="1" RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
								<Grid>
									<Border x:Name="SelectionSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="SelectionRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<ContentPresenter />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="RowChrome" Property="BorderBrush" Value="Transparent" />
									<Trigger.EnterActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0.62"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="1"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
									</Storyboard></BeginStoryboard></Trigger.EnterActions>
									<Trigger.ExitActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0"
											Duration="{StaticResource Redux.Motion.Standard}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="0"
											Duration="{StaticResource Redux.Motion.Standard}" />
									</Storyboard></BeginStoryboard></Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="RowChrome" Property="BorderBrush" Value="Transparent" />
									<Setter TargetName="SelectionSurface" Property="Opacity" Value="0.62" />
									<Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
									<Setter TargetName="HoverSurface" Property="Background" Value="Transparent" />
									<Setter TargetName="HoverRail" Property="BorderBrush" Value="Transparent" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="DownloadActionButton" BasedOn="{StaticResource ReduxMinorActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="Margin" Value="6,0,0,0" />
				<Setter Property="MinWidth" Value="0" />
			</Style>
			<Style x:Key="NexusDownloadSourceButtonStyle" BasedOn="{StaticResource ReduxMinorNexusActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="Margin" Value="6,0,0,0" />
				<Setter Property="MinWidth" Value="0" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding HasNexusSource}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="RemoveDownloadButton" BasedOn="{StaticResource ReduxMinorDestructiveActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="Margin" Value="6,0,0,0" />
				<Setter Property="MinWidth" Value="0" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Installing"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Installed"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ClearDownloadHistoryButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Installed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="PauseDownloadButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Resolving"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Queued"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="RetryWaiting"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding HasNexusSource}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ResumeDownloadButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Paused"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding HasNexusSource}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ReviewDownloadButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Downloaded"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="InstallFailed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Installed" /><Condition Binding="{Binding HasAvailableArchive}" Value="True" /></MultiDataTrigger.Conditions>
						<Setter Property="Visibility" Value="Visible" />
					</MultiDataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ArchiveReinstallButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
			</Style>
			<DataTemplate x:Key="DownloadItemTemplate">
				<Border Padding="{DynamicResource Redux.Manager.RowPadding}" Background="Transparent">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Border Width="{DynamicResource Redux.Manager.ThumbnailWidth}" Height="{DynamicResource Redux.Manager.ThumbnailHeight}" VerticalAlignment="Center" Background="{DynamicResource ReduxSurfaceMutedBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
							<Grid>
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxTextMutedBrush}"
									StrokeData="{StaticResource Redux.Icon.Package}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
								<Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
							</Grid>
						</Border>
						<StackPanel Grid.Column="1" Margin="{DynamicResource Redux.Manager.ThumbnailGap}" VerticalAlignment="Center">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<TextBlock Style="{StaticResource ReduxManagerRowTitleStyle}"
									Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
								<Border x:Name="StatusPill" Grid.Column="1" Margin="10,0,0,0" Padding="0"
									VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
									<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
										<controls:ReduxIcon x:Name="StatusIcon" Width="11" Height="11" Margin="0,0,5,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.Download}"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
										<TextBlock Style="{StaticResource ReduxManagerStatusStyle}" x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource ReduxInfoBrush}" Text="{Binding StatusText}" />
									</StackPanel>
								</Border>
							</Grid>
							<TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding FileDisplayName}" TextTrimming="CharacterEllipsis" />
							<WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource ReduxManagerMetadataStyle}"
									Text="{Binding MetadataText}" TextTrimming="CharacterEllipsis"
									Visibility="{Binding MetadataText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
								<StackPanel x:Name="InstalledStatus" Margin="9,0,0,0" VerticalAlignment="Center"
									Orientation="Horizontal" Visibility="Collapsed">
									<controls:ReduxIcon Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"
										Foreground="{DynamicResource ReduxSuccessBrush}" StrokeData="{StaticResource Redux.Icon.CircleCheck}"
										Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
									<TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Redux.FontSize.11}"
										FontWeight="SemiBold" Foreground="{DynamicResource ReduxSuccessBrush}" Text="Installed" />
								</StackPanel>
							</WrapPanel>
							<TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Redux.FontSize.11}" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding DownloadDetailText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadDetailText}"
								Visibility="{Binding DownloadDetailText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
							<ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
								Foreground="{DynamicResource ReduxInfoBrush}" Background="{DynamicResource ReduxSurfaceMutedBrush}" BorderThickness="0" Visibility="Collapsed" />
						</StackPanel>
						<WrapPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
							<Button Tag="{Binding}" Style="{StaticResource PauseDownloadButton}" Click="PauseButton_Click">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeData="{StaticResource Redux.Icon.StopCircle}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Pause" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource ResumeDownloadButton}" Click="ResumeButton_Click">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Resume" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource ReviewDownloadButton}" Click="ReviewButton_Click"
								ToolTip="{Binding InstallActionToolTip}">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0"
									Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
									StrokeData="{StaticResource Redux.Icon.Package}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="{Binding InstallActionText}" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource NexusDownloadSourceButtonStyle}" Click="NexusButton_Click"
								ToolTip="{Binding NexusActionToolTip}">
								<StackPanel Orientation="Horizontal"><ContentControl Width="16" Height="16" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}" /><TextBlock Text="{Binding NexusActionText}" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource RemoveDownloadButton}" Click="RemoveButton_Click">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeData="{StaticResource Redux.Icon.Trash}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="{Binding RemoveActionText}" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource ClearDownloadHistoryButton}" Click="RemoveButton_Click">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeData="{StaticResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Clear" /></StackPanel>
							</Button>
						</WrapPanel>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Resolving"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Queued"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloading"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Installing"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Paused"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="RetryWaiting"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloaded"><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.CircleCheck}" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Installed"><Setter TargetName="StatusPill" Property="Visibility" Value="Collapsed" /><Setter TargetName="InstalledStatus" Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="NeedsReview"><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="NeedsFreshLink"><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.LinkStroke}" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Failed"><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="InstallFailed"><Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" /><Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" /><Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" /></DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Resolving" /><Condition Binding="{Binding DataContext.Settings.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" /></MultiDataTrigger.Conditions>
						<Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="False" />
					</MultiDataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Queued" /><Condition Binding="{Binding DataContext.Settings.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" /></MultiDataTrigger.Conditions>
						<Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="False" />
					</MultiDataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Installing" /><Condition Binding="{Binding DataContext.Settings.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" /></MultiDataTrigger.Conditions>
						<Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="False" />
					</MultiDataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<DataTemplate x:Key="RetainedArchiveItemTemplate">
				<Border Padding="{DynamicResource Redux.Manager.RowPadding}" Background="Transparent">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Border Width="{DynamicResource Redux.Manager.ThumbnailWidth}" Height="{DynamicResource Redux.Manager.ThumbnailHeight}" VerticalAlignment="Center" Background="{DynamicResource ReduxSurfaceMutedBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
							<Grid>
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxTextMutedBrush}"
									StrokeData="{StaticResource Redux.Icon.Archive}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
								<Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
							</Grid>
						</Border>
						<StackPanel Grid.Column="1" Margin="{DynamicResource Redux.Manager.ThumbnailGap}" VerticalAlignment="Center">
							<TextBlock Style="{StaticResource ReduxManagerRowTitleStyle}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
							<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
								<controls:ReduxIcon Width="11" Height="11" Margin="0,0,5,0" Foreground="{DynamicResource ReduxSuccessBrush}"
									StrokeData="{StaticResource Redux.Icon.Archive}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
								<TextBlock Style="{StaticResource ReduxManagerStatusStyle}" Foreground="{DynamicResource ReduxSuccessBrush}" Text="{Binding DestinationText}" />
							</StackPanel>
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis" />
							<TextBlock Style="{StaticResource ReduxManagerMetadataStyle}" Margin="0,2,0,0"
								Text="{Binding MetadataText}" TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<WrapPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
							<Button Tag="{Binding}" Style="{StaticResource ArchiveReinstallButton}" Click="ReinstallArchiveButton_Click">
								<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0"
									Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
									StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Reinstall" /></StackPanel>
							</Button>
							<Button Tag="{Binding}" Style="{StaticResource NexusDownloadSourceButtonStyle}" Click="ArchiveNexusButton_Click"
								Visibility="{Binding HasNexusSource, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Open this package on Nexus Mods.">
								<StackPanel Orientation="Horizontal"><ContentControl Width="16" Height="16" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}" /><TextBlock Text="Open Nexus" /></StackPanel>
							</Button>
						</WrapPanel>
					</Grid>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Download}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<DockPanel LastChildFill="True">
				<Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,10"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=DownloadsTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:ReduxIcon Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.LinkStroke}" Foreground="{DynamicResource ReduxTextMutedBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="AssociationText" Text="NXM links are off" Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap"/></StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AssociationCheckBox" Content="Use Redux for NXM links" Margin="14,0,2,0" VerticalAlignment="Center" Click="AssociationButton_Click" Style="{StaticResource ReduxCheckBoxStyle}"/>
                    </Grid>
					<Grid Grid.ColumnSpan="2" Margin="0,0,0,10">
								<Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=DownloadsTabs}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13" Height="13" Margin="0,0,6,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
										StrokeData="{StaticResource Redux.Icon.Database}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
									<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding RetainedPackageArchiveUsageText}" />
								</StackPanel>
								<CheckBox Grid.Column="1" Margin="14,0,2,0" VerticalAlignment="Center"
									IsChecked="{Binding Settings.RetainInstalledPackageArchives, Mode=TwoWay}"
									Click="ArchiveRetentionCheckBox_Click" Style="{StaticResource ReduxCheckBoxStyle}"
									Content="Retain installed package archives"
									ToolTip="Keep verified install packages in the deduplicated archive library. Configure its storage limit in Preferences." />
							</Grid>
<Button x:Name="PreviousVersionsButton" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Click="PreviousVersions_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Database}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Previous mod versions…"/></StackPanel>
                    </Button>
<Button x:Name="DownloadsCloseButton" Grid.Row="1" Grid.Column="1" MinWidth="84" IsCancel="True"
						Click="CloseButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Close" /></StackPanel>
					</Button>
				</Grid>
				<StackPanel DockPanel.Dock="Top">
					<TextBlock Style="{StaticResource ReduxWindowHeadingStyle}" Text="Download Manager" />
					<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"
						Text="Download and review NXM or local packages before installing." />
				</StackPanel>
				<WrapPanel x:Name="DownloadActions" DockPanel.Dock="Top" Margin="{DynamicResource Redux.Manager.ToolbarMargin}">
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="AddPackageButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
							StrokeData="{StaticResource Redux.Icon.Package}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Add Package..." /></StackPanel>
					</Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="PasteLinkButton_Click" Style="{StaticResource ReduxMinorNexusActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
							StrokeData="{StaticResource Redux.Icon.LinkStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Paste NXM Link" /></StackPanel>
					</Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="CollectionButton_Click" Style="{StaticResource ReduxMinorNexusActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><ContentControl Width="16" Height="16" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/><TextBlock Text="Import Nexus Collection"/></StackPanel>
					</Button>
                    <Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="OpenFolderButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.FolderOpen}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="OpenFolderText" Text="Open Folder"/></StackPanel></Button>


				</WrapPanel>
				<TabControl x:Name="DownloadsTabs" ClipToBounds="True" Margin="0" SelectionChanged="DownloadsTabs_SelectionChanged"
					ItemContainerStyle="{StaticResource ReduxContentTabItemStyle}" Style="{StaticResource ReduxContentTabControlStyle}">
					<TabItem Header="Downloads">
						<Grid Margin="0,7,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,6">					<Button x:Name="InstallAllButton" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="InstallAllButton_Click" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}"
						ToolTip="Review and install every ready package to its detected destination.">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" x:Name="InstallAllIcon" Width="13" Height="13" Margin="0,0,6,0"
							StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><TextBlock Text="Install All" /></StackPanel>
					</Button>
<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="PauseAllButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.StopCircle}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Pause All"/></StackPanel></Button>
<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="ResumeAllButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Resume All"/></StackPanel></Button>
<Button x:Name="DeleteAllButton" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="DeleteAllButton_Click" Style="{StaticResource ReduxMinorDestructiveActionButtonStyle}" ToolTip="Cancel downloads and delete their packages. Installed mods and retained archives are kept."><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Trash}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Delete All"/></StackPanel></Button>
</WrapPanel>
							<Border Grid.Row="1" Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
								BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
							<ListBox Grid.Row="1" x:Name="DownloadsList" Margin="7" Background="Transparent" BorderThickness="0"
								HorizontalContentAlignment="Stretch" ItemsSource="{Binding Source={StaticResource PendingDownloadsView}}"
								SelectionChanged="DownloadsList_SelectionChanged" ItemContainerStyle="{StaticResource DownloadListItemStyle}"
								ItemTemplate="{StaticResource DownloadItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
							<TextBlock Grid.Row="1" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
								Text="No packages need attention.&#x0a;Add or drop a package to get started." />
						</Grid>
					</TabItem>
					<TabItem Header="Installed">
						<Grid Margin="0,7,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,6"><Button x:Name="ClearInstalledButton" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="ClearInstalledButton_Click" Style="{StaticResource ReduxMinorWarningActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Trash}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Clear History"/></StackPanel></Button></WrapPanel>
							<Border Grid.Row="1" Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
								BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
							<ListBox Grid.Row="1" x:Name="InstalledDownloadsList" Margin="7" Background="Transparent" BorderThickness="0"
								HorizontalContentAlignment="Stretch" ItemsSource="{Binding Source={StaticResource InstalledDownloadsView}}"
								SelectionChanged="InstalledDownloadsList_SelectionChanged" ItemContainerStyle="{StaticResource DownloadListItemStyle}"
								ItemTemplate="{StaticResource DownloadItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
							<TextBlock Grid.Row="1" x:Name="InstalledEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
								Text="Installed downloads will appear here." />
						</Grid>
					</TabItem>
					<TabItem Header="Archives">
						<Grid Margin="0,7,0,0">
							<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" /></Grid.RowDefinitions><WrapPanel Margin="0,0,0,6"><Button x:Name="ClearArchivesButton" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="ClearArchivesButton_Click" Style="{StaticResource ReduxMinorDestructiveActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon x:Name="ClearArchivesIcon" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Trash}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Delete All"/></StackPanel></Button></WrapPanel>

							<Grid Grid.Row="1">
								<Border Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
								<ListBox x:Name="ArchivesList" Margin="7" Background="Transparent" BorderThickness="0"
									HorizontalContentAlignment="Stretch" ItemsSource="{Binding RetainedPackageArchives}"
									ItemContainerStyle="{StaticResource DownloadListItemStyle}" ItemTemplate="{StaticResource RetainedArchiveItemTemplate}"
									ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
								<TextBlock x:Name="ArchivesEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
									Text="No install packages are retained." />
							</Grid>
						</Grid>
					</TabItem>
				</TabControl>
			</DockPanel>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
