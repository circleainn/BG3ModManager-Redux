<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxLoadOrderExportWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	Title="Export Redux Bundle"
	Width="520" MinWidth="520" MaxWidth="520"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	ResizeMode="NoResize" SizeToContent="Height" ShowInTaskbar="False"
	TitleBarBackground="{DynamicResource ReduxSurfaceElevatedBrush}"
	TitleBarForeground="{DynamicResource ReduxTextPrimaryBrush}"
	WindowStartupLocation="CenterOwner">
	<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
	</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
	<Border Padding="22" Background="{DynamicResource ReduxAppBackgroundBrush}"
		BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<Border Width="42" Height="42" Margin="0,0,14,0"
					Background="{DynamicResource ReduxAccentSoftBrush}" BorderBrush="{DynamicResource ReduxAccentBrush}"
					BorderThickness="1" CornerRadius="21">
					<controls:ReduxIcon Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxAccentBrush}" StrokeData="{StaticResource Redux.Icon.CloudUpload}" />
				</Border>
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold"
						Text="Review bundle contents" />
					<TextBlock x:Name="OrderNameText" Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
				</StackPanel>
			</Grid>

			<Border Grid.Row="1" Margin="0,18,0,0" Padding="14,12"
				Background="{DynamicResource ReduxSurfaceBrush}"
				BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<StackPanel Margin="0,0,12,10">
						<TextBlock FontWeight="SemiBold" Text="Saved load order" />
						<TextBlock x:Name="ModCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Column="1" Margin="12,0,0,10">
						<TextBlock FontWeight="SemiBold" Text="Custom categories" />
						<TextBlock x:Name="CategoryCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Row="1" Margin="0,0,12,0">
						<TextBlock FontWeight="SemiBold" Text="Separators" />
						<TextBlock x:Name="SeparatorCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
						<TextBlock FontWeight="SemiBold" Text="Custom icons" />
						<TextBlock x:Name="IconCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10"
				Background="{DynamicResource ReduxSurfaceElevatedBrush}"
				BorderBrush="{DynamicResource ReduxInfoBrush}" BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
				<Grid>
					<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<controls:ReduxIcon Width="17" Height="17" Margin="0,1,8,0"
						VerticalAlignment="Top" Foreground="{DynamicResource ReduxInfoBrush}"
						StrokeData="{StaticResource Redux.Icon.Information}" />
					<TextBlock x:Name="BundleSafetyText" Grid.Column="1"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="The bundle does not contain mod .pak files or modsettings.lsx. It cannot install mods or change the game export until someone explicitly uses Export to Game."
						TextWrapping="Wrap" />
				</Grid>
			</Border>

			<CheckBox x:Name="OpenFolderCheckBox" Grid.Row="3" Margin="0,14,0,0"
				Content="Open containing folder after export"
				Style="{StaticResource ReduxCheckBoxStyle}" />

			<StackPanel Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
				<Button MinWidth="86" Content="Cancel" IsCancel="True"
					Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click" />
				<Button MinWidth="126" Margin="8,0,0,0" IsDefault="True"
					Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ContinueButton_Click">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							StrokeData="{StaticResource Redux.Icon.FolderOpen}" />
						<TextBlock Text="Choose Location..." />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</adonisUI:AdonisWindow>
