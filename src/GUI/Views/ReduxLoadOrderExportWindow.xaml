<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxLoadOrderExportWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Export Redux Modlist"
	Width="600" MinWidth="420" Height="640" MinHeight="320"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="False"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
	</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.CloudUpload}" />
	<Border Grid.Row="1" Padding="22" Background="{DynamicResource ReduxAppBackgroundBrush}"
		BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
		<Grid>
			<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<controls:ReduxIcon Width="24" Height="24" Margin="0,0,14,0"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
					Foreground="{DynamicResource ReduxAccentHoverBrush}" StrokeData="{StaticResource Redux.Icon.CloudUpload}" />
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold"
						Text="Review modlist contents" />
					<TextBlock x:Name="OrderNameText" Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
				</StackPanel>
			</Grid>

			<Border Grid.Row="1" Margin="0,18,0,0" Padding="14,12"
				Background="{DynamicResource ReduxSurfaceBrush}"
				BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<StackPanel Margin="0,0,12,10">
						<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Saved load order" />
						<TextBlock TextWrapping="Wrap" x:Name="ModCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Column="1" Margin="12,0,0,10">
						<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Custom categories" />
						<TextBlock TextWrapping="Wrap" x:Name="CategoryCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Row="1" Margin="0,0,12,0">
						<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Separators" />
						<TextBlock TextWrapping="Wrap" x:Name="SeparatorCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
						<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Custom icons" />
						<TextBlock TextWrapping="Wrap" x:Name="IconCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
						<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Source links" />
						<TextBlock TextWrapping="Wrap" x:Name="SourceLinkCountText" Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10"
				Background="{DynamicResource ReduxSurfaceElevatedBrush}"
				BorderBrush="{DynamicResource ReduxInfoBrush}" BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
				<Grid>
					<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<controls:ReduxIcon Width="17" Height="17" Margin="0,1,8,0"
						VerticalAlignment="Top" Foreground="{DynamicResource ReduxInfoBrush}"
						StrokeData="{StaticResource Redux.Icon.Information}" />
					<TextBlock x:Name="BundleSafetyText" Grid.Column="1"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="Shares the modlist only. Mod files are not included."
						TextWrapping="Wrap" />
				</Grid>
			</Border>

			<CheckBox x:Name="IncludePrivateNotesCheckBox" AutomationProperties.Name="Include private notes" Grid.Row="3" Margin="0,14,0,0"
				Style="{StaticResource ReduxCheckBoxStyle}">
				<StackPanel Margin="5,0,0,0">
					<TextBlock TextWrapping="Wrap" x:Name="PrivateNotesTitleText" FontWeight="SemiBold"
						Text="Include notes" />
					<TextBlock Margin="0,2,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="Anyone receiving this modlist can read included notes."
						TextWrapping="Wrap" />
				</StackPanel>
			</CheckBox>

			<CheckBox x:Name="OpenFolderCheckBox" Grid.Row="4" Margin="0,12,0,0"
				Content="Open containing folder after export"
				Style="{StaticResource ReduxCheckBoxStyle}" />

		</Grid>
			</ScrollViewer>
			<StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
				<Button x:Name="CancelButton" AutomationProperties.Name="{loc:Text Cancel_19766ed6}" MinWidth="86" IsCancel="True"
					Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock TextWrapping="Wrap" Text="{loc:Text Cancel_19766ed6}" />
					</StackPanel>
				</Button>
				<Button x:Name="ChooseLocationButton" AutomationProperties.Name="Choose export location" MinWidth="126" Margin="8,0,0,0" IsDefault="True"
					Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ContinueButton_Click">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							StrokeData="{StaticResource Redux.Icon.FolderOpen}" />
						<TextBlock TextWrapping="Wrap" Text="Save As..." />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
	</Grid>
</adonisUI:AdonisWindow>
