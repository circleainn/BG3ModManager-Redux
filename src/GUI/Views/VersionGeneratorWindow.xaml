<local:VersionGeneratorWindowBase
	x:Class="DivinityModManager.Views.VersionGeneratorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
	Title="Version Generator"
	Width="620"
	Height="430"
	MinWidth="560"
	MinHeight="400"
	ResizeMode="CanResize"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
	Background="{DynamicResource ReduxWindowBrush}"
	mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="VersionComponentLabelStyle"
				BasedOn="{StaticResource Redux.Text.Metadata}"
				TargetType="TextBlock">
				<Setter Property="Margin" Value="0,0,0,6" />
				<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Control}" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Build}" />
		<Border Grid.Row="1"
			Padding="22"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<controls:ReduxIcon Width="24"
					Height="24"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ReduxAccentHoverBrush}"
					StrokeData="{StaticResource Redux.Icon.Build}" />
				<StackPanel Grid.Column="1" Margin="13,0,0,0">
					<TextBlock Style="{StaticResource Redux.Text.PageTitle}" Text="Version Generator" />
					<TextBlock Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="For mod authors working with BG3 module metadata."
						TextWrapping="Wrap" />
				</StackPanel>
			</Grid>

			<TextBlock Grid.Row="1"
				Margin="0,16,0,14"
				Style="{StaticResource Redux.Text.Body}"
				Text="BG3 stores a mod's version as one packed Version64 number in meta.lsx. Set the four components below, or paste an existing packed value, then copy the result."
				TextWrapping="Wrap" />

			<Border Grid.Row="2"
				Padding="{DynamicResource Redux.Inset.Card}"
				Background="{DynamicResource ReduxSurfaceBrush}"
				BorderBrush="{DynamicResource ReduxBorderBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<StackPanel>
						<TextBlock Style="{StaticResource VersionComponentLabelStyle}" Text="Major" />
						<xc:ULongUpDown x:Name="MajorUpDown"
							HorizontalAlignment="Stretch"
							Maximum="127"
							Minimum="0" />
					</StackPanel>
					<StackPanel Grid.Column="2">
						<TextBlock Style="{StaticResource VersionComponentLabelStyle}" Text="Minor" />
						<xc:ULongUpDown x:Name="MinorUpDown"
							HorizontalAlignment="Stretch"
							Maximum="127"
							Minimum="0" />
					</StackPanel>
					<StackPanel Grid.Column="4">
						<TextBlock Style="{StaticResource VersionComponentLabelStyle}" Text="Revision" />
						<xc:ULongUpDown x:Name="RevisionUpDown"
							HorizontalAlignment="Stretch"
							Maximum="65536"
							Minimum="0" />
					</StackPanel>
					<StackPanel Grid.Column="6">
						<TextBlock Style="{StaticResource VersionComponentLabelStyle}" Text="Build" />
						<xc:ULongUpDown x:Name="BuildUpDown"
							HorizontalAlignment="Stretch"
							Maximum="2147483647"
							Minimum="0" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="3"
				Margin="0,14,0,0"
				Padding="{DynamicResource Redux.Inset.Card}"
				VerticalAlignment="Top"
				Background="{DynamicResource ReduxSurfaceBrush}"
				BorderBrush="{DynamicResource ReduxBorderBrush}"
				BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Style="{StaticResource VersionComponentLabelStyle}" Text="Packed version number" />
					<Grid Grid.Row="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<controls:UnfocusableTextBox x:Name="VersionNumberTextBox"
							MinHeight="{DynamicResource Redux.ControlHeight.Standard}"
							VerticalContentAlignment="Center" />
						<Button x:Name="CopyButton"
							Grid.Column="1"
							Margin="10,0,0,0"
							MinWidth="88"
							Style="{StaticResource ReduxPrimaryActionButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon Width="14"
									Height="14"
									Margin="0,0,6,0"
									Foreground="{DynamicResource ReduxAccentForegroundBrush}"
									StrokeData="{StaticResource Redux.Icon.Copy}" />
								<TextBlock Text="Copy" />
							</StackPanel>
						</Button>
						<Button x:Name="ResetButton"
							Grid.Column="2"
							Margin="8,0,0,0"
							MinWidth="88"
							Style="{StaticResource ReduxWarningActionButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon Width="14"
									Height="14"
									Margin="0,0,6,0"
									Foreground="{DynamicResource ReduxWarningBrush}"
									StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
								<TextBlock Text="Reset" />
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</Border>

			<controls:AlertBar x:Name="AlertBar"
				Grid.Row="4"
				Margin="0,12,0,0"
				MinHeight="18"
				Theme="Standard" />
		</Grid>
		</Border>
	</Grid>
</local:VersionGeneratorWindowBase>
