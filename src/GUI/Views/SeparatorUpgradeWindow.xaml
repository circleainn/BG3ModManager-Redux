<adonis:AdonisWindow x:Class="DivinityModManager.Views.SeparatorUpgradeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonis="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Existing separators" Width="560" Height="480" MinWidth="420" MinHeight="300"
    FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
    Background="{DynamicResource ReduxSurfaceBrush}" ShowInTaskbar="False" ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner" Template="{DynamicResource ReduxWindowTemplate}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/MainResourceDictionary.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Layers}"/>
        <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,16">
                <TextBlock Text="Update your existing separators" FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold"/>
                <TextBlock x:Name="OrderSummary" Margin="0,6,0,20" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
                <CheckBox x:Name="PersistentChoice" Style="{StaticResource ReduxCheckBoxStyle}">
                    <TextBlock Text="Use these separators in every load order" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Margin="24,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
                    Text="Share their appearance across orders. Each order keeps its own placement and collapsed state. Leave unchecked to keep the current scope."/>
                <TextBlock Text="Separator lines" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="DisableLinesChoice" Style="{StaticResource ReduxCheckBoxStyle}">
                    <TextBlock Text="Turn off lines for these existing separators" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Margin="24,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
                    Text="Leave unchecked to keep current line settings. New separators start without lines; you can enable a line in the separator editor."/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}"
                    Text="This choice applies to this load order. Other existing orders will ask when opened. Changes can be undone with Ctrl+Z."/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ReduxBorderBrush}" Background="{DynamicResource ReduxSurfaceElevatedBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="LeaveUnchanged_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                            Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Close}"/>
                        <TextBlock Text="Leave unchanged"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyButton" Style="{StaticResource ReduxPrimaryActionButtonStyle}" IsDefault="True" Click="Apply_Click">
                    <StackPanel Orientation="Horizontal">
                        <controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                            Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Check}"
                            Foreground="{DynamicResource ReduxAccentForegroundBrush}"/>
                        <TextBlock Text="Apply choices"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</adonis:AdonisWindow>
