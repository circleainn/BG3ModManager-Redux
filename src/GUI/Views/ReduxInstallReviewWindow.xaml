<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxInstallReviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="650" Height="500" MinWidth="570" MinHeight="390" MaxHeight="720"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="ReviewItemTemplate">
				<Border Margin="0,0,0,7" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="4" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border x:Name="StatusRail" Background="{DynamicResource ReduxInfoBrush}" />
						<StackPanel Grid.Column="1" Margin="13,10">
							<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
						</StackPanel>
						<Border x:Name="StatusPill" Grid.Column="2" MaxWidth="250" Margin="12,0,12,0" Padding="9,4"
							VerticalAlignment="Center" Background="Transparent"
							BorderBrush="Transparent" BorderThickness="0"
							CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon x:Name="StatusIcon" Width="13" Height="13" Margin="0,0,6,0"
									Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.AddCircle}"
									Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
								<TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold"
									Foreground="{DynamicResource ReduxInfoBrush}" Text="{Binding Status}"
									TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
							</StackPanel>
						</Border>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding Tone}" Value="Success">
							<Setter TargetName="StatusRail" Property="Background" Value="{DynamicResource ReduxSuccessBrush}" />
							<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
							<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.RefreshStroke}" />
							<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Tone}" Value="Warning">
							<Setter TargetName="StatusRail" Property="Background" Value="{DynamicResource ReduxWarningBrush}" />
							<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
							<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
							<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Tone}" Value="Error">
							<Setter TargetName="StatusRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
							<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
							<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
							<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}" Value="New mod">
							<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.AddCircle}" />
						</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar x:Name="TitleBar" IconData="{DynamicResource Redux.Icon.Download}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock x:Name="HeadingText" FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}" Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
					<TextBlock x:Name="DescriptionText" Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						TextWrapping="Wrap" />
				</StackPanel>

				<Border Grid.Row="1" Margin="0,12,0,9" Padding="12,9"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
					BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Width="34" Height="34" Margin="0,0,11,0" Background="{DynamicResource ReduxAccentPillBackground}" CornerRadius="8">
							<controls:ReduxIcon x:Name="SummaryIcon" Width="16" Height="16" Foreground="{DynamicResource ReduxAccentHoverBrush}"
								Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
						</Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
							<TextBlock x:Name="SummaryDetailText" Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
				</Border>

				<ListBox x:Name="ReviewList" Grid.Row="2" Background="Transparent" BorderThickness="0"
					HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}"
					ItemTemplate="{StaticResource ReviewItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />

				<Grid Grid.Row="3" Margin="0,10,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
						<TextBlock x:Name="FootnoteText" Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" />
						<CheckBox x:Name="SkipCleanReviewCheckBox" Margin="0,8,0,0"
							Content="{loc:Text Don_t_show_this_review_for_clean_packages_e3243cf8}" Visibility="Collapsed" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button x:Name="CancelButton" MinWidth="86" Style="{StaticResource ReduxSecondaryActionButtonStyle}" IsCancel="True" Click="CancelButton_Click">
							<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Cancel_19766ed6}" /></StackPanel>
						</Button>
						<Button x:Name="InstallButton" MinWidth="112" Margin="8,0,0,0" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}"
							IsDefault="True" Click="InstallButton_Click">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon VerticalAlignment="Center" x:Name="InstallButtonIcon" Width="14" Height="14" Margin="0,0,6,0"
									Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
									Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
									StrokeData="{StaticResource Redux.Icon.Download}" />
								<TextBlock x:Name="InstallButtonText" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
