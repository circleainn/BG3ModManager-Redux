<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxGameDirectoryModManagerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonis="clr-namespace:AdonisUI;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Game-Directory Mod Manager" Width="880" Height="700" MinWidth="740" MinHeight="560"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}" AllowDrop="True" Drop="Window_Drop"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="ReduxDeleteButtonStyle" BasedOn="{StaticResource ReduxMinorDestructiveActionButtonStyle}" TargetType="{x:Type Button}">
				<Style.Triggers>
					<Trigger Property="IsEnabled" Value="False">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static adonis:Brushes.DisabledForegroundBrush}}" />
						<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
						<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ReduxSourceButtonStyle" BasedOn="{StaticResource ReduxMinorNexusActionButtonStyle}" TargetType="{x:Type Button}">
				<Style.Triggers>
					<Trigger Property="IsEnabled" Value="False">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static adonis:Brushes.DisabledForegroundBrush}}" />
						<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
						<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ReduxScriptExtenderActionButtonStyle" BasedOn="{StaticResource ReduxMinorSuccessActionButtonStyle}" TargetType="{x:Type Button}">
				<Style.Triggers>
					<Trigger Property="IsEnabled" Value="False">
						<Setter Property="Foreground" Value="{DynamicResource {x:Static adonis:Brushes.DisabledForegroundBrush}}" />
						<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
						<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ReduxGameDirectoryListItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,5" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FocusVisualStyle" Value="{StaticResource ReduxManagerKeyboardFocusStyle}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="RowChrome" MinHeight="78" Background="{DynamicResource ReduxSurfaceBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True"
								util:ReduxWindowBehavior.HoverLift="1" RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
								<Grid>
									<Border x:Name="SelectionSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="SelectionRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverSurface" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}" IsHitTestVisible="False" Opacity="0" />
									<Border x:Name="HoverRail" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderBrush="{DynamicResource ReduxAccentBrush}" BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}" IsHitTestVisible="False" Opacity="0" />
									<ContentPresenter />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="RowChrome" Property="BorderBrush" Value="Transparent" />
									<Trigger.EnterActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0.62"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="1"
											Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
									</Storyboard></BeginStoryboard></Trigger.EnterActions>
									<Trigger.ExitActions><BeginStoryboard><Storyboard>
										<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0"
											Duration="{StaticResource Redux.Motion.Standard}" />
										<DoubleAnimation Storyboard.TargetName="HoverRail" Storyboard.TargetProperty="Opacity" To="0"
											Duration="{StaticResource Redux.Motion.Standard}" />
									</Storyboard></BeginStoryboard></Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="RowChrome" Property="BorderBrush" Value="Transparent" />
									<Setter TargetName="SelectionSurface" Property="Opacity" Value="0.62" />
									<Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
									<Setter TargetName="HoverSurface" Property="Background" Value="Transparent" />
									<Setter TargetName="HoverRail" Property="BorderBrush" Value="Transparent" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="InstalledModTemplate">
				<Border Padding="{DynamicResource Redux.Manager.RowPadding}" Background="Transparent">
                    <Border.ToolTip><StackPanel MaxWidth="460">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FileSummary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ManagementNote}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel></Border.ToolTip>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="128" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<Border Grid.RowSpan="2" Width="{DynamicResource Redux.Manager.ThumbnailWidth}" Height="{DynamicResource Redux.Manager.ThumbnailHeight}" VerticalAlignment="Center"
							Background="{DynamicResource ReduxSurfaceMutedBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
							<Grid>
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxTextMutedBrush}"
									StrokeData="{StaticResource Redux.Icon.Blocks}" />
								<Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
							</Grid>
						</Border>
						<StackPanel Grid.Column="1" Margin="{DynamicResource Redux.Manager.ThumbnailGap}" VerticalAlignment="Center">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<TextBlock Style="{StaticResource ReduxManagerRowTitleStyle}" VerticalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" />
								<Border x:Name="StatusPill" Grid.Column="1" MaxWidth="180" VerticalAlignment="Top" Margin="12,1,0,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding ManagementNote}">
									<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<controls:ReduxIcon x:Name="StatusIcon" VerticalAlignment="Center" Width="11" Height="11" Margin="0,0,5,0"
											Foreground="{DynamicResource ReduxSuccessBrush}" StrokeData="{StaticResource Redux.Icon.ShieldCheck}" />
										<TextBlock Style="{StaticResource ReduxManagerStatusStyle}" x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ReduxSuccessBrush}" Text="{Binding StatusText}" />
									</Grid>
								</Border>
							</Grid>
							
							<TextBlock Style="{StaticResource ReduxManagerMetadataStyle}" Margin="0,3,0,0"
								Text="{Binding DetailsText}" TextWrapping="Wrap" ToolTip="{Binding DetailsText}" />
							
						</StackPanel>
						<WrapPanel Grid.Row="1" Grid.Column="1" Margin="13,6,0,0">
							<Button Margin="0,0,6,0" Padding="8,4" MinHeight="30" FontSize="{DynamicResource Redux.FontSize.12}" Style="{StaticResource ReduxSourceButtonStyle}"
								AutomationProperties.Name="Open mod source" Click="SourceButton_Click" IsEnabled="{Binding HasSource}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,6,0"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.LinkStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
									<TextBlock Text="Source" />
								</StackPanel>
							</Button>
							<Button Margin="0,0,6,0" Padding="8,4" MinHeight="30" FontSize="{DynamicResource Redux.FontSize.12}" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}"
								ToolTip="{Binding ManagementNote}" AutomationProperties.Name="Manage this mod with Redux" Click="AdoptButton_Click" Visibility="{Binding CanAdopt, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,6,0"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.ShieldCheck}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="Manage" />
								</StackPanel>
							</Button>
							<Button Margin="0,0,6,0" Padding="8,4" MinHeight="30" FontSize="{DynamicResource Redux.FontSize.12}" Style="{StaticResource ReduxDeleteButtonStyle}"
								AutomationProperties.Name="Delete this game-directory mod" Click="DeleteButton_Click" IsEnabled="{Binding CanRestore}" Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,6,0"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.Trash}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
									<TextBlock Text="Delete" />
								</StackPanel>
							</Button>
						</WrapPanel>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Status}" Value="External">
						<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
						<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
						<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Information}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsExternalReplacement}" Value="True">
						<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Status}" Value="Changed">
						<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Status}" Value="Missing">
						<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.ShieldAlert}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Status}" Value="RecoveryRequired">
						<Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.ShieldAlert}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Blocks}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock Style="{StaticResource ReduxWindowHeadingStyle}" Text="Game-Directory Mod Manager" />
					<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"
						Text="Manage reviewed native plugins and mods installed beside BG3." />
				</StackPanel>

				<WrapPanel Grid.Row="1" Margin="{DynamicResource Redux.Manager.ToolbarMargin}" Orientation="Horizontal">
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Install game-directory mod archive" Click="InstallButton_Click" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="Install Archive..." />
						</StackPanel>
					</Button>
					<Button x:Name="ScriptExtenderButton" AutomationProperties.Name="{Binding Text, ElementName=ScriptExtenderButtonText}" Margin="{DynamicResource Redux.Manager.ActionMargin}" Click="ScriptExtenderButton_Click"
						Style="{StaticResource ReduxScriptExtenderActionButtonStyle}"
						ToolTip="Download and install Script Extender through this manager's reviewed workflow.">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock x:Name="ScriptExtenderButtonText" Text="Install Script Extender" />
						</StackPanel>
					</Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Open game folder" Click="OpenGameFolderButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.FolderOpen}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="Open Game Folder" />
						</StackPanel>
					</Button>
					<Button x:Name="InstallYanmlButton" Margin="{DynamicResource Redux.Manager.ActionMargin}"
						AutomationProperties.Name="Install native plugin for YANML" Click="InstallYanmlButton_Click"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" Visibility="Collapsed"
						ToolTip="Review a native plugin archive and install its DLL in YANML's local Plugins folder.">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="Install for YANML..." />
						</StackPanel>
					</Button>
					<Button x:Name="OpenYanmlPluginsButton" Margin="{DynamicResource Redux.Manager.ActionMargin}"
						AutomationProperties.Name="Open YANML plugins folder" Click="OpenYanmlPluginsButton_Click"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" Visibility="Collapsed"
						ToolTip="YANML loads native plugins from this local folder, outside Redux's game-directory workflow.">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.FolderOpen}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="YANML Plugins" />
						</StackPanel>
					</Button>
					<Button Margin="{DynamicResource Redux.Manager.ActionMargin}" AutomationProperties.Name="Refresh game-directory mods" Click="RefreshButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
								Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
								StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
							<TextBlock Text="Refresh" />
						</StackPanel>
					</Button>
				</WrapPanel>

				<Border Grid.Row="2" Margin="0,12,0,10" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Background="{DynamicResource ReduxWarningBrush}" />
						<controls:ReduxIcon Grid.Column="1" Width="16" Height="16" Margin="11,10,8,10" VerticalAlignment="Top"
							Foreground="{DynamicResource ReduxWarningBrush}" IconKey="warning"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
						<TextBlock x:Name="NativeWarningText" Grid.Column="2" Margin="0,9,12,9" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"
							Text="Native DLLs run code inside the game. Install only from sources you trust." />
					</Grid>
				</Border>

				<Grid Grid.Row="3">
					<Border Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />
					<ListBox x:Name="InstalledList" Margin="7" Background="Transparent" BorderThickness="0"
						HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource ReduxGameDirectoryListItemStyle}"
						ItemTemplate="{StaticResource InstalledModTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
					<TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
						Text="No recognized game-directory mods are installed.&#x0a;Choose Install Archive or drop a reviewed archive here." />
				</Grid>

				<Grid Grid.Row="4" Margin="0,10,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<TextBlock x:Name="GamePathText" Margin="0,0,14,0" VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}" TextTrimming="CharacterEllipsis" />
					<Button x:Name="GameDirectoryCloseButton" Grid.Column="1" MinWidth="84" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" />
							<TextBlock Text="Close" />
						</StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
