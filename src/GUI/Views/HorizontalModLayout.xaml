<local:HorizontalModLayoutBase x:Class="DivinityModManager.Views.HorizontalModLayout"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
	xmlns:behavior="clr-namespace:DivinityModManager.Controls.Behavior"
	xmlns:c="clr-namespace:DivinityModManager.Controls"
	xmlns:conv="clr-namespace:DivinityModManager.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:dd="urn:gong-wpf-dragdrop"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	x:Name="HorizontalModLayoutView"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<conv:ModDetailsMediaWidthConverter x:Key="ModDetailsMediaWidthConverter" />
			<conv:NexusDescriptionToPlainTextConverter x:Key="NexusDescriptionToPlainTextConverter" />
			<Style x:Key="ListViewItemMouseEvents" BasedOn="{StaticResource DivinityModDataListItem}" TargetType="{x:Type ListViewItem}">
			</Style>
			<Style x:Key="ModOrderListViewWithDrag" BasedOn="{StaticResource ModOrderListView}" TargetType="ListView">
				<Setter Property="dd:DragDrop.DragDirectlySelectedOnly" Value="True" />
				<Setter Property="dd:DragDrop.IsDragSource" Value="True" />
				<Setter Property="dd:DragDrop.IsDropTarget" Value="True" />
				<Setter Property="dd:DragDrop.DropTargetAdornerBrush" Value="{DynamicResource ReduxAccentBrush}" />
				<Setter Property="dd:DragDrop.DropTargetAdornerPen">
					<Setter.Value>
						<Pen Brush="{DynamicResource ReduxAccentBrush}" Thickness="2" />
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="OverrideModListViewStyle" BasedOn="{StaticResource ModOrderListViewWithDrag}" TargetType="{x:Type c:ModListView}">
				<!-- Override Mods shares the exact pane chrome and scrollbar template, but remains read-only for ordering. -->
				<Setter Property="dd:DragDrop.IsDragSource" Value="False" />
				<Setter Property="dd:DragDrop.IsDropTarget" Value="False" />
			</Style>
			<Style x:Key="ModSectionCard" TargetType="{x:Type Border}">
				<!--
					Panel chrome and list content use separate semantic layers: the full-bleed
					header surface is added in each pane while this card supplies the quieter
					list interior. This preserves custom-theme behavior without adding colors.
				-->
				<Setter Property="Background" Value="{DynamicResource ReduxListInteriorBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Card}" />
				<Setter Property="ClipToBounds" Value="True" />
			</Style>
			<Style x:Key="ModSectionTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.14}" />
				<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Title}" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style x:Key="ModViewNoticeButtonStyle" TargetType="{x:Type Button}">
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Setter Property="HorizontalContentAlignment" Value="Left" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.11}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxAccentBrush}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Button}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
                <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="ModCategoryFilterNoticeButtonStyle" BasedOn="{StaticResource ModViewNoticeButtonStyle}" TargetType="{x:Type Button}">
                <Setter Property="ToolTip" Value="Clear the category filter and show all mods" />
                <Setter Property="AutomationProperties.Name" Value="Clear category filter" />
				<Style.Triggers>
					<!-- An empty selection can briefly occur while profiles/categories refresh.
					     Do not expose an incomplete notice or fall back to WPF's black text. -->
					<DataTrigger Binding="{Binding SelectedModCategory}" Value="">
						<Setter Property="Visibility" Value="Collapsed" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedModCategory}" Value="{x:Null}">
						<Setter Property="Visibility" Value="Collapsed" />
					</DataTrigger>
					<DataTrigger Binding="{Binding SelectedModCategory}" Value="All Mods">
						<Setter Property="Visibility" Value="Collapsed" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Settings.UseCategoryColorsForSidebarText}" Value="True">
						<Setter Property="Foreground" Value="{Binding SelectedModCategoryColor}" />
					</DataTrigger>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Opacity" Value="0.78" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ModCategoryFilterNoticeIconStyle"
				BasedOn="{StaticResource {x:Type c:ReduxIcon}}"
				TargetType="{x:Type c:ReduxIcon}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding SelectedModCategoryHasIcon}" Value="True" />
							<Condition Binding="{Binding Settings.ShowCategoryIconsInPills}" Value="True" />
						</MultiDataTrigger.Conditions>
						<Setter Property="Visibility" Value="Visible" />
					</MultiDataTrigger>
				</Style.Triggers>
			</Style>
			<DataTemplate x:Key="ModCategoryFilterNoticeContentTemplate">
				<StackPanel Orientation="Horizontal">
					<TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						Text="Filtered: " />
					<c:ReduxIcon Width="11" Height="11" Margin="0,0,4,0"
						VerticalAlignment="Center"
						Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						IconKey="{Binding SelectedModCategoryIcon}"
						Style="{StaticResource ModCategoryFilterNoticeIconStyle}" />
					<TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						Text="{Binding SelectedModCategory}" />
					<TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						Text=" · Clear" />
				</StackPanel>
			</DataTemplate>
			<!-- One vertical rhythm for Categories, Active Mods, and Inactive Mods. -->
			<Style x:Key="ModPaneHeaderStyle" TargetType="{x:Type Grid}">
				<Setter Property="Height" Value="{DynamicResource Redux.PaneHeaderHeight}" />
				<Setter Property="Margin" Value="12,0" />
			</Style>
			<Style x:Key="ModPaneHeaderDividerStyle" TargetType="{x:Type Border}">
				<Setter Property="Height" Value="1" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="Background" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="Opacity" Value="0.8" />
				<Setter Property="IsHitTestVisible" Value="False" />
			</Style>
			<!--
				Rest state is a quiet secondary glyph; the accent foreground and soft pill arrive
				only on hover, mirroring ReduxChromeToggleStyle so the + controls and the chevron
				toggles beside them share one interaction language.
			-->
			<Style x:Key="ModPaneHeaderActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ReduxPaneHeaderActionButtonStyle}" />
			<!-- Pane-resize handles mirror the rounded insertion rail without adding permanent chrome. -->
			<Style x:Key="ReduxVerticalSplitterStyle" TargetType="{x:Type GridSplitter}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Cursor" Value="SizeWE" />
				<Setter Property="ResizeDirection" Value="Columns" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type GridSplitter}">
							<Grid Background="Transparent">
								<Border x:Name="SplitterHalo"
									Width="6"
									Margin="0,6"
									HorizontalAlignment="Center"
									Background="{DynamicResource ReduxAccentHoverBrush}"
									CornerRadius="3"
									Opacity="0" />
								<Border x:Name="SplitterRail"
									Width="2"
									Margin="0,6"
									HorizontalAlignment="Center"
									Background="{DynamicResource ReduxAccentHoverBrush}"
									CornerRadius="1"
									Opacity="0" />
							</Grid>
							<ControlTemplate.Triggers>
								<EventTrigger RoutedEvent="MouseEnter">
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="SplitterHalo" Storyboard.TargetProperty="Opacity"
												To="0.18" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											<DoubleAnimation Storyboard.TargetName="SplitterRail" Storyboard.TargetProperty="Opacity"
												To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										</Storyboard>
									</BeginStoryboard>
								</EventTrigger>
								<EventTrigger RoutedEvent="MouseLeave">
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="SplitterHalo" Storyboard.TargetProperty="Opacity"
												To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											<DoubleAnimation Storyboard.TargetName="SplitterRail" Storyboard.TargetProperty="Opacity"
												To="0" Duration="{StaticResource Redux.Motion.Standard}" />
										</Storyboard>
									</BeginStoryboard>
								</EventTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ReduxHorizontalSplitterStyle" TargetType="{x:Type GridSplitter}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="Cursor" Value="SizeNS" />
				<Setter Property="ResizeDirection" Value="Rows" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type GridSplitter}">
							<Grid Background="Transparent">
								<Border x:Name="SplitterHalo"
									Height="6"
									Margin="10,0"
									VerticalAlignment="Center"
									Background="{DynamicResource ReduxAccentHoverBrush}"
									CornerRadius="3"
									Opacity="0" />
								<Border x:Name="SplitterRail"
									Height="2"
									Margin="10,0"
									VerticalAlignment="Center"
									Background="{DynamicResource ReduxAccentHoverBrush}"
									CornerRadius="1"
									Opacity="0" />
							</Grid>
							<ControlTemplate.Triggers>
								<EventTrigger RoutedEvent="MouseEnter">
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="SplitterHalo" Storyboard.TargetProperty="Opacity"
												To="0.18" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											<DoubleAnimation Storyboard.TargetName="SplitterRail" Storyboard.TargetProperty="Opacity"
												To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										</Storyboard>
									</BeginStoryboard>
								</EventTrigger>
								<EventTrigger RoutedEvent="MouseLeave">
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="SplitterHalo" Storyboard.TargetProperty="Opacity"
												To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											<DoubleAnimation Storyboard.TargetName="SplitterRail" Storyboard.TargetProperty="Opacity"
												To="0" Duration="{StaticResource Redux.Motion.Standard}" />
										</Storyboard>
									</BeginStoryboard>
								</EventTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ModCategoryListItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="1,2" />
				<Setter Property="Padding" Value="{DynamicResource Redux.Interaction.RowPadding}" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1.5" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="ToolTip" Value="{x:Null}" />
				<Setter Property="ToolTipService.ShowDuration" Value="12000" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="CategorySurface"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.PillTall}"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform>
									<TranslateTransform x:Name="CategorySurfaceTranslate" Y="0" />
								</Border.RenderTransform>
								<Grid>
									<Border x:Name="CategorySelectionSurface"
										BorderThickness="{DynamicResource Redux.Interaction.SelectedBorderThickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.PillTall}"
										OpacityMask="{StaticResource Redux.Hover.WashMaskSubtle}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<!-- Same horizontal sheen as the pills; kept close to opaque here since
												     selection is a solid state, not a soft tint (see ReduxSelectionPillBackground). -->
												<Setter Property="Background" Value="{DynamicResource ReduxSelectionPillBackground}" />
												<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.Settings.UseCategoryColorsForInteractions, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
														<Setter Property="Background" Value="{Binding Color, Converter={StaticResource StringToGradientBrushConverter}, ConverterParameter=42\,22}" />
														<Setter Property="BorderBrush" Value="{Binding Color}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border x:Name="CategoryHoverSurface"
										BorderThickness="{DynamicResource Redux.Interaction.HoverBorderThickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.PillTall}"
										OpacityMask="{StaticResource Redux.Hover.WashMaskSubtle}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="{DynamicResource ReduxAccentPillBackground}" />
												<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.Settings.UseCategoryColorsForInteractions, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
														<Setter Property="Background" Value="{Binding Color, Converter={StaticResource StringToGradientBrushConverter}, ConverterParameter=28\,10}" />
														<Setter Property="BorderBrush" Value="{Binding Color}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<ContentPresenter Margin="{TemplateBinding Padding}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<DataTrigger Binding="{Binding HasDescription}" Value="True">
									<Setter Property="ToolTip" Value="{Binding Description}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Count}" Value="0">
									<Setter TargetName="CategorySurface" Property="Opacity" Value="0.58" />
								</DataTrigger>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition Property="IsMouseOver" Value="True" />
										<Condition Property="IsSelected" Value="False" />
									</MultiTrigger.Conditions>
									<MultiTrigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<util:ReduxDoubleAnimation Storyboard.TargetName="CategoryHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</MultiTrigger.EnterActions>
									<MultiTrigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<util:ReduxDoubleAnimation Storyboard.TargetName="CategoryHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</MultiTrigger.ExitActions>
								</MultiTrigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="CategorySurface" Property="Opacity" Value="1" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="CategorySurface" Property="Opacity" Value="1" />
									<!-- Selection is independent from the hover storyboard so an exit
										animation cannot retain control of and hide the selected state. -->
									<Setter TargetName="CategorySelectionSurface" Property="Opacity" Value="1" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ModDetailsToggleStyle" TargetType="{x:Type ToggleButton}">
				<Setter Property="Width" Value="30" />
				<Setter Property="Height" Value="28" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ToggleButton}">
							<Border x:Name="ToggleChrome"
								Background="Transparent"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
								RenderTransformOrigin="0.5,0.5"
								util:ReduxWindowBehavior.HoverLift="1">
								<Border.RenderTransform>
									<TranslateTransform Y="0" />
								</Border.RenderTransform>
								<Grid>
									<Border x:Name="HoverSurface"
										Width="24"
										Height="24"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
										IsHitTestVisible="False"
										Opacity="0" />
									<Path x:Name="ToggleGlyph"
										Width="10" Height="5"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Data="{StaticResource Redux.Icon.ChevronUpStroke}"
										RenderTransformOrigin="0.5,0.5"
										Stroke="{TemplateBinding Foreground}"
										StrokeEndLineCap="Round"
										StrokeLineJoin="Round"
										StrokeStartLineCap="Round"
										StrokeThickness="1.25"
										Stretch="Fill">
										<Path.RenderTransform>
											<RotateTransform Angle="0" />
										</Path.RenderTransform>
									</Path>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<!--  Rotate rather than swap geometry so the flip animates smoothly.  -->
								<Trigger Property="IsChecked" Value="False">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ToggleGlyph" Storyboard.TargetProperty="RenderTransform.Angle"
													To="180" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="ToggleGlyph" Storyboard.TargetProperty="RenderTransform.Angle"
													To="0" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
													To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ReduxPressedBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="CategoryPanelToggleStyle"
				BasedOn="{StaticResource ReduxChromeToggleStyle}"
				TargetType="{x:Type ToggleButton}" />
			<Style x:Key="ModDetailsTabControlStyle" TargetType="{x:Type TabControl}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabControl}">
							<Grid KeyboardNavigation.TabNavigation="Local">
								<Grid.RowDefinitions>
								<RowDefinition Height="42" />
									<RowDefinition Height="1" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
							<TabPanel Margin="14,2,14,2"
									ClipToBounds="False"
									IsItemsHost="True"
									KeyboardNavigation.TabIndex="1" />
								<Border Grid.Row="1"
									Height="1"
									Background="{DynamicResource ReduxBorderBrush}" />
								<ContentPresenter x:Name="PART_SelectedContentHost"
									Grid.Row="2"
									ContentSource="SelectedContent"
									KeyboardNavigation.DirectionalNavigation="Contained"
									SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
									TextElement.Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ModDetailsTabItemStyle" TargetType="{x:Type TabItem}">
				<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Control}" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="ClipToBounds" Value="False" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
				<Setter Property="Padding" Value="{DynamicResource Redux.TabHeader.Padding}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabItem}">
							<!--
								Inter-tab gap lives on the template root, NOT on TabItem.Margin:
								TabPanel double-counts external child margins and applies a layout
								clip narrower than the tab, shearing the hover pill's right corner.
							-->
							<Grid x:Name="HeaderHost"
								Margin="0,0,4,0"
								Background="Transparent"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5">
								<Grid.RenderTransform>
									<TranslateTransform Y="0" />
								</Grid.RenderTransform>
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="2" />
								</Grid.RowDefinitions>
								<Border x:Name="TabHoverSurface"
									Grid.RowSpan="2"
									Margin="{DynamicResource Redux.TabHeader.HoverMargin}"
									Background="{DynamicResource ReduxAccentSoftBrush}"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									IsHitTestVisible="False"
									Opacity="0" />
								<TextBlock x:Name="HeaderText"
									Margin="{TemplateBinding Padding}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="{TemplateBinding Header}" />
								<Border x:Name="SelectionUnderline"
									Grid.Row="1"
									Margin="5,0"
									Background="{DynamicResource ReduxAccentBrush}"
									CornerRadius="1"
									Opacity="0"
									RenderTransformOrigin="0.5,0.5">
									<Border.RenderTransform>
										<ScaleTransform ScaleX="0.4" />
									</Border.RenderTransform>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<MultiTrigger>
									<MultiTrigger.Conditions>
										<Condition Property="IsMouseOver" Value="True" />
										<Condition Property="IsSelected" Value="False" />
									</MultiTrigger.Conditions>
									<MultiTrigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</MultiTrigger.EnterActions>
									<MultiTrigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
													To="0" Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</MultiTrigger.ExitActions>
								</MultiTrigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Panel.ZIndex" Value="1" />
									<Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="1" Duration="0:0:0.14" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="1" Duration="0:0:0.14">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase EasingMode="EaseOut" />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="Opacity"
													To="0" Duration="0:0:0.10" />
												<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
													Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
													To="0.4" Duration="0:0:0.10" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ModDetailsMetadataChipStyle" BasedOn="{StaticResource ReduxPillBaseStyle}" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0,0,6,5" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceMutedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
			</Style>
			<!-- The drawer uses a stable compact status pill. Its snapshot is supplied through Tag
			     because the drawer header's DataContext wraps the selected mod. -->
			<Style x:Key="ModDetailsHealthIndicatorStyle" BasedOn="{StaticResource ReduxPillBaseStyle}" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
				<Setter Property="BorderThickness" Value="2" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Tag.HasErrors, RelativeSource={RelativeSource Self}}" Value="True">
						<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
						<Setter Property="BorderBrush" Value="{DynamicResource ReduxErrorBrush}" />
					</DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding UseIconsOnly}" Value="True" />
							<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
						</MultiDataTrigger.Conditions>
						<Setter Property="MinWidth" Value="{DynamicResource Redux.StatusPill.IconOnlyWidth}" />
						<Setter Property="Padding" Value="{DynamicResource Redux.StatusPill.IconOnlyPadding}" />
					</MultiDataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ModDetailsAuthorChipStyle" BasedOn="{StaticResource ModDetailsMetadataChipStyle}" TargetType="{x:Type Border}">
				<Style.Triggers>
					<DataTrigger Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.MODIO}">
						<Setter Property="ToolTip" Value="mod.io's user ID system does not provide Redux with enough reliable information to automatically open the author's direct profile. Use the mod.io mod page instead." />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<!-- The drawer header is auto-sized, so its pill must measure naturally instead of
				 using the list-cell template's arranged-width clamp. -->
			<DataTemplate x:Key="ModDetailsTitleCategoryPillItemTemplate">
				<Border>
					<Border.Style>
						<Style BasedOn="{StaticResource ReduxCategoryPillBaseStyle}" TargetType="{x:Type Border}">
							<Setter Property="Margin" Value="0,0,6,5" />
							<Setter Property="BorderThickness" Value="2" />
						</Style>
					</Border.Style>
					<Border.ToolTip>
						<ToolTip Content="{Binding}"
							ContentTemplate="{StaticResource ReduxCategoryPillToolTipTemplate}"
							Style="{StaticResource ReduxRichToolTipStyle}" />
					</Border.ToolTip>
					<StackPanel Orientation="Horizontal">
						<ContentControl Width="14"
							Height="14"
							Content="{Binding}"
							ContentTemplate="{StaticResource ReduxCategoryGlyphTemplate}">
							<ContentControl.Style>
								<Style TargetType="{x:Type ContentControl}">
									<Setter Property="Margin" Value="0,0,5,0" />
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding ShowInterfaceIcons}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding UseIconsOnly}" Value="True" />
												<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
											</MultiDataTrigger.Conditions>
											<Setter Property="Margin" Value="0" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</ContentControl.Style>
						</ContentControl>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="Medium"
							Text="{Binding Name}">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<!-- Presentation state travels with the category item so the drawer
									     stays synchronized with list and hover-card pills. -->
									<Setter Property="Foreground" Value="{Binding Color}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding UseCategoryColorsForText}" Value="False">
											<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
										</DataTrigger>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding UseIconsOnly}" Value="True" />
												<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility" Value="Collapsed" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsCategoryTemplate" DataType="{x:Type data:DivinityModData}">
				<ItemsControl Margin="0,0,0,-5" ClipToBounds="False"
					ItemTemplate="{StaticResource ModDetailsTitleCategoryPillItemTemplate}"
					ItemsSource="{Binding DisplayCategories}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</DataTemplate>
			<Style x:Key="ModDetailsSourceButtonStyle" BasedOn="{StaticResource ReduxAccentPillButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Height" Value="27" />
				<Setter Property="Margin" Value="0,0,6,5" />
				<Setter Property="Padding" Value="9,3" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.NEXUSMODS}">
						<Setter Property="Background" Value="{StaticResource Redux.Pill.Nexus.Background}" />
						<Setter Property="BorderBrush" Value="{StaticResource Redux.Pill.Nexus.Border}" />
						<Setter Property="Foreground" Value="{StaticResource Redux.Pill.Nexus.Border}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.MODIO}">
						<Setter Property="Background" Value="{StaticResource Redux.Pill.Modio.Background}" />
						<Setter Property="BorderBrush" Value="{StaticResource Redux.Pill.Modio.Border}" />
						<Setter Property="Foreground" Value="{StaticResource Redux.Pill.Modio.Border}" />
					</DataTrigger>
					<!-- "Colored names" off: label goes neutral; icon and chrome keep carrying the colour. -->
					<DataTrigger Binding="{Binding UseCategoryColorsForText}" Value="False">
						<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
			<DataTemplate x:Key="PlatformAuthorButtonTemplate" DataType="{x:Type data:DivinityModData}">
				<StackPanel Orientation="Horizontal">
					<ContentControl Margin="0,0,6,0" Content="{Binding}" ContentTemplate="{StaticResource PlatformIconPresenterTemplate}" />
					<TextBlock VerticalAlignment="Center" Text="{Binding Metadata.AuthorActionLabel}" />
				</StackPanel>
			</DataTemplate>
			<DataTemplate x:Key="PlatformSourceButtonTemplate" DataType="{x:Type data:DivinityModData}">
				<StackPanel Orientation="Horizontal">
					<ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlatformIconPresenterTemplate}">
						<ContentControl.Style>
							<Style TargetType="{x:Type ContentControl}">
								<Setter Property="Margin" Value="0,0,6,0" />
								<Style.Triggers>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding UseIconsOnly}" Value="True" />
											<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="Margin" Value="0" />
									</MultiDataTrigger>
								</Style.Triggers>
							</Style>
						</ContentControl.Style>
					</ContentControl>
					<TextBlock VerticalAlignment="Center" Text="{Binding Metadata.SourcePageButtonLabel}">
						<TextBlock.Style>
							<Style TargetType="{x:Type TextBlock}">
								<Style.Triggers>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding UseIconsOnly}" Value="True" />
											<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="Visibility" Value="Collapsed" />
									</MultiDataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>
			</DataTemplate>
			<DataTemplate x:Key="PlatformChangelogButtonTemplate" DataType="{x:Type data:DivinityModData}">
				<StackPanel Orientation="Horizontal">
					<ContentControl Margin="0,0,6,0" Content="{Binding}" ContentTemplate="{StaticResource PlatformIconPresenterTemplate}" />
					<TextBlock VerticalAlignment="Center" Text="{Binding Metadata.ChangelogButtonLabel}" />
				</StackPanel>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsOverviewTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="14,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="14" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border MinWidth="250"
						MaxWidth="620"
						Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource ModDetailsMediaWidthConverter}}"
						VerticalAlignment="Stretch"
						Background="{DynamicResource ReduxListInteriorBrush}"
						BorderThickness="1"
						ClipToBounds="True"
						CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
						<Border.InputBindings>
							<MouseBinding Command="{Binding Path=OpenModGalleryPageCommand, Source={x:Static dapp:DivinityApp.Commands}}"
								CommandParameter="{Binding}"
								MouseAction="LeftClick" />
						</Border.InputBindings>
						<Border.Style>
							<Style TargetType="{x:Type Border}">
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Metadata.OnlineSourceVisibility}" Value="Visible">
										<Setter Property="Cursor" Value="Hand" />
										<Setter Property="ToolTip" Value="{Binding Metadata.GalleryTooltip}" />
									</DataTrigger>
									<!--  Hover glow matches the linked provider's brand color instead of always Redux purple.  -->
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding Metadata.OnlineSourceVisibility}" Value="Visible" />
											<Condition Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.NEXUSMODS}" />
											<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="BorderBrush" Value="{StaticResource Redux.Pill.Nexus.Border}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect BlurRadius="10" Color="#F9A332" Opacity="0.65" ShadowDepth="0" />
											</Setter.Value>
										</Setter>
									</MultiDataTrigger>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding Metadata.OnlineSourceVisibility}" Value="Visible" />
											<Condition Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.MODIO}" />
											<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="BorderBrush" Value="{StaticResource Redux.Pill.Modio.Border}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect BlurRadius="10" Color="#05C2D8" Opacity="0.65" ShadowDepth="0" />
											</Setter.Value>
										</Setter>
									</MultiDataTrigger>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding Metadata.OnlineSourceVisibility}" Value="Visible" />
											<Condition Binding="{Binding Metadata.SourceType}" Value="{x:Static dapp:ModSourceType.NONE}" />
											<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect BlurRadius="10" Color="{DynamicResource ReduxAccentColor}" Opacity="0.65" ShadowDepth="0" />
											</Setter.Value>
										</Setter>
									</MultiDataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Grid>
							<!--  Future linked artwork belongs in this layer. Uniform preserves the complete image without aggressive cropping.  -->
							<Image x:Name="ModDetailsPreviewImage"
								Margin="6"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								IsHitTestVisible="False"
								RenderOptions.BitmapScalingMode="HighQuality"
								util:RemoteImageBehavior.SourceUri="{Binding Metadata.PreviewImageUri}"
								Stretch="Uniform"
								Visibility="Collapsed" />
							<Grid x:Name="ModDetailsLocalPreviewPlaceholder">
								<Grid.Style>
									<Style TargetType="{x:Type Grid}">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
							<DataTrigger Binding="{Binding Visibility, ElementName=ModDetailsPreviewImage}" Value="Visible">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Grid.Style>
								<StackPanel MaxWidth="205"
									Margin="8"
									HorizontalAlignment="Center"
									VerticalAlignment="Center">
									<!--  Same circular icon-avatar language as ReduxMessageBoxWindow's severity badge.  -->
									<Border Width="56" Height="56"
										HorizontalAlignment="Center"
										Background="{DynamicResource ReduxAccentSoftBrush}"
										BorderBrush="{DynamicResource ReduxAccentBrush}"
										BorderThickness="1"
										CornerRadius="28">
										<c:ReduxIcon Width="26" Height="26"
											StrokeData="{StaticResource Redux.Icon.Package}"
											Foreground="{DynamicResource ReduxAccentHoverBrush}" />
									</Border>
									<TextBlock Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="No linked media" />
									<TextBlock Margin="0,2,0,0"
										HorizontalAlignment="Center"
										Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="Online source will appear here when linked."
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Grid>
					</Border>
					<Grid Grid.Column="2">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<ItemsControl Margin="0,1,0,0"
							ItemTemplate="{StaticResource ReduxPackageBehaviorPillTemplate}"
							ItemsSource="{Binding HealthSnapshot.PackageBehaviorFindings}">
							<ItemsControl.ItemContainerStyle>
								<Style TargetType="{x:Type ContentPresenter}">
									<Setter Property="Margin" Value="0,0,6,5" />
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</ItemsControl.ItemContainerStyle>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
						<WrapPanel Grid.Row="1" Margin="0,2,0,0" VerticalAlignment="Center">
							<TextBlock VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{Binding Metadata.LinkStatus}"
								ToolTip="{Binding Metadata.LinkStatusTooltip}" />
						</WrapPanel>
						<WrapPanel Grid.Row="2" Margin="0,7,0,0">
							<Border Style="{StaticResource ModDetailsMetadataChipStyle}"
								ToolTip="{Binding SourceComponentTooltip}"
								Visibility="{Binding SourceComponentVisibility}">
								<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding SourceComponentSummary}" />
							</Border>
							<Border Style="{StaticResource ModDetailsMetadataChipStyle}">
								<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Metadata.VersionLabel}" />
							</Border>
							<Border Style="{StaticResource ModDetailsMetadataChipStyle}">
								<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Metadata.UpdatedLabel}" />
							</Border>
							<Border Margin="0,0,6,5"
								Padding="8,4"
								Background="{DynamicResource ReduxAccentSoftBrush}"
								BorderBrush="{DynamicResource ReduxAccentBrush}"
								BorderThickness="1.5"
								CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
								ToolTip="{Binding Metadata.OfflineDatabaseNoticeTooltip}"
								Visibility="Collapsed">
								<StackPanel Orientation="Horizontal">
									<TextBlock Margin="0,0,5,0"
										Foreground="{DynamicResource ReduxAccentHoverBrush}"
										Text="◇" />
									<TextBlock FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxAccentHoverBrush}"
										Text="{Binding Metadata.OfflineDatabaseNotice}" />
								</StackPanel>
							</Border>
							<Border Style="{StaticResource ModDetailsAuthorChipStyle}" Visibility="{Binding Metadata.LocalAuthorVisibility}">
								<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding Metadata.AuthorLabel}" />
							</Border>
							<Button Command="{Binding Path=OpenURLCommand, Source={x:Static dapp:DivinityApp.Commands}}"
								CommandParameter="{Binding Metadata.AuthorPageUrl}"
								Content="{Binding}"
								ContentTemplate="{StaticResource PlatformAuthorButtonTemplate}"
								Style="{StaticResource ModDetailsSourceButtonStyle}"
								ToolTip="Open the mod author's profile"
								Visibility="{Binding Metadata.AuthorPageVisibility}" />
							<Button Command="{Binding Path=OpenModSourcePageCommand, Source={x:Static dapp:DivinityApp.Commands}}"
								CommandParameter="{Binding}"
								Content="{Binding}"
								ContentTemplate="{StaticResource PlatformSourceButtonTemplate}"
								Style="{StaticResource ModDetailsSourceButtonStyle}"
								Visibility="{Binding Metadata.OnlineSourceVisibility}">
								<Button.ToolTip>
									<ToolTip Content="{Binding}"
										ContentTemplate="{DynamicResource ReduxSourceLabelToolTipTemplate}"
										Style="{StaticResource ReduxRichToolTipStyle}" />
								</Button.ToolTip>
							</Button>
						</WrapPanel>
						<Border Grid.Row="3"
							Margin="0,3,0,0"
							Padding="10,8"
							Background="{DynamicResource ReduxListInteriorBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}"
							BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBlock FontSize="{DynamicResource Redux.FontSize.11}"
									FontWeight="SemiBold"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="SUMMARY" />
								<ScrollViewer Grid.Row="1"
									Margin="0,4,0,0"
									HorizontalScrollBarVisibility="Disabled"
									VerticalScrollBarVisibility="Auto">
									<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="{Binding Metadata.Summary, TargetNullValue='No local description is available.'}"
										TextWrapping="Wrap" />
								</ScrollViewer>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsDescriptionTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="18,12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.16}"
							FontWeight="SemiBold"
							Text="{Binding Metadata.DescriptionHeading}" />
					</Grid>
					<TextBlock Grid.Row="1"
						Margin="0,2,0,0"
						Foreground="{DynamicResource ReduxTextMutedBrush}">
						<TextBlock.Style>
							<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
								<Setter Property="Text" Value="Description stored inside the installed mod package." />
								<Style.Triggers>
									<DataTrigger Binding="{Binding NexusModsInformationVisibility}" Value="Visible">
									<Setter Property="Text" Value="Readable plain-text view of the author's description." />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<Border Grid.Row="2"
						Margin="0,9,0,0"
						Padding="12,10"
						Background="{DynamicResource ReduxListInteriorBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
							<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding Metadata.Description, Converter={StaticResource NexusDescriptionToPlainTextConverter}, TargetNullValue='No local description is available for this mod.'}"
								TextWrapping="Wrap" />
						</ScrollViewer>
					</Border>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsFilesTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="18,14">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold" Text="Installed package" />
					<Grid Grid.Row="1" Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Mod UUID" />
						<TextBlock Grid.Column="1" Text="{Binding UUID}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UUID}" />
					</Grid>
					<Grid Grid.Row="2" Margin="0,8,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="File path" />
						<TextBlock Grid.Column="1" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
					</Grid>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsRequirementsTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="18,12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold" Text="Installed mod dependencies" />
					<TextBlock Grid.Row="1"
						Margin="0,2,0,0"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="Dependencies parsed from the installed mod package. Online requirements can be added when a source provides them." />
					<Border Grid.Row="2"
						Margin="0,9,0,0"
						Padding="10"
						Background="{DynamicResource ReduxListInteriorBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
						<Grid>
							<ListBox ItemTemplate="{StaticResource DependencyModTemplate}"
								ItemsSource="{Binding DisplayedDependencies}">
								<ListBox.Style>
									<Style BasedOn="{StaticResource ModuleShortDescListBox}" TargetType="ListBox">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding HasDependencies}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ListBox.Style>
							</ListBox>
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding HasDependencies}" Value="False">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>
								<TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No installed dependencies declared" />
								<TextBlock Margin="0,5,0,0"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="This mod does not list another mod as a dependency."
									TextAlignment="Center"
									TextWrapping="Wrap" />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsChangelogTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="18,12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.16}"
							FontWeight="SemiBold"
							Text="{Binding Metadata.ChangelogHeading}" />
						<Button Grid.Column="1"
							Command="{Binding Path=OpenModChangelogPageCommand, Source={x:Static dapp:DivinityApp.Commands}}"
							CommandParameter="{Binding}"
							Content="{Binding}"
							ContentTemplate="{StaticResource PlatformChangelogButtonTemplate}"
							Style="{StaticResource ModDetailsSourceButtonStyle}"
							Visibility="{Binding Metadata.OnlineSourceVisibility}" />
					</Grid>
					<TextBlock Grid.Row="1"
						Margin="0,2,0,0"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="{Binding Metadata.ChangelogHelperText}" />
					<Border Grid.Row="2"
						Margin="0,9,0,0"
						Padding="12,10"
						Background="{DynamicResource ReduxListInteriorBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
							<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap">
								<TextBlock.Style>
									<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
										<Setter Property="Text" Value="No online changelog is linked to this installed mod." />
										<Style.Triggers>
										<DataTrigger Binding="{Binding Metadata.OnlineSourceVisibility}" Value="Visible">
											<Setter Property="Text" Value="{Binding Metadata.ChangelogText, Converter={StaticResource NexusDescriptionToPlainTextConverter}, ConverterParameter='No online changelog is available for this mod.'}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</ScrollViewer>
					</Border>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsNotesTemplate" DataType="{x:Type data:DivinityModData}">
				<Grid Margin="18,12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal">
							<c:ReduxIcon Width="18"
								Height="18"
								Margin="0,0,8,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxAccentBrush}"
								StrokeData="{StaticResource Redux.Icon.ScrollText}" />
							<TextBlock VerticalAlignment="Center"
								FontSize="{DynamicResource Redux.FontSize.16}"
								FontWeight="SemiBold"
								Text="Notes" />
						</StackPanel>
						<Button Grid.Column="1"
							MinWidth="76"
							Click="EditPrivateNoteButton_Click">
							<Button.Style>
								<Style BasedOn="{StaticResource ReduxSecondaryActionButtonStyle}" TargetType="{x:Type Button}">
									<Setter Property="Content" Value="Add Note" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasPrivateNote}" Value="True">
											<Setter Property="Content" Value="Edit Note" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</Grid>
					<TextBlock Grid.Row="1"
						Margin="0,3,0,10"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="Stored on this computer unless included in a Redux Modlist."
						TextWrapping="Wrap" />
					<Border Grid.Row="2"
						Padding="12,10"
						Background="{DynamicResource ReduxListInteriorBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
							VerticalScrollBarVisibility="Auto">
							<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								TextWrapping="Wrap">
								<TextBlock.Style>
									<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
										<Setter Property="Text" Value="{Binding PrivateNote, TargetNullValue=''}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding HasPrivateNote}" Value="False">
												<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
												<Setter Property="FontStyle" Value="Italic" />
												<Setter Property="Text" Value="No notes have been added for this mod." />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</ScrollViewer>
					</Border>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsDebugTemplate" DataType="{x:Type data:DivinityModData}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="18,12">
						<TextBlock FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold" Text="Technical mod state" />
						<TextBlock Margin="0,2,0,10" Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="Read-only values used to identify this package and diagnose its current Redux state."
							TextWrapping="Wrap" />
						<UniformGrid Columns="2">
							<Border Margin="0,0,5,8" Padding="11,9" Background="{DynamicResource ReduxListInteriorBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Package identity" />
									<Grid Margin="0,7,0,0">
										<Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="UUID" />
										<TextBlock Grid.Column="1" Text="{Binding UUID}" TextTrimming="CharacterEllipsis" ToolTip="{Binding UUID}" />
										<TextBlock Grid.Row="1" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Folder" />
										<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
										<TextBlock Grid.Row="2" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="PAK" />
										<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
										<TextBlock Grid.Row="3" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Type" />
										<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModType, TargetNullValue=Unknown}" />
										<TextBlock Grid.Row="4" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Publish ID" />
										<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PublishHandle}" />
									</Grid>
								</StackPanel>
							</Border>
							<Border Margin="5,0,0,8" Padding="11,9" Background="{DynamicResource ReduxListInteriorBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Load-order state" />
									<Grid Margin="0,7,0,0">
										<Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Position" />
										<TextBlock Grid.Column="1" Text="{Binding LoadOrderDisplayText}" />
										<TextBlock Grid.Row="1" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Active" />
										<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IsActive}" />
										<TextBlock Grid.Row="2" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Always loaded" />
										<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IsForceLoaded}" />
										<TextBlock Grid.Row="3" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Merged override" />
										<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IsForceLoadedMergedMod}" />
										<TextBlock Grid.Row="4" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Order allowed" />
										<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CanAddToLoadOrder}" />
									</Grid>
								</StackPanel>
							</Border>
							<Border Margin="0,0,5,8" Padding="11,9" Background="{DynamicResource ReduxListInteriorBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Source recognition" />
									<Grid Margin="0,7,0,0">
										<Grid.ColumnDefinitions><ColumnDefinition Width="98" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
										<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Resolved source" />
										<TextBlock Grid.Column="1" Text="{Binding Metadata.SourceLabel}" />
										<TextBlock Grid.Row="1" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Provenance" />
										<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metadata.LinkStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Metadata.LinkStatus}" />
										<TextBlock Grid.Row="2" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Nexus ID" />
										<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NexusModsData.ModId}" />
										<TextBlock Grid.Row="3" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Nexus origin" />
										<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NexusModsData.MetadataOrigin}" />
										<TextBlock Grid.Row="4" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="mod.io ID" />
										<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModioData.ModId}" />
									</Grid>
								</StackPanel>
							</Border>
							<Border Margin="5,0,0,8" Padding="11,9" Background="{DynamicResource ReduxListInteriorBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Classification" />
									<TextBlock Margin="0,7,0,2" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Resolved categories" />
									<ItemsControl ItemsSource="{Binding DisplayCategories}">
										<ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate><Border Margin="0,2,5,2" Padding="7,2" Background="{Binding SoftColor}" CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"><TextBlock Foreground="{Binding Color}" Text="{Binding Name}" /></Border></DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Margin="0,7,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Creator manifest" />
									<TextBlock Text="{Binding CreatorManifest.State}" />
								</StackPanel>
							</Border>
						</UniformGrid>
						<Border Padding="11,9" Background="{DynamicResource ReduxListInteriorBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
							<StackPanel>
								<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Diagnostics and advisor findings" />
								<TextBlock Margin="0,3,0,6" Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="{Binding HealthSnapshot.FindingCountSummary, TargetNullValue='Diagnostics have not run for this mod.'}" />
								<ItemsControl ItemsSource="{Binding HealthSnapshot.Findings}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,3,0,0" Padding="9,6" Background="{DynamicResource ReduxSurfaceMutedBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}">
												<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
													<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding Code}" />
													<StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</DataTemplate>
			<DataTemplate x:Key="ModDetailsTabbedTemplate" DataType="{x:Type data:DivinityModData}">
				<TabControl ItemContainerStyle="{StaticResource ReduxContentTabItemStyle}"
					SelectedIndex="0"
					Style="{StaticResource ReduxContentTabControlStyle}">
					<TabItem Header="Overview">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsOverviewTemplate}" />
					</TabItem>
					<TabItem Header="Description">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsDescriptionTemplate}" />
					</TabItem>
					<TabItem Header="Requirements">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsRequirementsTemplate}" />
					</TabItem>
					<TabItem Header="Files">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsFilesTemplate}" />
					</TabItem>
					<TabItem Header="Debug"
						Visibility="{Binding DataContext.Settings.DebugModeEnabled, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsDebugTemplate}" />
					</TabItem>
					<TabItem Header="Changelog">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsChangelogTemplate}" />
					</TabItem>
					<TabItem Header="Notes">
						<ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModDetailsNotesTemplate}" />
					</TabItem>
				</TabControl>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>
	<UserControl.Style>
		<Style BasedOn="{StaticResource {x:Type UserControl}}" TargetType="UserControl" />
	</UserControl.Style>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition x:Name="ModListsRow" Height="*" MinHeight="180" />
			<RowDefinition x:Name="ModDetailsSplitterRow" Height="0" />
			<RowDefinition x:Name="ModDetailsRow" Height="0" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition x:Name="CategoriesColumn" Width="220" MinWidth="52" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition x:Name="ActiveModsColumn" Width="*" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition x:Name="InactiveModsColumn" Width="*" />
		</Grid.ColumnDefinitions>
		<Border x:Name="CategoriesPanel" Grid.Column="0"
			Margin="10,4,5,10"
			Style="{StaticResource ModSectionCard}">
			<Border.ContextMenu>
				<ContextMenu Opened="CategoriesContextMenu_Opened">
					<MenuItem x:Name="ShowEmptyCategoriesMenuItem"
						Header="Show categories with 0 mods"
						IsCheckable="True"
						Click="ShowEmptyCategoriesMenuItem_Click">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.ListStroke}" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem x:Name="SaveCategoryFilterMenuItem"
						Header="Save filter state between sessions"
						IsCheckable="True"
						Click="SaveCategoryFilterMenuItem_Click">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.Save}" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem x:Name="DisableNewModIndicatorsMenuItem"
						Header="Disable new-mod indicators"
						IsCheckable="True"
						Click="DisableNewModIndicatorsMenuItem_Click">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.Information}" /></MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="Create Custom Category..." Click="AddCustomCategoryMenuItem_Click">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem x:Name="EditCategoryMenuItem" Header="Edit Selected Category..." Click="EditCategoryMenuItem_Click">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.ColorPalette}" /></MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem x:Name="EnableCategoriesMenuItem" Header="Enable / Disable Categories">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.Pricetag}" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem x:Name="DeleteCustomCategoryMenuItem"
						Header="Delete Custom Category"
						util:ReduxMenuItemExtension.UseSemanticHover="True"
						util:ReduxMenuItemExtension.SemanticHoverBrush="{DynamicResource ReduxErrorPillBackground}"
						util:ReduxMenuItemExtension.SemanticRailBrush="{DynamicResource ReduxErrorBrush}">
						<MenuItem.Icon><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" /></MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</Border.ContextMenu>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="1" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
					IsHitTestVisible="False" />
				<Border Grid.Row="1" Style="{StaticResource ModPaneHeaderDividerStyle}" />
				<Grid>
					<Grid.Style>
						<Style BasedOn="{StaticResource ModPaneHeaderStyle}" TargetType="{x:Type Grid}">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsCategoriesExpanded}" Value="False">
									<Setter Property="Margin" Value="3,0" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsCategoriesExpanded}" Value="False">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>
						<TextBlock Style="{StaticResource ModSectionTitle}" Text="Categories">
							<TextBlock.ToolTip>
								<ToolTip MaxWidth="340">
							<TextBlock Text="Category suggestions use available mod information and may need correction."
										TextWrapping="Wrap" />
								</ToolTip>
							</TextBlock.ToolTip>
						</TextBlock>
					</StackPanel>
					<Button Grid.Column="1"
						Click="AddCustomCategoryMenuItem_Click"
						AutomationProperties.Name="Create a custom category">
						<Button.Style>
							<Style BasedOn="{StaticResource ModPaneHeaderActionButtonStyle}" TargetType="{x:Type Button}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsCategoriesExpanded}" Value="False">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<c:ReduxIcon Width="14" Height="14"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
							StrokeData="{StaticResource Redux.Icon.AddStroke}" />
					</Button>
					<ToggleButton Grid.Column="2"
						Width="30"
						Height="28"
						Padding="0"
						IsChecked="{Binding IsCategoriesExpanded, Mode=TwoWay}"
						Style="{StaticResource CategoryPanelToggleStyle}"
						ToolTip="Collapse or expand categories">
						<Path Width="5" Height="10"
							Data="{StaticResource Redux.Icon.ChevronLeftStroke}"
							RenderTransformOrigin="0.5,0.5"
							Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							StrokeEndLineCap="Round"
							StrokeLineJoin="Round"
							StrokeStartLineCap="Round"
							StrokeThickness="1.25"
							Stretch="Fill">
							<Path.RenderTransform>
								<RotateTransform Angle="0" />
							</Path.RenderTransform>
							<Path.Style>
								<Style TargetType="{x:Type Path}">
									<Style.Triggers>
										<!--  Rotate rather than swap geometry so the flip animates smoothly.  -->
										<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="False">
											<DataTrigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
															To="180" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.EnterActions>
											<DataTrigger.ExitActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
															To="0" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.ExitActions>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Path.Style>
						</Path>
					</ToggleButton>
				</Grid>
				<Border Grid.Row="1" Background="{DynamicResource ReduxBorderBrush}" />
				<ListBox x:Name="CategoryListBox" Grid.Row="2"
					Margin="6"
					Padding="0"
					AllowDrop="True"
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding ModCategoryFilters}"
					ItemContainerStyle="{StaticResource ModCategoryListItemStyle}"
					ScrollViewer.CanContentScroll="True"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					ScrollViewer.PanningMode="VerticalOnly"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.ScrollUnit="Item"
					VirtualizingPanel.VirtualizationMode="Recycling"
					util:SmoothLogicalScrollBehavior.IsInteractionSuppressed="{Binding IsDragging}"
					SelectedIndex="0"
					PreviewMouseLeftButtonDown="CategoryListBox_PreviewMouseLeftButtonDown"
					PreviewMouseMove="CategoryListBox_PreviewMouseMove"
					PreviewMouseLeftButtonUp="CategoryListBox_PreviewMouseLeftButtonUp"
					LostMouseCapture="CategoryListBox_LostMouseCapture"
					DragOver="CategoryListBox_DragOver"
					DragLeave="CategoryListBox_DragLeave"
					Drop="CategoryListBox_Drop"
					SelectedValue="{Binding SelectedModCategory, Mode=TwoWay}"
					SelectedValuePath="Name">
					<ListBox.Style>
						<Style TargetType="{x:Type ListBox}">
							<Setter Property="Visibility" Value="Visible" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsCategoriesExpanded}" Value="False">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ListBox.Style>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0" Width="14"
									Height="14"
									Margin="0,0,7,0"
									VerticalAlignment="Center"
									ToolTip="{Binding Name}">
									<Grid.Style>
										<Style TargetType="{x:Type Grid}">
											<Setter Property="Visibility" Value="Visible" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding DataContext.Settings.ShowCategoryIconsInPills, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False">
													<Setter Property="Visibility" Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Grid.Style>
									<!--  Stroke ring, not a filled dot: default markers follow the Lucide stroke icon language.  -->
									<Border Width="{DynamicResource Redux.MarkerSize.Default}"
										Height="{DynamicResource Redux.MarkerSize.Default}"
										CornerRadius="6" BorderThickness="1.5"
										Background="Transparent" BorderBrush="{Binding Color}"
										Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
									<c:ReduxIcon Width="14" Height="14" IconKey="{Binding IconId}" Foreground="{Binding Color}"
										Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
								</Grid>
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<TextBlock VerticalAlignment="Center"
										FontWeight="Medium"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis">
										<TextBlock.Style>
											<Style TargetType="{x:Type TextBlock}">
												<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
												<Style.Triggers>
											<DataTrigger Binding="{Binding DataContext.Settings.UseCategoryColorsForSidebarText, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
												<Setter Property="Foreground" Value="{Binding Color}" />
											</DataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding IsIconOnly}" Value="True" />
													<Condition Binding="{Binding DataContext.Settings.ShowCategoryIconsInPills, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Collapsed" />
											</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Border Width="8"
										Height="8"
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										Background="{DynamicResource ReduxSuccessBrush}"
										CornerRadius="4"
										ToolTip="New mod detected in this category">
										<Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasNewMods}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
										<Border.Effect>
											<DropShadowEffect BlurRadius="8"
												Color="{DynamicResource ReduxSuccessColor}"
												Opacity="0.85"
												ShadowDepth="0" />
										</Border.Effect>
									</Border>
								</StackPanel>
								<Border Grid.Column="2"
									MinWidth="28"
									Margin="8,0,0,0"
									Padding="6,2"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
									<Border.Style>
										<Style TargetType="{x:Type Border}">
											<Setter Property="Background" Value="{DynamicResource ReduxSurfaceMutedBrush}" />
											<Setter Property="BorderBrush" Value="Transparent" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
													<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												</DataTrigger>
												<MultiDataTrigger>
													<MultiDataTrigger.Conditions>
														<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
														<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="False" />
														<Condition Binding="{Binding DataContext.Settings.UseCategoryColorsForInteractions, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
													</MultiDataTrigger.Conditions>
													<Setter Property="Background" Value="{Binding CountHoverColor}" />
												</MultiDataTrigger>
												<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
													<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												</DataTrigger>
												<MultiDataTrigger>
													<MultiDataTrigger.Conditions>
														<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True" />
														<Condition Binding="{Binding DataContext.Settings.UseCategoryColorsForInteractions, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
													</MultiDataTrigger.Conditions>
													<Setter Property="Background" Value="{Binding CountSelectionColor}" />
												</MultiDataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<TextBlock HorizontalAlignment="Center"
										FontSize="{DynamicResource Redux.FontSize.11}"
										FontWeight="SemiBold"
										Text="{Binding Count}">
										<TextBlock.Style>
											<Style TargetType="{x:Type TextBlock}">
												<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding Count}" Value="0">
														<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
														<Setter Property="Opacity" Value="0.72" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
														<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
														<Setter Property="Opacity" Value="1" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Border>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<TextBlock Grid.Row="2"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="{DynamicResource Redux.FontSize.12}"
					FontWeight="SemiBold"
					Foreground="{DynamicResource ReduxTextMutedBrush}"
					IsHitTestVisible="False"
					Text="CATEGORIES">
					<TextBlock.LayoutTransform>
						<RotateTransform Angle="-90" />
					</TextBlock.LayoutTransform>
					<TextBlock.Style>
						<Style TargetType="{x:Type TextBlock}">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsCategoriesExpanded}" Value="False">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>
		</Border>
		<GridSplitter x:Name="CategoriesGridSplitter" Grid.Column="1"
			Width="4"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Style="{StaticResource ReduxVerticalSplitterStyle}"
			Visibility="{Binding IsCategoriesExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
			ShowsPreview="False" />
		<Border Grid.Column="2"
