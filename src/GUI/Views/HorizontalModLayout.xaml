					Background="{DynamicResource ReduxSurfaceMutedBrush}"
					BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
					CanUndoTextOnEscape="True"
					TextAlignment="Left"
					ToolTip="Filter Inactive Mods"
					UpdateBindingOnFocusLost="True" />
				<TextBlock Grid.Column="6"
					Margin="0"
					Padding="4,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ReduxTextMutedBrush}"
					IsHitTestVisible="False"
					Text="Filter Inactive Mods">
					<TextBlock.Style>
						<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Text, ElementName=InactiveModsFilterTextBox}" Value="">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
				<TextBlock x:Name="InactiveModsFilterResultText"
					Grid.Column="3"
					Margin="0,0,8,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					behavior:ScreenReaderHelperBehavior.Name="Total Hidden Inactive Mods"
					AutomationProperties.HelpText="{Binding Text, RelativeSource={RelativeSource Self}}" />
				<TextBlock x:Name="InactiveSelectedText"
					Grid.Column="4"
					Margin="0,0,8,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					behavior:ScreenReaderHelperBehavior.Name="Total Inactive Mods Selected"
					AutomationProperties.HelpText="{Binding Text, RelativeSource={RelativeSource Self}}"
					AutomationProperties.Name="Inactive Mods" />
				<ToggleButton Grid.Column="0"
					Width="30"
					Height="28"
					Padding="0"
					behavior:ScreenReaderHelperBehavior.Name="Collapse or expand inactive mods"
					IsChecked="{Binding IsInactiveModsExpanded, Mode=TwoWay}"
					Style="{StaticResource CategoryPanelToggleStyle}"
					ToolTip="Collapse or expand inactive mods">
					<!--  Right-edge pane: collapse pushes it rightward, so the chevron mirrors the categories pane.  -->
					<Path Width="5" Height="10"
						Data="{StaticResource Redux.Icon.ChevronRightStroke}"
						RenderTransformOrigin="0.5,0.5"
						Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
						StrokeEndLineCap="Round"
						StrokeLineJoin="Round"
						StrokeStartLineCap="Round"
						StrokeThickness="1.25"
						Stretch="Fill">
						<Path.RenderTransform>
							<RotateTransform Angle="0" />
						</Path.RenderTransform>
						<Path.Style>
							<Style TargetType="{x:Type Path}">
								<Style.Triggers>
									<!--  Rotate rather than swap geometry so the flip animates smoothly.  -->
									<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="False">
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
														To="180" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
														To="0" Duration="{StaticResource Redux.Motion.Panel}" EasingFunction="{StaticResource Redux.Motion.PanelEase}" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.ExitActions>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Path.Style>
					</Path>
				</ToggleButton>
			</Grid>
			<Border Grid.Row="1" Background="{DynamicResource ReduxBorderBrush}" />
			<c:ModListView x:Name="InactiveModsListView"
				Grid.Row="2"
				MaxHeight="99999"
				behavior:ScreenReaderHelperBehavior.Name="Inactive Mods"
				dd:DragDrop.DragHandler="{Binding DragHandler}"
				dd:DragDrop.DropHandler="{Binding DropHandler}"
				ContextMenuOpening="ModListView_ContextMenuOpening"
				GridViewColumnHeader.Click="ListView_Click"
				GridViewColumnHeader.PreviewMouseLeftButtonUp="ListViewColumnHeader_PreviewMouseLeftButtonUp"
				GridViewColumnHeader.PreviewMouseRightButtonUp="ListViewColumnHeader_RightClick"
				ItemContainerStyle="{StaticResource ListViewItemMouseEvents}"
				PreviewDragOver="ModListView_PreviewDragOver"
				PreviewDragLeave="ModListView_PreviewDragLeave"
				PreviewDrop="ModListView_PreviewDrop"
				PreviewQueryContinueDrag="ModListView_PreviewQueryContinueDrag"
				ScrollViewer.VerticalScrollBarVisibility="Auto"
				View="{DynamicResource InactiveModGridView}">
				<c:ModListView.Style>
					<Style BasedOn="{StaticResource ModOrderListViewWithDrag}" TargetType="{x:Type c:ModListView}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsInactiveModsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</c:ModListView.Style>
				<c:ModListView.ContextMenu><ContextMenu /></c:ModListView.ContextMenu>
			</c:ModListView>
			<TextBlock Grid.Row="2"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="{DynamicResource Redux.FontSize.12}"
				FontWeight="SemiBold"
				Foreground="{DynamicResource ReduxTextMutedBrush}"
				IsHitTestVisible="False"
				Text="INACTIVE MODS">
				<TextBlock.LayoutTransform>
					<RotateTransform Angle="-90" />
				</TextBlock.LayoutTransform>
				<TextBlock.Style>
					<Style TargetType="{x:Type TextBlock}">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsInactiveModsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Grid>
		</Border>
		<GridSplitter x:Name="ModDetailsGridSplitter"
			Grid.Row="1"
			Grid.ColumnSpan="5"
			Height="6"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			ResizeBehavior="PreviousAndNext"
			ShowsPreview="False"
			Style="{StaticResource ReduxHorizontalSplitterStyle}"
			Visibility="Collapsed" />
		<Border x:Name="ModDetailsPanel"
			Grid.Row="2"
			Grid.ColumnSpan="5"
			Margin="10,0,10,10"
			Visibility="Collapsed">
			<Border.Style>
				<Style BasedOn="{StaticResource ModSectionCard}" TargetType="{x:Type Border}">
					<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
				</Style>
			</Border.Style>
			<Grid>
				<Grid.RowDefinitions>
					<!-- RowDefinition.Height requires a GridLength; a dynamic Double resource throws during XAML load. -->
					<RowDefinition Height="Auto" />
					<RowDefinition Height="1" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
					IsHitTestVisible="False" />
				<Border Grid.Row="1" Style="{StaticResource ModPaneHeaderDividerStyle}" />
				<Grid MinHeight="{DynamicResource Redux.PaneHeaderHeight}" Margin="12,0">
					<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid Width="14" Height="14" Margin="2,0,10,0" VerticalAlignment="Center" ToolTip="Primary mod category">
						<Ellipse Width="{DynamicResource Redux.MarkerSize.Default}"
							Height="{DynamicResource Redux.MarkerSize.Default}"
							Fill="Transparent"
							Stroke="{Binding Content.DisplayCategories[0].Color, ElementName=ModDetailsContent, FallbackValue=#8F879E}" StrokeThickness="1.5">
							<Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Content.DisplayCategories[0].HasIcon, ElementName=ModDetailsContent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
						</Ellipse>
						<c:ReduxIcon Width="14" Height="14"
							IconKey="{Binding Content.DisplayCategories[0].IconId, ElementName=ModDetailsContent}"
							Foreground="{Binding Content.DisplayCategories[0].Color, ElementName=ModDetailsContent, FallbackValue=#8F879E}">
							<c:ReduxIcon.Style><Style BasedOn="{StaticResource {x:Type c:ReduxIcon}}" TargetType="{x:Type c:ReduxIcon}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Content.DisplayCategories[0].HasIcon, ElementName=ModDetailsContent}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></c:ReduxIcon.Style>
						</c:ReduxIcon>
					</Grid>
					<TextBlock Grid.Column="1"
						VerticalAlignment="Center"
						Style="{StaticResource Redux.Text.WindowTitle}"
						FontSize="{DynamicResource Redux.FontSize.15}"
						MaxWidth="420"
						Text="{Binding Content.Metadata.Title, ElementName=ModDetailsContent, TargetNullValue='Selected Mod'}"
						TextTrimming="CharacterEllipsis" />
					<ContentControl Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
						Content="{Binding Content, ElementName=ModDetailsContent}"
						ContentTemplate="{StaticResource ModDetailsCategoryTemplate}" />
					<Border Grid.Column="3"
						DataContext="{Binding Content, ElementName=ModDetailsContent}"
						Style="{StaticResource ModDetailsHealthIndicatorStyle}"
						Tag="{Binding Content.HealthSnapshot, ElementName=ModDetailsContent}"
						Visibility="{Binding Content.HealthSnapshot.NeedsAttention, ElementName=ModDetailsContent, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
						<Border.ToolTip>
							<ToolTip Style="{StaticResource ReduxRichToolTipStyle}">
								<Border Style="{StaticResource ReduxStatusCardChromeStyle}">
									<ItemsControl
										ItemsSource="{Binding PlacementTarget.Tag.AttentionFindings, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
										ItemTemplate="{StaticResource ReduxStatusFindingTemplate}" />
								</Border>
							</ToolTip>
						</Border.ToolTip>
						<StackPanel Orientation="Horizontal">
							<c:ReduxIcon Width="{DynamicResource Redux.StatusPill.IconSize}"
								Height="{DynamicResource Redux.StatusPill.IconSize}"
								IconKey="search-alert"
								Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}">
								<c:ReduxIcon.Style>
									<Style BasedOn="{StaticResource {x:Type c:ReduxIcon}}" TargetType="{x:Type c:ReduxIcon}">
										<Setter Property="Margin" Value="0,0,5,0" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding ShowInterfaceIcons}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding UseIconsOnly}" Value="True" />
													<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
												</MultiDataTrigger.Conditions>
												<Setter Property="Margin" Value="0" />
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</c:ReduxIcon.Style>
							</c:ReduxIcon>
							<TextBlock VerticalAlignment="Center" FontWeight="Medium"
								FontSize="{DynamicResource Redux.FontSize.11}"
								Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
								Text="{Binding HealthSnapshot.StatusTitle}">
								<TextBlock.Style>
									<Style TargetType="{x:Type TextBlock}">
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding UseIconsOnly}" Value="True" />
													<Condition Binding="{Binding ShowInterfaceIcons}" Value="True" />
												</MultiDataTrigger.Conditions>
												<Setter Property="Visibility" Value="Collapsed" />
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</StackPanel>
					</Border>
					<Border Grid.Column="4" MaxWidth="360" Margin="6,0,8,0"
						HorizontalAlignment="Left" VerticalAlignment="Center"
						Style="{StaticResource ModDetailsMetadataChipStyle}"
						ToolTip="{Binding Content.FileName, ElementName=ModDetailsContent}">
						<TextBlock FontSize="{DynamicResource Redux.FontSize.11}" Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding Content.FileName, ElementName=ModDetailsContent, TargetNullValue='Local package'}"
							TextTrimming="CharacterEllipsis" />
					</Border>
					<ToggleButton x:Name="ModDetailsToggleButton"
						Grid.Column="5"
						VerticalAlignment="Center"
						IsChecked="{Binding IsModDetailsExpanded, Mode=TwoWay}"
						Style="{StaticResource ModDetailsToggleStyle}"
						ToolTip="Collapse or expand mod details" />
				</Grid>
				<Border Grid.Row="1"
					Background="{DynamicResource ReduxBorderBrush}"
					IsHitTestVisible="False" />
				<ContentControl x:Name="ModDetailsContent"
					Grid.Row="2"
					ContentTemplate="{StaticResource ModDetailsTabbedTemplate}" />
			</Grid>
		</Border>
	</Grid>
</local:HorizontalModLayoutBase>
