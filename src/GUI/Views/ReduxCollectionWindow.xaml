<adonis:AdonisWindow x:Class="DivinityModManager.Views.ReduxCollectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adonis="clr-namespace:AdonisUI.Controls;assembly=AdonisUI" xmlns:c="clr-namespace:DivinityModManager.Controls"
 Title="Nexus Collection" Width="1040" Height="660" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{DynamicResource ReduxWindowBrush}" Template="{DynamicResource ReduxWindowTemplate}"
 FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MainResourceDictionary.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <c:ReduxWindowTitleBar IconSource="/Redux;component/Resources/Icons/Platforms/nexus.png"/>
 <Grid Grid.Row="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="Heading" Text="Add a Nexus collection" Style="{StaticResource ReduxWindowHeadingStyle}" TextWrapping="Wrap"/>
 <Grid Grid.Row="1" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBox x:Name="LinkBox" MinHeight="34" VerticalContentAlignment="Center" AutomationProperties.Name="Nexus collection link" ToolTip="Paste a Baldur's Gate 3 collection link"/>
 <Button Grid.Column="1" x:Name="PreviewButton" Margin="8,0,0,0" Click="Preview_Click" Style="{StaticResource ReduxMinorNexusActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.LinkStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="{loc:Text Import_2cff9baa}"/></StackPanel></Button>
 <Button Grid.Column="2" x:Name="RecentButton" Visibility="Collapsed" Click="Recent_Click" Margin="8,0,0,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" ToolTip="Resume a recently imported collection with its saved file choices."><Button.ContextMenu><ContextMenu Style="{StaticResource ReduxContextMenuStyle}" ItemContainerStyle="{StaticResource ReduxPopupMenuItemStyle}"/></Button.ContextMenu><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Clock}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Recent collections"/></StackPanel></Button></Grid>
 <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,0,0,12" Text="Choose which files to download. Installation stays in Download Manager." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel><WrapPanel Margin="0,0,0,8">
 <Button x:Name="SelectAllButton" ToolTip="Select all available files in the current filtered view." Click="SelectAll_Click" IsEnabled="False" Margin="0,0,8,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Check}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Select All"/></StackPanel></Button>
 <Button x:Name="DeselectAllButton" ToolTip="Deselect files in the current filtered view. Hidden selections are kept." Click="DeselectAll_Click" IsEnabled="False" Margin="0,0,8,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Deselect All"/></StackPanel></Button>
 <Button x:Name="ResetButton" Click="Reset_Click" IsEnabled="False" Margin="0,0,0,4" ToolTip="Select required files that are not already installed. Optional, installed, queued, and unavailable files stay unchecked." Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Reset to Defaults"/></StackPanel></Button>
 <Button x:Name="SaveOrderButton" ToolTipService.ShowOnDisabled="True" IsEnabled="False" Click="SaveOrder_Click" Margin="8,0,0,4" Style="{StaticResource ReduxMinorActionButtonStyle}" ToolTip="Save the collection’s BG3 load order to your saved load orders, if provided. Select it later from the main window’s Load Order dropdown. Saving does not activate or apply it."><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Save}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Save Load Order"/></StackPanel></Button>
<Button Click="BrowseCollections_Click" Margin="8,0,0,4" Style="{StaticResource ReduxMinorNexusActionButtonStyle}"><StackPanel Orientation="Horizontal"><Image Source="/Redux;component/Resources/Icons/Platforms/nexus.png" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Open collections page"/></StackPanel></Button>
 </WrapPanel></StackPanel>
 <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Grid Margin="0,0,8,0"><TextBox x:Name="SearchBox" MaxLength="200" MinHeight="32" VerticalContentAlignment="Center" TextChanged="FilterChanged" AutomationProperties.Name="Search collection files" ToolTip="Search mod names, filenames, authors, categories, or versions."/><TextBlock Text="Search collection files…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ReduxTextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
 <ComboBox x:Name="FilterBox" Grid.Column="1" Width="160" MinHeight="32" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filter collection files"><ComboBoxItem Content="All files" Tag="All"/><ComboBoxItem Content="Missing" Tag="Missing"/><ComboBoxItem Content="Installed" Tag="Installed"/><ComboBoxItem Content="Unverified" Tag="Unverified"/><ComboBoxItem Content="Needs attention" Tag="NeedsAttention"/></ComboBox>
 <Button Grid.Column="2" x:Name="ClearFiltersButton" Click="ClearFilters_Click" Margin="8,0,0,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" ToolTip="Clear search and filters"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="VisibleFilesText" Text="0 files"/></StackPanel></Button>
 </Grid>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.6*" MinWidth="220"/></Grid.ColumnDefinitions>
 <ListBox Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" Padding="6" ItemContainerStyle="{StaticResource ReduxManagerSelectableItemStyle}" x:Name="FilesList" SelectionChanged="Files_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Collection files">
 <ListBox.Resources><Thickness x:Key="Redux.Manager.RowPadding">10,6</Thickness></ListBox.Resources><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" Style="{StaticResource ReduxCheckBoxStyle}"/>
 <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Style="{StaticResource ReduxManagerRowTitleStyle}"/><TextBlock Text="{Binding RowDetails}" Margin="0,3,0,0" Style="{StaticResource ReduxManagerMetadataStyle}"/></StackPanel>
 </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
 <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Style="{StaticResource ReduxManagerPaneSplitterStyle}" AutomationProperties.Name="Resize collection list and details"/>
 <Border Grid.Column="2" Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" Padding="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock x:Name="DetailsPlaceholder" Text="Select a file to see its details." Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap"/>
 <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
 <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource Redux.FontSize.14}" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding File.FileName}" Margin="0,8,0,0" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding AuthorCategory}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/><TextBlock Text="{Binding File.Summary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding VersionText}" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <TextBlock Text="{Binding SizeText}" Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <TextBlock Text="{Binding InstalledLocation}" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <TextBlock Text="{Binding SelectionNote}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <Button IsEnabled="{Binding HasSource}" Click="Source_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource ReduxMinorNexusActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.LinkStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="View on Nexus"/></StackPanel></Button>
 </StackPanel>
 <TextBlock Text="About this collection" Margin="0,20,0,8" FontWeight="SemiBold"/>
 <Image x:Name="CollectionImage" Visibility="Collapsed" MaxHeight="160" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"/>
 <TextBlock x:Name="CollectionSummary" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 </StackPanel></ScrollViewer></Border>
 </Grid></Grid>
 <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
 <TextBlock Text="Free accounts authorize each file on Nexus. Install downloaded files in Download Manager." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}"/>
 <Grid x:Name="DownloadGuidePanel" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock x:Name="DownloadGuideText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="NextFileButton" Click="NextFile_Click" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ReduxMinorNexusActionButtonStyle}" ToolTip="Open the next file that needs Nexus authorization. Choose Mod Manager Download there, then return here for the next file."><StackPanel Orientation="Horizontal"><c:ReduxIcon StrokeData="{StaticResource Redux.Icon.LinkStroke}" Width="14" Height="14" Margin="0,0,6,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="NextFileLabel" Text="Download next file"/></StackPanel></Button>
 <Button x:Name="RetryFailedButton" Visibility="Collapsed" Click="RetryFailed_Click" Margin="12,6,0,0" Style="{StaticResource ReduxMinorWarningActionButtonStyle}" ToolTip="Retry eligible failed downloads for this collection, including hidden rows. Installation failures still require review in Download Manager."><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="RetryFailedLabel" Text="Retry failed downloads"/></StackPanel></Button></StackPanel>
 </Grid></StackPanel>
 <DockPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="SelectionText" Text="No files selected" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
 <Button x:Name="DownloadButton" IsEnabled="False" Click="Download_Click" Margin="0,0,8,0" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Download selected"/></StackPanel></Button>
 <Button Click="Close_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="{loc:Text Close_7d9eb7ac}"/></StackPanel></Button>
 </StackPanel></DockPanel></Grid></Grid></Grid>
</adonis:AdonisWindow>
