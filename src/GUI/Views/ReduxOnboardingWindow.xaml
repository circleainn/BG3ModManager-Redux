									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.LinkStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
									<TextBlock Text="Connect mod services" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
								</Grid>
							</CheckBox>
							<TextBlock Text="Get mod details and update information from Nexus Mods and mod.io." Style="{StaticResource WelcomeCaptionStyle}"/>
							<Border x:Name="SourceCredentialsPanel" Visibility="Collapsed" Margin="0,16,0,0" Padding="16" Background="{DynamicResource ReduxSurfaceBrush}" CornerRadius="8">
								<StackPanel>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition/>
											<ColumnDefinition Width="16"/>
											<ColumnDefinition/>
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<Grid Margin="0,0,0,7">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
												</Grid.ColumnDefinitions>
												<ContentControl Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
												<TextBlock Text="Nexus Mods API key" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
											</Grid>
											<PasswordBox x:Name="NexusApiKeyTextBox" AutomationProperties.Name="Nexus Mods API key" MinHeight="34"/>
										</StackPanel>
										<StackPanel Grid.Column="2">
											<Grid Margin="0,0,0,7">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
												</Grid.ColumnDefinitions>
												<ContentControl Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" ContentTemplate="{DynamicResource ModioPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
												<TextBlock Text="mod.io API key (optional)" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
											</Grid>
											<PasswordBox x:Name="ModioApiKeyTextBox" AutomationProperties.Name="mod.io API key (optional)" MinHeight="34"/>
										</StackPanel>
									</Grid>
									<TextBlock Text="Keys stay on this computer. Change them in Preferences." Style="{StaticResource WelcomeCaptionStyle}"/>
									<CheckBox x:Name="NxmLinksCheckBox" Style="{StaticResource ReduxCheckBoxStyle}" Margin="0,16,0,0">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>
											<ContentControl Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
											<TextBlock x:Name="NxmLinksLabel" Text="Open Nexus download links in Redux" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
										</Grid>
									</CheckBox>
									<TextBlock Text="A Nexus API key is required for downloads." Style="{StaticResource WelcomeCaptionStyle}"/>
								</StackPanel>
							</Border>
						</StackPanel>
						<StackPanel x:Name="OptionsPage" Visibility="Collapsed">
							<Border Background="{DynamicResource ReduxSurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
								<StackPanel>
									<Grid Margin="18,14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="Your load order" FontWeight="SemiBold"/>
										<TextBlock Grid.Column="1" Text="PRACTICE" Foreground="{DynamicResource ReduxTextMutedBrush}"/>
									</Grid>
									<Border Background="{DynamicResource ReduxBorderBrush}" Height="1"/>
									<Grid Margin="18,12,18,14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition/>
											<ColumnDefinition Width="32"/>
											<ColumnDefinition/>
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="Inactive" Foreground="{DynamicResource ReduxTextMutedBrush}" Margin="0,0,0,12"/>
											<Border Style="{StaticResource WelcomeFeatureCardStyle}" MinHeight="70">
												<StackPanel>
													<controls:ReduxIcon Width="22" Height="22" StrokeData="{DynamicResource Redux.Icon.Archive}" Foreground="{DynamicResource ReduxAccentHoverBrush}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
													<TextBlock x:Name="DemoInactiveText" Text="Example mod" TextWrapping="Wrap"/>
												</StackPanel>
											</Border>
										</StackPanel>
										<controls:ReduxIcon Width="18" Height="18" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
										<StackPanel Grid.Column="2">
											<TextBlock Text="Active" Foreground="{DynamicResource ReduxTextMutedBrush}" Margin="0,0,0,12"/>
											<Border Style="{StaticResource WelcomeFeatureCardStyle}" MinHeight="70">
												<StackPanel>
													<controls:ReduxIcon Width="22" Height="22" StrokeData="{DynamicResource Redux.Icon.ReorderStroke}" Foreground="{DynamicResource ReduxAccentHoverBrush}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
													<TextBlock x:Name="DemoActiveText" Text="No active mods" TextWrapping="Wrap"/>
												</StackPanel>
											</Border>
										</StackPanel>
									</Grid>
									<Border Background="{DynamicResource ReduxSurfaceElevatedBrush}" Padding="18,14" CornerRadius="0,0,10,10">
										<StackPanel>
											<TextBlock x:Name="DemoProgressText" Text="01 / Activate" Foreground="{DynamicResource ReduxAccentHoverBrush}" FontWeight="SemiBold"/>
											<TextBlock x:Name="DemoInstructionText" Text="Installed mods start here. Move one to Active to use it." TextWrapping="Wrap" Margin="0,6,0,10"/>
											<Button x:Name="DemoActionButton" Click="DemoAction_Click" HorizontalAlignment="Left" Style="{StaticResource ReduxPrimaryActionButtonStyle}">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
													</Grid.ColumnDefinitions>
													<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" x:Name="DemoActionIcon" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
													<TextBlock x:Name="DemoActionLabel" Text="Activate mod" Grid.Column="1" VerticalAlignment="Center"/>
												</Grid>
											</Button>
										</StackPanel>
									</Border>
								</StackPanel>
							</Border>
							<CheckBox x:Name="GuidanceCheckBox" Style="{StaticResource ReduxCheckBoxStyle}" Checked="GuidanceCheckBox_Changed" Unchecked="GuidanceCheckBox_Changed" Margin="0,18,0,0" ToolTip="Offers suggestions for active mods. You review changes before applying them.">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.Flag}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
									<TextBlock Text="Enable Load Order Advisor (experimental)" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
								</Grid>
							</CheckBox>
							<CheckBox x:Name="RetainArchivesCheckBox" Style="{StaticResource ReduxCheckBoxStyle}" Margin="0,10,0,0" ToolTip="Uses additional disk space. Off by default.">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.Archive}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
									<TextBlock Text="Keep installed archives for reinstalling" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
								</Grid>
							</CheckBox>
							<Expander x:Name="BeforePlayExpander" Header="Before you play" Style="{StaticResource WelcomeDetailsStyle}" Expanded="BeforePlayExpansion_Changed" Collapsed="BeforePlayExpansion_Changed" Margin="0,8,0,0">
								<TextBlock Margin="4,8" Text="Install each mod’s requirements, check Mod Diagnostics, then sync your order. Keep the same mod setup when returning to an existing save." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
							</Expander>
						</StackPanel>
						<StackPanel x:Name="OrganizePage" Visibility="Collapsed">
<Border Style="{StaticResource WelcomeFeatureCardStyle}" Margin="0,0,0,12">
<StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,8"><controls:ReduxIcon Width="18" Height="18" Margin="0,0,8,0" StrokeData="{DynamicResource Redux.Icon.Layers}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock Text="Categories find. Separators organize." FontWeight="SemiBold"/></StackPanel>
<TextBlock Text="Create custom categories in the sidebar and assign them to mods. Click a category to filter both panes; click the filtered-view notice to show everything again." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
<TextBlock Text="Use + beside Active or Inactive Mods to add a separator. Give it a name, color, and icon, then drag it into place. Collapse sections to keep long lists readable." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Margin="0,10,0,0"/>
</StackPanel>
</Border>
<Border Style="{StaticResource WelcomeFeatureCardStyle}">
<StackPanel>
<CheckBox x:Name="StarterSeparatorsCheckBox" Style="{StaticResource ReduxCheckBoxStyle}"><TextBlock Text="Start with a few sections" FontWeight="SemiBold"/></CheckBox>
<TextBlock Text="Choose the separators to add to the end of Active Mods when you finish setup." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
<UniformGrid x:Name="StarterSeparatorsPreview" Columns="3" IsEnabled="{Binding IsChecked, ElementName=StarterSeparatorsCheckBox}"/>
<TextBlock Text="Your mods stay in place. Existing names are skipped. Rename or delete any section later." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"/>
</StackPanel>
</Border>
<TextBlock Text="These are labels, not a recommended load order. Follow each mod’s installation instructions." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"/>
</StackPanel>
<StackPanel x:Name="ManagersPage" Visibility="Collapsed">
							<Grid Margin="0,0,0,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="12"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Button x:Name="SaveTourButton" Tag="save" Click="ManagerTourSelection_Click" Style="{StaticResource WelcomeCurrentStepStyle}">
									<StackPanel Orientation="Horizontal">
										<controls:ReduxIcon Width="20" Height="20" Margin="0,0,8,0" StrokeData="{DynamicResource Redux.Icon.Save}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
										<TextBlock Text="Save games" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
								<Button x:Name="NativeTourButton" Grid.Column="2" Tag="native" Click="ManagerTourSelection_Click" Style="{StaticResource WelcomeStepStyle}">
									<StackPanel Orientation="Horizontal">
										<controls:ReduxIcon Width="20" Height="20" Margin="0,0,8,0" StrokeData="{DynamicResource Redux.Icon.Shield}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
										<TextBlock Text="Native mods" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							</Grid>
							<Border Background="{DynamicResource ReduxSurfaceBrush}" CornerRadius="10" Padding="18">
