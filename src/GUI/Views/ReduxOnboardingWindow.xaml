									</StackPanel>
								</Border>
							</Grid>
							<CheckBox x:Name="SourceIntegrationsCheckBox" Style="{StaticResource ReduxCheckBoxStyle}" Checked="SourceIntegrationsCheckBox_Changed" Unchecked="SourceIntegrationsCheckBox_Changed">
