										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="40"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>
										<Border Style="{StaticResource WelcomeFeatureCardStyle}">
											<StackPanel>
												<controls:ReduxIcon x:Name="TourFileIcon" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,10" Foreground="{DynamicResource ReduxAccentHoverBrush}" StrokeData="{DynamicResource Redux.Icon.Save}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
												<TextBlock x:Name="TourFileName" Text="Example save.zip" TextWrapping="Wrap" FontWeight="SemiBold"/>
												<TextBlock x:Name="TourFileDescription" Text="A save file, folder, or ZIP" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
											</StackPanel>
										</Border>
										<controls:ReduxIcon Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
										<Border Grid.Column="2" Style="{StaticResource WelcomeFeatureCardStyle}">
											<StackPanel>
												<controls:ReduxIcon x:Name="TourDestinationIcon" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,10" Foreground="{DynamicResource ReduxAccentHoverBrush}" StrokeData="{DynamicResource Redux.Icon.FolderOpen}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
												<TextBlock x:Name="TourDestination" Text="Save Game Manager" FontWeight="SemiBold" TextWrapping="Wrap"/>
												<TextBlock x:Name="TourResult" Text="Ready for your save" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
											</StackPanel>
										</Border>
									</Grid>
									<TextBlock x:Name="TourExplanation" Text="Drop a save file, folder, or ZIP into Redux." Margin="0,14,0,12" TextWrapping="Wrap"/>
									<Button ToolTip="Practice only. No files are changed." x:Name="TourActionButton" Click="ManagerTourAction_Click" HorizontalAlignment="Left" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.Download}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
											<TextBlock x:Name="TourActionLabel" Text="Preview import"/>
										</StackPanel>
									</Button>
								</StackPanel>
							</Border>
							<Border Style="{StaticResource WelcomeFeatureCardStyle}" Margin="0,12,0,0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top" StrokeData="{DynamicResource Redux.Icon.FolderOpen}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
									<StackPanel Grid.Column="1">
										<TextBlock x:Name="TourLocation" Text="Saves → Manage" FontWeight="SemiBold" TextWrapping="Wrap"/>
										<TextBlock x:Name="TourTip" Text="Browse, import, and open the selected profile’s saves." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
									</StackPanel>
								</Grid>
							</Border>
							<CheckBox x:Name="OpenDownloadsCheckBox" IsChecked="True" Margin="0,12,0,0" Style="{StaticResource ReduxCheckBoxStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.Download}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
									<TextBlock Text="Open Download Manager when I finish" TextWrapping="Wrap" Grid.Column="1" VerticalAlignment="Center"/>
								</Grid>
							</CheckBox>
						</StackPanel>
					</Grid>
				</ScrollViewer>
				<Grid Grid.Row="2" Margin="0,20,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<Button x:Name="NotNowButton" Click="CloseButton_Click" HorizontalAlignment="Left" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
