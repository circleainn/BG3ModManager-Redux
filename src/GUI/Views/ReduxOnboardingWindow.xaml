								</Border>
								<Border Grid.Column="2" Style="{StaticResource WelcomeFeatureCardStyle}" Padding="18">
									<StackPanel>
										<Viewbox Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,14" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
											<ContentControl Width="16" Height="16" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}"/>
										</Viewbox>
										<TextBlock Text="Download from Nexus" Style="{StaticResource WelcomeSectionTitleStyle}" TextWrapping="Wrap"/>
