							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.Close}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
							<TextBlock Text="Set up later" Grid.Column="1" VerticalAlignment="Center"/>
						</Grid>
					</Button>
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button x:Name="BackButton" Click="BackButton_Click" Visibility="Collapsed" Margin="0,0,8,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.ChevronLeftStroke}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
								<TextBlock Text="Back" Grid.Column="1" VerticalAlignment="Center"/>
							</Grid>
						</Button>
						<Button x:Name="SaveContinueButton" Click="SaveButton_Click" IsDefault="True" MinWidth="110" Style="{StaticResource ReduxPrimaryActionButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock x:Name="ContinueLabel" Text="Continue"/>
								<controls:ReduxIcon x:Name="ContinueIcon" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
