<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxRestorePointsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:models="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="{loc:Text Load_Order_History_0bf5a079}"
	Width="980" Height="680" MinWidth="820" MinHeight="560" MaxWidth="1260" MaxHeight="900"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FocusManager.FocusedElement="{Binding ElementName=RestorePointList}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}"
	UseLayoutRounding="True"
	SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="RestorePointItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,7" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="ItemChrome"
								Background="{DynamicResource ReduxSurfaceElevatedBrush}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
								ClipToBounds="True">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="4" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border x:Name="ItemRail" Background="Transparent" />
									<ContentPresenter Grid.Column="1" Margin="12,10" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="ItemRail" Property="Background" Value="{DynamicResource ReduxAccentHoverBrush}" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ReduxSelectionBrush}" />
									<Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="ItemRail" Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<DataTemplate x:Key="RestorePointTemplate">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Border Width="36" Height="36" Margin="0,0,11,0"
						VerticalAlignment="Center"
						Background="{DynamicResource ReduxAccentPillBackground}"
						CornerRadius="8"
						Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
						<controls:ReduxIcon Width="17" Height="17"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxAccentHoverBrush}"
							StrokeData="{StaticResource Redux.Icon.ScrollText}" />
					</Border>
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Text="{Binding CreatedSummary}" />
						<TextBlock Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Reason}"
							TextTrimming="CharacterEllipsis" />
						<TextBlock Margin="0,2,0,0"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{loc:FormatText Key=Source_order_0_b9e32e00, Path=SourceOrderName}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<Border Grid.Column="2" Margin="12,0,0,0" Padding="9,4"
						VerticalAlignment="Center"
						Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
						<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Text="{Binding ModCountSummary}" />
					</Border>
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="HistoryChangeTemplate">
				<Border Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
					ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border x:Name="ChangeRail" Background="{DynamicResource ReduxInfoBrush}" />
						<controls:ReduxIcon x:Name="ChangeIcon"
							Grid.Column="1" Width="16" Height="16" Margin="11,0,9,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxInfoBrush}"
							StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
						<StackPanel Grid.Column="2" Margin="0,8">
							<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="{Binding Name}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock x:Name="ChangeKindText" Margin="0,2,0,0"
								Foreground="{DynamicResource ReduxInfoBrush}"
								Text="{Binding ChangeSummary}" />
						</StackPanel>
						<TextBlock Grid.Column="3" Margin="12,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding PositionSummary}" />
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Activated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.AddStroke}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Deactivated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.RemoveCircle}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ScrollText}" />
		<Border Grid.Row="1"
			Padding="18,14"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock Style="{StaticResource ReduxWindowHeadingStyle}" Text="{loc:Text Load_order_history_e9129373}" />
						<TextBlock Margin="0,5,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{loc:Text Restore_an_earlier_order_Sync_separately_to_apply_it_to_the__7bc6b78d}"
							TextWrapping="Wrap" />
					</StackPanel>
					<Button Grid.Column="1"
						MinWidth="126"
						Margin="18,0,0,0"
						VerticalAlignment="Center"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CompareOrdersButton_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.SwapHorizontalStroke}" /><TextBlock Text="{loc:Text Compare_Orders_2ea68b57}" /></StackPanel>
					</Button>
				</Grid>

				<Grid Grid.Row="1" Margin="0,12,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="320" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
						ClipToBounds="True">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Grid Margin="12,9,9,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel VerticalAlignment="Center">
									<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
										FontWeight="{DynamicResource Redux.FontWeight.Control}"
										Text="{loc:Text Snapshots_f187f78e}" />
									<TextBlock x:Name="SnapshotCountText" Margin="0,2,0,0"
										Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="{loc:Text 0_saved_5b74b091}" />
								</StackPanel>
								<Button x:Name="CreateButton"
									Grid.Column="1"
									MinWidth="88"
									Style="{StaticResource ReduxSecondaryActionButtonStyle}"
									Click="CreateButton_Click">
									<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.AddCircle}" /><TextBlock Text="{loc:Text Capture_1900b478}" /></StackPanel>
								</Button>
							</Grid>
							<ListBox x:Name="RestorePointList"
								Grid.Row="1"
								Margin="6"
								Padding="0"
								Background="Transparent"
								BorderThickness="0"
								HorizontalContentAlignment="Stretch"
								ItemContainerStyle="{StaticResource RestorePointItemStyle}"
								ItemTemplate="{StaticResource RestorePointTemplate}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Auto"
								SelectionChanged="RestorePointList_SelectionChanged"
								MouseDoubleClick="RestorePointList_MouseDoubleClick" />
							<StackPanel x:Name="EmptyState"
								Grid.Row="1"
								Margin="18"
								HorizontalAlignment="Center" VerticalAlignment="Center">
								<controls:ReduxIcon Width="28" Height="28"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
									StrokeData="{StaticResource Redux.Icon.ScrollText}" />
								<TextBlock Margin="0,9,0,0"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									FontWeight="{DynamicResource Redux.FontWeight.Control}"
									Text="{loc:Text No_snapshots_yet_168e5187}" />
								<TextBlock Margin="0,3,0,0"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="{loc:Text Capture_the_working_order_or_sync_a_load_order_to_begin_61a025e3}"
									TextAlignment="Center"
									TextWrapping="Wrap" />
							</StackPanel>
						</Grid>
					</Border>

					<Border Grid.Column="2"
						Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
						ClipToBounds="True">
						<Grid Margin="14,12">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock x:Name="SelectedCreatedText"
										Foreground="{DynamicResource ReduxTextPrimaryBrush}"
										FontSize="{DynamicResource Redux.FontSize.16}"
										FontWeight="{DynamicResource Redux.FontWeight.Title}"
										Text="{loc:Text Select_a_snapshot_a6f67f35}" />
									<TextBlock x:Name="SelectedReasonText" Margin="0,4,0,0"
										Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="{loc:Text Choose_a_snapshot_to_review_its_changes_fbab5155}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<Border Grid.Column="1"
									Margin="12,0,0,0"
									Padding="9,4"
									VerticalAlignment="Center"
									Background="{DynamicResource ReduxSurfaceElevatedBrush}"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
									<TextBlock x:Name="SelectedModCountText"
										Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										FontWeight="{DynamicResource Redux.FontWeight.Control}"
										Text="{loc:Text 0_mods_772b55b7}" />
								</Border>
							</Grid>

							<TextBlock x:Name="SelectedSourceText"
								Grid.Row="1"
								Margin="0,5,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{loc:Text Source_order_77a9f139}"
								TextTrimming="CharacterEllipsis" />

							<UniformGrid Grid.Row="2" Margin="0,10,0,9" Columns="3">
								<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxSuccessPillBackground}" CornerRadius="8"
											Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
											<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxSuccessBrush}" StrokeData="{StaticResource Redux.Icon.AddStroke}" />
										</Border>
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock x:Name="AddedCountText"
											FontSize="{DynamicResource Redux.FontSize.20}"
											FontWeight="{DynamicResource Redux.FontWeight.Title}"
											Foreground="{DynamicResource ReduxSuccessBrush}"
											Text="0" />
										<TextBlock Margin="0,2,0,0"
											Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											Text="{loc:Text Added_since_06fefec1}" />
										</StackPanel>
									</Grid>
								</Border>
								<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxErrorPillBackground}" CornerRadius="8"
											Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
											<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxErrorBrush}" StrokeData="{StaticResource Redux.Icon.RemoveCircle}" />
										</Border>
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock x:Name="RemovedCountText"
											FontSize="{DynamicResource Redux.FontSize.20}"
											FontWeight="{DynamicResource Redux.FontWeight.Title}"
											Foreground="{DynamicResource ReduxErrorBrush}"
											Text="0" />
										<TextBlock Margin="0,2,0,0"
											Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											Text="{loc:Text Removed_since_50818b6e}" />
										</StackPanel>
									</Grid>
								</Border>
								<Border Margin="0" Style="{StaticResource ReduxDialogSummaryCardStyle}">
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxInfoPillBackground}" CornerRadius="8"
											Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
											<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
										</Border>
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock x:Name="MovedCountText"
											FontSize="{DynamicResource Redux.FontSize.20}"
											FontWeight="{DynamicResource Redux.FontWeight.Title}"
											Foreground="{DynamicResource ReduxInfoBrush}"
											Text="0" />
										<TextBlock Margin="0,2,0,0"
											Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											Text="{loc:Text Repositioned_13080dee}" />
										</StackPanel>
									</Grid>
								</Border>
							</UniformGrid>

							<Grid Grid.Row="3">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<Grid Margin="2,0,2,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
										FontWeight="{DynamicResource Redux.FontWeight.Control}"
										Text="{loc:Text Changes_to_the_current_working_order_c39a6f35}" />
									<TextBlock x:Name="DifferenceCountText"
										Grid.Column="1"
										Foreground="{DynamicResource ReduxTextMutedBrush}"
										Text="{loc:Text 0_changes_93238d7a}" />
								</Grid>
								<Grid Grid.Row="1">
									<ListBox x:Name="ChangeList"
										Padding="0"
										Background="Transparent"
										BorderThickness="0"
										HorizontalContentAlignment="Stretch"
										ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}"
										ItemTemplate="{StaticResource HistoryChangeTemplate}"
										ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										ScrollViewer.VerticalScrollBarVisibility="Auto" />
									<StackPanel x:Name="NoChangesState"
										HorizontalAlignment="Center" VerticalAlignment="Center">
										<controls:ReduxIcon Width="28" Height="28"
											HorizontalAlignment="Center"
											Foreground="{DynamicResource ReduxSuccessBrush}"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											StrokeData="{StaticResource Redux.Icon.Check}" />
										<TextBlock Margin="0,9,0,0"
											HorizontalAlignment="Center"
											Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											FontWeight="{DynamicResource Redux.FontWeight.Control}"
											Text="{loc:Text The_current_order_matches_this_snapshot_de785a94}" />
									</StackPanel>
								</Grid>
							</Grid>
						</Grid>
					</Border>
				</Grid>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,7,0"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							Foreground="{DynamicResource ReduxTextMutedBrush}" IconKey="info" />
						<TextBlock x:Name="StatusText" Grid.Column="1"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
							Text="{loc:Text The_20_newest_snapshots_are_kept_for_each_profile_9830923d}" />
					</Grid>
					<Button x:Name="DeleteButton"
						Grid.Column="1"
						MinWidth="74"
						Margin="12,0,8,0"
						IsEnabled="False"
						Style="{StaticResource ReduxMinorDestructiveActionButtonStyle}"
						Click="DeleteButton_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Trash}" /><TextBlock Text="{loc:Text Delete_e2d0a549}" /></StackPanel>
					</Button>
					<Button Grid.Column="2" MinWidth="84" Margin="0,0,8,0"
						IsCancel="True"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CloseButton_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Close_7d9eb7ac}" /></StackPanel>
					</Button>
					<Button x:Name="LoadButton" Grid.Column="3" MinWidth="150"
						IsDefault="True"
						IsEnabled="False"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}"
						Click="LoadButton_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Undo}" /><TextBlock Text="{loc:Text Load_Working_Order_72a053e5}" /></StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
