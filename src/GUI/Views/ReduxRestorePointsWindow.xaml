<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxRestorePointsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Restore Points"
	Width="640" Height="520" MinWidth="540" MinHeight="420" MaxWidth="780" MaxHeight="760"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResizeWithGrip"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="RestorePointItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,7" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="ItemChrome"
								Padding="13,11"
								Background="{DynamicResource ReduxSurfaceElevatedBrush}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<ContentPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ReduxSelectionBrush}" />
									<Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<DataTemplate x:Key="RestorePointTemplate">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Border Width="34" Height="34" Margin="0,0,11,0"
						VerticalAlignment="Center"
						Background="{DynamicResource ReduxAccentSoftBrush}"
						CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
						<controls:ReduxIcon Width="17" Height="17"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxAccentHoverBrush}"
							StrokeData="{StaticResource Redux.Icon.ScrollText}" />
					</Border>
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Text="{Binding CreatedSummary}" />
						<TextBlock Margin="0,3,0,0"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Reason}"
							TextTrimming="CharacterEllipsis" />
						<TextBlock Margin="0,2,0,0"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding SourceOrderName, StringFormat=Source order: {0}}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<Border Grid.Column="2" Margin="12,0,0,0" Padding="9,4"
						VerticalAlignment="Center"
						Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
						<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Text="{Binding ModCountSummary}" />
					</Border>
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ScrollText}" />
		<Border Grid.Row="1"
			Padding="22,19"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="Load a previous exported order" />
					<TextBlock Margin="0,5,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="Redux creates a restore point before each confirmed export. You can also capture the current working order at any time. Loading one never changes game files until you export again."
						TextWrapping="Wrap" />
				</StackPanel>

				<Grid Grid.Row="1" Margin="0,17,0,15">
					<Border Background="{DynamicResource ReduxSurfaceBrush}"
						BorderBrush="{DynamicResource ReduxBorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
						ClipToBounds="True">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Grid Margin="14,9,9,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock VerticalAlignment="Center"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									FontWeight="{DynamicResource Redux.FontWeight.Control}"
									Text="Restore-point history" />
								<Button x:Name="CompareButton"
									Grid.Column="1"
									MinWidth="126"
									Margin="8,0,6,0"
									Content="Compare with Current"
									IsEnabled="False"
									Style="{StaticResource ReduxSecondaryActionButtonStyle}"
									Click="CompareButton_Click" />
								<Button x:Name="DeleteButton"
									Grid.Column="2"
									MinWidth="74"
									Content="Delete"
									IsEnabled="False"
									Style="{StaticResource ReduxDestructiveActionButtonStyle}"
									Click="DeleteButton_Click" />
							</Grid>
							<ListBox x:Name="RestorePointList"
								Grid.Row="1"
								Margin="7"
								Padding="0"
								Background="Transparent"
								BorderThickness="0"
								HorizontalContentAlignment="Stretch"
								ItemContainerStyle="{StaticResource RestorePointItemStyle}"
								ItemTemplate="{StaticResource RestorePointTemplate}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Auto"
								SelectionChanged="RestorePointList_SelectionChanged"
								MouseDoubleClick="RestorePointList_MouseDoubleClick" />
							<StackPanel x:Name="EmptyState"
								Grid.Row="1"
								HorizontalAlignment="Center" VerticalAlignment="Center">
								<controls:ReduxIcon Width="28" Height="28"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									StrokeData="{StaticResource Redux.Icon.ScrollText}" />
								<TextBlock Margin="0,9,0,0"
									HorizontalAlignment="Center"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									FontWeight="{DynamicResource Redux.FontWeight.Control}"
									Text="No restore points yet" />
								<TextBlock Margin="0,3,0,0"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Create one now or confirm an export to begin the history." />
							</StackPanel>
						</Grid>
					</Border>
				</Grid>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Button x:Name="CreateButton"
						MinWidth="116"
						Content="Create Snapshot"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CreateButton_Click" />
					<TextBlock x:Name="StatusText"
						Grid.Column="1"
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						TextTrimming="CharacterEllipsis"
						Text="Redux keeps the 20 newest restore points for each profile." />
					<Button Grid.Column="2" MinWidth="84" Margin="12,0,8,0"
						Content="Close"
						IsCancel="True"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CloseButton_Click" />
					<Button x:Name="LoadButton" Grid.Column="3" MinWidth="140"
						Content="Load Working Order"
						IsDefault="True"
						IsEnabled="False"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}"
						Click="LoadButton_Click" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
