<adonisControls:AdonisWindow x:Class="DivinityModManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:conv="clr-namespace:DivinityModManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:dutil="clr-namespace:DivinityModManager.Util;assembly=DivinityModManagerCore"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vm="clr-namespace:DivinityModManager.ViewModels"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="{Binding Title}"
	Icon="/Redux;component/Redux.ico"
	Width="1440"
	Height="900"
	MinWidth="960"
	MinHeight="620"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}"
	WindowStartupLocation="CenterScreen"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="Medium"
	AllowDrop="True"
	PreviewDragEnter="MainWindow_PreviewDragEnter"
	PreviewDragOver="MainWindow_PreviewDragOver"
	PreviewDragLeave="MainWindow_PreviewDragLeave"
	PreviewDrop="MainWindow_PreviewDrop"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<!--  d:DataContext="{d:DesignInstance IsDesignTimeCreatable=True, Type=local:MainWindowDebugData}"  -->
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Window.TaskbarItemInfo>
		<TaskbarItemInfo />
	</Window.TaskbarItemInfo>
	<Grid x:Name="WindowRoot">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid x:Name="WindowContentLayer" Grid.RowSpan="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<controls:ReduxWindowTitleBar
				Background="{DynamicResource ReduxWindowBrush}"
				BottomBorderThickness="0"
				IconSource="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
			<Grid x:Name="MainGrid"
				Grid.Row="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch" />
		</Grid>
		<Border x:Name="WindowResizeGlow"
			Grid.RowSpan="2"
			Margin="1"
			Panel.ZIndex="1000"
			Background="Transparent"
			BorderBrush="{DynamicResource ReduxAccentHoverBrush}"
			BorderThickness="{DynamicResource Redux.WindowInteraction.BorderThickness}"
			CornerRadius="6"
			IsHitTestVisible="False"
			Opacity="0">
			<Border.Effect>
				<DropShadowEffect BlurRadius="10"
					Color="{DynamicResource ReduxAccentHoverColor}"
					Opacity="0.75"
					ShadowDepth="0" />
			</Border.Effect>
		</Border>
		<Grid x:Name="InstallDropOverlay"
			Grid.RowSpan="2"
			Panel.ZIndex="2000"
			IsHitTestVisible="False"
			Opacity="0"
			Visibility="Collapsed">
			<Border x:Name="InstallDropScrim"
				Background="{DynamicResource ReduxAppBackgroundBrush}"
				Opacity="0.62" />
			<Border Margin="2"
				BorderBrush="{DynamicResource ReduxAccentHoverBrush}"
				BorderThickness="{DynamicResource Redux.WindowInteraction.BorderThickness}"
				CornerRadius="6">
				<Border.Effect>
					<DropShadowEffect BlurRadius="12"
						Color="{DynamicResource ReduxAccentHoverColor}"
						Opacity="0.72"
						ShadowDepth="0" />
				</Border.Effect>
			</Border>
			<Border HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Padding="28,22"
				Background="{DynamicResource ReduxSurfaceElevatedBrush}"
				BorderBrush="{DynamicResource ReduxAccentHoverBrush}"
				BorderThickness="1"
				CornerRadius="12">
				<StackPanel HorizontalAlignment="Center">
					<Border Width="52" Height="52"
						HorizontalAlignment="Center"
						Background="{DynamicResource ReduxAccentPillBackground}"
						CornerRadius="26">
						<controls:ReduxIcon Width="22" Height="22"
							Foreground="{DynamicResource ReduxAccentHoverBrush}"
							StrokeData="{StaticResource Redux.Icon.Download}" />
					</Border>
					<TextBlock Margin="0,12,0,0"
						HorizontalAlignment="Center"
						FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="{loc:Text Drop_to_install_bcdbf529}" />
					<TextBlock Margin="0,5,0,0"
						HorizontalAlignment="Center"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="{loc:Text Redux_will_inspect_and_route_supported_mods_and_saves_3875dc19}" />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</adonisControls:AdonisWindow>
