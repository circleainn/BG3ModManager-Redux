<local:AppUpdateWindowBase x:Class="DivinityModManager.Views.AppUpdateWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Redux Updater"
	Width="900"
	Height="620"
	MinWidth="680"
	MinHeight="460"
	ResizeMode="CanResizeWithGrip"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
	Background="{DynamicResource ReduxWindowBrush}"
	mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
				<ResourceDictionary Source="../Themes/DefaultStyles/MarkdownStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
				<Setter Property="Width" Value="120" />
				<Setter Property="Margin" Value="10,0" />
			</Style>
			<Style x:Key="UpdateButtonPanelStyle" TargetType="StackPanel">
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Orientation" Value="Horizontal" />
				<Setter Property="Margin" Value="10" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Download}" />
		<Separator Grid.Row="2"
			Margin="0,18,0,4"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch" />
		<TextBlock Grid.Row="3"
			Padding="4"
			FontSize="{DynamicResource Redux.FontSize.24}"
			Text="Changelog"
			TextAlignment="Center" />
		<FlowDocumentScrollViewer x:Name="UpdateChangelogView"
			Grid.Row="4"
			ScrollViewer.CanContentScroll="True"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			ScrollViewer.VerticalScrollBarVisibility="Auto">
			<FlowDocumentScrollViewer.Resources>
				<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
					<Setter Property="TextWrapping" Value="Wrap" />
				</Style>
			</FlowDocumentScrollViewer.Resources>
		</FlowDocumentScrollViewer>
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="4*" />
			</Grid.RowDefinitions>
			<TextBlock x:Name="UpdateDescription"
				Padding="0,10"
				FontSize="{DynamicResource Redux.FontSize.18}"
				Foreground="{DynamicResource {x:Static adonisUI:Brushes.AccentForegroundBrush}}"
				Text=""
				TextAlignment="Center" />
			<StackPanel Grid.Row="1"
				Margin="4,0,4,0"
				HorizontalAlignment="Center"
				Background="{DynamicResource {x:Static adonisUI:Brushes.Layer0BackgroundBrush}}"
				Style="{StaticResource UpdateButtonPanelStyle}">
				<Button x:Name="ConfirmButton"
					HorizontalAlignment="Center"
					Background="{DynamicResource ReduxSuccessBrush}"
					Content="Download"
					ToolTip="Download Update">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="5" />
						</Style>
					</Button.Resources>
				</Button>
				<Button x:Name="SkipButton"
					HorizontalAlignment="Center"
					Content="Skip"
					ToolTip="Skip Update">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="5" />
						</Style>
					</Button.Resources>
				</Button>
			</StackPanel>
		</Grid>
	</Grid>
</local:AppUpdateWindowBase>
