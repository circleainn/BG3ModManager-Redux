<local:AppUpdateWindowBase x:Class="DivinityModManager.Views.AppUpdateWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Redux Update"
	Width="760"
	Height="540"
	MinWidth="560"
	MinHeight="460"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
	Background="{DynamicResource ReduxWindowBrush}"
	mc:Ignorable="d">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
				<ResourceDictionary Source="../Themes/DefaultStyles/MarkdownStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Download}" />
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="24,20,24,20">
				<TextBlock x:Name="UpdateDescription" FontSize="{DynamicResource Redux.FontSize.18}"
					FontWeight="{DynamicResource Redux.FontWeight.Title}" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
					TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
				<TextBlock x:Name="BackupExplanation" Margin="0,8,0,0"
					Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"
					Visibility="Collapsed"
					Text="Update &amp; Back Up saves your current Redux installation, BG3 mod PAKs, previous mod versions, and load orders to a ZIP you choose before the update restarts." />
				<ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="1"
					Style="{StaticResource ReduxProgressBarStyle}" Visibility="Collapsed" AutomationProperties.Name="Update progress" />
				<Border Margin="0,20,0,0" Padding="16" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
					<FlowDocumentScrollViewer x:Name="UpdateChangelogView" MinHeight="120"
						IsToolBarVisible="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
						AutomationProperties.Name="Update details" />
				</Border>
			</StackPanel>
		</ScrollViewer>
		<Border Grid.Row="2" Padding="24,14" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
			<WrapPanel HorizontalAlignment="Right">
				<Button x:Name="SkipButton" MinWidth="96" Margin="0,4,8,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock x:Name="SkipButtonText" Text="Close" />
					</StackPanel>
				</Button>
				<Button x:Name="BackupAndConfirmButton" MinWidth="150" Margin="0,4,8,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}"
					ToolTip="Choose where to save a pre-update ZIP of Redux, mod PAKs, previous versions, and load orders">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Archive}" />
						<TextBlock Text="Update &amp; Back Up" />
					</StackPanel>
				</Button>
				<Button x:Name="ConfirmButton" MinWidth="120" Margin="0,4,0,4" Style="{StaticResource ReduxPrimaryActionButtonStyle}">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Download}" />
						<TextBlock x:Name="ConfirmButtonText" Text="Update &amp; Restart" />
					</StackPanel>
				</Button>
			</WrapPanel>
		</Border>
	</Grid>
</local:AppUpdateWindowBase>
