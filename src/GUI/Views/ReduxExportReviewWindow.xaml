<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxExportReviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:models="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Review Export"
	Width="680" MinWidth="600" MaxWidth="760" MaxHeight="760"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResizeWithGrip"
	SizeToContent="Height"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<DataTemplate x:Key="ExportChangeTemplate">
				<Border Margin="0,0,0,6"
					Padding="0"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
					ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border x:Name="ChangeRail" Background="{DynamicResource ReduxInfoBrush}" />
						<controls:ReduxIcon x:Name="ChangeIcon"
							Grid.Column="1" Width="16" Height="16" Margin="11,0,9,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxInfoBrush}"
							StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
						<StackPanel Grid.Column="2" Margin="0,8">
							<TextBlock Text="{Binding Name}" FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock x:Name="ChangeKindText" Margin="0,2,0,0"
								Foreground="{DynamicResource ReduxInfoBrush}"
								Text="Position changed" />
						</StackPanel>
						<TextBlock Grid.Column="3" Margin="12,0,12,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding PositionSummary}" />
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Activated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.AddStroke}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Activated" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Deactivated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.RemoveCircle}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Deactivated" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.AutomaticallyAdded}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.ExtensionPuzzle}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Installed dependency included in this export" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.CloudUpload}" />
		<Border Grid.Row="1"
			Padding="22,20"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ScrollViewer MaxHeight="610" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="0,0,6,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border Width="42" Height="42" Margin="0,0,14,0"
								VerticalAlignment="Top"
								Background="{DynamicResource ReduxAccentSoftBrush}"
								BorderBrush="{DynamicResource ReduxAccentBrush}"
								BorderThickness="1"
								CornerRadius="21">
								<controls:ReduxIcon Width="21" Height="21"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									Foreground="{DynamicResource ReduxAccentHoverBrush}"
									StrokeData="{StaticResource Redux.Icon.CloudUpload}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
									FontWeight="{DynamicResource Redux.FontWeight.Title}"
									Foreground="{DynamicResource ReduxTextPrimaryBrush}"
									Text="Review export" />
								<TextBlock Margin="0,4,0,0"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="{Binding DestinationSummary}"
									TextWrapping="Wrap" />
							</StackPanel>
						</Grid>

						<UniformGrid Margin="0,18,0,0" Columns="3">
							<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
								<StackPanel>
									<TextBlock FontSize="{DynamicResource Redux.FontSize.17}"
										FontWeight="{DynamicResource Redux.FontWeight.Title}"
										Foreground="{DynamicResource ReduxSuccessBrush}"
										Text="{Binding ActivatedCount}" />
									<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Activated" />
								</StackPanel>
							</Border>
							<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
								<StackPanel>
									<TextBlock FontSize="{DynamicResource Redux.FontSize.17}"
										FontWeight="{DynamicResource Redux.FontWeight.Title}"
										Foreground="{DynamicResource ReduxErrorBrush}"
										Text="{Binding DeactivatedCount}" />
									<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Deactivated" />
								</StackPanel>
							</Border>
							<Border Margin="0" Padding="11,9"
								Background="{DynamicResource ReduxSurfaceBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}"
								BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<StackPanel>
									<TextBlock FontSize="{DynamicResource Redux.FontSize.17}"
										FontWeight="{DynamicResource Redux.FontWeight.Title}"
										Foreground="{DynamicResource ReduxInfoBrush}"
										Text="{Binding RepositionedCount}" />
									<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Repositioned" />
								</StackPanel>
							</Border>
						</UniformGrid>
						<TextBlock Margin="2,8,0,0"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding IncludedDependencySummary}"
							TextWrapping="Wrap"
							Visibility="{Binding HasIncludedDependencies, Converter={StaticResource BoolToVisibilityConverter}}" />

						<Border Margin="0,12,0,0" Padding="13,11"
							BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasDiagnosticWarnings}" Value="True">
											<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
											<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding HasDiagnosticErrors}" Value="True">
											<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
											<Setter Property="BorderBrush" Value="{DynamicResource ReduxErrorBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<controls:ReduxIcon x:Name="DiagnosticIcon"
									Width="19" Height="19" Margin="0,1,10,0"
									VerticalAlignment="Top">
									<controls:ReduxIcon.Style>
										<Style TargetType="controls:ReduxIcon">
											<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
											<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ShieldCheck}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasDiagnosticWarnings}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
													<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.Warning}" />
												</DataTrigger>
												<DataTrigger Binding="{Binding HasDiagnosticErrors}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
													<Setter Property="IconKey" Value="error" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</controls:ReduxIcon.Style>
								</controls:ReduxIcon>
								<StackPanel Grid.Column="1">
									<TextBlock FontWeight="{DynamicResource Redux.FontWeight.Control}"
										Foreground="{DynamicResource ReduxTextPrimaryBrush}"
										Text="{Binding DiagnosticTitle}" />
									<TextBlock Margin="0,3,0,0"
										Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="{Binding DiagnosticSummary}"
										TextWrapping="Wrap" />
									<TextBlock Margin="0,3,0,0"
										Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="{Binding DependencySummary}"
										TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>

						<TextBlock Margin="2,16,0,8"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							Text="{Binding ChangeListTitle}" />
						<ItemsControl
							ItemTemplate="{StaticResource ExportChangeTemplate}"
							ItemsSource="{Binding Changes}"
							Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
						<Border Padding="13,11"
							Background="{DynamicResource ReduxSurfaceBrush}"
							BorderBrush="{DynamicResource ReduxBorderBrush}"
							BorderThickness="1"
							CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
							Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverterReversed}}">
							<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding NoChangesSummary}"
								TextWrapping="Wrap" />
						</Border>

						<TextBlock Margin="2,10,0,0"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding BaselineSummary}"
							TextWrapping="Wrap" />
					</StackPanel>
				</ScrollViewer>

				<Grid Grid.Row="1" Margin="0,18,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Margin="2,0,16,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="Nothing is changed until you choose Export to Game."
						TextWrapping="Wrap" />
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button MinWidth="86" Content="Cancel" IsCancel="True"
							Style="{StaticResource ReduxSecondaryActionButtonStyle}"
							Click="CancelButton_Click" />
						<Button MinWidth="142" Margin="8,0,0,0" IsDefault="True"
							Style="{StaticResource ReduxPrimaryActionButtonStyle}"
							Click="ExportButton_Click">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
									Foreground="{DynamicResource ReduxAccentForegroundBrush}"
									StrokeData="{StaticResource Redux.Icon.CloudUpload}" />
								<TextBlock Text="Export to Game" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
