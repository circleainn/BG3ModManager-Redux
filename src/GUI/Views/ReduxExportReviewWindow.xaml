<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxExportReviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:models="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Review Game Load Order Changes"
	Width="860" Height="700" MinWidth="720" MinHeight="540"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" SizeToContent="Manual"
	ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="ExportPositionPillStyle" BasedOn="{StaticResource ReduxPillBaseStyle}" TargetType="{x:Type Border}">
				<Setter Property="MinHeight" Value="25" /><Setter Property="Padding" Value="9,3" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="TextElement.Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>

			<DataTemplate x:Key="ExportChangeTemplate">
				<Border Margin="0,0,0,7" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Border x:Name="ChangeRail" Background="{DynamicResource ReduxInfoBrush}" />
						<Border Grid.Column="1" Width="36" Height="36" Margin="12,0,10,0" VerticalAlignment="Center"
							Background="{DynamicResource ReduxInfoPillBackground}" CornerRadius="8">
							<controls:ReduxIcon x:Name="ChangeIcon" Width="17" Height="17"
								Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
						</Border>
						<StackPanel Grid.Column="2" Margin="0,10">
							<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock x:Name="ChangeKindText" Margin="0,3,0,0" Foreground="{DynamicResource ReduxInfoBrush}"
								Text="Will move to a different position" />
						</StackPanel>
						<Border Grid.Column="3" Margin="12,0,13,0" VerticalAlignment="Center" Style="{StaticResource ExportPositionPillStyle}">
							<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding PositionSummary}" />
						</Border>
					</Grid>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Activated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.AddStroke}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Will be added to the game load order" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.Deactivated}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.RemoveCircle}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Will be removed from the game load order" />
					</DataTrigger>
					<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LoadOrderChangeKind.AutomaticallyAdded}">
						<Setter TargetName="ChangeRail" Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
						<Setter TargetName="ChangeIcon" Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
						<Setter TargetName="ChangeIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.ExtensionPuzzle}" />
						<Setter TargetName="ChangeKindText" Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
						<Setter TargetName="ChangeKindText" Property="Text" Value="Required installed dependency will be added" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ReorderStroke}" />
		<Border Grid.Row="1" Padding="20,16" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
					<RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid>
					<StackPanel>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Review game load order changes" />
						<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding DestinationSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Grid>

				<StackPanel Grid.Row="1">
					<UniformGrid Margin="0,14,0,0" Columns="3">
						<Border Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxSuccessPillBackground}" CornerRadius="8" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxSuccessBrush}" StrokeData="{StaticResource Redux.Icon.AddStroke}" /></Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="Bold"
								Foreground="{DynamicResource ReduxSuccessBrush}" Text="{Binding ActivatedCount}" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Added to game order" /></StackPanel>
						</Grid></Border>
						<Border Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxErrorPillBackground}" CornerRadius="8" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxErrorBrush}" StrokeData="{StaticResource Redux.Icon.RemoveCircle}" /></Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="Bold"
								Foreground="{DynamicResource ReduxErrorBrush}" Text="{Binding DeactivatedCount}" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Removed from game order" /></StackPanel>
						</Grid></Border>
						<Border Margin="0" Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxInfoPillBackground}" CornerRadius="8" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.ReorderStroke}" /></Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="Bold"
								Foreground="{DynamicResource ReduxInfoBrush}" Text="{Binding RepositionedCount}" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Positions changed" /></StackPanel>
						</Grid></Border>
					</UniformGrid>
					<TextBlock Margin="2,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="{Binding IncludedDependencySummary}" TextWrapping="Wrap"
						Visibility="{Binding HasIncludedDependencies, Converter={StaticResource BoolToVisibilityConverter}}" />
				</StackPanel>

				<Border Grid.Row="2" Margin="0,11,0,11" Padding="12,10" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Border.Style><Style TargetType="Border">
						<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
						<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasDiagnosticWarnings}" Value="True"><Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" /></DataTrigger>
							<DataTrigger Binding="{Binding HasDiagnosticErrors}" Value="True"><Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource ReduxErrorBrush}" /></DataTrigger>
						</Style.Triggers>
					</Style></Border.Style>
					<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Width="38" Height="38" Margin="0,0,11,0" CornerRadius="8">
							<controls:ReduxIcon Width="19" Height="19"><controls:ReduxIcon.Style><Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="controls:ReduxIcon">
								<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" /><Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ShieldCheck}" />
								<Style.Triggers><DataTrigger Binding="{Binding HasDiagnosticWarnings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" /><Setter Property="IconKey" Value="warning" /></DataTrigger>
									<DataTrigger Binding="{Binding HasDiagnosticErrors}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" /><Setter Property="IconKey" Value="error" /></DataTrigger></Style.Triggers>
							</Style></controls:ReduxIcon.Style></controls:ReduxIcon>
						</Border>
						<StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding DiagnosticTitle}" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding DiagnosticSummary}" TextWrapping="Wrap" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding DependencySummary}" TextWrapping="Wrap" />
							<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxWarningBrush}"
								Text="{Binding DependencyOrderWarningSummary}" TextWrapping="Wrap"
								Visibility="{Binding HasDependencyOrderWarnings, Converter={StaticResource BoolToVisibilityConverter}}" /></StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="3">
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
					<TextBlock Margin="2,0,0,9" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding ChangeListTitle}" />
					<Border Grid.Row="1" Background="{DynamicResource ReduxBorderBrush}" />
					<ListBox Grid.Row="2" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
						HorizontalContentAlignment="Stretch" ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource ExportChangeTemplate}"
						ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
						Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
					<StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
						Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverterReversed}}">
						<Border Width="44" Height="44" HorizontalAlignment="Center" Background="{DynamicResource ReduxSuccessPillBackground}" CornerRadius="22" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
							<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxSuccessBrush}" IconKey="shield-check" /></Border>
						<TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="No load-order changes" />
						<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding NoChangesSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Grid>

				<TextBlock Grid.Row="4" Margin="2,11,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
					Text="{Binding BaselineSummary}" TextWrapping="Wrap" />

				<Grid Grid.Row="5" Margin="0,13,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource ReduxTextMutedBrush}" IconKey="info" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" />
						<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="Your game load order will not change until you apply these changes." />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<Button MinWidth="88" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click">
							<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="Cancel" /></StackPanel>
						</Button>
						<Button MinWidth="148" Margin="8,0,0,0" IsDefault="True" Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ExportButton_Click">
							<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,7,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
								Foreground="{DynamicResource ReduxAccentForegroundBrush}" StrokeData="{StaticResource Redux.Icon.Check}" />
								<TextBlock Text="Apply Changes" /></StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
