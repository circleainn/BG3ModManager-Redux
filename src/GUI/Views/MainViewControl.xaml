					<Border x:Name="ToolbarBand"
					    Margin="12,6"
					    Padding="10,7"
					    Background="{DynamicResource ReduxSurfaceBrush}"
					    BorderBrush="{DynamicResource ReduxBorderBrush}"
					    BorderThickness="1"
					    TextElement.FontFamily="{DynamicResource Redux.FontFamily.UI}"
					    TextElement.FontSize="{DynamicResource Redux.FontSize.12}"
					    CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
						<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.Resources>
							<ControlTemplate x:Key="ToolbarButtonTemplate" TargetType="{x:Type Button}">
								<!--
									Padding is applied to the ContentPresenter, not ButtonChrome:
									with Border.Padding the HoverSurface only covers the content box,
									leaving the padding ring (right edge/corners) in the base color
									during hover.
								-->
								<Grid ClipToBounds="False">
									<Border x:Name="ButtonChrome"
										Margin="0,1"
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										RenderTransformOrigin="0.5,0.5"
										SnapsToDevicePixels="True"
										UseLayoutRounding="True">
										<Border.RenderTransform>
											<TranslateTransform x:Name="ButtonChromeTranslate" Y="0" />
										</Border.RenderTransform>
										<Grid>
											<Border x:Name="HoverSurface"
												Background="{DynamicResource ReduxAccentSoftBrush}"
												CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
												IsHitTestVisible="False"
												Opacity="0" />
											<ContentPresenter Margin="{TemplateBinding Padding}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Content="{TemplateBinding Content}"
												ContentStringFormat="{TemplateBinding ContentStringFormat}"
												ContentTemplate="{TemplateBinding ContentTemplate}"
												RecognizesAccessKey="True" />
										</Grid>
									</Border>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
														To="0.38" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
													<DoubleAnimation Storyboard.TargetName="ButtonChromeTranslate" Storyboard.TargetProperty="Y"
														To="{StaticResource Redux.Motion.HoverTranslateNegative}" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
														To="0" Duration="{StaticResource Redux.Motion.Standard}" />
													<DoubleAnimation Storyboard.TargetName="ButtonChromeTranslate" Storyboard.TargetProperty="Y"
														To="0" Duration="{StaticResource Redux.Motion.Standard}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<!-- Match the proven pane-header +/chevron controls: press feedback is
										     transient opacity only, so no brush or transform can outlive IsPressed. -->
										<Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82" />
									</Trigger>
									<Trigger Property="IsEnabled" Value="False">
										<Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
										<Setter Property="Cursor" Value="Arrow" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
							<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
