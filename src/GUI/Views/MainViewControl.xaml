<local:MainViewControlViewBase x:Class="DivinityModManager.Views.MainViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:conv="clr-namespace:DivinityModManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:dutil="clr-namespace:DivinityModManager.Util;assembly=DivinityModManagerCore"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:health="clr-namespace:DivinityModManager.Models.Health;assembly=DivinityModManagerCore"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vm="clr-namespace:DivinityModManager.ViewModels"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<UserControl.Style>
		<Style BasedOn="{StaticResource {x:Type UserControl}}" TargetType="UserControl" />
	</UserControl.Style>
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}" />
			<Style x:Key="MenuItemHighlightBlink" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
				<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<DataTrigger.EnterActions>
							<BeginStoryboard Name="BlinkyMenuItemStoryboard">
								<Storyboard AutoReverse="True"
								    BeginTime="00:00:00"
								    FillBehavior="Stop"
								    RepeatBehavior="Forever"
								    Duration="0:0:0.5">
									<DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" />
								</Storyboard>
							</BeginStoryboard>
						</DataTrigger.EnterActions>
						<DataTrigger.ExitActions>
							<StopStoryboard BeginStoryboardName="BlinkyMenuItemStoryboard" />
						</DataTrigger.ExitActions>
					</DataTrigger>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="False">
						<Setter Property="Opacity" Value="1.0" />
						<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Background="{DynamicResource ReduxWindowBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<xc:BusyIndicator x:Name="MainBusyIndicator" Style="{StaticResource BusyIndicatorProgressStyle}" Visibility="Hidden">
			<xc:BusyIndicator.BusyContent>
				<Grid Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock HorizontalAlignment="Center"
					    FontSize="{DynamicResource Redux.FontSize.16}"
					    FontWeight="Bold"
					    Text="{Binding MainProgressTitle, FallbackValue='Archiving...'}" />
					<DockPanel Grid.Row="1" Margin="8">
						<TextBlock HorizontalAlignment="Center"
						    VerticalAlignment="Center"
						    DockPanel.Dock="Bottom"
						    Text="{Binding MainProgressWorkText, FallbackValue='Archiving pak 4/10...'}"
						    TextAlignment="Center" />
						<ProgressBar MinHeight="15" Style="{StaticResource ReduxProgressBarStyle}"
						    VerticalAlignment="Center"
						    DockPanel.Dock="Top"
						    Maximum="1"
						    Value="{Binding MainProgressValue, FallbackValue='0'}" />
					</DockPanel>
					<Button Grid.Row="2"
					    Margin="8,0,8,8"
					    Padding="20,4"
					    HorizontalAlignment="Center"
					    VerticalAlignment="Center"
					    Command="{Binding CancelMainProgressCommand}"
					    Content="Cancel"
					    Visibility="{Binding CanCancelProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
				</Grid>
			</xc:BusyIndicator.BusyContent>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<local:DeleteFilesConfirmationView x:Name="DeleteFilesView" Grid.RowSpan="3" Panel.ZIndex="99" />
				<Rectangle x:Name="ModListRectangle"
				    Grid.RowSpan="3"
				    HorizontalAlignment="Stretch"
				    VerticalAlignment="Stretch"
				    Panel.ZIndex="98"
				    Fill="{DynamicResource ReduxWindowBrush}" />
				<Grid Background="{DynamicResource ReduxWindowBrush}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Menu x:Name="TopMenuBar"
						Padding="4,2"
						Background="{DynamicResource ReduxWindowBrush}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}">
						<Menu.Resources>
							<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
								<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
								<Style.Triggers>
									<!-- Adonis places submenu rows directly against the popup chrome. Inset the
									     rows horizontally so their rectangular highlight cannot paint over the
									     popup's rounded corner arcs. -->
									<Trigger Property="Role" Value="SubmenuHeader">
										<Setter Property="Margin" Value="1,0" />
									</Trigger>
									<Trigger Property="Role" Value="SubmenuItem">
										<Setter Property="Margin" Value="1,0" />
									</Trigger>
								</Style.Triggers>
							</Style>
						</Menu.Resources>
						<MenuItem x:Name="FileMenuItem" Header="File" />
						<MenuItem x:Name="EditMenuItem" Header="Edit" />
						<MenuItem x:Name="SettingsMenuItem" Header="Settings" />
						<MenuItem x:Name="AccessibilityMenuItem" Header="Accessibility" />
						<MenuItem x:Name="ToolsMenuItem" Header="Tools" Style="{StaticResource MenuItemHighlightBlink}" />
						<!-- A compact command surface remains available whenever the visual toolbar is hidden. -->
						<MenuItem Header="Toolbar"
							Visibility="{Binding Settings.HideToolbar, Converter={StaticResource BoolToVisibilityConverter}}">
							<MenuItem Header="Setup">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Settings}" /></MenuItem.Icon>
								<MenuItem Command="{Binding Keys.ImportMod.Command}" Header="Install Mod..." InputGestureText="{Binding Keys.ImportMod.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem x:Name="ToolbarProfileMenu"
									Header="Profile"
									DisplayMemberPath="Name"
									ItemsSource="{Binding Profiles}"
									SubmenuOpened="ToolbarProfileMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarProfileMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
								<MenuItem x:Name="ToolbarCampaignMenu"
									Header="Campaign"
									DisplayMemberPath="DisplayName"
									ItemsSource="{Binding AdventureMods}"
									SubmenuOpened="ToolbarCampaignMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarCampaignMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
							</MenuItem>
							<MenuItem Header="Load Order">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.ListStroke}" /></MenuItem.Icon>
								<MenuItem x:Name="ToolbarLoadOrderMenu"
									Header="Current Order"
									DisplayMemberPath="Name"
									ItemsSource="{Binding ModOrderList}"
									SubmenuOpened="ToolbarLoadOrderMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarLoadOrderMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
								<Separator />
								<MenuItem Command="{Binding Keys.Save.Command}" Header="Save Order" InputGestureText="{Binding Keys.Save.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Save}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.SaveAs.Command}" Header="Save Order As..." InputGestureText="{Binding Keys.SaveAs.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Duplicate}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.NewOrder.Command}" Header="New Load Order" InputGestureText="{Binding Keys.NewOrder.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" /></MenuItem.Icon>
								</MenuItem>
							</MenuItem>
							<MenuItem Header="Export">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.CloudUpload}" /></MenuItem.Icon>
								<MenuItem Command="{Binding Keys.ExportOrderToGame.Command}" Header="Export to Game" InputGestureText="{Binding Keys.ExportOrderToGame.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.CloudUpload}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.ExportOrderToZip.Command}" Header="Export Active Mods to Zip" InputGestureText="{Binding Keys.ExportOrderToZip.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Archive}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.ExportOrderToArchiveAs.Command}" Header="Export Active Mods to Zip As..." InputGestureText="{Binding Keys.ExportOrderToArchiveAs.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Duplicate}" /></MenuItem.Icon>
								</MenuItem>
								<Separator />
								<MenuItem Command="{Binding Keys.Refresh.Command}" Header="Refresh Mods" InputGestureText="{Binding Keys.Refresh.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.RefreshStroke}" /></MenuItem.Icon>
								</MenuItem>
							</MenuItem>
							<MenuItem Header="Play">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.GameController}" /></MenuItem.Icon>
								<MenuItem x:Name="ToolbarAfterLaunchMenu"
									Header="After Launch"
									DisplayMemberPath="Description"
									ItemsSource="{Binding Source={ext:EnumExtension {x:Type dapp:DivinityGameLaunchWindowAction}}}"
									SubmenuOpened="ToolbarAfterLaunchMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="Header" Value="{Binding Description}" />
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarAfterLaunchMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
								<MenuItem Command="{Binding Keys.LaunchGame.Command}" Header="Launch Game" InputGestureText="{Binding Keys.LaunchGame.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.GameController}" /></MenuItem.Icon>
								</MenuItem>
							</MenuItem>
							<Separator />
							<MenuItem Command="{Binding Keys.ToggleToolbar.Command}" Header="Show Toolbar" InputGestureText="{Binding Keys.ToggleToolbar.DisplayBindingText}">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Desktop}" /></MenuItem.Icon>
							</MenuItem>
						</MenuItem>
						<MenuItem Header="Shortcuts">
							<MenuItem Header="FOLDERS" IsEnabled="False" />
							<MenuItem Command="{Binding Keys.OpenModsFolder.Command}" Header="Mods Folder" InputGestureText="{Binding Keys.OpenModsFolder.DisplayBindingText}">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Command="{Binding Keys.OpenGameFolder.Command}" Header="Game Folder" InputGestureText="{Binding Keys.OpenGameFolder.DisplayBindingText}">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.GameController}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Command="{Binding Keys.OpenLogsFolder.Command}" Header="Extender Logs Folder" InputGestureText="{Binding Keys.OpenLogsFolder.DisplayBindingText}">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.DocumentText}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Save Games Folder" Click="OpenSaveGamesFolder_Click">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
							</MenuItem>
							<Separator />
							<MenuItem Header="ONLINE" IsEnabled="False" />
							<MenuItem Header="BG3 on Nexus Mods" Click="OpenBg3Nexus_Click">
								<MenuItem.Icon><ContentControl ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="BG3 Script Extender on GitHub" Click="OpenScriptExtenderRepo_Click">
								<MenuItem.Icon><ContentControl ContentTemplate="{DynamicResource GithubPlatformIconTemplate}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="BG3 Mod Manager Redux on Nexus Mods" Click="OpenReduxNexus_Click">
								<MenuItem.Icon><ContentControl ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" /></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="BG3 Mod Manager Redux on GitHub" Click="OpenReduxRepo_Click">
								<MenuItem.Icon><ContentControl ContentTemplate="{DynamicResource GithubPlatformIconTemplate}" /></MenuItem.Icon>
							</MenuItem>
						</MenuItem>
						<MenuItem x:Name="HelpMenuItem" Header="Help" />
					</Menu>
					<StackPanel x:Name="UpdatesButtonPanel"
					    Grid.Column="2"
					    HorizontalAlignment="Left"
					    VerticalAlignment="Center"
					    Orientation="Horizontal"
					    Visibility="Collapsed">
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Style.Triggers>
									<DataTrigger Binding="{Binding ModUpdatesViewVisible}" Value="True">
										<Setter Property="Background" Value="{DynamicResource {x:Static adonisUI:Brushes.Layer1HighlightBorderBrush}}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding ModUpdatesViewVisible}" Value="False">
										<Setter Property="Background" Value="Transparent" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>
						<Button x:Name="UpdateViewToggleButton"
						    MinWidth="20"
						    Margin="0"
						    Padding="0"
						    HorizontalAlignment="Stretch"
						    VerticalAlignment="Stretch"
						    BorderThickness="0"
						    ToolTip="Toggle the Mod Updates View">
							<Button.Style>
								<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border Background="{TemplateBinding Background}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="LightGreen" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<Button.Content>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock Padding="4,0"
									    HorizontalAlignment="Center"
									    VerticalAlignment="Center"
									    Foreground="{DynamicResource {x:Static adonisUI:Brushes.ForegroundBrush}}"
									    Text="Updates:"
									    TextAlignment="Center" />
									<controls:BusyIndicator x:Name="UpdatesToggleButtonBusyIndicator"
									    Grid.Column="1"
									    Width="16"
									    Height="16"
									    Margin="2" />
									<TextBlock x:Name="UpdateCountTextBlock"
									    Grid.Column="1"
									    Padding="4,0"
									    HorizontalAlignment="Center"
									    VerticalAlignment="Center"
									    Foreground="{DynamicResource {x:Static adonisUI:Brushes.ForegroundBrush}}"
									    TextAlignment="Center">
										<TextBlock.Style>
											<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
												<Style.Triggers>
													<DataTrigger Binding="{Binding ModUpdatesAvailable}" Value="True">
														<Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUI:Brushes.ErrorBrush}}" />
														<Setter Property="FontWeight" Value="Bold" />
													</DataTrigger>
													<DataTrigger Binding="{Binding ModUpdatesAvailable}" Value="False">
														<Setter Property="Foreground" Value="{DynamicResource {x:Static adonisUI:Brushes.DisabledForegroundBrush}}" />
														<Setter Property="FontWeight" Value="Normal" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
										<TextBlock.Effect>
											<DropShadowEffect BlurRadius="4"
											    Direction="330"
											    Opacity="0.5"
											    ShadowDepth="1"
											    Color="Black" />
										</TextBlock.Effect>
									</TextBlock>
									<controls:ReduxIcon x:Name="UpdatesToggleButtonExpandImage"
									    Grid.Column="3"
									    Width="16"
									    Height="16"
									    StrokeData="{StaticResource Redux.Icon.ChevronDownStroke}">
										<controls:ReduxIcon.Style>
											<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding ModUpdatesViewVisible}" Value="False" />
															<Condition Binding="{Binding ModUpdatesAvailable}" Value="True" />
														</MultiDataTrigger.Conditions>
														<MultiDataTrigger.Setters>
													<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ChevronDownStroke}" />
														</MultiDataTrigger.Setters>
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding ModUpdatesViewVisible}" Value="True" />
															<Condition Binding="{Binding ModUpdatesAvailable}" Value="True" />
														</MultiDataTrigger.Conditions>
														<MultiDataTrigger.Setters>
													<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ChevronUpStroke}" />
														</MultiDataTrigger.Setters>
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding ModUpdatesViewVisible}" Value="False" />
															<Condition Binding="{Binding ModUpdatesAvailable}" Value="False" />
														</MultiDataTrigger.Conditions>
														<MultiDataTrigger.Setters>
														<Setter Property="StrokeData" Value="{StaticResource Redux.Icon.ChevronDownStroke}" />
														<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
														</MultiDataTrigger.Setters>
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</controls:ReduxIcon.Style>
									</controls:ReduxIcon>
								</Grid>
							</Button.Content>
						</Button>
					</StackPanel>
				</Grid>
				<Separator Grid.Row="1"
				    Height="1"
				    Background="{DynamicResource ReduxBorderBrush}"
				    BorderThickness="0">
					<Separator.Style>
						<Style TargetType="{x:Type Separator}">
							<Style.Triggers>
								<DataTrigger Binding="{Binding Settings.HideToolbar}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Separator.Style>
				</Separator>
				<Grid x:Name="ModOrderPanel" Grid.Row="2" Loaded="ModOrderPanel_Loaded">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border x:Name="ToolbarBand"
					    Margin="12,6"
					    Padding="10,7"
					    Background="{DynamicResource ReduxSurfaceBrush}"
					    BorderBrush="{DynamicResource ReduxBorderBrush}"
					    BorderThickness="1"
					    CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
						<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid.Resources>
							<SolidColorBrush x:Key="Toolbar.Button.HoverBrush" Color="{DynamicResource ReduxAccentSoftColor}" />
							<ControlTemplate x:Key="ToolbarButtonTemplate" TargetType="{x:Type Button}">
								<!--
									Padding is applied to the ContentPresenter, not ButtonChrome:
									with Border.Padding the HoverSurface only covers the content box,
									leaving the padding ring (right edge/corners) in the base color
									during hover.
								-->
								<Grid ClipToBounds="False">
									<Border x:Name="ButtonChrome"
										Margin="0,1"
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										RenderTransformOrigin="0.5,0.5"
										SnapsToDevicePixels="True"
										UseLayoutRounding="True">
										<Border.RenderTransform>
											<TranslateTransform x:Name="ButtonChromeTranslate" Y="0" />
										</Border.RenderTransform>
										<Grid>
											<Border x:Name="HoverSurface"
												Background="{DynamicResource Toolbar.Button.HoverBrush}"
												CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
												IsHitTestVisible="False"
												Opacity="0" />
											<ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}"
												HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
												Content="{TemplateBinding Content}"
												ContentStringFormat="{TemplateBinding ContentStringFormat}"
												ContentTemplate="{TemplateBinding ContentTemplate}"
												RecognizesAccessKey="True"
												RenderTransformOrigin="0.5,0.5">
												<ContentPresenter.RenderTransform>
													<ScaleTransform x:Name="ButtonContentScale" ScaleX="1" ScaleY="1" />
												</ContentPresenter.RenderTransform>
											</ContentPresenter>
										</Grid>
									</Border>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
														To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
													<DoubleAnimation Storyboard.TargetName="ButtonChromeTranslate" Storyboard.TargetProperty="Y"
														To="{StaticResource Redux.Motion.HoverTranslateNegative}" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
														To="0" Duration="{StaticResource Redux.Motion.Standard}" />
													<DoubleAnimation Storyboard.TargetName="ButtonChromeTranslate" Storyboard.TargetProperty="Y"
														To="0" Duration="{StaticResource Redux.Motion.Standard}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsPressed" Value="True">
										<Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource ReduxPressedBrush}" />
										<Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ButtonContentScale" Storyboard.TargetProperty="ScaleX"
														To="{StaticResource Redux.Motion.PressScale}" Duration="0" />
													<DoubleAnimation Storyboard.TargetName="ButtonContentScale" Storyboard.TargetProperty="ScaleY"
														To="{StaticResource Redux.Motion.PressScale}" Duration="0" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ButtonContentScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
													<DoubleAnimation Storyboard.TargetName="ButtonContentScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
									<Trigger Property="IsEnabled" Value="False">
										<Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
										<Setter Property="Cursor" Value="Arrow" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
							<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center" />
								<Setter Property="Margin" Value="2,0,2,0" />
							</Style>
							<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
								<Setter Property="StrokeThickness" Value="2.5" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
							<Style BasedOn="{StaticResource VerticalSeparator}" TargetType="Rectangle">
								<!--
									Symmetric: paired with the uniform 1px toolbar button margin this
									yields an identical 7px gutter on both sides of every separator.
								-->
								<Setter Property="Margin" Value="6,0,6,0" />
								<Setter Property="Fill" Value="{DynamicResource ReduxBorderBrush}" />
							</Style>
							<Style x:Key="ToolbarButtonBaseStyle" BasedOn="{StaticResource IconButtonStyle}" TargetType="{x:Type Button}">
								<Setter Property="Width" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Height" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Margin" Value="1,0" />
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderBrush" Value="Transparent" />
								<Setter Property="BorderThickness" Value="1" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								<Setter Property="HorizontalContentAlignment" Value="Center" />
								<Setter Property="VerticalContentAlignment" Value="Center" />
								<Setter Property="Template" Value="{StaticResource ToolbarButtonTemplate}" />
								<Setter Property="Tag" Value="{Binding}" />
							</Style>
							<Style BasedOn="{StaticResource ToolbarButtonBaseStyle}" TargetType="{x:Type Button}" />
							<Style x:Key="ToolbarComboBoxItemStyle" BasedOn="{StaticResource ReduxComboBoxItemStyle}" TargetType="{x:Type ComboBoxItem}">
								<Setter Property="MinHeight" Value="26" />
								<Setter Property="Padding" Value="8,2" />
							</Style>
							<Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type ComboBox}">
								<Setter Property="MinHeight" Value="{DynamicResource Redux.ControlHeight.Compact}" />
								<Setter Property="Height" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Padding" Value="{DynamicResource Redux.Inset.Compact}" />
								<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
								<Setter Property="BorderThickness" Value="1" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								<Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItemStyle}" />
								<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
							</Style>
							<Style x:Key="ToolbarTextButtonStyle" BasedOn="{StaticResource ToolbarButtonBaseStyle}" TargetType="{x:Type Button}">
								<Setter Property="Width" Value="Auto" />
								<Setter Property="Height" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Margin" Value="1,0" />
								<Setter Property="Padding" Value="10,0" />
								<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								<Setter Property="BorderThickness" Value="1" />
								<Setter Property="Tag" Value="{Binding}" />
							</Style>
							<Style x:Key="ToolbarWorkflowButtonStyle" BasedOn="{StaticResource ToolbarTextButtonStyle}" TargetType="{x:Type Button}">
								<Style.Resources>
									<SolidColorBrush x:Key="Toolbar.Button.HoverBrush" Color="{DynamicResource ReduxAccentHoverColor}" />
								</Style.Resources>
								<Setter Property="Padding" Value="12,0" />
								<Setter Property="Background" Value="{DynamicResource ReduxAccentBrush}" />
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
								<Setter Property="BorderThickness" Value="1" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxAccentForegroundBrush}" />
							</Style>
							<Style x:Key="ToolbarWorkflowIconStyle" BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
								<Setter Property="Foreground" Value="{DynamicResource ReduxAccentForegroundBrush}" />
							</Style>
							<SolidColorBrush x:Key="ToolbarHealthErrorSoftBrush" Color="{DynamicResource ReduxErrorColor}" Opacity="0.14" />
							<ControlTemplate x:Key="ToolbarHealthStatusButtonTemplate" TargetType="{x:Type Button}">
								<Border x:Name="StatusChrome"
									Margin="0,1"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									ClipToBounds="True"
									SnapsToDevicePixels="True"
									UseLayoutRounding="True"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
									<Grid>
										<Border x:Name="StatusHoverSurface"
											CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
											Background="{TemplateBinding Foreground}"
											IsHitTestVisible="False"
											Opacity="0" />
										<StackPanel x:Name="StatusContent" Margin="8,0" Orientation="Horizontal">
											<controls:ReduxIcon x:Name="StatusIcon"
												Width="15"
												Height="15"
												VerticalAlignment="Center"
												Foreground="{TemplateBinding Foreground}"
												StrokeData="{StaticResource Redux.Icon.Check}" />
											<controls:ReduxIcon x:Name="StatusChevron"
												Width="11"
												Height="11"
												Margin="4,0,0,0"
												VerticalAlignment="Center"
												Foreground="{TemplateBinding Foreground}"
												RenderTransformOrigin="0.5,0.5"
												StrokeData="{StaticResource Redux.Icon.ChevronRightStroke}">
												<controls:ReduxIcon.RenderTransform>
													<RotateTransform Angle="0" />
												</controls:ReduxIcon.RenderTransform>
											</controls:ReduxIcon>
											<TextBlock x:Name="StatusLabel"
												Margin="6,0,0,0"
												VerticalAlignment="Center"
												FontWeight="SemiBold"
												Foreground="{TemplateBinding Foreground}"
												Opacity="0"
												Text="No issues found" />
										</StackPanel>
									</Grid>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="StatusHoverSurface" Property="Opacity" Value="0.08" />
									</Trigger>
									<DataTrigger Binding="{Binding HasActiveModHealthAttention}" Value="True">
										<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.Danger}" />
										<Setter TargetName="StatusLabel" Property="Text" Value="{Binding ActiveModHealthSummaryText}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding HasActiveModHealthErrors}" Value="True">
										<Setter TargetName="StatusIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.CloseCircle}" />
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
							<Style x:Key="ToolbarHealthStatusButtonStyle" BasedOn="{StaticResource ToolbarButtonBaseStyle}" TargetType="{x:Type Button}">
								<Setter Property="Width" Value="48" />
								<Setter Property="Height" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Margin" Value="8,0,0,0" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="Background" Value="{DynamicResource ReduxSuccessSoftBrush}" />
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
								<Setter Property="BorderThickness" Value="1" />
								<Setter Property="HorizontalAlignment" Value="Right" />
								<Setter Property="Template" Value="{StaticResource ToolbarHealthStatusButtonTemplate}" />
								<Setter Property="ToolTip" Value="{x:Null}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasActiveModHealthAttention}" Value="True">
										<Setter Property="Background" Value="{DynamicResource ReduxWarningSoftBrush}" />
										<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
										<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding HasActiveModHealthErrors}" Value="True">
										<Setter Property="Background" Value="{StaticResource ToolbarHealthErrorSoftBrush}" />
										<Setter Property="BorderBrush" Value="{DynamicResource ReduxErrorBrush}" />
										<Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
							<Style x:Key="ToolbarModHealthMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
								<Setter Property="Padding" Value="0" />
								<Setter Property="Margin" Value="0" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="{x:Type MenuItem}">
											<ContentPresenter
												ContentSource="Header"
												HorizontalAlignment="Stretch"
												RecognizesAccessKey="True" />
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<EventSetter Event="Click" Handler="ToolbarModHealthMenuItem_Click" />
							</Style>
							<Style x:Key="ToolbarModHealthContextMenuStyle" BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}">
								<Setter Property="MinWidth" Value="0" />
								<Setter Property="MaxWidth" Value="410" />
								<Setter Property="Padding" Value="5" />
							</Style>
							<DataTemplate x:Key="ToolbarModHealthMenuItemTemplate" DataType="{x:Type health:ModHealthSnapshot}">
								<Border MinWidth="300"
									MaxWidth="380"
									Padding="8,7"
									Background="Transparent">
									<StackPanel>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border x:Name="HealthIconBadge"
												Width="30"
												Height="30"
												Margin="0,0,9,0"
												Background="{DynamicResource ReduxWarningSoftBrush}"
												CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
												<controls:ReduxIcon x:Name="HealthIcon"
													Width="16"
													Height="16"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Foreground="{DynamicResource ReduxWarningBrush}"
													IconKey="warning" />
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock FontWeight="SemiBold"
													Text="{Binding Mod.DisplayName}"
													TextTrimming="CharacterEllipsis" />
												<TextBlock Margin="0,1,0,0"
													FontSize="{DynamicResource Redux.FontSize.11}"
													Foreground="{DynamicResource ReduxTextSecondaryBrush}"
													Text="{Binding AttentionCountSummary}" />
											</StackPanel>
										</Grid>
										<Border Height="1"
											Margin="0,8,0,7"
											Background="{DynamicResource ReduxBorderBrush}" />
										<ItemsControl ItemsSource="{Binding AttentionFindings}">
											<ItemsControl.ItemTemplate>
												<DataTemplate DataType="{x:Type health:ModHealthFinding}">
													<Grid Margin="1,0,1,6">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="2" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<Border x:Name="FindingRail"
															Background="{DynamicResource ReduxWarningBrush}"
															CornerRadius="1" />
														<StackPanel Grid.Column="1" Margin="9,0,0,0">
															<TextBlock x:Name="FindingTitle"
																FontWeight="SemiBold"
																Foreground="{DynamicResource ReduxWarningBrush}"
																Text="{Binding Title}"
																TextWrapping="Wrap" />
															<TextBlock Margin="0,2,0,0"
																Foreground="{DynamicResource ReduxTextSecondaryBrush}"
																Text="{Binding Message}"
																TextWrapping="Wrap" />
														</StackPanel>
													</Grid>
													<DataTemplate.Triggers>
														<DataTrigger Binding="{Binding Severity}" Value="{x:Static health:ModHealthSeverity.Info}">
															<Setter TargetName="FindingRail" Property="Background" Value="{DynamicResource ReduxInfoBrush}" />
															<Setter TargetName="FindingTitle" Property="Foreground" Value="{DynamicResource ReduxInfoBrush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding Severity}" Value="{x:Static health:ModHealthSeverity.Error}">
															<Setter TargetName="FindingRail" Property="Background" Value="{DynamicResource ReduxErrorBrush}" />
															<Setter TargetName="FindingTitle" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
														</DataTrigger>
													</DataTemplate.Triggers>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding HasOnlyLoadOrderAdvice}" Value="True">
										<Setter TargetName="HealthIconBadge" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
										<Setter TargetName="HealthIcon" Property="IconKey" Value="flag" />
										<Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource ReduxInfoBrush}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding HasErrors}" Value="True">
										<Setter TargetName="HealthIconBadge" Property="Background" Value="{StaticResource ToolbarHealthErrorSoftBrush}" />
										<Setter TargetName="HealthIcon" Property="IconKey" Value="error" />
										<Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
							<Style x:Key="ToolbarGroupLabelStyle" BasedOn="{StaticResource Redux.Text.Overline}" TargetType="{x:Type TextBlock}">
								<Setter Property="Margin" Value="1,0,0,3" />
								<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
								<Setter Property="FontWeight" Value="SemiBold" />
								<Setter Property="Opacity" Value="0.9" />
							</Style>
							<Style BasedOn="{StaticResource {x:Type ContextMenu}}" TargetType="{x:Type ContextMenu}">
								<Setter Property="DataContext" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}" />
							</Style>
						</Grid.Resources>
						<Grid Grid.ColumnSpan="5">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="1" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="1" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<!-- Setup: choose where the work applies, then install into it. -->
							<Grid Grid.Column="0" Margin="0,0,12,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Style="{StaticResource ToolbarGroupLabelStyle}" Text="Setup" />
								<StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
									<Button x:Name="ImportModButton"
										Margin="1,0,7,0"
										Style="{StaticResource ToolbarWorkflowButtonStyle}"
										ToolTip="Install a Mod from an Archive">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.AddCircle}" Style="{StaticResource ToolbarWorkflowIconStyle}" />
											<TextBlock Text="Install Mod" />
										</StackPanel>
									</Button>
									<controls:ReduxIcon Margin="2,0,5,0" StrokeData="{StaticResource Redux.Icon.Person}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
									<ComboBox x:Name="ProfilesComboBox"
										Width="116"
										DisplayMemberPath="Name"
										IsEditable="False"
										IsTextSearchEnabled="False"
										Tag="{Binding}"
										ToolTip="Active profile">
										<ComboBox.ContextMenu>
											<ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
												<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding SelectedProfile.Folder}" Header="Open Profile Folder in File Explorer...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding SelectedProfile.Folder}" Header="Copy Profile Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</ComboBox.ContextMenu>
									</ComboBox>
									<controls:ReduxIcon Margin="9,0,5,0" StrokeData="{StaticResource Redux.Icon.Map}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
									<ComboBox x:Name="AdventureModComboBox"
										Width="104"
										DisplayMemberPath="DisplayName"
										IsTextSearchEnabled="False"
										Tag="{Binding}"
										ToolTip="{StaticResource ModToolTip}">
										<ComboBox.ContextMenu>
											<ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
												<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding FilePath}" Header="Open Adventure Mod in File Explorer...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding Path=CopyToClipboardCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding FilePath}" Header="Copy Mod Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</ComboBox.ContextMenu>
									</ComboBox>
								</StackPanel>
							</Grid>

							<Rectangle Grid.Column="1" Width="1" Margin="0,8" Fill="{DynamicResource ReduxBorderBrush}" Opacity="0.7" />

							<!-- Order & Export: select, save, then publish the active load order. -->
							<Grid Grid.Column="2" Margin="12,0" ClipToBounds="False">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.ColumnSpan="3" Style="{StaticResource ToolbarGroupLabelStyle}" Text="Order &amp; Export" />
								<StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
									<controls:ReduxIcon Margin="1,0,5,0" StrokeData="{StaticResource Redux.Icon.ListStroke}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" />
									<ComboBox x:Name="OrdersComboBox"
										Margin="0,0,1,0"
										MinWidth="146"
										MaxWidth="220"
										DisplayMemberPath="Name"
										IsTextSearchEnabled="False"
										KeyDown="ComboBox_KeyDown_LoseFocus"
										Loaded="OrdersComboBox_Loaded"
										LostFocus="OrdersComboBox_LostFocus"
										Tag="{Binding}"
										ToolTip="Current load order">
										<ComboBox.ItemContainerStyle>
											<Style BasedOn="{StaticResource ToolbarComboBoxItemStyle}" TargetType="ComboBoxItem">
												<EventSetter Event="ComboBoxItem.PreviewMouseDown" Handler="OrderComboBox_OnUserClick" />
											</Style>
										</ComboBox.ItemContainerStyle>
										<ComboBox.ContextMenu>
											<ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.Tag}">
												<MenuItem Command="{Binding ToggleOrderRenamingCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}, Path=PlacementTarget}" Header="Rename">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Create}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding SelectedModOrder.FilePath}" Header="Open in File Explorer...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding SelectedModOrder.FilePath}" Header="Copy Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding DeleteOrderCommand}" CommandParameter="{Binding SelectedModOrder}" Header="Delete Order">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</ComboBox.ContextMenu>
									</ComboBox>
									<Rectangle Width="1" Height="20" />
									<Button x:Name="SaveButton" ToolTip="Save Load Order to File">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Save}" />
									</Button>
									<Button x:Name="SaveAsButton" ToolTip="Save Order As...">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Duplicate}" />
									</Button>
									<Button x:Name="AddNewOrderButton" ToolTip="Add New Load Order">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" />
									</Button>
									<Rectangle Width="1" Height="20" />
									<Button x:Name="ExportToModSettingsButton"
										Style="{StaticResource ToolbarWorkflowButtonStyle}"
										ToolTip="Export Order to Game">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.CloudUpload}" Style="{StaticResource ToolbarWorkflowIconStyle}" />
											<TextBlock Text="Export to Game" />
										</StackPanel>
										<Button.ContextMenu>
											<ContextMenu>
												<MenuItem Command="{Binding Path=OpenFileCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding SelectedProfile.ModSettingsFile}" Header="Open Exported Mod Order File...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Open}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding SelectedProfile.ModSettingsFile}" Header="Open in File Explorer...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding SelectedProfile.ModSettingsFile}" Header="Copy Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding CopyOrderToClipboardCommand}" Header="Copy Order to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Clipboard}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding ExportOrderAsListCommand}" Header="Export Order As List...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.DocumentText}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</Button.ContextMenu>
									</Button>
									<Rectangle Width="1" Height="20" />
									<Button x:Name="ExportOrderToArchiveButton" ToolTip="Export Active Mods to Zip">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Archive}" />
									</Button>
									<Button x:Name="ExportOrderToArchiveAsButton" ToolTip="Export Active Mods to Zip As...">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Duplicate}" />
									</Button>
									<Rectangle Width="1" Height="20" />
									<Button x:Name="RefreshButton" ToolTip="Refresh Mods">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
									</Button>
									<Button x:Name="OpenModsFolderButton" ToolTip="Open Mods Folder">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" />
										<Button.ContextMenu>
											<ContextMenu>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding PathwayData.AppDataModsPath}" Header="Copy Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</Button.ContextMenu>
									</Button>
									<Button x:Name="OpenExtenderLogsFolderButton" ToolTip="Open Logs Folder">
										<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.DocumentText}" />
										<Button.ContextMenu>
											<ContextMenu>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding Settings.ExtenderLogDirectory}" Header="Copy Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</Button.ContextMenu>
									</Button>
								</StackPanel>
								<Button x:Name="ToolbarModHealthStatusButton"
									Grid.Row="1"
									Grid.Column="2"
									Click="ToolbarModHealthStatusButton_Click"
									ContextMenuOpening="ToolbarModHealthStatusButton_ContextMenuOpening"
									MouseEnter="ToolbarModHealthStatusButton_MouseEnter"
									MouseLeave="ToolbarModHealthStatusButton_MouseLeave"
									Style="{StaticResource ToolbarHealthStatusButtonStyle}"
									Tag="{Binding}"
									Visibility="{Binding Modules.ModHealthEnabled, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
									<Button.ContextMenu>
										<ContextMenu
											Closed="ToolbarModHealthMenu_Closed"
											Opened="ToolbarModHealthMenu_Opened"
											ItemContainerStyle="{StaticResource ToolbarModHealthMenuItemStyle}"
											ItemTemplate="{StaticResource ToolbarModHealthMenuItemTemplate}"
											ItemsSource="{Binding PlacementTarget.DataContext.ActiveModHealthAttentionSnapshots, RelativeSource={RelativeSource Self}}"
											Style="{StaticResource ToolbarModHealthContextMenuStyle}" />
									</Button.ContextMenu>
								</Button>
							</Grid>

							<Rectangle Grid.Column="3" Width="1" Margin="0,8" Fill="{DynamicResource ReduxBorderBrush}" Opacity="0.7" />

							<!-- Play: the final action remains visually distinct and anchored to the right edge. -->
							<Grid Grid.Column="4" Margin="12,0,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Style="{StaticResource ToolbarGroupLabelStyle}" Text="Play" />
								<StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
									<ComboBox x:Name="GameLaunchActionComboBox"
										Width="106"
										Margin="1,0,6,0"
										DisplayMemberPath="Description"
										ItemsSource="{Binding Source={ext:EnumExtension {x:Type dapp:DivinityGameLaunchWindowAction}}}"
										SelectedValuePath="Value"
										ToolTip="Choose what Redux does after launching the game." />
									<Button x:Name="OpenGameButton"
										Style="{StaticResource ToolbarWorkflowButtonStyle}"
										ToolTip="Launch Game (Ctrl+Shift+G)">
										<StackPanel Orientation="Horizontal">
											<controls:ReduxIcon Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.GameController}" Style="{StaticResource ToolbarWorkflowIconStyle}" />
											<TextBlock Text="Launch Game" />
										</StackPanel>
										<Button.ContextMenu>
											<ContextMenu>
												<MenuItem Command="{Binding Path=OpenInFileExplorerCommand, Source={x:Static dapp:DivinityApp.Commands}}" CommandParameter="{Binding Settings.GameExecutablePath}" Header="Open Game Folder...">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /></MenuItem.Icon>
												</MenuItem>
												<MenuItem Command="{Binding CopyPathToClipboardCommand}" CommandParameter="{Binding Settings.GameExecutablePath}" Header="Copy Path to Clipboard">
													<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Copy}" /></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</Button.ContextMenu>
									</Button>
								</StackPanel>
							</Grid>

							<Button x:Name="OpenDonationPageButton"
								Visibility="Collapsed"
								ToolTip="Tip the Developer (Ko-fi)&#x0a;https://ko-fi.com/laughingleader">
								<controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Heart}" />
							</Button>
							<Button x:Name="OpenRepoPageButton"
								Visibility="Collapsed"
								ToolTip="Open Project Page (Github)">
								<ContentControl ContentTemplate="{DynamicResource GithubPlatformIconTemplate}" />
							</Button>
						</Grid>
						</Grid>
					</Border>
					<local:HorizontalModLayout x:Name="ModLayout" Grid.Row="2" />
				</Grid>
				<local:ModUpdatesLayout x:Name="ModUpdaterPanel" Grid.Row="2" Background="{DynamicResource ReduxSurfaceBrush}" />
			</Grid>
		</xc:BusyIndicator>
		<StatusBar Grid.Row="1"
			MinHeight="16"
			Background="{DynamicResource ReduxWindowBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="0,1,0,0"
			Foreground="{DynamicResource ReduxTextSecondaryBrush}">
			<StatusBarItem HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<controls:BusyIndicator x:Name="StatusBarBusyIndicator"
				    Grid.Column="0"
				    Width="16"
				    Height="16"
				    Margin="2"
				    Visibility="Collapsed" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<controls:AlertBar x:Name="AlertBar" Theme="Standard" />
			</StatusBarItem>
			<StatusBarItem Padding="8,0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
				<TextBlock x:Name="StatusBarLoadingOperationTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</StatusBarItem>
		</StatusBar>
	</Grid>
</local:MainViewControlViewBase>
