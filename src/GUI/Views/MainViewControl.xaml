								<Setter Property="Height" Value="{DynamicResource Redux.ControlHeight.Standard}" />
								<Setter Property="Margin" Value="1,0" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="Background" Value="Transparent" />
