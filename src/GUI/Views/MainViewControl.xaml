<local:MainViewControlViewBase x:Class="DivinityModManager.Views.MainViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<UserControl.Style>
		<Style BasedOn="{StaticResource {x:Type UserControl}}" TargetType="UserControl" />
	</UserControl.Style>
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}" />
			<ControlTemplate x:Key="ToolbarStatusMenuItemTemplate" TargetType="{x:Type MenuItem}">
				<ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" RecognizesAccessKey="True" />
			</ControlTemplate>
			<!--
				The Template is assigned from Role triggers, not a plain setter: the base MenuItem
				style sets Template from a Role trigger too, and a trigger outranks a setter. With a
				plain setter these rows silently kept the full popup row template, giving the card a
				large invisible hover surface behind it.
			-->
			<Style x:Key="ToolbarStatusMenuItemStyle"
				BasedOn="{StaticResource {x:Type MenuItem}}"
				TargetType="{x:Type MenuItem}">
				<Setter Property="Padding" Value="0" />
				<Setter Property="Margin" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
				<EventSetter Event="Click" Handler="ToolbarModHealthMenuItem_Click" />
				<Style.Triggers>
					<Trigger Property="Role" Value="SubmenuItem">
						<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="SubmenuHeader">
						<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ToolbarStaticStatusMenuItemStyle"
				BasedOn="{StaticResource ToolbarStatusMenuItemStyle}"
				TargetType="{x:Type MenuItem}">
				<Setter Property="IsHitTestVisible" Value="False" />
			</Style>
			<!--
				The shared status card already draws the surface, border and padding. Without this
				the ContextMenu draws a second card around it, which is where the doubled padding
				and outline came from. Strip the menu chrome and let the card be the only surface.
			-->
			<Style x:Key="ToolbarStatusContextMenuStyle"
				BasedOn="{StaticResource {x:Type ContextMenu}}"
				TargetType="{x:Type ContextMenu}">
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="MaxWidth" Value="420" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FontFamily" Value="{DynamicResource Redux.FontFamily.UI}" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ContextMenu}">
							<Grid Margin="4">
								<ItemsPresenter />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="ToolbarHealthAffectedModTemplate">
				<Grid Margin="0,3,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ContentControl Width="14"
						Height="14"
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						Content="{Binding Mod.DisplayCategories[0]}"
						ContentTemplate="{DynamicResource ReduxCategoryGlyphTemplate}" />
					<TextBlock Grid.Column="1"
						VerticalAlignment="Center"
						FontSize="{DynamicResource Redux.FontSize.11}"
						FontWeight="SemiBold"
						Text="{Binding Mod.DisplayName}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding Mod.DisplayName}">
						<TextBlock.Style>
							<Style TargetType="{x:Type TextBlock}">
								<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True">
										<Setter Property="Foreground" Value="{Binding Mod.DisplayCategories[0].Color}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="ToolbarHealthFindingGroupTemplate">
				<Border Style="{StaticResource ReduxStatusFindingStyle}">
					<StackPanel>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock FontWeight="SemiBold"
								Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
								Text="{Binding Title}"
								TextWrapping="Wrap" />
							<Border Grid.Column="1"
								Margin="8,0,0,0"
								Padding="6,1"
								VerticalAlignment="Top"
								Background="{DynamicResource ReduxSurfaceMutedBrush}"
								BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
								BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
								<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
									FontWeight="SemiBold"
									Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
									Text="{Binding AffectedCountText}" />
							</Border>
						</Grid>
						<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}" Text="{Binding Message}" />
						<ItemsControl Margin="0,3,0,0"
							ItemTemplate="{StaticResource ToolbarHealthAffectedModTemplate}"
							ItemsSource="{Binding AffectedMods}" />
					</StackPanel>
				</Border>
			</DataTemplate>
			<Style x:Key="ToolbarHealthContextMenuStyle"
				BasedOn="{StaticResource ToolbarStatusContextMenuStyle}"
				TargetType="{x:Type ContextMenu}">
				<Setter Property="MaxWidth" Value="{DynamicResource Redux.StatusMenu.MaxWidth}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ContextMenu}">
							<Grid Margin="4">
								<Border MaxWidth="{DynamicResource Redux.StatusMenu.MaxWidth}"
									Style="{StaticResource ReduxStatusCardChromeStyle}">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border Style="{StaticResource ReduxStatusCardBadgeStyle}">
												<controls:ReduxIcon x:Name="HealthMenuIcon"
													Width="15"
													Height="15"
													Foreground="{DynamicResource ReduxWarningBrush}"
													IconKey="search-alert" />
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock x:Name="HealthMenuTitle"
													Style="{StaticResource ReduxStatusCardTitleStyle}"
													Text="Review recommended" />
												<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}"
													Text="{Binding PlacementTarget.DataContext.ActiveModHealthSummaryText, RelativeSource={RelativeSource TemplatedParent}}" />
											</StackPanel>
										</Grid>
										<Border Grid.Row="1" Style="{StaticResource ReduxStatusCardDividerStyle}" />
										<ScrollViewer Grid.Row="2"
											MaxHeight="{DynamicResource Redux.StatusMenu.MaxHeight}"
											CanContentScroll="True"
											HorizontalScrollBarVisibility="Disabled"
											VerticalScrollBarVisibility="Auto">
											<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
										</ScrollViewer>
									</Grid>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<DataTrigger Binding="{Binding PlacementTarget.DataContext.HasActiveModHealthErrors, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
									<Setter TargetName="HealthMenuIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
									<Setter TargetName="HealthMenuIcon" Property="IconKey" Value="warning" />
									<Setter TargetName="HealthMenuTitle" Property="Text" Value="Action recommended" />
								</DataTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="ToolbarAdvisorStatusMenuTemplate">
				<Border Style="{StaticResource ReduxStatusCardChromeStyle}">
					<StackPanel>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource ReduxStatusCardBadgeStyle}">
								<controls:ReduxIcon x:Name="AdvisorIcon"
									Width="15"
									Height="15"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ReduxSuccessBrush}"
									StrokeData="{StaticResource Redux.Icon.ShieldCheck}" />
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Style="{StaticResource ReduxStatusCardTitleStyle}" Text="{Binding LoadOrderAdvisorDebugText}" />
								<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}" Text="{Binding LoadOrderAdvisorDebugSummaryText}" />
							</StackPanel>
						</Grid>
						<Border Style="{StaticResource ReduxStatusCardDividerStyle}" />
						<Border x:Name="AdvisorFinding"
							BorderBrush="{DynamicResource ReduxSuccessBrush}"
							Style="{StaticResource ReduxStatusFindingStyle}">
							<StackPanel>
								<TextBlock x:Name="AdvisorFindingTitle"
									FontWeight="SemiBold"
									Foreground="{DynamicResource ReduxSuccessBrush}"
									Text="{Binding LoadOrderAdvisorDebugDetailTitle}"
									TextWrapping="Wrap" />
								<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}" Text="{Binding LoadOrderAdvisorDebugTooltip}" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding LoadOrderAdvisorDebugHasWarnings}" Value="True">
						<Setter TargetName="AdvisorIcon" Property="StrokeData" Value="{StaticResource Redux.Icon.SearchAlert}" />
						<Setter TargetName="AdvisorIcon" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="AdvisorFinding" Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
						<Setter TargetName="AdvisorFindingTitle" Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
					</DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<!--
				Single definition of Redux menu presentation for every MenuItem role. Both the
				menu bar implicit style and MenuItemHighlightBlink derive from this, so an item
				carrying an explicit style (Tools) cannot silently fall back to stock chrome.
			-->
			<Style x:Key="ReduxMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
				<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
				<!-- MenuItem popups are a separate visual window and do not reliably inherit typography. -->
				<Setter Property="FontFamily" Value="{DynamicResource Redux.FontFamily.UI}" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Style.Triggers>
					<Trigger Property="Role" Value="TopLevelHeader">
						<Setter Property="Padding" Value="8,4" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Template" Value="{DynamicResource ReduxTopLevelMenuHeaderTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="TopLevelItem">
						<Setter Property="Padding" Value="8,4" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Template" Value="{DynamicResource ReduxTopLevelMenuHeaderTemplate}" />
					</Trigger>
					<!-- Inset rows horizontally so their highlight cannot paint over the popup corner arcs. -->
					<Trigger Property="Role" Value="SubmenuHeader">
						<Setter Property="Margin" Value="1,0" />
						<Setter Property="Template" Value="{DynamicResource ReduxPopupMenuItemTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="SubmenuItem">
						<Setter Property="Margin" Value="1,0" />
						<Setter Property="Template" Value="{DynamicResource ReduxPopupMenuItemTemplate}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="MenuItemHighlightBlink" BasedOn="{StaticResource ReduxMenuItemStyle}" TargetType="{x:Type MenuItem}">
				<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<DataTrigger.EnterActions>
							<BeginStoryboard Name="BlinkyMenuItemStoryboard">
								<Storyboard AutoReverse="True"
								    BeginTime="00:00:00"
								    FillBehavior="Stop"
								    RepeatBehavior="Forever"
								    Duration="0:0:0.5">
									<DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" />
								</Storyboard>
							</BeginStoryboard>
						</DataTrigger.EnterActions>
						<DataTrigger.ExitActions>
							<StopStoryboard BeginStoryboardName="BlinkyMenuItemStoryboard" />
						</DataTrigger.ExitActions>
					</DataTrigger>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="False">
						<Setter Property="Opacity" Value="1.0" />
						<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Background="{DynamicResource ReduxWindowBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<xc:BusyIndicator x:Name="MainBusyIndicator" Style="{StaticResource BusyIndicatorProgressStyle}" Visibility="Hidden">
			<xc:BusyIndicator.BusyContent>
				<Grid Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock HorizontalAlignment="Center"
					    FontSize="{DynamicResource Redux.FontSize.16}"
					    FontWeight="Bold"
					    Text="{Binding MainProgressTitle, FallbackValue='Archiving...'}" />
					<DockPanel Grid.Row="1" Margin="8">
						<TextBlock HorizontalAlignment="Center"
						    VerticalAlignment="Center"
						    DockPanel.Dock="Bottom"
						    Text="{Binding MainProgressWorkText, FallbackValue='Archiving pak 4/10...'}"
						    TextAlignment="Center" />
						<ProgressBar MinHeight="15" Style="{StaticResource ReduxProgressBarStyle}"
						    VerticalAlignment="Center"
						    DockPanel.Dock="Top"
						    Maximum="1"
						    Value="{Binding MainProgressValue, FallbackValue='0'}" />
					</DockPanel>
					<Button Grid.Row="2"
					    Margin="8,0,8,8"
					    Padding="20,4"
					    HorizontalAlignment="Center"
					    VerticalAlignment="Center"
					    Command="{Binding CancelMainProgressCommand}"
					    Content="Cancel"
					    Visibility="{Binding CanCancelProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
				</Grid>
			</xc:BusyIndicator.BusyContent>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<local:DeleteFilesConfirmationView x:Name="DeleteFilesView" Grid.RowSpan="3" Panel.ZIndex="99" />
				<Rectangle x:Name="ModListRectangle"
				    Grid.RowSpan="3"
				    HorizontalAlignment="Stretch"
				    VerticalAlignment="Stretch"
				    Panel.ZIndex="98"
				    Fill="{DynamicResource ReduxWindowBrush}" />
				<Grid Background="{DynamicResource ReduxWindowBrush}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.Resources>
						<ControlTemplate x:Key="CompactTopBarStatusButtonTemplate" TargetType="{x:Type Button}">
							<Border x:Name="StatusChrome"
								Margin="0,1"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
								SnapsToDevicePixels="True">
								<Grid>
									<Border x:Name="HoverSurface"
										Background="{TemplateBinding Foreground}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
										IsHitTestVisible="False"
										Opacity="0" />
									<controls:ReduxIcon Width="13"
										Height="13"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{TemplateBinding Foreground}"
										IconKey="{TemplateBinding Tag}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HoverSurface" Property="Opacity" Value="0.1" />
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="HoverSurface" Property="Opacity" Value="0.16" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
						<Style x:Key="CompactTopBarStatusButtonStyle" TargetType="{x:Type Button}">
							<Setter Property="Width" Value="27" />
							<Setter Property="Height" Value="22" />
							<Setter Property="Margin" Value="3,0" />
							<Setter Property="Padding" Value="0" />
							<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
							<Setter Property="BorderBrush" Value="{DynamicResource ReduxSuccessBrush}" />
							<Setter Property="BorderThickness" Value="1.25" />
							<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
							<Setter Property="FocusVisualStyle" Value="{x:Null}" />
							<Setter Property="Cursor" Value="Hand" />
							<Setter Property="Tag" Value="check" />
							<Setter Property="Template" Value="{StaticResource CompactTopBarStatusButtonTemplate}" />
						</Style>
						<Style x:Key="CompactTopBarHealthStatusButtonStyle"
							BasedOn="{StaticResource CompactTopBarStatusButtonStyle}"
							TargetType="{x:Type Button}">
							<!-- The base style's default Tag ("check") has no IconKey mapping and renders
							     blank; the clear state needs its own real icon, same as the Advisor style. -->
							<Setter Property="Tag" Value="shield-check" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasActiveModHealthAttention}" Value="True">
									<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
									<Setter Property="Tag" Value="search-alert" />
								</DataTrigger>
								<DataTrigger Binding="{Binding HasActiveModHealthErrors}" Value="True">
									<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxErrorBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
									<Setter Property="Tag" Value="error" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
						<Style x:Key="CompactTopBarAdvisorStatusButtonStyle"
							BasedOn="{StaticResource CompactTopBarStatusButtonStyle}"
							TargetType="{x:Type Button}">
							<Setter Property="Tag" Value="shield-check" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding LoadOrderAdvisorDebugHasWarnings}" Value="True">
									<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxWarningBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
									<Setter Property="Tag" Value="search-alert" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Modules.LoadOrderAdvisorEnabled}" Value="False">
									<Setter Property="Background" Value="{DynamicResource ReduxSurfaceMutedBrush}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
									<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
									<Setter Property="Tag" Value="search-alert" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Resources>
					<Menu x:Name="TopMenuBar"
						Padding="4,2"
						Background="{DynamicResource ReduxWindowBrush}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						FontFamily="{DynamicResource Redux.FontFamily.UI}"
						FontSize="{DynamicResource Redux.FontSize.12}">
						<Menu.Resources>
							<Style BasedOn="{StaticResource ReduxMenuItemStyle}" TargetType="{x:Type MenuItem}" />
						</Menu.Resources>
						<MenuItem x:Name="FileMenuItem" Header="File" />
						<MenuItem x:Name="EditMenuItem" Header="Edit" />
						<MenuItem x:Name="SettingsMenuItem" Header="Settings" />
						<MenuItem x:Name="AccessibilityMenuItem" Header="Accessibility" />
						<MenuItem x:Name="ToolsMenuItem" Header="Tools" Style="{StaticResource MenuItemHighlightBlink}" />
						<!-- A compact command surface remains available whenever the visual toolbar is hidden. -->
						<MenuItem Header="Toolbar"
							Visibility="{Binding Settings.HideToolbar, Converter={StaticResource BoolToVisibilityConverter}}">
							<MenuItem Header="Setup">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Settings}" /></MenuItem.Icon>
								<MenuItem Command="{Binding Keys.ImportMod.Command}" Header="Install Mod..." InputGestureText="{Binding Keys.ImportMod.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem x:Name="ToolbarProfileMenu"
									Header="Profile"
									DisplayMemberPath="Name"
									ItemsSource="{Binding Profiles}"
									SubmenuOpened="ToolbarProfileMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarProfileMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
								<MenuItem x:Name="ToolbarCampaignMenu"
									Header="Campaign"
									DisplayMemberPath="DisplayName"
									ItemsSource="{Binding AdventureMods}"
									SubmenuOpened="ToolbarCampaignMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarCampaignMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
							</MenuItem>
							<MenuItem Header="Load Order">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.ListStroke}" /></MenuItem.Icon>
								<MenuItem x:Name="ToolbarLoadOrderMenu"
									Header="Current Order"
									DisplayMemberPath="Name"
									ItemsSource="{Binding ModOrderList}"
									SubmenuOpened="ToolbarLoadOrderMenu_SubmenuOpened">
									<MenuItem.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
											<Setter Property="IsCheckable" Value="True" />
											<EventSetter Event="Click" Handler="ToolbarLoadOrderMenuItem_Click" />
										</Style>
									</MenuItem.ItemContainerStyle>
								</MenuItem>
								<Separator />
								<MenuItem Command="{Binding Keys.Save.Command}" Header="Save Order" InputGestureText="{Binding Keys.Save.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Save}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.SaveAs.Command}" Header="Save Order As..." InputGestureText="{Binding Keys.SaveAs.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Duplicate}" /></MenuItem.Icon>
								</MenuItem>
								<MenuItem Command="{Binding Keys.NewOrder.Command}" Header="New Load Order" InputGestureText="{Binding Keys.NewOrder.DisplayBindingText}">
									<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddCircle}" /></MenuItem.Icon>
								</MenuItem>
							</MenuItem>
							<MenuItem Header="Export">
								<MenuItem.Icon><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.CloudUpload}" /></MenuItem.Icon>
								<MenuItem Command="{Binding Keys.ExportOrderToGame.Command}" Header="Export to Game" InputGestureText="{Binding Keys.ExportOrderToGame.DisplayBindingText}">
