<local:MainViewControlViewBase x:Class="DivinityModManager.Views.MainViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
    xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
    xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
    xmlns:local="clr-namespace:DivinityModManager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:util="clr-namespace:DivinityModManager.Util"
    xmlns:xc="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<UserControl.Style>
		<Style BasedOn="{StaticResource {x:Type UserControl}}" TargetType="UserControl" />
	</UserControl.Style>
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}" />
			<ControlTemplate x:Key="ToolbarStatusMenuItemTemplate" TargetType="{x:Type MenuItem}">
				<ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" RecognizesAccessKey="True" />
			</ControlTemplate>
			<!--
				The Template is assigned from Role triggers, not a plain setter: the base MenuItem
				style sets Template from a Role trigger too, and a trigger outranks a setter. With a
				plain setter these rows silently kept the full popup row template, giving the card a
				large invisible hover surface behind it.
			-->
			<Style x:Key="ToolbarStatusMenuItemStyle"
				BasedOn="{StaticResource {x:Type MenuItem}}"
				TargetType="{x:Type MenuItem}">
				<Setter Property="Padding" Value="0" />
				<Setter Property="Margin" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
				<EventSetter Event="Click" Handler="ToolbarModDiagnosticsMenuItem_Click" />
				<Style.Triggers>
					<Trigger Property="Role" Value="SubmenuItem">
						<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="SubmenuHeader">
						<Setter Property="Template" Value="{StaticResource ToolbarStatusMenuItemTemplate}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<!--
				The shared status card already draws the surface, border and padding. Without this
				the ContextMenu draws a second card around it, which is where the doubled padding
				and outline came from. Strip the menu chrome and let the card be the only surface.
			-->
			<Style x:Key="ToolbarStatusContextMenuStyle"
				BasedOn="{StaticResource {x:Type ContextMenu}}"
				TargetType="{x:Type ContextMenu}">
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="MaxWidth" Value="420" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FontFamily" Value="{DynamicResource Redux.FontFamily.UI}" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ContextMenu}">
							<Grid Margin="4">
								<ItemsPresenter />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="ToolbarDiagnosticAffectedModButtonStyle" TargetType="{x:Type Button}">
				<Setter Property="MinHeight" Value="24" />
				<Setter Property="HorizontalAlignment" Value="Stretch" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Padding" Value="7,3" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type Button}">
							<Border x:Name="AffectedModChrome"
								Background="{TemplateBinding Background}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
								util:ReduxWindowBehavior.HoverLift="1"
								RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform>
									<TranslateTransform x:Name="AffectedModTranslate" Y="0" />
								</Border.RenderTransform>
								<Grid>
									<Border x:Name="AffectedModHoverSurface"
										Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										OpacityMask="{StaticResource Redux.Hover.WashMask}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												<Style.Triggers>
													<DataTrigger
														Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForInteractions)}"
														Value="True">
														<Setter Property="Background"
															Value="{Binding Mod.DisplayCategories[0].Color, Converter={StaticResource StringToSolidBrushConverter}, ConverterParameter=4D, FallbackValue=#4D8F879E}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border x:Name="AffectedModHoverRail"
										Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
										BorderThickness="{DynamicResource Redux.Rail.Thickness}"
										CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
												<Style.Triggers>
													<DataTrigger
														Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForInteractions)}"
														Value="True">
														<Setter Property="BorderBrush"
															Value="{Binding Mod.DisplayCategories[0].Color, Converter={StaticResource StringToSolidBrushConverter}, FallbackValue=#8F879E}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<ContentPresenter Margin="{TemplateBinding Padding}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="AffectedModHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="0.62"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												<DoubleAnimation Storyboard.TargetName="AffectedModHoverRail"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="AffectedModHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
												<DoubleAnimation Storyboard.TargetName="AffectedModHoverRail"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="AffectedModHoverSurface" Property="Opacity" Value="0.62" />
									<Setter TargetName="AffectedModHoverRail" Property="Opacity" Value="1" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="ToolbarDiagnosticAffectedModTemplate">
				<Button Click="ToolbarDiagnosticAffectedMod_Click"
					CommandParameter="{Binding Snapshot}"
					Style="{StaticResource ToolbarDiagnosticAffectedModButtonStyle}"
					ToolTip="{Binding Mod.DisplayName, StringFormat=Focus {0}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ContentControl Width="14"
							Height="14"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Content="{Binding Mod.DisplayCategories[0]}"
							ContentTemplate="{DynamicResource ReduxCategoryGlyphTemplate}">
							<ContentControl.Style>
								<Style TargetType="{x:Type ContentControl}">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons)}" Value="False">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ContentControl.Style>
						</ContentControl>
						<TextBlock Grid.Column="1"
							VerticalAlignment="Center"
							FontSize="{DynamicResource Redux.FontSize.11}"
							FontWeight="SemiBold"
							Text="{Binding Mod.DisplayName}"
							TextTrimming="CharacterEllipsis">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True">
											<Setter Property="Foreground" Value="{Binding Mod.DisplayCategories[0].Color}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<controls:ReduxIcon Grid.Column="2"
							Width="10"
							Height="10"
							Margin="8,0,0,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							StrokeData="{StaticResource Redux.Icon.ChevronRightStroke}" />
					</Grid>
				</Button>
			</DataTemplate>
			<DataTemplate x:Key="ToolbarDiagnosticFindingGroupTemplate">
				<Border Style="{StaticResource ReduxStatusFindingStyle}">
					<StackPanel>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock FontWeight="SemiBold"
								Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
								Text="{Binding Title}"
								TextWrapping="Wrap" />
							<Border Grid.Column="1"
								Margin="8,0,0,0"
								Padding="6,1"
								VerticalAlignment="Top"
								Background="{DynamicResource ReduxSurfaceMutedBrush}"
								BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
								BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
								<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
									FontWeight="SemiBold"
									Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
									Text="{Binding AffectedCountText}" />
							</Border>
						</Grid>
						<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}" Text="{Binding Message}" />
						<ItemsControl Margin="0,4,0,0"
							ItemTemplate="{StaticResource ToolbarDiagnosticAffectedModTemplate}"
							ItemsSource="{Binding AffectedMods}">
							<ItemsControl.ItemContainerStyle>
								<Style TargetType="{x:Type ContentPresenter}">
									<Setter Property="HorizontalAlignment" Value="Stretch" />
								</Style>
							</ItemsControl.ItemContainerStyle>
						</ItemsControl>
						<WrapPanel Margin="0,7,0,0"
							Visibility="{Binding HasDiagnosticActions, Converter={StaticResource BoolToVisibilityConverter}}">
							<Button Margin="0,0,6,0"
								Click="ToolbarDiagnosticRelatedMod_Click"
								CommandParameter="{Binding PrimaryRelatedMod}"
								Style="{StaticResource ReduxSecondaryActionButtonStyle}"
								Visibility="{Binding CanRevealRelatedDependency, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13"
										Height="13"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.Eye}" />
									<TextBlock VerticalAlignment="Center" Text="{Binding RelatedDependencyActionText}" />
								</StackPanel>
							</Button>
							<Button Margin="0,0,6,0"
								Click="ToolbarDiagnosticActivateDependency_Click"
								CommandParameter="{Binding}"
								Style="{StaticResource ReduxSecondaryActionButtonStyle}"
								ToolTip="Add the installed dependency to the end of the current working order"
								Visibility="{Binding CanActivateRelatedDependency, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13"
										Height="13"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.CircleCheck}" />
									<TextBlock VerticalAlignment="Center" Text="Activate" />
								</StackPanel>
							</Button>
							<Button Margin="0,0,6,0"
								Click="ToolbarDiagnosticRelatedSource_Click"
								CommandParameter="{Binding PrimaryRelatedSourceUrl}"
								Style="{StaticResource ReduxSecondaryActionButtonStyle}"
								ToolTip="Open the dependency's known source page"
								Visibility="{Binding CanOpenRelatedDependencySource, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13"
										Height="13"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.LinkStroke}" />
									<TextBlock VerticalAlignment="Center" Text="Dependency page" />
								</StackPanel>
							</Button>
							<Button Margin="0,0,6,0"
								Click="ToolbarDiagnosticCopyDependencyUuid_Click"
								CommandParameter="{Binding PrimaryRelatedModUuid}"
								Style="{StaticResource ReduxSecondaryActionButtonStyle}"
								ToolTip="Copy the dependency UUID"
								Visibility="{Binding CanCopyRelatedDependencyUuid, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13"
										Height="13"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.Copy}" />
									<TextBlock VerticalAlignment="Center" Text="Copy UUID" />
								</StackPanel>
							</Button>
							<Button Click="ToolbarDiagnosticAffectedSource_Click"
								CommandParameter="{Binding PrimarySnapshot.Mod}"
								Style="{StaticResource ReduxSecondaryActionButtonStyle}"
								ToolTip="Open the linked mod page to review the author's requirements"
								Visibility="{Binding CanOpenAffectedModSource, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal">
									<controls:ReduxIcon Width="13"
										Height="13"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
										StrokeData="{StaticResource Redux.Icon.LinkStroke}" />
									<TextBlock VerticalAlignment="Center" Text="Review requirements" />
								</StackPanel>
							</Button>
						</WrapPanel>
					</StackPanel>
				</Border>
			</DataTemplate>
			<Style x:Key="ToolbarDiagnosticContextMenuStyle"
				BasedOn="{StaticResource ToolbarStatusContextMenuStyle}"
				TargetType="{x:Type ContextMenu}">
				<Setter Property="MaxWidth" Value="{DynamicResource Redux.StatusMenu.MaxWidth}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ContextMenu}">
							<Grid Margin="4">
								<Border MaxWidth="{DynamicResource Redux.StatusMenu.MaxWidth}"
									Style="{StaticResource ReduxStatusCardChromeStyle}">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border Style="{StaticResource ReduxStatusCardBadgeStyle}">
												<controls:ReduxIcon x:Name="DiagnosticMenuIcon"
													Width="15"
													Height="15"
													Foreground="{DynamicResource ReduxWarningBrush}"
													IconKey="search-alert" />
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock x:Name="DiagnosticMenuTitle"
													Style="{StaticResource ReduxStatusCardTitleStyle}"
													Text="Review recommended" />
												<TextBlock Style="{StaticResource ReduxStatusCardSubtitleStyle}"
													Text="{Binding PlacementTarget.DataContext.ActiveDiagnosticSummaryText, RelativeSource={RelativeSource TemplatedParent}}" />
											</StackPanel>
										</Grid>
										<Border Grid.Row="1" Style="{StaticResource ReduxStatusCardDividerStyle}" />
										<ScrollViewer Grid.Row="2"
											MaxHeight="{DynamicResource Redux.StatusMenu.MaxHeight}"
											CanContentScroll="True"
											HorizontalScrollBarVisibility="Disabled"
											VerticalScrollBarVisibility="Auto">
											<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
										</ScrollViewer>
									</Grid>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<DataTrigger Binding="{Binding PlacementTarget.DataContext.HasActiveDiagnosticErrors, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
									<Setter TargetName="DiagnosticMenuIcon" Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
									<Setter TargetName="DiagnosticMenuIcon" Property="IconKey" Value="warning" />
									<Setter TargetName="DiagnosticMenuTitle" Property="Text" Value="Action recommended" />
								</DataTrigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<!--
				Single definition of Redux menu presentation for every MenuItem role. Both the
				menu bar implicit style and MenuItemHighlightBlink derive from this, so an item
				carrying an explicit style (Tools) cannot silently fall back to stock chrome.
			-->
			<Style x:Key="ReduxMenuItemStyle" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
				<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
				<!-- MenuItem popups are a separate visual window and do not reliably inherit typography. -->
				<Setter Property="FontFamily" Value="{DynamicResource Redux.FontFamily.UI}" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.12}" />
				<Style.Triggers>
					<Trigger Property="Role" Value="TopLevelHeader">
						<Setter Property="Padding" Value="8,4" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Template" Value="{DynamicResource ReduxTopLevelMenuHeaderTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="TopLevelItem">
						<Setter Property="Padding" Value="8,4" />
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="Template" Value="{DynamicResource ReduxTopLevelMenuHeaderTemplate}" />
					</Trigger>
					<!-- Inset rows horizontally so their highlight cannot paint over the popup corner arcs. -->
					<Trigger Property="Role" Value="SubmenuHeader">
						<Setter Property="Margin" Value="1,0" />
						<Setter Property="Template" Value="{DynamicResource ReduxPopupMenuItemTemplate}" />
					</Trigger>
					<Trigger Property="Role" Value="SubmenuItem">
						<Setter Property="Margin" Value="1,0" />
						<Setter Property="Template" Value="{DynamicResource ReduxPopupMenuItemTemplate}" />
					</Trigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="MenuItemHighlightBlink" BasedOn="{StaticResource ReduxMenuItemStyle}" TargetType="{x:Type MenuItem}">
				<Setter Property="adonisExtensions:CornerRadiusExtension.CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
						<DataTrigger.EnterActions>
							<BeginStoryboard Name="BlinkyMenuItemStoryboard">
								<Storyboard AutoReverse="True"
								    BeginTime="00:00:00"
								    FillBehavior="Stop"
								    RepeatBehavior="3x"
								    Duration="0:0:0.5">
									<DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" />
								</Storyboard>
							</BeginStoryboard>
						</DataTrigger.EnterActions>
						<DataTrigger.ExitActions>
							<StopStoryboard BeginStoryboardName="BlinkyMenuItemStoryboard" />
						</DataTrigger.ExitActions>
					</DataTrigger>
					<DataTrigger Binding="{Binding HighlightExtenderDownload}" Value="False">
						<Setter Property="Opacity" Value="1.0" />
						<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid Background="{DynamicResource ReduxWindowBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<xc:BusyIndicator x:Name="MainBusyIndicator" Style="{StaticResource BusyIndicatorProgressStyle}">
			<xc:BusyIndicator.BusyContent>
				<controls:ReduxOperationProgress
					CanCancel="{Binding CanCancelProgress}"
					CancelCommand="{Binding CancelMainProgressCommand}"
					IconBrush="{DynamicResource ReduxAccentHoverBrush}"
					IconKey="package"
					ProgressValue="{Binding MainProgressValue}"
					Status="{Binding MainProgressWorkText}"
					Title="{Binding MainProgressTitle}" />
			</xc:BusyIndicator.BusyContent>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<local:DeleteFilesConfirmationView x:Name="DeleteFilesView" Grid.RowSpan="3" Panel.ZIndex="99" />
				<Rectangle x:Name="ModListRectangle"
				    Grid.RowSpan="3"
				    HorizontalAlignment="Stretch"
				    VerticalAlignment="Stretch"
				    Panel.ZIndex="98"
				    Fill="{DynamicResource ReduxWindowBrush}"
				    Opacity="0.64">
					<Rectangle.Style>
						<Style TargetType="{x:Type Rectangle}">
							<Style.Triggers>
								<DataTrigger Binding="{Binding Settings.DisableBackgroundEffects}" Value="True">
									<Setter Property="Opacity" Value="0" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Rectangle.Style>
				</Rectangle>
				<Grid Background="{DynamicResource ReduxWindowBrush}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.Resources>
						<ControlTemplate x:Key="CompactTopBarStatusButtonTemplate" TargetType="{x:Type Button}">
							<Border x:Name="StatusChrome"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
								SnapsToDevicePixels="True">
								<Grid>
									<Border x:Name="HoverSurface"
										Background="{TemplateBinding Foreground}"
										CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
										IsHitTestVisible="False"
										Opacity="0" />
									<controls:ReduxIcon Width="{DynamicResource Redux.StatusPill.IconSize}"
										Height="{DynamicResource Redux.StatusPill.IconSize}"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{TemplateBinding Foreground}"
										IconKey="{TemplateBinding Tag}" />
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HoverSurface" Property="Opacity" Value="0.1" />
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="HoverSurface" Property="Opacity" Value="0.16" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
