<local:AboutWindowBase x:Class="DivinityModManager.Views.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:app="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:c="clr-namespace:DivinityModManager.Controls"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="About BG3 Mod Manager Redux"
	Width="720"
	Height="500"
	MinWidth="640"
	MinHeight="450"
	ResizeMode="CanResize"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style x:Key="AboutLinkStyle" TargetType="c:HyperlinkText">
				<Setter Property="Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style x:Key="AboutLabelStyle" TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
			<Style x:Key="AboutSectionCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="{DynamicResource Redux.Inset.Card}" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Card}" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<c:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Information}" />
		<Border Grid.Row="1"
			Padding="22"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<c:ReduxIcon Width="26"
					Height="26"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ReduxAccentHoverBrush}"
					StrokeData="{StaticResource Redux.Icon.Information}" />
				<StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
					<TextBlock x:Name="TitleText" Style="{StaticResource Redux.Text.PageTitle}" />
					<TextBlock Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						TextWrapping="Wrap">
						<Run Text="Version " />
						<Run Text="{x:Static app:DivinityApp.REDUX_DISPLAY_VERSION}" />
						<Run Text="  •  A community-made update to BG3 Mod Manager" />
					</TextBlock>
				</StackPanel>
			</Grid>

			<Border Grid.Row="1"
				Height="1"
				Margin="0,18,0,16"
				Background="{DynamicResource ReduxBorderBrush}" />

			<Grid Grid.Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="16" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border Style="{StaticResource AboutSectionCardStyle}">
					<StackPanel>
						<TextBlock Style="{StaticResource Redux.Text.SectionTitle}" Text="Current Project" />
						<TextBlock Margin="0,5,0,14"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="Maintained by raincloudsfollow."
							TextWrapping="Wrap" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="76" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition MinHeight="29" />
								<RowDefinition MinHeight="29" />
								<RowDefinition MinHeight="29" />
								<RowDefinition MinHeight="29" />
							</Grid.RowDefinitions>
							<TextBlock Style="{StaticResource AboutLabelStyle}" Text="Project" />
							<c:HyperlinkText Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="Open on GitHub" URL="{x:Static app:DivinityApp.URL_REDUX_REPO}" />
							<TextBlock Grid.Row="1" Style="{StaticResource AboutLabelStyle}" Text="Releases" />
							<c:HyperlinkText Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="View releases" URL="{x:Static app:DivinityApp.URL_REDUX_RELEASES}" />
							<TextBlock Grid.Row="2" Style="{StaticResource AboutLabelStyle}" Text="Issues" />
							<c:HyperlinkText Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="Report an issue" URL="{x:Static app:DivinityApp.URL_REDUX_BUG_REPORT}" />
							<TextBlock Grid.Row="3" Style="{StaticResource AboutLabelStyle}" Text="License" />
							<c:HyperlinkText Grid.Row="3" Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="MIT License" URL="{x:Static app:DivinityApp.URL_REDUX_LICENSE}" />
						</Grid>
					</StackPanel>
				</Border>

				<Border Grid.Column="2" Style="{StaticResource AboutSectionCardStyle}">
					<StackPanel>
						<TextBlock Style="{StaticResource Redux.Text.SectionTitle}" Text="Original Project" />
						<TextBlock Margin="0,5,0,14"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="This project builds on LaughingLeader's BG3 Mod Manager and keeps its familiar load-order and package-management foundation."
							TextWrapping="Wrap" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="76" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition MinHeight="29" />
								<RowDefinition MinHeight="29" />
								<RowDefinition MinHeight="29" />
							</Grid.RowDefinitions>
							<TextBlock Style="{StaticResource AboutLabelStyle}" Text="Upstream" />
							<c:HyperlinkText Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="Original BG3 Mod Manager" URL="{x:Static app:DivinityApp.URL_REPO}" />
							<TextBlock Grid.Row="1" Style="{StaticResource AboutLabelStyle}" Text="Author" />
							<c:HyperlinkText Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="LaughingLeader" URL="{x:Static app:DivinityApp.URL_AUTHOR}" />
							<TextBlock Grid.Row="2" Style="{StaticResource AboutLabelStyle}" Text="Support" />
							<c:HyperlinkText Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutLinkStyle}" DisplayText="Support on Ko-fi" URL="{x:Static app:DivinityApp.URL_DONATION}" />
						</Grid>
					</StackPanel>
				</Border>
			</Grid>

			<TextBlock Grid.Row="3"
				Margin="0,16,0,0"
				HorizontalAlignment="Center"
				Style="{StaticResource Redux.Text.Caption}"
				Text="Built on the original BG3 Mod Manager." />
		</Grid>
		</Border>
	</Grid>
</local:AboutWindowBase>
