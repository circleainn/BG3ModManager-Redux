<adonisUi:AdonisWindow x:Class="DivinityModManager.Views.CustomThemeEditorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUi="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:ext="clr-namespace:DivinityModManager.Controls.Extensions"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	Title="{loc:Text Custom_Theme_Editor_d7209d86}"
	Width="960"
	Height="700"
	MinWidth="840"
	MinHeight="620"
	MaxWidth="1280"
	MaxHeight="920"
	ResizeMode="CanResize"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<adonisUi:AdonisWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="ThemeEditorFieldLabelStyle" TargetType="TextBlock">
				<Setter Property="Margin" Value="1,0,0,7" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.10}" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
			</Style>

			<Style x:Key="ThemeColorButtonStyle" TargetType="Button">
				<Setter Property="Height" Value="92" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="Margin" Value="5" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="VerticalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Grid ClipToBounds="False">
								<Border x:Name="Card"
									Margin="0,1"
									Padding="8,7"
									Background="{DynamicResource ReduxSurfaceElevatedBrush}"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									RenderTransformOrigin="0.5,0.5"
									util:ReduxWindowBehavior.HoverLift="1">
									<Border.RenderTransform>
										<TranslateTransform />
									</Border.RenderTransform>
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="32" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<TextBlock
											FontWeight="SemiBold"
											Foreground="{TemplateBinding Foreground}"
											Text="{TemplateBinding Content}"
											TextTrimming="CharacterEllipsis" />
										<Border Grid.Row="1"
											Margin="0,5,0,4"
											Background="{TemplateBinding Background}"
											BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
											BorderThickness="1"
											CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}">
											<Border.Effect>
												<DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.16" Color="#FF000000" />
											</Border.Effect>
										</Border>
										<Grid Grid.Row="2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<TextBlock
												VerticalAlignment="Center"
												FontSize="{DynamicResource Redux.FontSize.10}"
												Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{TemplateBinding CommandParameter}"
												TextTrimming="CharacterEllipsis" />
											<controls:ReduxIcon Grid.Column="1"
												Width="13" Height="13"
												Margin="7,0,0,0"
												VerticalAlignment="Center"
												Foreground="{DynamicResource ReduxTextMutedBrush}"
												StrokeData="{StaticResource Redux.Icon.Create}" />
										</Grid>
										<Border x:Name="FocusRing" Grid.RowSpan="3"
											Margin="-5"
											BorderBrush="{DynamicResource ReduxAccentBrush}"
											BorderThickness="2"
											CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
											IsHitTestVisible="False"
											Opacity="0" />
									</Grid>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Card" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="FocusRing" Property="Opacity" Value="1" />
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter TargetName="Card" Property="Opacity" Value="0.78" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</adonisUi:AdonisWindow.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ColorPalette}" />

		<Border x:Name="EditorWindowShell" Grid.Row="1"
			Background="{DynamicResource ReduxWindowBrush}"
			BorderThickness="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ScrollViewer
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto"
					PanningMode="VerticalOnly">
					<StackPanel Margin="12,13,12,12">
						<TextBlock
							FontSize="{DynamicResource Redux.FontSize.19}"
							FontWeight="SemiBold"
							Text="{loc:Text Create_a_custom_theme_83a0f196}" />
						<TextBlock
							MaxWidth="820"
							Margin="0,4,0,12"
							HorizontalAlignment="Left"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{loc:Text Choose_colors_font_text_size_and_category_options_89b52beb}"
							TextWrapping="Wrap" />

						<Grid Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.4*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="0.85*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="1.35*" />
							</Grid.ColumnDefinitions>

							<StackPanel>
								<TextBlock Style="{StaticResource ThemeEditorFieldLabelStyle}" Text="{loc:Text THEME_NAME_b9a3ab43}" />
								<Grid>
									<TextBox x:Name="ThemeNameTextBox"
										MinHeight="36"
										MaxLength="50"
										Padding="37,9,10,8"
										Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
									<controls:ReduxIcon
										Width="17" Height="17"
										Margin="12,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										IsHitTestVisible="False"
										Foreground="{DynamicResource ReduxAccentBrush}"
										StrokeData="{StaticResource Redux.Icon.ColorPalette}" />
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Style="{StaticResource ThemeEditorFieldLabelStyle}" Text="{loc:Text BASE_THEME_6a61407b}" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon
										Width="16" Height="16"
										Margin="8,0,8,0"
										VerticalAlignment="Center"
										Foreground="{DynamicResource ReduxAccentBrush}"
										StrokeData="{StaticResource Redux.Icon.Sparkles}" />
									<ComboBox x:Name="BaseThemeComboBox" Grid.Column="1"
										MinHeight="36"
										DisplayMemberPath="Description"
										ItemsSource="{Binding Source={ext:EnumExtension {x:Type data:ReduxThemeType}}}"
										SelectedValuePath="Value"
										SelectionChanged="BaseThemeComboBox_SelectionChanged" />
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="4">
								<TextBlock Style="{StaticResource ThemeEditorFieldLabelStyle}" Text="{loc:Text TEXT_SIZE_9752c1b4}" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Margin="8,0"
										VerticalAlignment="Center"
										FontSize="{DynamicResource Redux.FontSize.17}"
										FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxAccentBrush}"
										Text="Tt" />
									<ComboBox x:Name="TextSizeComboBox" Grid.Column="1"
										MinHeight="36"
										DisplayMemberPath="Description"
										ItemsSource="{Binding Source={ext:EnumExtension {x:Type data:ReduxTextSize}}}"
										SelectedValuePath="Value"
										SelectionChanged="TextSizeComboBox_SelectionChanged" />
								</Grid>
							</StackPanel>

							<StackPanel Grid.Column="6">
								<TextBlock Style="{StaticResource ThemeEditorFieldLabelStyle}" Text="{loc:Text FONT_f054427a}" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Margin="8,0"
										VerticalAlignment="Center"
										FontSize="{DynamicResource Redux.FontSize.17}"
										FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxAccentBrush}"
										Text="Aa" />
									<ComboBox x:Name="TypographyFontComboBox" Grid.Column="1"
										MinHeight="36"
										DisplayMemberPath="Name"
										SelectionChanged="TypographyFontComboBox_SelectionChanged" />
									<Button Grid.Column="2"
										Width="36" Height="36"
										Margin="6,0,0,0"
										Padding="8"
										Style="{StaticResource ReduxSecondaryActionButtonStyle}"
										Click="ImportCustomFont_Click"
										ToolTip="{loc:Text Import_a_TrueType_or_OpenType_font_2d13f7b2}">
										<controls:ReduxIcon VerticalAlignment="Center"
											Width="15" Height="15"
											StrokeData="{StaticResource Redux.Icon.Download}" />
									</Button>
								</Grid>
								<TextBlock
									Margin="8,3,0,0"
									FontSize="{DynamicResource Redux.FontSize.12}"
									Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="Aa Qg 0O 1Il" />
							</StackPanel>
						</Grid>

						<Grid Margin="2,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<controls:ReduxIcon
										Width="21" Height="21"
										Margin="0,0,10,0"
										VerticalAlignment="Top"
										Foreground="{DynamicResource ReduxAccentBrush}"
										StrokeData="{StaticResource Redux.Icon.ColorPalette}" />
									<StackPanel Grid.Column="1">
										<TextBlock
											FontSize="{DynamicResource Redux.FontSize.14}"
											FontWeight="SemiBold"
											Text="{loc:Text Color_palette_81a9be1a}" />
										<TextBlock
											Margin="0,3,0,0"
											Foreground="{DynamicResource ReduxTextMutedBrush}"
											Text="{loc:Text Select_a_color_to_edit_Related_colors_update_automatically_9da22242}"
											TextWrapping="Wrap" />
									</StackPanel>
									<Border Grid.Column="2"
										Padding="0,2"
										VerticalAlignment="Top"
										Background="Transparent"
										BorderThickness="0">
										<TextBlock
											HorizontalAlignment="Center"
											Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											Text="{loc:Text 8_colors_b79afa81}" />
									</Border>
								</Grid>

								<UniformGrid Grid.Row="1"
									Margin="-5,8,-5,-5"
									Columns="8"
									Rows="1">
									<Button Content="{loc:Text Background_ea2b8a87}" Tag="BackgroundColor"
										Background="{Binding BackgroundColor}"
										CommandParameter="{Binding BackgroundColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Surface_0905f7f5}" Tag="SurfaceColor"
										Background="{Binding SurfaceColor}"
										CommandParameter="{Binding SurfaceColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Accent_a5c6fb18}" Tag="AccentColor"
										Background="{Binding AccentColor}"
										CommandParameter="{Binding AccentColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Text_71988c4d}" Tag="TextColor"
										Background="{Binding TextColor}"
										CommandParameter="{Binding TextColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Success_c88a0b90}" Tag="SuccessColor"
										Background="{Binding SuccessColor}"
										CommandParameter="{Binding SuccessColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Warning_e981ddae}" Tag="WarningColor"
										Background="{Binding WarningColor}"
										CommandParameter="{Binding WarningColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Error_54a0e8c1}" Tag="ErrorColor"
										Background="{Binding ErrorColor}"
										CommandParameter="{Binding ErrorColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
									<Button Content="{loc:Text Info_170322a3}" Tag="InfoColor"
										Background="{Binding InfoColor}"
										CommandParameter="{Binding InfoColor}"
										Click="ColorButton_Click"
										Style="{StaticResource ThemeColorButtonStyle}" />
								</UniformGrid>
						</Grid>

						<Border
							Margin="0,12,0,0"
							Padding="2,13,2,0"
							Background="Transparent"
							BorderBrush="{DynamicResource ReduxBorderBrush}"
							BorderThickness="0,1,0,0">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="28" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<CheckBox
									IsChecked="{Binding UseCategoryColorsForInteractions}"
									Click="PresentationCheckBox_Click"
									Style="{StaticResource ReduxCheckBoxStyle}">
									<Grid Margin="4,0,12,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<controls:ReduxIcon
											Width="18" Height="18"
											Margin="0,0,12,0"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ReduxAccentBrush}"
											StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
										<StackPanel Grid.Column="1">
											<TextBlock FontWeight="SemiBold" Text="{loc:Text Use_category_colors_for_selection_209451de}" />
											<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{loc:Text Use_category_colors_when_hovering_over_or_selecting_mods_56e7e3d5}"
												TextWrapping="Wrap" />
										</StackPanel>
									</Grid>
								</CheckBox>

								<CheckBox x:Name="HideIconsCheckBox" Grid.Column="2"
									IsChecked="{Binding ShowCategoryIconsInPills, Converter={StaticResource InverseBooleanConverter}}"
									Style="{StaticResource ReduxCheckBoxStyle}"
									Checked="HideIconsCheckBox_Checked"
									Click="PresentationCheckBox_Click">
									<Grid Margin="4,0,12,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<controls:ReduxIcon
											Width="18" Height="18"
											Margin="0,0,12,0"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ReduxAccentBrush}"
											StrokeData="{StaticResource Redux.Icon.ListStroke}" />
										<StackPanel Grid.Column="1">
											<TextBlock FontWeight="SemiBold" Text="{loc:Text Hide_icons_db3f620f}" />
											<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{loc:Text Remove_decorative_icons_from_lists_cards_details_and_menus_0bef5cc0}"
												TextWrapping="Wrap" />
										</StackPanel>
									</Grid>
								</CheckBox>

								<CheckBox Grid.Row="1"
									Margin="0,10,0,0"
									IsChecked="{Binding UseCategoryColorsForSidebarText}"
									Click="PresentationCheckBox_Click"
									Style="{StaticResource ReduxCheckBoxStyle}">
									<Grid Margin="4,0,12,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<controls:ReduxIcon
											Width="18" Height="18"
											Margin="0,0,12,0"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ReduxAccentBrush}"
											StrokeData="{StaticResource Redux.Icon.Pricetag}" />
										<StackPanel Grid.Column="1">
											<TextBlock FontWeight="SemiBold" Text="{loc:Text Colored_text_80111d15}" />
											<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{loc:Text Use_contextual_colors_for_text_and_menu_icons_throughout_Red_d6188ea1}"
												TextWrapping="Wrap" />
										</StackPanel>
									</Grid>
								</CheckBox>

								<CheckBox Grid.Row="1" Grid.Column="2"
									Margin="0,10,0,0"
									IsChecked="{Binding UseIconsOnly}"
									IsEnabled="{Binding ShowCategoryIconsInPills}"
									Click="PresentationCheckBox_Click"
									Style="{StaticResource ReduxCheckBoxStyle}">
									<Grid Margin="4,0,12,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<controls:ReduxIcon
											Width="18" Height="18"
											Margin="0,0,12,0"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ReduxAccentBrush}"
											StrokeData="{StaticResource Redux.Icon.Albums}" />
										<StackPanel Grid.Column="1">
											<TextBlock FontWeight="SemiBold" Text="{loc:Text Hide_icon_labels_14bb5c66}" />
											<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{loc:Text Show_icons_without_their_text_labels_af059098}"
												TextWrapping="Wrap" />
										</StackPanel>
									</Grid>
								</CheckBox>

								<CheckBox x:Name="GeneratedGradientsCheckBox"
									Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
									IsChecked="{Binding UsesGeneratedGradients, Mode=TwoWay}"
									Style="{StaticResource ReduxCheckBoxStyle}"
									Click="GeneratedGradientsCheckBox_Click">
									<Grid Margin="4,0,12,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<controls:ReduxIcon Width="18" Height="18" Margin="0,0,12,0"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											VerticalAlignment="Center" Foreground="{DynamicResource ReduxAccentBrush}"
											StrokeData="{StaticResource Redux.Icon.Sparkles}" />
										<StackPanel Grid.Column="1">
											<TextBlock FontWeight="SemiBold" Text="{loc:Text Use_generated_gradients_69e174ff}" />
											<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="{loc:Text Blend_this_theme_s_colors_across_primary_and_destructive_act_854b53d9}"
												TextWrapping="Wrap" />
										</StackPanel>
									</Grid>
								</CheckBox>
							</Grid>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<Grid Grid.Row="1" Margin="12,9,12,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<controls:ReduxIcon
						Width="17" Height="17"
						Margin="0,0,9,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						StrokeData="{StaticResource Redux.Icon.Information}" />
					<TextBlock Grid.Column="1"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
					Text="{loc:Text Changes_preview_live_4d1ea525}" />
					<Button Grid.Column="2"
						MinWidth="112"
						Margin="16,0,10,0"
						IsCancel="True"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="CancelButton_Click">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,7,0" StrokeData="{StaticResource Redux.Icon.Close}" />
							<TextBlock Text="{loc:Text Cancel_19766ed6}" />
						</StackPanel>
					</Button>
					<Button Grid.Column="3"
						MinWidth="132"
						IsDefault="True"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}"
						Click="SaveButton_Click">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon VerticalAlignment="Center"
								Width="15" Height="15"
								Margin="0,0,7,0"
								Foreground="{DynamicResource ReduxAccentForegroundBrush}"
								StrokeData="{StaticResource Redux.Icon.Save}" />
							<TextBlock Text="{loc:Text Save_Theme_e5424fa7}" />
						</StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUi:AdonisWindow>
