<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxOverrideDuplicateWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="{loc:Text Resolve_Override_Copies_1416205c}" Width="880" Height="700" MinWidth="650" MinHeight="480"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow" Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxSurfaceBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="OverrideRecoveryActionContentTemplate">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
						Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
						Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						StrokeData="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
					<TextBlock Text="{Binding}" VerticalAlignment="Center" />
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.FolderOpen}" />
		<Border Grid.Row="1" Padding="20" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<ScrollViewer x:Name="ReviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
					<StackPanel>
						<TextBlock Text="{loc:Text Choose_which_copy_to_keep_4330add9}" FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="SemiBold" TextWrapping="Wrap" />
						<TextBlock Margin="0,7,0,12" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{loc:Text The_chosen_copy_stays_in_its_current_folder_Redux_backs_up_t_31fa0a1f}" />
						<ProgressBar x:Name="BusyProgress" Height="4" Margin="0,0,0,12" IsIndeterminate="True" />
					<ItemsControl x:Name="ConflictItems">
						<ItemsControl.ItemTemplate><DataTemplate>
							<Border Padding="14" Margin="0,0,0,10" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
								<StackPanel>
									<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
									<TextBlock Text="{loc:BoundText Path=Comparison}" Margin="0,5,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ReduxWarningBrush}" />
									<TextBlock Text="{Binding ModsSummary}" TextWrapping="Wrap" Margin="0,0,0,6" />
									<TextBlock Text="{Binding HeldSummary}" TextWrapping="Wrap" Margin="0,0,0,10" />
									<ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="DisplayLabel" SelectedValuePath="Value"
										SelectedValue="{Binding Choice, Mode=TwoWay}" SelectionChanged="Choice_SelectionChanged"
										MinWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="{loc:FormatText Key=Copy_to_keep_for_0_4e361873, Path=Name}" />
								</StackPanel>
							</Border>
						</DataTemplate></ItemsControl.ItemTemplate>
					</ItemsControl>
						<TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="{DynamicResource ReduxTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
					</StackPanel>
				</ScrollViewer>
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<WrapPanel VerticalAlignment="Center">
						<Button Content="{loc:Text Open_Mods_df7e0667}" Tag="{StaticResource Redux.Icon.FolderOpen}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							Margin="0,0,6,6" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="OpenMods_Click" />
						<Button Content="{loc:Text Open_Holding_58d8af3d}" Tag="{StaticResource Redux.Icon.FolderOpen}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							Margin="0,0,6,6" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="OpenHolding_Click" />
						<Button Content="{loc:Text Copy_Details_c6bb8a59}" Tag="{StaticResource Redux.Icon.Copy}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							Margin="0,0,6,6" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CopyDetails_Click" />
						<Button x:Name="ReviewButton" Content="{loc:Text Review_Again_823d9ee0}" Tag="{StaticResource Redux.Icon.RefreshStroke}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							Margin="0,0,6,6" IsEnabled="False" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="ReviewAgain_Click" />
					</WrapPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,6">
						<Button Content="{loc:Text Cancel_19766ed6}" Tag="{StaticResource Redux.Icon.Close}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							MinWidth="80" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="Cancel_Click" />
						<Button x:Name="ApplyButton" Content="{loc:Text Back_Up_and_Apply_71c1e7bc}" MinWidth="150" Margin="8,0,0,0" IsEnabled="False"
							Tag="{StaticResource Redux.Icon.Archive}" ContentTemplate="{StaticResource OverrideRecoveryActionContentTemplate}"
							Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="Apply_Click" />
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
