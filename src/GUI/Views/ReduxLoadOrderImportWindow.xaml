<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxLoadOrderImportWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="{loc:Text Import_Redux_Modlist_72832ae1}"
	Width="600" MinWidth="420" Height="640" MinHeight="320"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="False"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
	</ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Download}" />
	<Border Grid.Row="1" Padding="22" Background="{DynamicResource ReduxAppBackgroundBrush}"
		BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
		<Grid>
			<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<controls:ReduxIcon Width="24" Height="24" Margin="0,0,14,0"
					HorizontalAlignment="Center" VerticalAlignment="Center"
					Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
					Foreground="{DynamicResource ReduxAccentHoverBrush}" StrokeData="{StaticResource Redux.Icon.Download}" />
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold"
						Text="{loc:Text Choose_what_to_import_5804a52b}" />
					<TextBlock x:Name="BundleSummaryText" Margin="0,4,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
					<TextBlock x:Name="BundleMetadataText" Margin="0,3,0,0"
						Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" />
				</StackPanel>
			</Grid>

			<StackPanel Grid.Row="1" Margin="0,18,0,0">
				<Border Padding="14,12" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<CheckBox x:Name="ImportLoadOrderCheckBox" AutomationProperties.Name="{loc:Text Import_load_order_96c8e8dc}" IsChecked="True" Style="{StaticResource ReduxCheckBoxStyle}"
						Checked="ImportOption_Changed" Unchecked="ImportOption_Changed">
						<StackPanel Margin="5,0,0,0">
							<TextBlock FontWeight="SemiBold" Text="{loc:Text Load_order_d287beb5}" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{loc:Text Create_a_saved_order_d9585741}" TextWrapping="Wrap" />
							<TextBlock x:Name="LoadOrderAvailabilityText" Margin="0,5,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" />
						</StackPanel>
					</CheckBox>
				</Border>
				<Border Margin="0,8,0,0" Padding="14,12" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<CheckBox x:Name="ImportPresentationCheckBox" AutomationProperties.Name="{loc:Text Import_categories_and_separators_ba81e380}" IsChecked="True" Style="{StaticResource ReduxCheckBoxStyle}"
						Checked="ImportOption_Changed" Unchecked="ImportOption_Changed">
						<StackPanel Margin="5,0,0,0">
							<TextBlock FontWeight="SemiBold" Text="{loc:Text Categories_and_separators_1472618c}" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{loc:Text Merge_categories_icons_and_active_list_separators_fc518165}" TextWrapping="Wrap" />
							<TextBlock x:Name="PresentationContentsText" Margin="0,5,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" />
						</StackPanel>
					</CheckBox>
				</Border>
				<Border x:Name="SourceLinksOptionBorder" Margin="0,8,0,0" Padding="14,12"
					Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<CheckBox x:Name="ImportSourceLinksCheckBox" AutomationProperties.Name="{loc:Text Replace_source_links_1dd06291}" IsChecked="False"
						Style="{StaticResource ReduxCheckBoxStyle}"
						Checked="ImportOption_Changed" Unchecked="ImportOption_Changed">
						<StackPanel Margin="5,0,0,0">
							<TextBlock FontWeight="SemiBold" Text="{loc:Text Source_links_optional_8dab04b7}" />
							<TextBlock Margin="0,2,0,0"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{loc:Text Use_the_modlist_author_s_Nexus_Mods_and_mod_io_links_e971f907}"
								TextWrapping="Wrap" />
							<TextBlock x:Name="SourceLinksContentsText" Margin="0,5,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}" />
						</StackPanel>
					</CheckBox>
				</Border>
				<Border x:Name="PrivateNotesOptionBorder" Margin="0,8,0,0" Padding="14,12"
					Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<CheckBox x:Name="ImportPrivateNotesCheckBox" AutomationProperties.Name="{loc:Text Import_notes_f5544a89}" IsChecked="True"
						Style="{StaticResource ReduxCheckBoxStyle}"
						Checked="ImportOption_Changed" Unchecked="ImportOption_Changed">
						<StackPanel Margin="5,0,0,0">
							<TextBlock FontWeight="SemiBold" Text="{loc:Text Notes_8a7525b1}" />
							<TextBlock Margin="0,2,0,0"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{loc:Text Add_included_notes_keep_existing_notes_177ffbd0}"
								TextWrapping="Wrap" />
							<TextBlock x:Name="PrivateNotesContentsText" Margin="0,5,0,0"
								Foreground="{DynamicResource ReduxTextMutedBrush}" />
						</StackPanel>
					</CheckBox>
				</Border>
			</StackPanel>

			<Border x:Name="ImportImpactBorder" Grid.Row="2" Margin="0,12,0,0" Padding="12,10"
				Background="{DynamicResource ReduxWarningSoftBrush}"
				BorderBrush="{DynamicResource ReduxWarningBrush}" BorderThickness="1"
				CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
				Visibility="Collapsed">
				<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<controls:ReduxIcon Width="17" Height="17" Margin="0,1,8,0"
						VerticalAlignment="Top" Foreground="{DynamicResource ReduxWarningBrush}"
						IconKey="warning" />
					<TextBlock x:Name="ImportImpactText" Grid.Column="1" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						TextWrapping="Wrap" />
				</Grid>
			</Border>

			<TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
				Text="{loc:Text Apply_to_the_game_later_with_Sync_Load_Order_to_Game_d3473f7a}"
				TextWrapping="Wrap" />

		</Grid>
			</ScrollViewer>
			<StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
				<Button x:Name="CancelButton" AutomationProperties.Name="{loc:Text Cancel_19766ed6}" MinWidth="86" IsCancel="True"
					Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="CancelButton_Click">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Close}" />
						<TextBlock Text="{loc:Text Cancel_19766ed6}" />
					</StackPanel>
				</Button>
				<Button x:Name="ImportButton" AutomationProperties.Name="{loc:Text Import_modlist_520e75c0}" MinWidth="86" Margin="8,0,0,0" IsDefault="True"
					Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ImportButton_Click">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
							Foreground="{DynamicResource ReduxAccentForegroundBrush}"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							StrokeData="{StaticResource Redux.Icon.Download}" />
						<TextBlock Text="{loc:Text Import_2cff9baa}" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
	</Grid>
</adonisUI:AdonisWindow>
