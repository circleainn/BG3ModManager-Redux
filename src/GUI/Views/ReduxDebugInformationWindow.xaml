<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxDebugInformationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Debug Information"
	Width="760" Height="680" MinWidth="620" MinHeight="480" MaxWidth="980" MaxHeight="900"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="DebugValueTemplate">
				<Grid Margin="0,3">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="158" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding Label}" />
					<TextBlock Grid.Column="1" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="DebugSectionTemplate">
				<Border Margin="0,0,0,10" Padding="13,11"
					Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
					<StackPanel>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.14}"
							FontWeight="{DynamicResource Redux.FontWeight.Title}"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding Title}" />
						<TextBlock Margin="0,2,0,7" Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding Description}" TextWrapping="Wrap" />
						<ItemsControl ItemTemplate="{StaticResource DebugValueTemplate}" ItemsSource="{Binding Values}" />
					</StackPanel>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Terminal}" />
		<Border Grid.Row="1" Padding="20,17"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Debug information" />
					<TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="Read-only Redux state captured for troubleshooting. This window never changes mods, saves, or load orders."
						TextWrapping="Wrap" />
				</StackPanel>
				<Border Grid.Row="1" Margin="0,12,0,12" Padding="10,8"
					Background="{DynamicResource ReduxWarningSoftBrush}"
					BorderBrush="{DynamicResource ReduxWarningBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<StackPanel Orientation="Horizontal">
						<controls:ReduxIcon Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							Foreground="{DynamicResource ReduxWarningBrush}" StrokeData="{StaticResource Redux.Icon.Warning}" />
						<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="Local paths can contain your Windows account name. Review screenshots before sharing them; API keys and credentials are never shown here."
							TextWrapping="Wrap" />
					</StackPanel>
				</Border>
				<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource DebugSectionTemplate}" />
				</ScrollViewer>
				<Grid Grid.Row="3" Margin="0,12,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<StackPanel Orientation="Horizontal">
						<Button MinWidth="132" Click="CopySummaryButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
									Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.Copy}" />
								<TextBlock Text="Copy safe summary" />
							</StackPanel>
						</Button>
						<Button MinWidth="92" Margin="8,0,0,0" Click="RefreshButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
							<StackPanel Orientation="Horizontal">
								<controls:ReduxIcon VerticalAlignment="Center" Width="15" Height="15" Margin="0,0,7,0"
									Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
								<TextBlock Text="{loc:Text Refresh_0e916101}" />
							</StackPanel>
						</Button>
					</StackPanel>
					<Button Grid.Column="1" MinWidth="82" Click="CloseButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Close_7d9eb7ac}" /></StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
