<Window x:Class="DivinityModManager.Views.ReduxStartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    Width="560"
    Height="282"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="False"
    Background="{DynamicResource ReduxWindowBrush}"
    FontFamily="{DynamicResource Redux.FontFamily.UI}"
    FontSize="{DynamicResource Redux.FontSize.12}"
    FontWeight="{DynamicResource Redux.FontWeight.Body}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    AutomationProperties.Name="BG3 Mod Manager Redux is starting">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid x:Name="StartupContent" ClipToBounds="True">
		<Grid.RenderTransform>
			<ScaleTransform ScaleX="1" ScaleY="1" CenterX="280" CenterY="141" />
		</Grid.RenderTransform>

		<Border Background="{DynamicResource ReduxSplashSurfaceBrush}"
		    BorderBrush="{DynamicResource ReduxSplashBorderBrush}"
		    BorderThickness="1"
		    CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />

		<!-- One quiet theme accent keeps the surface recognizable without using status colors as decoration. -->
		<Ellipse Width="340" Height="240" Margin="-145,-145,0,0"
		    HorizontalAlignment="Left" VerticalAlignment="Top"
		    Fill="{DynamicResource ReduxAccentBrush}" Opacity="{DynamicResource Redux.Splash.AccentOpacity}"
		    IsHitTestVisible="False">
			<Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
		</Ellipse>

		<!--
			Only the foreground animates on entrance. The card background, border and colour
			field above form the splash surface: fading them leaves nothing but the
			opaque window background, which reads as a black window fading into the splash.
		-->
		<Grid x:Name="StartupForeground" Margin="28,24,28,26">
			<Grid.RenderTransform>
				<TranslateTransform Y="0" />
			</Grid.RenderTransform>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Border Width="38" Height="38" CornerRadius="10"
				    Background="{DynamicResource ReduxAccentSoftBrush}"
				    BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
					<controls:ReduxIcon Width="20" Height="20"
					    HorizontalAlignment="Center" VerticalAlignment="Center"
					    Foreground="{DynamicResource ReduxAccentBrush}"
					    Data="{StaticResource Redux.Icon.ReduxStar}" />
				</Border>
				<StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
					<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
					    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
					    Text="BG3 MOD MANAGER" />
					<TextBlock Margin="0,-2,0,0"
					    FontSize="{DynamicResource Redux.FontSize.18}"
					    FontWeight="{DynamicResource Redux.FontWeight.Title}"
					    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
					    Text="Redux" />
				</StackPanel>
				<Border Grid.Column="2" Margin="0,0,12,0" Padding="9,4"
				    VerticalAlignment="Center" CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
				    Background="{DynamicResource ReduxSurfaceBrush}"
				    BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
					<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
					    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
					    Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" />
				</Border>
				<Button Grid.Column="3" Width="26" Height="26" Padding="0"
				    Style="{StaticResource ReduxPaneHeaderActionButtonStyle}"
				    Click="CloseStartup_Click" ToolTip="Close Redux"
				    AutomationProperties.Name="Close Redux">
					<controls:ReduxIcon Width="14" Height="14"
					    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
					    StrokeData="{StaticResource Redux.Icon.Close}" />
				</Button>
			</Grid>

			<Border Grid.Row="1" Height="1" Margin="0,17,0,0"
			    Background="{DynamicResource ReduxBorderBrush}" Opacity="0.65" />

			<StackPanel Grid.Row="2" VerticalAlignment="Center">
				<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
				    FontWeight="{DynamicResource Redux.FontWeight.Title}"
				    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
				    Text="Preparing your workspace" />
				<TextBlock Margin="0,7,0,0"
				    FontSize="{DynamicResource Redux.FontSize.13}"
				    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
				    Text="{Binding MainProgressWorkText, FallbackValue='Loading settings...', TargetNullValue='Loading settings...'}"
				    TextTrimming="CharacterEllipsis"
				    AutomationProperties.LiveSetting="Polite" />

				<Grid Margin="0,25,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
						    FontWeight="{DynamicResource Redux.FontWeight.Control}"
						    Foreground="{DynamicResource ReduxTextMutedBrush}"
						    Text="STARTUP PROGRESS" />
						<TextBlock Grid.Column="1" Margin="12,0,0,0"
						    FontSize="{DynamicResource Redux.FontSize.11}"
						    FontWeight="{DynamicResource Redux.FontWeight.Control}"
						    Foreground="{DynamicResource ReduxTextSecondaryBrush}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Text" Value="{Binding MainProgressValue, StringFormat={}{0:P0}}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding MainProgressValue}" Value="0">
											<Setter Property="Text" Value="Working" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
					<ProgressBar Grid.Row="1" Height="6" Margin="0,9,0,0"
					    Maximum="1"
					    Style="{StaticResource ReduxProgressBarStyle}"
					    Value="{Binding MainProgressValue}" />
				</Grid>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
