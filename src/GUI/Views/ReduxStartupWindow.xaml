<Window x:Class="DivinityModManager.Views.ReduxStartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    Width="560"
    Height="320"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="False"
    Background="{DynamicResource ReduxWindowBrush}"
    FontFamily="{DynamicResource Redux.FontFamily.UI}"
    FontSize="{DynamicResource Redux.FontSize.12}"
    FontWeight="{DynamicResource Redux.FontWeight.Body}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    AutomationProperties.Name="BG3 Mod Manager Redux is starting">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid x:Name="StartupContent" ClipToBounds="True">
		<Grid.RenderTransform>
			<ScaleTransform ScaleX="1" ScaleY="1" CenterX="280" CenterY="160" />
		</Grid.RenderTransform>

		<Border Background="{DynamicResource ReduxWindowBrush}"
		    BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
		    BorderThickness="1"
		    CornerRadius="{DynamicResource Redux.CornerRadius.Card}" />

		<!-- Broad semantic-color fields replace the old bokeh/card composition. -->
		<Ellipse Width="330" Height="230" Margin="-150,-125,0,0"
		    HorizontalAlignment="Left" VerticalAlignment="Top"
		    Fill="{DynamicResource ReduxAccentBrush}" Opacity="0.24"
		    IsHitTestVisible="False">
			<Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
		</Ellipse>
		<Ellipse Width="300" Height="220" Margin="0,-135,-130,0"
		    HorizontalAlignment="Right" VerticalAlignment="Top"
		    Fill="{DynamicResource ReduxErrorBrush}" Opacity="0.14"
		    IsHitTestVisible="False">
			<Ellipse.Effect><BlurEffect Radius="75" /></Ellipse.Effect>
		</Ellipse>
		<Ellipse Width="310" Height="200" Margin="-100,0,0,-125"
		    HorizontalAlignment="Left" VerticalAlignment="Bottom"
		    Fill="{DynamicResource ReduxWarningBrush}" Opacity="0.13"
		    IsHitTestVisible="False">
			<Ellipse.Effect><BlurEffect Radius="78" /></Ellipse.Effect>
		</Ellipse>
		<Ellipse Width="340" Height="220" Margin="0,0,-145,-130"
		    HorizontalAlignment="Right" VerticalAlignment="Bottom"
		    Fill="{DynamicResource ReduxSuccessBrush}" Opacity="0.16"
		    IsHitTestVisible="False">
			<Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect>
		</Ellipse>

		<Grid Margin="28,24,28,22">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<controls:ReduxIcon Width="20" Height="20"
				    VerticalAlignment="Center"
				    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
				    StrokeData="{StaticResource Redux.Icon.Sparkles}" />
				<TextBlock Grid.Column="1" Margin="9,0,0,0"
				    VerticalAlignment="Center"
				    FontSize="{DynamicResource Redux.FontSize.13}"
				    FontWeight="{DynamicResource Redux.FontWeight.Title}"
				    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
				    Text="BG3 Mod Manager Redux" />
				<TextBlock Grid.Column="2"
				    VerticalAlignment="Center"
				    FontSize="{DynamicResource Redux.FontSize.10}"
				    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
				    Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" />
			</Grid>

			<StackPanel Grid.Row="1"
			    HorizontalAlignment="Center"
			    VerticalAlignment="Center"
			    TextBlock.TextAlignment="Center">
				<TextBlock FontSize="{DynamicResource Redux.FontSize.26}"
				    FontWeight="{DynamicResource Redux.FontWeight.Title}"
				    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
				    Text="Starting Redux" />
				<TextBlock Margin="0,6,0,0"
				    FontSize="{DynamicResource Redux.FontSize.12}"
				    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
				    Text="Preparing your modding workspace" />
			</StackPanel>

			<Grid Grid.Row="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
					    Text="{Binding MainProgressWorkText, FallbackValue='Preparing startup services...', TargetNullValue='Preparing startup services...'}"
					    TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Column="1" Margin="12,0,0,0"
					    FontWeight="{DynamicResource Redux.FontWeight.Control}"
					    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
					    Text="{Binding MainProgressValue, StringFormat={}{0:P0}}" />
				</Grid>
				<ProgressBar Grid.Row="1" Height="4" Margin="0,8,0,0"
				    Maximum="1"
				    Style="{StaticResource ReduxProgressBarStyle}"
				    Value="{Binding MainProgressValue}" />
			</Grid>
		</Grid>
	</Grid>
</Window>
