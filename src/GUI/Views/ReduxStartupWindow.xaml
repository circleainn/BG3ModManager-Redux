<Window x:Class="DivinityModManager.Views.ReduxStartupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DivinityModManager.Controls"
    Width="540"
    Height="252"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource Redux.FontFamily.UI}"
    FontSize="{DynamicResource Redux.FontSize.12}"
    FontWeight="{DynamicResource Redux.FontWeight.Body}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    AutomationProperties.Name="BG3 Mod Manager Redux is starting">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid x:Name="StartupContent" Margin="14">
		<Grid.RenderTransform>
			<ScaleTransform ScaleX="1" ScaleY="1" CenterX="256" CenterY="112" />
		</Grid.RenderTransform>

		<Border Background="{DynamicResource ReduxWindowBrush}"
		    BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
		    BorderThickness="1"
		    CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
			<Border.Effect>
				<DropShadowEffect BlurRadius="24"
				    Direction="270"
				    Opacity="0.4"
				    ShadowDepth="7"
				    Color="#000000" />
			</Border.Effect>
		</Border>

		<Border Margin="1"
		    Padding="22,20"
		    Background="{DynamicResource ReduxWindowBrush}"
		    BorderBrush="{DynamicResource ReduxBorderBrush}"
		    BorderThickness="1"
		    CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Border Width="40"
					    Height="40"
					    Margin="0,0,13,0"
					    Background="{DynamicResource ReduxAccentSoftBrush}"
					    BorderBrush="{DynamicResource ReduxAccentBrush}"
					    BorderThickness="1"
					    CornerRadius="20">
						<controls:ReduxIcon Width="21"
						    Height="21"
						    HorizontalAlignment="Center"
						    VerticalAlignment="Center"
						    Foreground="{DynamicResource ReduxAccentHoverBrush}"
						    StrokeData="{StaticResource Redux.Icon.Sparkles}" />
					</Border>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock FontSize="{DynamicResource Redux.FontSize.16}"
						    FontWeight="{DynamicResource Redux.FontWeight.Title}"
						    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						    Text="Baldur's Gate 3 Mod Manager Redux" />
						<TextBlock Margin="0,3,0,0"
						    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						    Text="Preparing your modding workspace" />
					</StackPanel>

					<Border Grid.Column="2"
					    Padding="8,3"
					    VerticalAlignment="Top"
					    Background="{DynamicResource ReduxSurfaceMutedBrush}"
					    BorderBrush="{DynamicResource ReduxBorderBrush}"
					    BorderThickness="1"
					    CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
						<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
						    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						    Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}" />
					</Border>
				</Grid>

				<StackPanel Grid.Row="1" Margin="0,17,0,15" VerticalAlignment="Center">
					<TextBlock FontSize="{DynamicResource Redux.FontSize.19}"
					    FontWeight="{DynamicResource Redux.FontWeight.Title}"
					    Foreground="{DynamicResource ReduxTextPrimaryBrush}"
					    Text="Starting Redux" />
					<TextBlock MinHeight="18"
					    Margin="0,5,0,0"
					    Foreground="{DynamicResource ReduxTextSecondaryBrush}"
					    Text="{Binding MainProgressWorkText, FallbackValue='Preparing startup services...', TargetNullValue='Preparing startup services...'}"
					    TextTrimming="CharacterEllipsis" />
				</StackPanel>

				<Grid Grid.Row="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.10}"
						    Foreground="{DynamicResource ReduxTextMutedBrush}"
						    Text="Loading application data" />
						<TextBlock Grid.Column="1"
						    FontSize="{DynamicResource Redux.FontSize.10}"
						    FontWeight="{DynamicResource Redux.FontWeight.Control}"
						    Foreground="{DynamicResource ReduxAccentHoverBrush}"
						    Text="{Binding MainProgressValue, StringFormat={}{0:P0}}" />
					</Grid>
					<ProgressBar Grid.Row="1"
					    Height="6"
					    Margin="0,7,0,0"
					    Maximum="1"
					    Style="{StaticResource ReduxProgressBarStyle}"
					    Value="{Binding MainProgressValue}" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</Window>
