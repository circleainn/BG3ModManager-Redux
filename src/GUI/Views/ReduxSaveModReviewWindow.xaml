<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxSaveModReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI" xmlns:c="clr-namespace:DivinityModManager.Controls"
 Title="{loc:Text Save_Mod_Review_26423acb}" Width="780" Height="560" MinWidth="540" MinHeight="380" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" Background="{DynamicResource ReduxWindowBrush}" Template="{DynamicResource ReduxWindowTemplate}"
 FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MainResourceDictionary.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <c:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Save}"/>
 <Grid Grid.Row="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="SaveNameText" Style="{StaticResource ReduxWindowHeadingStyle}" TextWrapping="Wrap"/>
 <TextBlock x:Name="SummaryText" Margin="0,8,0,12" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
 <TextBlock x:Name="InstructionsText" Grid.Row="1" Text="{loc:Text Select_inactive_mods_to_add_to_the_end_of_your_active_list_E_31ad2809}" Margin="0,0,0,12" TextWrapping="Wrap"/>
 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <ItemsControl x:Name="RequirementsGrid" AutomationProperties.Name="{loc:Text Mods_recorded_in_the_save_90f60a44}">
 <ItemsControl.ItemTemplate><DataTemplate>
 <Border Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" Padding="{DynamicResource Redux.Manager.RowPadding}" Margin="0,0,0,6">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <CheckBox Visibility="{Binding SelectionVisibility}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Requirement.CanActivate}" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Requirement.Name}" Style="{StaticResource ReduxCheckBoxStyle}"/>
 <StackPanel Grid.Column="1">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding IdentityText}" Style="{StaticResource ReduxManagerRowTitleStyle}"/>
 <TextBlock Grid.Column="1" Text="{Binding Requirement.StatusText}" ToolTip="{Binding Requirement.Detail}" Margin="12,0,0,0">
 <TextBlock.Style><Style BasedOn="{StaticResource ReduxManagerStatusStyle}" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}"/>
 <Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
 <TextBlock Text="{Binding MetadataText}" Margin="0,4,0,0" Style="{StaticResource ReduxManagerMetadataStyle}" Visibility="{Binding MetadataText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
 <TextBlock Text="{Binding Requirement.Detail}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 </StackPanel></Grid></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="FooterText" Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap" Text="{loc:Text Recorded_mods_only_Versions_dependencies_and_native_mods_are_1e81a306}"/>
 <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
 <Button x:Name="ApplyButton" Click="Apply_Click" Margin="0,0,8,0" Style="{StaticResource ReduxMinorSuccessActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Check}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"/><TextBlock x:Name="ApplyLabel" Text="{loc:Text Activate_selected_39289eb5}"/></StackPanel></Button>
 <Button IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><c:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" StrokeData="{StaticResource Redux.Icon.Close}"/><TextBlock Text="{loc:Text Close_7d9eb7ac}"/></StackPanel></Button>
 </WrapPanel></StackPanel></Grid></Grid>
</adonisUI:AdonisWindow>
