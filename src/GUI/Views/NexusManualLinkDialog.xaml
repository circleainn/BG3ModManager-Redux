<adonisUi:AdonisWindow x:Class="DivinityModManager.Views.NexusManualLinkDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUi="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="{loc:Text Link_Nexus_Mods_Page_ae8059b7}"
	Width="520" MinWidth="440" MinHeight="210" MaxHeight="480"
	SizeToContent="Height"
	ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<adonisUi:AdonisWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</adonisUi:AdonisWindow.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.LinkStroke}" />
	<Border Grid.Row="1" Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock FontSize="{DynamicResource Redux.FontSize.17}" FontWeight="SemiBold" Text="{loc:Text Link_a_Nexus_Mods_page_2b627d45}" />
			<TextBlock Grid.Row="1" Margin="0,5,0,12" TextWrapping="Wrap"
				Foreground="{DynamicResource ReduxTextSecondaryBrush}"
				Text="{loc:Text Paste_the_Baldur_s_Gate_3_Nexus_Mods_page_for_this_mod_The_i_a67c676d}" />
			<TextBox x:Name="NexusLinkTextBox" Grid.Row="2" MinHeight="34" Padding="9,5"
				ToolTip="{loc:Text Example_https_www_nexusmods_com_baldursgate3_mods_125_17706a85}" />
			<TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
				Text="{loc:Text An_API_key_is_required_to_load_current_page_information_66dbed5b}" />
			<StackPanel Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
				<Button MinWidth="92" Margin="0,0,8,0" IsDefault="True" Click="Link_Click" Style="{StaticResource ReduxPrimaryActionButtonStyle}">
					<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.LinkStroke}" /><TextBlock Text="{loc:Text Link_Page_f50671ad}" /></StackPanel>
				</Button>
				<Button MinWidth="84" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
					<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Cancel_19766ed6}" /></StackPanel>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
	</Grid>
</adonisUi:AdonisWindow>
