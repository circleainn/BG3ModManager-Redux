<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxLoadOrderAdvisorOrganizerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:loc="clr-namespace:DivinityModManager.Localization"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Organize Active Load Order"
	Width="860" Height="680" MinWidth="760" MinHeight="560"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="PolicyCardStyle" TargetType="{x:Type RadioButton}">
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type RadioButton}">
							<Border x:Name="Card" MinHeight="70" Padding="11,8"
								Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Card" Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="Card" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="CountPillStyle" BasedOn="{StaticResource ReduxPillBaseStyle}" TargetType="{x:Type Border}">
				<Setter Property="MinHeight" Value="25" /><Setter Property="Padding" Value="9,3" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="TextElement.Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>

			<DataTemplate x:Key="MoveTemplate">
				<Border Margin="0,0,0,7" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Border Background="{DynamicResource ReduxInfoBrush}" />
						<StackPanel Grid.Column="1" Margin="13,10">
							<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{Binding Reason}" TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Grid.Column="2" Margin="14,0,4,0" VerticalAlignment="Center" Orientation="Horizontal">
							<Border Style="{StaticResource CountPillStyle}"><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding PreviousPosition}" /></Border>
							<controls:ReduxIcon Width="14" Height="14" Margin="8,0" Foreground="{DynamicResource ReduxInfoBrush}"
								StrokeData="{StaticResource Redux.Icon.ArrowForwardStroke}" />
							<Border Style="{StaticResource CountPillStyle}" Background="{DynamicResource ReduxInfoPillBackground}"
								BorderBrush="{DynamicResource ReduxInfoBrush}">
								<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding NextPosition}" />
							</Border>
						</StackPanel>
						<Button Grid.Column="3" Margin="10,0,12,0" Padding="9,4" VerticalAlignment="Center"
							Click="IgnoreAdviceButton_Click" CommandParameter="{Binding IgnoreKey}"
							Style="{StaticResource ReduxSecondaryActionButtonStyle}"
							Visibility="{Binding CanIgnore, Converter={StaticResource BoolToVisibilityConverter}}">
							<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" StrokeData="{StaticResource Redux.Icon.CircleMinus}" /><TextBlock Text="Ignore" /></StackPanel>
						</Button>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="UnresolvedTemplate">
				<Border Margin="0,0,0,7" Background="{DynamicResource ReduxWarningPillBackground}"
					BorderBrush="{DynamicResource ReduxWarningBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Border Background="{DynamicResource ReduxWarningBrush}" />
						<controls:ReduxIcon Grid.Column="1" Width="18" Height="18" Margin="13,0,0,0"
							VerticalAlignment="Center" Foreground="{DynamicResource ReduxWarningBrush}" IconKey="warning" />
						<StackPanel Grid.Column="2" Margin="11,10">
							<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxWarningBrush}" Text="{Binding Relationship}" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding Reason}" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="3" Margin="10,0,12,0" Padding="9,4" VerticalAlignment="Center"
							Click="IgnoreAdviceButton_Click" CommandParameter="{Binding IgnoreKey}"
							Style="{StaticResource ReduxSecondaryActionButtonStyle}">
							<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="13" Height="13" Margin="0,0,5,0" StrokeData="{StaticResource Redux.Icon.CircleMinus}" /><TextBlock Text="Ignore" /></StackPanel>
						</Button>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="SeparatorTemplate">
				<Border Margin="0,0,0,9" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}" ClipToBounds="True">
					<Grid>
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<Border Padding="12,9" Background="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}, ConverterParameter=20}">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
									Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
									<Ellipse Width="10" Height="10" Fill="Transparent"
										Stroke="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}" StrokeThickness="1.5"
										Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
									<controls:ReduxIcon Width="14" Height="14" IconKey="{Binding IconId}"
										Foreground="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}"
										Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
								</Grid>
								<TextBlock Grid.Column="1" Margin="0,0,11,0" VerticalAlignment="Center" FontWeight="SemiBold"
									Foreground="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}"
									Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
								<Border Grid.Column="2" Height="1.5" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="1"
									Background="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}" />
								<Border Grid.Column="3" Style="{StaticResource CountPillStyle}"
									Background="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}, ConverterParameter=2B}"
									BorderBrush="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}">
									<TextBlock FontWeight="SemiBold" Foreground="{Binding Color, Converter={StaticResource StringToSolidBrushConverter}}"
										Text="{Binding CountSummary}" />
								</Border>
							</Grid>
						</Border>
						<Grid Grid.Row="1" Margin="15,9,14,10">
							<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,7,0"
								Style="{StaticResource ReduxOptionalInterfaceIconStyle}" Foreground="{DynamicResource ReduxTextMutedBrush}"
								StrokeData="{StaticResource Redux.Icon.ReorderStroke}" />
							<TextBlock Grid.Column="1" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="{Binding PlacementSummary}" TextWrapping="Wrap" />
						</Grid>
					</Grid>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ReorderStroke}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

				<Grid>
					<StackPanel>
						<TextBlock FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="{DynamicResource Redux.FontWeight.Title}"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Organize active load order" />
						<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="Compare Redux's suggested changes before applying them. The game load order is not changed here." TextWrapping="Wrap" />
					</StackPanel>
				</Grid>

				<Border Grid.Row="1" Margin="0,12,0,0" Padding="11,9" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<StackPanel>
						<TextBlock Margin="1,0,0,8" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							Text="Choose how Redux handles separators" />
						<UniformGrid Columns="3">
							<RadioButton x:Name="PreservePolicyButton" Margin="0,0,7,0" GroupName="SeparatorPolicy"
								Checked="PolicyButton_Checked" Style="{StaticResource PolicyCardStyle}">
								<Grid>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
									<controls:ReduxIcon Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
										Margin="0,0,10,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
										Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="list" />
									<TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Preserve my separators" />
									<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="Keep each separator and its mods together. Only sort within each separator." TextWrapping="Wrap" />
								</Grid>
							</RadioButton>
							<RadioButton x:Name="SuggestedPolicyButton" Margin="0,0,7,0" GroupName="SeparatorPolicy"
								Checked="PolicyButton_Checked" Style="{StaticResource PolicyCardStyle}">
								<Grid>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
									<controls:ReduxIcon Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
										Margin="0,0,10,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
										Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="sparkles" />
									<TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Use suggested separators" />
									<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
									Text="Replace current separators with named groups from Redux's offline knowledge, then place matching mods inside them." TextWrapping="Wrap" />
								</Grid>
							</RadioButton>
							<RadioButton x:Name="RemovePolicyButton" GroupName="SeparatorPolicy"
								Checked="PolicyButton_Checked" Style="{StaticResource PolicyCardStyle}">
								<Grid>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
									<controls:ReduxIcon Grid.RowSpan="2" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
										Margin="0,0,10,0" Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
										Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="archive" />
									<TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
										Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Remove separators" />
									<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
										Text="Remove active separators and reorder the full list. Inactive mods are untouched." TextWrapping="Wrap" />
								</Grid>
							</RadioButton>
						</UniformGrid>
					</StackPanel>
				</Border>

				<UniformGrid Grid.Row="2" Margin="0,9,0,7" Columns="3">
					<Border Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxInfoPillBackground}" CornerRadius="8"
							Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
							<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxInfoBrush}" StrokeData="{StaticResource Redux.Icon.ReorderStroke}" /></Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MoveCountText" FontSize="{DynamicResource Redux.FontSize.20}"
							FontWeight="Bold" Foreground="{DynamicResource ReduxInfoBrush}" Text="0" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Mods repositioned" /></StackPanel>
					</Grid></Border>
					<Border Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxAccentPillBackground}" CornerRadius="8"
							Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
							<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="list" /></Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SeparatorCountText" FontSize="{DynamicResource Redux.FontSize.20}"
							FontWeight="Bold" Foreground="{DynamicResource ReduxAccentHoverBrush}" Text="0" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Separator changes" /></StackPanel>
					</Grid></Border>
					<Border Margin="0" Style="{StaticResource ReduxDialogSummaryCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border Width="38" Height="38" Margin="0,0,11,0" Background="{DynamicResource ReduxWarningPillBackground}" CornerRadius="8"
							Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
							<controls:ReduxIcon Width="17" Height="17" Foreground="{DynamicResource ReduxWarningBrush}" IconKey="warning" /></Border>
						<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="UnresolvedCountText" FontSize="{DynamicResource Redux.FontSize.20}"
							FontWeight="Bold" Foreground="{DynamicResource ReduxWarningBrush}" Text="0" /><TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="Needs review" /></StackPanel>
					</Grid></Border>
				</UniformGrid>

				<TabControl x:Name="PreviewTabs" Grid.Row="3" ItemContainerStyle="{StaticResource ReduxContentTabItemStyle}" Style="{StaticResource ReduxContentTabControlStyle}">
					<TabItem Header="Proposed Moves"><Grid Margin="0,9,0,0">
						<ListBox x:Name="MoveList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
							ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}" ItemTemplate="{StaticResource MoveTemplate}"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
						<StackPanel x:Name="NoMovesText" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Width="44" Height="44" HorizontalAlignment="Center" Background="{DynamicResource ReduxSuccessPillBackground}" CornerRadius="22"
								Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxSuccessBrush}" IconKey="shield-check" /></Border>
							<TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="This order already looks good" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="No known placements need to change." />
						</StackPanel>
					</Grid></TabItem>
					<TabItem x:Name="ResultingSeparatorsTab" Header="Separator Changes"><Grid Margin="0,9,0,0">
						<ListBox x:Name="SeparatorList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
							ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}" ItemTemplate="{StaticResource SeparatorTemplate}"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
						<StackPanel x:Name="NoSeparatorsText" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Width="44" Height="44" HorizontalAlignment="Center" Background="{DynamicResource ReduxAccentPillBackground}" CornerRadius="22"
								Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxAccentHoverBrush}" IconKey="list" /></Border>
							<TextBlock x:Name="NoSeparatorsTitle" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No separator changes" />
							<TextBlock x:Name="NoSeparatorsDescription" Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Your existing separators stay where they are." />
						</StackPanel>
					</Grid></TabItem>
					<TabItem Header="Needs Review"><Grid Margin="0,9,0,0">
						<ListBox x:Name="UnresolvedList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
							ItemContainerStyle="{StaticResource ReduxPassiveResultItemStyle}" ItemTemplate="{StaticResource UnresolvedTemplate}"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
						<StackPanel x:Name="NoUnresolvedText" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Width="44" Height="44" HorizontalAlignment="Center" Background="{DynamicResource ReduxSuccessPillBackground}" CornerRadius="22"
								Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
								<controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxSuccessBrush}" IconKey="shield-check" /></Border>
							<TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="Nothing needs your attention" />
							<TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="No known relationship is blocked by this separator layout." />
						</StackPanel>
					</Grid></TabItem>
				</TabControl>

				<Grid Grid.Row="4" Margin="0,10,0,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<Grid VerticalAlignment="Center">
						<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<controls:ReduxIcon Width="14" Height="14" Margin="0,0,7,0"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							Foreground="{DynamicResource ReduxTextMutedBrush}" IconKey="info" />
						<TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="Apply changes to this load order only. Use Ctrl+Z to undo, then sync with the game when ready."
							TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
					</Grid>
					<Button x:Name="RestoreIgnoredButton" Grid.Column="1" Margin="0,0,10,0"
						Click="RestoreIgnoredButton_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.RefreshStroke}" /><TextBlock Text="Restore Ignored Advice" /></StackPanel>
					</Button>
					<Button Grid.Column="2" MinWidth="88" Margin="0,0,8,0" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" /><TextBlock Text="{loc:Text Cancel_19766ed6}" /></StackPanel>
					</Button>
					<Button x:Name="ApplyButton" Grid.Column="3" MinWidth="126"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ApplyButton_Click">
						<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Check}" /><TextBlock Text="Apply Changes" /></StackPanel>
					</Button>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
