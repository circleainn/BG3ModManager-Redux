<adonisUi:AdonisWindow x:Class="DivinityModManager.Views.CategoryNameDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUi="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	Title="Add Mod Category"
	Width="740"
	Height="800"
	MinWidth="640"
	MinHeight="620"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<adonisUi:AdonisWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		<SolidColorBrush x:Key="Redux.CategoryEditor.IconBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.HoverBrush" Color="{DynamicResource ReduxAccentSoftColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.CountHoverBrush" Color="{DynamicResource ReduxSelectionColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.HueBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.SaturationTrackBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.BrightnessTrackBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.RedTrackBrush" Color="{DynamicResource ReduxErrorColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.GreenTrackBrush" Color="{DynamicResource ReduxSuccessColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.BlueTrackBrush" Color="{DynamicResource ReduxInfoColor}" />
		<Style x:Key="CategoryColorSwatchStyle" TargetType="Border">
			<Setter Property="Width" Value="34" /><Setter Property="Height" Value="28" />
			<Setter Property="Margin" Value="0,0,7,7" /><Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Small}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
			<Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
			<Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" /></Trigger></Style.Triggers>
		</Style>
		<Style x:Key="CategoryColorSliderStyle" TargetType="Slider">
			<Setter Property="Height" Value="20" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="255" />
			<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
				<Grid>
					<Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3" />
				<Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
					<Track.DecreaseRepeatButton><RepeatButton Background="Transparent" Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
					<Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource ReduxTextPrimaryBrush}" Stroke="{DynamicResource ReduxBorderStrongBrush}" StrokeThickness="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
					<Track.IncreaseRepeatButton><RepeatButton Background="Transparent" Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
				</Track>
				</Grid>
			</ControlTemplate></Setter.Value></Setter>
		</Style>
		<Style x:Key="CategoryIconChoiceStyle" TargetType="{x:Type ComboBoxItem}">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Margin" Value="2" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBoxItem}">
						<Border x:Name="ChoiceChrome" Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{DynamicResource Redux.CornerRadius.Small}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource ReduxAccentMutedBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		</ResourceDictionary>
	</adonisUi:AdonisWindow.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ColorPalette}" />
	<Border Grid.Row="1" Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
	<Grid Margin="16,14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="DialogHeading" FontSize="{DynamicResource Redux.FontSize.16}" FontWeight="SemiBold" Text="Create a category" />
		<TextBlock x:Name="DialogHelperText" Grid.Row="1" Margin="0,3,0,8" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"
			Text="Assign mods to this category from their right-click menu." />
		<TextBox x:Name="CategoryNameTextBox" Grid.Row="2" MinHeight="32" VerticalAlignment="Top"
			MaxLength="40" Padding="8,4" />
		<StackPanel x:Name="DescriptionEditorPanel" Grid.Row="3" Margin="0,8,0,0">
			<TextBlock Margin="0,0,0,5" FontWeight="SemiBold"
				Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Description (optional)" />
			<TextBox x:Name="CategoryDescriptionTextBox" MinHeight="48" MaxLength="240"
				AcceptsReturn="True" Padding="8,6" TextWrapping="Wrap"
				TextChanged="CategoryDescriptionTextBox_TextChanged"
				ToolTip="Shown when the category is hovered in the Categories pane" />
		</StackPanel>
		<Border x:Name="CategoryPreviewPanel" Grid.Row="4" Margin="0,8,0,0" Padding="10,8"
			Background="{DynamicResource ReduxSurfaceElevatedBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<TextBlock FontSize="{DynamicResource Redux.FontSize.10}" FontWeight="SemiBold"
					Foreground="{DynamicResource ReduxTextMutedBrush}" Text="LIVE PREVIEW" />
				<Border x:Name="CategoryPreviewRow" Grid.Row="1" Margin="0,6,0,0"
					Background="Transparent" BorderBrush="Transparent"
					BorderThickness="{DynamicResource Redux.Interaction.HoverBorderThickness}"
					CornerRadius="{DynamicResource Redux.CornerRadius.PillTall}" Cursor="Hand"
					ToolTipService.ShowDuration="12000">
					<Grid>
						<Border x:Name="CategoryPreviewHoverSurface"
							BorderThickness="{DynamicResource Redux.Interaction.HoverBorderThickness}"
							CornerRadius="{DynamicResource Redux.CornerRadius.PillTall}"
							IsHitTestVisible="False" Opacity="0">
							<Border.Style>
								<Style TargetType="{x:Type Border}">
									<Setter Property="Background" Value="{DynamicResource ReduxAccentPillBackground}" />
									<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Tag, ElementName=CategoryPreviewPanel}" Value="True">
											<Setter Property="Background" Value="{DynamicResource Redux.CategoryEditor.HoverBrush}" />
											<Setter Property="BorderBrush" Value="{DynamicResource Redux.CategoryEditor.IconBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding IsMouseOver, ElementName=CategoryPreviewRow}" Value="True">
											<DataTrigger.EnterActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
															Duration="{StaticResource Redux.Motion.Fast}"
															EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.EnterActions>
											<DataTrigger.ExitActions>
												<BeginStoryboard>
													<Storyboard>
														<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
															Duration="{StaticResource Redux.Motion.Standard}" />
													</Storyboard>
												</BeginStoryboard>
											</DataTrigger.ExitActions>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
						</Border>
						<Grid Margin="{DynamicResource Redux.Interaction.RowPadding}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid x:Name="CategoryPreviewIconHost" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
							<Ellipse Width="{DynamicResource Redux.MarkerSize.Default}" Height="{DynamicResource Redux.MarkerSize.Default}"
								Fill="Transparent" Stroke="{DynamicResource Redux.CategoryEditor.IconBrush}" StrokeThickness="1.5"
								Visibility="{Binding SelectedItem.IsNone, ElementName=CategoryIconComboBox, Converter={StaticResource BoolToVisibilityConverter}}" />
							<controls:ReduxIcon Width="14" Height="14"
								IconKey="{Binding SelectedItem.PreviewIconId, ElementName=CategoryIconComboBox}"
								Foreground="{DynamicResource Redux.CategoryEditor.IconBrush}"
								Visibility="{Binding SelectedItem.IsNone, ElementName=CategoryIconComboBox, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
						</Grid>
						<TextBlock x:Name="CategoryPreviewName" Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium"
							Text="{Binding Text, ElementName=CategoryNameTextBox}" TextTrimming="CharacterEllipsis">
							<TextBlock.Style>
								<Style TargetType="{x:Type TextBlock}">
									<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Tag, ElementName=CategoryPreviewName}" Value="True">
											<Setter Property="Foreground" Value="{DynamicResource Redux.CategoryEditor.IconBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<Border Grid.Column="2" MinWidth="28" Margin="8,0,0,0" Padding="6,2"
							CornerRadius="{DynamicResource Redux.CornerRadius.Pill}">
							<Border.Style>
								<Style TargetType="{x:Type Border}">
									<Setter Property="Background" Value="{DynamicResource ReduxSurfaceMutedBrush}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMouseOver, ElementName=CategoryPreviewRow}" Value="True">
											<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
										</DataTrigger>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding IsMouseOver, ElementName=CategoryPreviewRow}" Value="True" />
												<Condition Binding="{Binding Tag, ElementName=CategoryPreviewPanel}" Value="True" />
											</MultiDataTrigger.Conditions>
											<Setter Property="Background" Value="{DynamicResource Redux.CategoryEditor.CountHoverBrush}" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource Redux.FontSize.11}"
								FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="1" />
						</Border>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Border>
		<Border x:Name="SeparatorPreviewPanel" Grid.Row="4" Margin="0,8,0,0" Padding="10,8"
			Background="{DynamicResource ReduxSurfaceElevatedBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" Visibility="Collapsed">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<TextBlock FontSize="{DynamicResource Redux.FontSize.10}" FontWeight="SemiBold"
					Foreground="{DynamicResource ReduxTextMutedBrush}" Text="LIVE PREVIEW" />
				<Grid Grid.Row="1" Height="32" Margin="{DynamicResource Redux.Interaction.SurfaceMargin}">
					<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<Border Grid.ColumnSpan="4"
						Margin="{DynamicResource Redux.Interaction.SurfaceMargin}"
						CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}"
						BorderThickness="{DynamicResource Redux.Rail.Thickness}"
						OpacityMask="{StaticResource Redux.Hover.WashMask}"
						IsHitTestVisible="False">
						<Border.Style>
							<Style TargetType="{x:Type Border}">
								<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
								<Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								<Setter Property="Opacity" Value="0" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Tag, ElementName=SeparatorPreviewPanel}" Value="True">
										<Setter Property="Background" Value="{DynamicResource Redux.CategoryEditor.HoverBrush}" />
										<Setter Property="BorderBrush" Value="{DynamicResource Redux.CategoryEditor.IconBrush}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsMouseOver, ElementName=SeparatorPreviewPanel}" Value="True">
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
														Duration="{StaticResource Redux.Motion.Fast}"
														EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
														Duration="{StaticResource Redux.Motion.Standard}" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.ExitActions>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
					</Border>
					<ToggleButton Width="22" Height="22" Margin="6,0,5,0" Padding="0"
						VerticalAlignment="Center"
						IsHitTestVisible="False"
						Style="{StaticResource ReduxChromeToggleStyle}">
						<Path Width="10" Height="5"
							Data="{StaticResource Redux.Icon.ChevronDownStroke}"
							Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
							StrokeEndLineCap="Round"
							StrokeLineJoin="Round"
							StrokeStartLineCap="Round"
							StrokeThickness="1.25"
							Stretch="Fill" />
					</ToggleButton>
					<Grid Grid.Column="1" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
						<Ellipse Width="9.5"
							Height="9.5"
							VerticalAlignment="Center" Fill="Transparent"
							Stroke="{DynamicResource Redux.CategoryEditor.IconBrush}" StrokeThickness="1.5"
							Visibility="{Binding SelectedItem.IsNone, ElementName=CategoryIconComboBox, Converter={StaticResource BoolToVisibilityConverter}}" />
						<controls:ReduxIcon IconKey="{Binding SelectedItem.PreviewIconId, ElementName=CategoryIconComboBox}"
							Foreground="{DynamicResource Redux.CategoryEditor.IconBrush}"
							Visibility="{Binding SelectedItem.IsNone, ElementName=CategoryIconComboBox, Converter={StaticResource BoolToVisibilityConverterReversed}}">
							<controls:ReduxIcon.Style>
								<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
									<Setter Property="Width" Value="13" />
									<Setter Property="Height" Value="13" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedValue, ElementName=CategoryIconComboBox}" Value="marker-diamond">
											<Setter Property="Width" Value="11" />
											<Setter Property="Height" Value="11" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</controls:ReduxIcon.Style>
						</controls:ReduxIcon>
					</Grid>
					<TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
						FontSize="{DynamicResource Redux.FontSize.12}" FontWeight="SemiBold"
						Foreground="{DynamicResource Redux.CategoryEditor.IconBrush}" Text="{Binding Text, ElementName=CategoryNameTextBox}"
						TextTrimming="CharacterEllipsis"
						Visibility="{Binding Text, ElementName=CategoryNameTextBox, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
					<Border x:Name="SeparatorPreviewLine" Grid.Column="3" Height="1.5"
						VerticalAlignment="Center" CornerRadius="1"
						Background="{DynamicResource Redux.CategoryEditor.IconBrush}"
						Visibility="{Binding IsChecked, ElementName=HideSeparatorLineCheckBox, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
				</Grid>
			</Grid>
		</Border>
		<TextBlock x:Name="ColorFieldLabel" Grid.Row="5" Margin="0,8,0,5" FontWeight="SemiBold"
			Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Color" />
		<Border Grid.Row="6" Padding="12" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<Grid.ColumnDefinitions><ColumnDefinition Width="228" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" MinWidth="270" /></Grid.ColumnDefinitions>
				<Grid x:Name="SpectrumSurface" Width="218" Height="218" HorizontalAlignment="Center"
					Background="Transparent" Cursor="Cross" SnapsToDevicePixels="True"
					AutomationProperties.Name="Hue and color field"
					MouseLeftButtonDown="Spectrum_MouseLeftButtonDown" MouseMove="Spectrum_MouseMove" MouseLeftButtonUp="ColorSurface_MouseLeftButtonUp">
					<Image x:Name="ColorWheelImage" Width="216" Height="216" Stretch="Fill"
						IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
						<Image.Clip>
							<GeometryGroup FillRule="EvenOdd">
								<EllipseGeometry Center="108,108" RadiusX="107" RadiusY="107" />
								<EllipseGeometry Center="108,108" RadiusX="76" RadiusY="76" />
							</GeometryGroup>
						</Image.Clip>
					</Image>
					<Grid x:Name="ColorPlane" Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center"
						Background="Transparent"
						MouseLeftButtonDown="ColorPlane_MouseLeftButtonDown"
						MouseMove="ColorPlane_MouseMove"
						MouseLeftButtonUp="ColorSurface_MouseLeftButtonUp">
						<Grid.Clip>
							<EllipseGeometry Center="71,71" RadiusX="71" RadiusY="71" />
						</Grid.Clip>
						<Grid>
							<Ellipse Fill="{DynamicResource Redux.CategoryEditor.HueBrush}" IsHitTestVisible="False" />
							<Ellipse IsHitTestVisible="False">
								<Ellipse.Fill>
									<LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
										<GradientStop Color="White" Offset="0" />
										<GradientStop Color="#00FFFFFF" Offset="1" />
									</LinearGradientBrush>
								</Ellipse.Fill>
							</Ellipse>
							<Ellipse IsHitTestVisible="False">
								<Ellipse.Fill>
									<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
										<GradientStop Color="#00000000" Offset="0" />
										<GradientStop Color="Black" Offset="1" />
									</LinearGradientBrush>
								</Ellipse.Fill>
							</Ellipse>
							<Ellipse Fill="Transparent" Stroke="{DynamicResource ReduxBorderStrongBrush}"
								StrokeThickness="1" IsHitTestVisible="False" />
							<Ellipse x:Name="ColorPlaneMarker" Width="12" Height="12"
								HorizontalAlignment="Left" VerticalAlignment="Top"
								Fill="Transparent" Stroke="White" StrokeThickness="2"
								IsHitTestVisible="False">
								<Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.85" Color="#FF111018" /></Ellipse.Effect>
							</Ellipse>
						</Grid>
					</Grid>
					<Ellipse x:Name="SpectrumMarker" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top"
						Fill="{DynamicResource ReduxSurfaceBrush}" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
						<Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.7" Color="#FF111018" /></Ellipse.Effect>
					</Ellipse>
				</Grid>
				<xctk:ColorCanvas x:Name="CategoryColorPicker" Visibility="Collapsed" UsingAlphaChannel="False" SelectedColorChanged="CategoryColorPicker_SelectedColorChanged" />
				<StackPanel Grid.Column="2" VerticalAlignment="Top">
					<TextBlock Margin="0,0,0,5" FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="SemiBold"
						Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Current color" />
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Border x:Name="SelectedColorPreview" Height="36" Margin="0,0,8,0" Background="#8A6AF1"
							BorderBrush="{DynamicResource ReduxBorderStrongBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Small}" />
						<TextBox x:Name="HexColorTextBox" Grid.Column="1" MinHeight="36" Padding="9,5" Text="#8A6AF1"
							LostFocus="HexColorTextBox_Commit" KeyDown="HexColorTextBox_KeyDown" />
					</Grid>
					<Grid Margin="0,10,0,0">
						<Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Saturation" />
						<Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="100"
							Background="{DynamicResource Redux.CategoryEditor.SaturationTrackBrush}"
							ValueChanged="SaturationSlider_ValueChanged" />
						<TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:0}%}" />
						<TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Brightness" />
						<Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="100"
							Background="{DynamicResource Redux.CategoryEditor.BrightnessTrackBrush}"
							ValueChanged="BrightnessSlider_ValueChanged" />
						<TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}" />
						<TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Red" />
						<Slider x:Name="RedSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.RedTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0}}" />
						<TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Green" />
						<Slider x:Name="GreenSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.GreenTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0}}" />
						<TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Blue" />
						<Slider x:Name="BlueSlider" Grid.Row="4" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.BlueTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0}}" />
					</Grid>
				</StackPanel>
				<Border x:Name="IconChooserCard" Grid.Row="2" Grid.ColumnSpan="3" Padding="11,9" Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.ControlInner}">
					<Grid x:Name="IconChooserPanel">
						<Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock x:Name="IconFieldLabel" FontWeight="SemiBold" Text="Icon" />
							<TextBlock Margin="0,3,12,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="Choose a built-in symbol or import a square transparent PNG." TextWrapping="Wrap" />
						</StackPanel>
						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<WrapPanel>
								<ComboBox x:Name="CategoryIconComboBox" Width="62" SelectedValuePath="Id" MaxDropDownHeight="420"
									ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
									SelectionChanged="CategoryIconComboBox_SelectionChanged">
									<ComboBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Width="380" Columns="10" Margin="6" IsItemsHost="True" /></ItemsPanelTemplate></ComboBox.ItemsPanel>
									<ComboBox.ItemContainerStyle><StaticResource ResourceKey="CategoryIconChoiceStyle" /></ComboBox.ItemContainerStyle>
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Grid Width="20" Height="20" AutomationProperties.Name="{Binding DisplayName}">
												<Ellipse Width="{DynamicResource Redux.MarkerSize.Default}"
													Height="{DynamicResource Redux.MarkerSize.Default}"
													Fill="Transparent"
													Stroke="{DynamicResource Redux.CategoryEditor.IconBrush}"
													StrokeThickness="1.5"
													Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibilityConverter}}" />
												<controls:ReduxIcon Width="18" Height="18" IconKey="{Binding PreviewIconId}" Foreground="{DynamicResource Redux.CategoryEditor.IconBrush}" Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
											</Grid>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<Button Margin="7,0,0,0" MinWidth="98" Padding="9,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="ImportCustomIcon_Click">
									<StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" Margin="0,0,5,0" StrokeData="{StaticResource Redux.Icon.FolderOpen}" /><TextBlock Text="Import PNG" /></StackPanel>
								</Button>
								<Button x:Name="DeleteCustomIconButton" Margin="7,0,0,0" MinWidth="32" Padding="7,4" Style="{StaticResource ReduxDestructiveActionButtonStyle}" Visibility="Collapsed" Click="DeleteCustomIcon_Click" ToolTip="Remove the selected custom icon">
									<controls:ReduxIcon Width="14" Height="14" StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" />
								</Button>
							</WrapPanel>
							<CheckBox x:Name="TintCustomIconCheckBox" Margin="0,6,0,0" Style="{StaticResource ReduxCheckBoxStyle}" Visibility="Collapsed"
								Checked="TintCustomIconCheckBox_Changed" Unchecked="TintCustomIconCheckBox_Changed"
								ToolTip="Use the PNG transparency as a mask and apply this category or separator color.">
								<TextBlock x:Name="TintCustomIconText" Text="Tint with category color" TextWrapping="Wrap" />
							</CheckBox>
							<CheckBox x:Name="HideSeparatorLineCheckBox" Margin="0,6,0,0"
								Style="{StaticResource ReduxCheckBoxStyle}" Visibility="Collapsed">
								<TextBlock Text="Hide separator line" TextWrapping="Wrap" />
							</CheckBox>
						</StackPanel>
					</Grid>
				</Border>
				<Grid Grid.Row="4" Grid.ColumnSpan="3">
					<Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock Margin="0,0,0,7" FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Presets" />
						<WrapPanel>
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#8A6AF1" Tag="#8A6AF1" ToolTip="Arcane Violet" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#3B82F6" Tag="#3B82F6" ToolTip="Electric Blue" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#22B8C5" Tag="#22B8C5" ToolTip="Cyan Tide" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#3FA37A" Tag="#3FA37A" ToolTip="Emerald Mist" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#71B96B" Tag="#71B96B" ToolTip="Moss Green" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#D7A24B" Tag="#D7A24B" ToolTip="Antique Amber" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#F97316" Tag="#F97316" ToolTip="Ember Orange" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#D66B55" Tag="#D66B55" ToolTip="Terracotta" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#D45A9E" Tag="#D45A9E" ToolTip="Rose" MouseLeftButtonUp="ColorSwatch_Click" />
						<Border Style="{StaticResource CategoryColorSwatchStyle}" Background="#8F879E" Tag="#8F879E" ToolTip="Muted Lilac" MouseLeftButtonUp="ColorSwatch_Click" />
						</WrapPanel>
					</StackPanel>
					<StackPanel Grid.Column="2">
					<DockPanel Margin="0,0,0,5" LastChildFill="False">
						<TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Redux.FontSize.11}" FontWeight="SemiBold"
							Foreground="{DynamicResource ReduxTextMutedBrush}" Text="Saved colors" />
						<Button DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource ReduxSecondaryActionButtonStyle}"
							Click="SaveCurrentColor_Click">
							<StackPanel Margin="0" Orientation="Horizontal">
								<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.AddCircle}" />
								<TextBlock Text="Save current" />
							</StackPanel>
						</Button>
					</DockPanel>
					<WrapPanel x:Name="SavedColorsPanel" />
					<TextBlock x:Name="NoSavedColorsText" Foreground="{DynamicResource ReduxTextMutedBrush}"
						FontSize="{DynamicResource Redux.FontSize.11}" Text="No saved colors yet." />
				</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
	</ScrollViewer>
		<Border Grid.Row="1" Padding="18,10" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
			<Button x:Name="ResetToDefaultButton" MinWidth="138" Margin="0,0,8,0"
				Style="{StaticResource ReduxWarningActionButtonStyle}" Visibility="Collapsed"
				Click="ResetToDefault_Click">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
						StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
					<TextBlock Text="Reset to default" />
				</StackPanel>
			</Button>
			<Button x:Name="ConfirmButton" MinWidth="84" Margin="0,0,8,0" Style="{StaticResource ReduxPrimaryActionButtonStyle}" IsDefault="True" Click="Add_Click">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon x:Name="ConfirmButtonIcon" Width="14" Height="14" Margin="0,0,6,0"
						Foreground="{DynamicResource ReduxAccentForegroundBrush}"
						StrokeData="{StaticResource Redux.Icon.Check}" />
					<TextBlock x:Name="ConfirmButtonText" Text="Add" />
				</StackPanel>
			</Button>
			<Button MinWidth="84" Style="{StaticResource ReduxSecondaryActionButtonStyle}" IsCancel="True">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" />
					<TextBlock Text="Cancel" />
				</StackPanel>
			</Button>
		</StackPanel>
		</Border>
	</Grid>
	</Border>
	</Grid>
</adonisUi:AdonisWindow>
