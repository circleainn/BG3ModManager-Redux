<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#3B82F6" Tag="#3B82F6" ToolTip="{loc:Text Electric_Blue_c34dee36}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#22B8C5" Tag="#22B8C5" ToolTip="{loc:Text Cyan_Tide_c529865d}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#3FA37A" Tag="#3FA37A" ToolTip="{loc:Text Emerald_Mist_3aed0c47}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#71B96B" Tag="#71B96B" ToolTip="{loc:Text Moss_Green_5d0272cd}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D7A24B" Tag="#D7A24B" ToolTip="{loc:Text Antique_Amber_40824362}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#F97316" Tag="#F97316" ToolTip="{loc:Text Ember_Orange_8cb1e5d7}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D66B55" Tag="#D66B55" ToolTip="{loc:Text Terracotta_433d669d}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D45A9E" Tag="#D45A9E" ToolTip="{loc:Text Rose_e10d8509}" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#8F879E" Tag="#8F879E" ToolTip="{loc:Text Muted_Lilac_86320f20}" Click="ColorSwatch_Click" /></WrapPanel>
                                <DockPanel Margin="0,12,0,8">
