                                    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                    <Border BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ReduxBorderStrongBrush}" IsHitTestVisible="False"/>
