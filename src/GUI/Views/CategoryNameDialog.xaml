                                <Slider x:Name="HueSlider" Margin="0,10,0,10" Maximum="359.99" SmallChange="1" LargeChange="15" AutomationProperties.Name="{loc:Text Hue_4d7056f0}" Style="{StaticResource CategoryColorSliderStyle}" ValueChanged="HueSlider_ValueChanged">
