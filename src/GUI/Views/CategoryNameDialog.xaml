<adonisUi:AdonisWindow x:Class="DivinityModManager.Views.CategoryNameDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUi="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
	Title="Add Mod Category"
	Width="600"
	Height="600"
	MinWidth="560"
	MinHeight="380"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	Background="{DynamicResource ReduxWindowBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<adonisUi:AdonisWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		<SolidColorBrush x:Key="Redux.CategoryEditor.IconBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.HueBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.SaturationTrackBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.BrightnessTrackBrush" Color="{DynamicResource ReduxAccentColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.RedTrackBrush" Color="{DynamicResource ReduxErrorColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.GreenTrackBrush" Color="{DynamicResource ReduxSuccessColor}" />
		<SolidColorBrush x:Key="Redux.CategoryEditor.BlueTrackBrush" Color="{DynamicResource ReduxInfoColor}" />
		<Style x:Key="CategoryColorSwatchStyle" TargetType="Button">
			<Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
			<Setter Property="Margin" Value="0,0,6,6" />
			<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderStrongBrush}" />
			<Setter Property="BorderThickness" Value="1" /><Setter Property="Cursor" Value="Hand" />
			<Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Small}"/>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" /></Trigger></Style.Triggers>
		</Style>
		<Style x:Key="CategoryColorSliderStyle" TargetType="Slider">
			<Setter Property="Height" Value="20" /><Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="255" />
			<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
				<Grid>
					<Border Height="8" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="4" />
				<Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
					<Track.DecreaseRepeatButton><RepeatButton Background="Transparent" Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
					<Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource ReduxSurfaceBrush}" Stroke="{DynamicResource ReduxTextPrimaryBrush}" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
					<Track.IncreaseRepeatButton><RepeatButton Background="Transparent" Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
				</Track>
				</Grid>
			</ControlTemplate></Setter.Value></Setter>
		</Style>
        <Style x:Key="CompactEditorDisclosureStyle" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton Content="{TemplateBinding Header}" HorizontalContentAlignment="Left"
                        Foreground="{DynamicResource ReduxTextSecondaryBrush}" Background="Transparent"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="DisclosureHeader" Padding="2,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="{DynamicResource Redux.CornerRadius.Small}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path x:Name="DisclosureChevron" Width="9" Height="5" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Data="{StaticResource Redux.Icon.ChevronDownStroke}" Stretch="Fill" StrokeThickness="1.25"
                                        Stroke="{TemplateBinding Foreground}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                                    </Path>
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="DisclosureChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DisclosureHeader" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="DisclosureContent" Visibility="Collapsed"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DisclosureContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
		<Style x:Key="CategoryIconChoiceStyle" TargetType="{x:Type ComboBoxItem}">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Margin" Value="2" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="ToolTip" Value="{Binding DisplayName}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBoxItem}">
						<Border x:Name="ChoiceChrome" Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{DynamicResource Redux.CornerRadius.Small}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource ReduxAccentMutedBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								<Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		</ResourceDictionary>
	</adonisUi:AdonisWindow.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:ReduxWindowTitleBar x:Name="DialogTitleBar" IconData="{DynamicResource Redux.Icon.ColorPalette}"/>
        <Border x:Name="DialogWindowShell" Grid.Row="1" Background="{DynamicResource ReduxWindowBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20">
                        <TextBlock x:Name="DialogHeading" Visibility="Collapsed" FontSize="{DynamicResource Redux.FontSize.17}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DialogHelperText" Visibility="Collapsed" Margin="0,0,0,12" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="NameEditorPanel" Margin="0,0,16,0">
                                <TextBlock x:Name="CategoryNameFieldLabel" Text="Name" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox x:Name="CategoryNameTextBox" Height="36" MaxLength="40" Padding="9,6"/>
                            </StackPanel>
                            <StackPanel x:Name="IconChooserCard" Grid.Column="1">
                                <TextBlock x:Name="IconFieldLabel" Text="Icon" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"><ComboBox x:Name="CategoryIconComboBox" Width="58" Height="36" Margin="0" SelectedValuePath="Id" MaxDropDownHeight="420"
									ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
									SelectionChanged="CategoryIconComboBox_SelectionChanged">
									<ComboBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Width="380" Columns="10" Margin="6" IsItemsHost="True" /></ItemsPanelTemplate></ComboBox.ItemsPanel>
									<ComboBox.ItemContainerStyle><StaticResource ResourceKey="CategoryIconChoiceStyle" /></ComboBox.ItemContainerStyle>
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<Grid Width="20" Height="20" AutomationProperties.Name="{Binding DisplayName}">
												<Ellipse Width="{DynamicResource Redux.MarkerSize.Default}"
													Height="{DynamicResource Redux.MarkerSize.Default}"
													Fill="Transparent"
													Stroke="{DynamicResource Redux.CategoryEditor.IconBrush}"
													StrokeThickness="1.5"
													Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibilityConverter}}" />
												<controls:ReduxIcon Width="18" Height="18" IconKey="{Binding PreviewIconId}" Foreground="{DynamicResource Redux.CategoryEditor.IconBrush}" Visibility="{Binding IsNone, Converter={StaticResource BoolToVisibilityConverterReversed}}" />
											</Grid>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
                                <Button Height="36" Margin="7,0,0,0" MinWidth="98" Padding="9,4" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="ImportCustomIcon_Click">
									<StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,5,0" StrokeData="{StaticResource Redux.Icon.FolderOpen}" /><TextBlock Text="Import PNG" /></StackPanel>
								</Button>
								<Button x:Name="DeleteCustomIconButton" Margin="7,0,0,0" MinWidth="32" Padding="7,4" Style="{StaticResource ReduxMinorDestructiveActionButtonStyle}" Visibility="Collapsed" Click="DeleteCustomIcon_Click" ToolTip="Remove the selected custom icon">
									<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" StrokeData="{StaticResource Redux.Icon.Trash}" Foreground="{DynamicResource ReduxErrorBrush}" />
								</Button></StackPanel>
                            </StackPanel>
                        </Grid>
                        <Expander Style="{StaticResource CompactEditorDisclosureStyle}" x:Name="DescriptionEditorPanel" Header="Add a description" Margin="0,8,0,16">
                            <TextBox x:Name="CategoryDescriptionTextBox" Height="52" MaxLength="240" Margin="0,6,0,0" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Expander>
                        <DockPanel x:Name="SeparatorParentPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Nest under" Width="112" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox x:Name="SeparatorParentComboBox" MinHeight="32" DisplayMemberPath="Label" SelectedValuePath="Id" MaxDropDownHeight="240" SelectionChanged="SeparatorParentComboBox_SelectionChanged"
                                ToolTip="Choose a separator to make this a sub-separator. Changing nesting moves only this separator; mod order stays unchanged. Sub-separators inherit persistence."/>
                        </DockPanel>
                        <Grid x:Name="ColorEditorCard">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColorFieldLabel" Text="Color" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Grid.Column="2" Text="Presets" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Grid.Row="1">
                                <Grid x:Name="ColorPlane" Height="156" Background="{DynamicResource Redux.CategoryEditor.HueBrush}" Cursor="Cross"
                                    AutomationProperties.Name="Color saturation and brightness"
                                    MouseLeftButtonDown="ColorPlane_MouseLeftButtonDown" MouseMove="ColorPlane_MouseMove" MouseLeftButtonUp="ColorSurface_MouseLeftButtonUp" SizeChanged="ColorPlane_SizeChanged">
                                    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                    <Border BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ReduxBorderStrongBrush}" IsHitTestVisible="False"/>
                                    <Ellipse x:Name="ColorPlaneMarker" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Transparent" Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" Color="Black"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <Slider x:Name="HueSlider" Margin="0,10,0,10" Maximum="359.99" SmallChange="1" LargeChange="15" AutomationProperties.Name="Hue" Style="{StaticResource CategoryColorSliderStyle}" ValueChanged="HueSlider_ValueChanged">
                                    <Slider.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Slider.Background>
                                </Slider>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="SelectedColorPreview" Height="34" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource ReduxBorderStrongBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.Small}"/>
                                    <TextBox x:Name="HexColorTextBox" Grid.Column="1" Height="34" MaxLength="7" Padding="8,5" AutomationProperties.Name="Hex color" LostFocus="HexColorTextBox_Commit" KeyDown="HexColorTextBox_KeyDown"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <WrapPanel Width="180" HorizontalAlignment="Left"><Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#8A6AF1" Tag="#8A6AF1" ToolTip="Arcane Violet" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#3B82F6" Tag="#3B82F6" ToolTip="Electric Blue" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#22B8C5" Tag="#22B8C5" ToolTip="Cyan Tide" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#3FA37A" Tag="#3FA37A" ToolTip="Emerald Mist" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#71B96B" Tag="#71B96B" ToolTip="Moss Green" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D7A24B" Tag="#D7A24B" ToolTip="Antique Amber" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#F97316" Tag="#F97316" ToolTip="Ember Orange" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D66B55" Tag="#D66B55" ToolTip="Terracotta" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#D45A9E" Tag="#D45A9E" ToolTip="Rose" Click="ColorSwatch_Click" />
<Button Style="{StaticResource CategoryColorSwatchStyle}" Background="#8F879E" Tag="#8F879E" ToolTip="Muted Lilac" Click="ColorSwatch_Click" /></WrapPanel>
                                <DockPanel Margin="0,12,0,8">
                                    <Button x:Name="SaveColorButton" DockPanel.Dock="Right" Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0" Margin="0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Click="SaveCurrentColor_Click" AutomationProperties.Name="Save color" ToolTip="Save this color to your palette">
                                        <controls:ReduxIcon Width="12" Height="12" StrokeData="{StaticResource Redux.Icon.AddStroke}"/>
                                    </Button>
                                    <TextBlock Text="Saved colors" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="SavedColorsPanel"/></ScrollViewer>
                                <TextBlock x:Name="NoSavedColorsText" Text="Save a color with + to reuse it." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextMutedBrush}" FontSize="{DynamicResource Redux.FontSize.11}"/>
                            </StackPanel>
                            <Expander Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CompactEditorDisclosureStyle}" x:Name="CustomColorExpander" Header="Fine-tune color" Margin="0,10,0,0"><Grid Margin="0,8,0,0">
						<Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Saturation" />
						<Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="100"
							Background="{DynamicResource Redux.CategoryEditor.SaturationTrackBrush}"
							ValueChanged="SaturationSlider_ValueChanged" />
						<TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:0}%}" />
						<TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Brightness" />
						<Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="100"
							Background="{DynamicResource Redux.CategoryEditor.BrightnessTrackBrush}"
							ValueChanged="BrightnessSlider_ValueChanged" />
						<TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}" />
						<TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Red" />
						<Slider x:Name="RedSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.RedTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0}}" />
						<TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Green" />
						<Slider x:Name="GreenSlider" Grid.Row="3" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.GreenTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0}}" />
						<TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Blue" />
						<Slider x:Name="BlueSlider" Grid.Row="4" Grid.Column="1" Style="{StaticResource CategoryColorSliderStyle}" Maximum="255"
							Background="{DynamicResource Redux.CategoryEditor.BlueTrackBrush}"
							ValueChanged="RgbSlider_ValueChanged" />
						<TextBlock Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
							Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0}}" />
					</Grid></Expander>
                            <xctk:ColorCanvas x:Name="CategoryColorPicker" Visibility="Collapsed" UsingAlphaChannel="False" SelectedColorChanged="CategoryColorPicker_SelectedColorChanged"/>
                        </Grid>
                        <WrapPanel x:Name="IconOptionsPanel" Margin="0,16,0,0"><CheckBox x:Name="TintCustomIconCheckBox" Margin="0,0,20,8" Style="{StaticResource ReduxCheckBoxStyle}" Visibility="Collapsed"
								Checked="TintCustomIconCheckBox_Changed" Unchecked="TintCustomIconCheckBox_Changed"
								ToolTip="Use the PNG transparency as a mask and apply this category or separator color.">
								<TextBlock x:Name="TintCustomIconText" Text="Tint with category color" TextWrapping="Wrap" />
							</CheckBox>
							<CheckBox x:Name="ShowSeparatorLineCheckBox" Margin="0,0,20,8"
								Style="{StaticResource ReduxCheckBoxStyle}" Visibility="Collapsed">
								<TextBlock Text="Show separator line" TextWrapping="Wrap" />
							</CheckBox>
							<CheckBox x:Name="GlobalSeparatorCheckBox" Margin="0,0,0,8"
								Style="{StaticResource ReduxCheckBoxStyle}" Visibility="Collapsed"
								ToolTip="Keep this separator available when you switch saved load orders.">
								<TextBlock x:Name="GlobalSeparatorCheckBoxText" Text="Use in every load order" TextWrapping="Wrap" />
							</CheckBox>
						</WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Padding="18,10" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
		<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
			<Button x:Name="ResetToDefaultButton" MinWidth="138" Margin="0,0,8,0"
				Style="{StaticResource ReduxMinorWarningActionButtonStyle}" Visibility="Collapsed"
				Click="ResetToDefault_Click">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0"
						Foreground="{DynamicResource ReduxWarningBrush}"
						StrokeData="{StaticResource Redux.Icon.RefreshStroke}" />
					<TextBlock Text="Reset to default" />
				</StackPanel>
			</Button>
			<Button x:Name="ConfirmButton" MinWidth="84" Margin="0,0,8,0" Style="{StaticResource ReduxPrimaryActionButtonStyle}" IsDefault="True" Click="Add_Click">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon VerticalAlignment="Center" x:Name="ConfirmButtonIcon" Width="14" Height="14" Margin="0,0,6,0"
						Foreground="{DynamicResource ReduxAccentForegroundBrush}"
						StrokeData="{StaticResource Redux.Icon.Check}" />
					<TextBlock x:Name="ConfirmButtonText" Text="Add" />
				</StackPanel>
			</Button>
			<Button MinWidth="84" Style="{StaticResource ReduxSecondaryActionButtonStyle}" IsCancel="True">
				<StackPanel Orientation="Horizontal">
					<controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" />
					<TextBlock Text="Cancel" />
				</StackPanel>
			</Button>
		</StackPanel>
		</Border>
            </Grid>
        </Border>
    </Grid>
</adonisUi:AdonisWindow>
