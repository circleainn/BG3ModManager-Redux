<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxModNoteWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Notes"
	Width="560" MinWidth="460" MaxWidth="720"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	ResizeMode="CanResizeWithGrip"
	SizeToContent="Height"
	ShowInTaskbar="False"
	Background="{DynamicResource ReduxSurfaceBrush}"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	WindowStartupLocation="CenterOwner">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ScrollText}" />
		<Border Grid.Row="1"
			Padding="22"
			Background="{DynamicResource ReduxSurfaceBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="0,1,0,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock FontSize="{DynamicResource Redux.FontSize.16}"
					FontWeight="SemiBold"
					Text="Notes" />
				<TextBlock x:Name="ModNameText" Grid.Row="1" Margin="0,4,0,0"
					Foreground="{DynamicResource ReduxTextSecondaryBrush}"
					TextWrapping="Wrap" />
				<Grid Grid.Row="2" Margin="0,16,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBox x:Name="NoteTextBox"
						MinHeight="150" MaxHeight="360"
						AcceptsReturn="True"
						AcceptsTab="True"
						MaxLength="8000"
						TextWrapping="Wrap"
						VerticalContentAlignment="Top"
						VerticalScrollBarVisibility="Auto"
						TextChanged="NoteTextBox_TextChanged" />
					<Grid Grid.Row="1" Margin="2,6,2,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="Stored locally unless explicitly included in a Redux bundle."
							TextWrapping="Wrap" />
						<TextBlock x:Name="CharacterCountText" Grid.Column="1" Margin="12,0,0,0"
							Foreground="{DynamicResource ReduxTextMutedBrush}" />
					</Grid>
				</Grid>
				<StackPanel Grid.Row="3" Margin="0,18,0,0"
					HorizontalAlignment="Right" Orientation="Horizontal">
					<Button x:Name="ClearButton" MinWidth="80"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						Click="ClearButton_Click">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Trash}" />
							<TextBlock Text="Clear" />
						</StackPanel>
					</Button>
					<Button MinWidth="80" Margin="8,0,0,0"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}"
						IsCancel="True">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0" StrokeData="{StaticResource Redux.Icon.Close}" />
							<TextBlock Text="Cancel" />
						</StackPanel>
					</Button>
					<Button MinWidth="80" Margin="8,0,0,0"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}"
						IsDefault="True" Click="SaveButton_Click">
						<StackPanel Orientation="Horizontal">
							<controls:ReduxIcon Width="14" Height="14" Margin="0,0,6,0"
								Foreground="{DynamicResource ReduxAccentForegroundBrush}"
								StrokeData="{StaticResource Redux.Icon.Save}" />
							<TextBlock Text="Save" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
