<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Parchment intentionally reuses the shared Redux Light control mappings.
		Only semantic colors are overridden here; layouts, fonts, icons, templates,
		and behavior remain common to every built-in and future custom theme.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="Light.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- A subdued paper-and-ink ladder with clear status colors and wax-seal emphasis. -->
	<Color x:Key="ReduxWindowColor">#DCCFB7</Color>
	<Color x:Key="ReduxListInteriorColor">#E7DAC2</Color>
	<Color x:Key="ReduxSurfaceColor">#EBDEC5</Color>
	<Color x:Key="ReduxSurfaceElevatedColor">#F0E4CE</Color>
	<Color x:Key="ReduxSurfaceMutedColor">#D1C0A2</Color>
	<Color x:Key="ReduxBorderColor">#AD9876</Color>
	<Color x:Key="ReduxBorderStrongColor">#806A49</Color>
	<Color x:Key="ReduxHoverColor">#DBC7A6</Color>
	<Color x:Key="ReduxPressedColor">#CAB187</Color>
	<Color x:Key="ReduxAccentColor">#8B3034</Color>
	<Color x:Key="ReduxAccentHoverColor">#A13E42</Color>
	<Color x:Key="ReduxAccentSoftColor">#DFC0B6</Color>
	<Color x:Key="ReduxSelectionColor">#D2A9A1</Color>
	<Color x:Key="ReduxCyanColor">#2B7371</Color>
	<Color x:Key="ReduxSuccessColor">#3F6B35</Color>
	<Color x:Key="ReduxSuccessSoftColor">#C8D7B4</Color>
	<Color x:Key="ReduxWarningColor">#8F4C08</Color>
	<Color x:Key="ReduxErrorColor">#AC2E3E</Color>
	<Color x:Key="ReduxInfoColor">#466989</Color>
	<Color x:Key="ReduxTextPrimaryColor">#2D231B</Color>
	<Color x:Key="ReduxTextSecondaryColor">#584737</Color>
	<Color x:Key="ReduxTextMutedColor">#6F5D4B</Color>
	<Color x:Key="ReduxAccentForegroundColor">#FFF8EB</Color>
	<Color x:Key="ReduxGithubIconColor">#000000</Color>
</ResourceDictionary>
