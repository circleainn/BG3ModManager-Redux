<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		Parchment intentionally reuses the shared Redux Light control mappings.
		Only semantic colors are overridden here; layouts, fonts, icons, templates,
		and behavior remain common to every built-in and future custom theme.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="Light.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- A subdued paper-and-ink ladder with clear status colors and wax-seal emphasis. -->
	<Color x:Key="ReduxWindowColor">#DCCFB7</Color>
	<Color x:Key="ReduxListInteriorColor">#E7DAC2</Color>
	<Color x:Key="ReduxSurfaceColor">#EBDEC5</Color>
	<Color x:Key="ReduxSurfaceElevatedColor">#F0E4CE</Color>
	<Color x:Key="ReduxSurfaceMutedColor">#D1C0A2</Color>
	<Color x:Key="ReduxBorderColor">#AD9876</Color>
	<Color x:Key="ReduxBorderStrongColor">#806A49</Color>
	<Color x:Key="ReduxHoverColor">#DBC7A6</Color>
	<Color x:Key="ReduxPressedColor">#CAB187</Color>
	<Color x:Key="ReduxAccentColor">#8B3034</Color>
	<Color x:Key="ReduxAccentHoverColor">#A13E42</Color>
	<Color x:Key="ReduxAccentSoftColor">#DFC0B6</Color>
	<Color x:Key="ReduxSelectionColor">#D2A9A1</Color>
	<Color x:Key="ReduxCyanColor">#2B7371</Color>
	<Color x:Key="ReduxSuccessColor">#3F6B35</Color>
	<Color x:Key="ReduxSuccessSoftColor">#C8D7B4</Color>
	<Color x:Key="ReduxWarningColor">#8F4C08</Color>
	<Color x:Key="ReduxErrorColor">#AC2E3E</Color>
	<Color x:Key="ReduxInfoColor">#466989</Color>
	<Color x:Key="ReduxTextPrimaryColor">#2D231B</Color>
	<Color x:Key="ReduxTextSecondaryColor">#584737</Color>
	<Color x:Key="ReduxTextMutedColor">#6F5D4B</Color>
	<Color x:Key="ReduxAccentForegroundColor">#FFF8EB</Color>
	<Color x:Key="ReduxGithubIconColor">#000000</Color>
	<!--
		Light.xaml's Redux*PillBackground gradients bake in Light's own hex rather than a
		DynamicResource Color, so they don't automatically pick up Parchment's overrides above
		the way a plain Color-bound SolidColorBrush does. Restated here with Parchment's colors.
	-->
	<LinearGradientBrush x:Key="ReduxAccentPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#3E8B3034" />
		<GradientStop Offset="1" Color="#1E8B3034" />
	</LinearGradientBrush>
	<!-- Primary actions stay saturated across the full button instead of fading into the paper surface. -->
	<LinearGradientBrush x:Key="ReduxPrimaryActionBackgroundBrush" StartPoint="0,0.5" EndPoint="1,0.5">
		<GradientStop Offset="0" Color="#72272A" />
		<GradientStop Offset="0.50" Color="#8B3034" />
		<GradientStop Offset="1" Color="#AE4D3C" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ReduxSuccessPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#3E3F6B35" />
		<GradientStop Offset="1" Color="#1E3F6B35" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ReduxWarningPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#3E8F4C08" />
		<GradientStop Offset="1" Color="#1E8F4C08" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ReduxErrorPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#3EAC2E3E" />
		<GradientStop Offset="1" Color="#1EAC2E3E" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ReduxInfoPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#3E466989" />
		<GradientStop Offset="1" Color="#1E466989" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="ReduxSelectionPillBackground" StartPoint="0,0" EndPoint="1,0">
		<GradientStop Offset="0" Color="#FFD2A9A1" />
		<GradientStop Offset="1" Color="#D9D2A9A1" />
	</LinearGradientBrush>
</ResourceDictionary>
