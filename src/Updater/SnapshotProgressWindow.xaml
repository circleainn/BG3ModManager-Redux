<Window x:Class="ReduxUpdater.SnapshotProgressWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:loc="clr-namespace:ReduxUpdater.Localization"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{loc:Text Redux_Backups_1086310b}" Width="580" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
 Foreground="{DynamicResource ReduxTextPrimaryBrush}" FontSize="{DynamicResource Redux.FontSize.12}">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/ReduxUpdater;component/Themes/StandaloneOperationResources.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ReduxOperationButtonStyle}">
   <Setter Property="Width" Value="34" /><Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="28" />
   <Setter Property="Padding" Value="9" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
  </Style>
  <Style TargetType="Path">
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
   <Setter Property="StrokeThickness" Value="1.7" /><Setter Property="StrokeStartLineCap" Value="Round" />
   <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ReduxBorderStrongBrush}" Background="{DynamicResource ReduxWindowBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="Caption_MouseLeftButtonDown" Margin="12,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Viewbox x:Name="CaptionIcon" Width="15" Height="15" Margin="0,0,9,0"><Path Data="{StaticResource Redux.Icon.Save}" Stroke="{DynamicResource ReduxAccentHoverBrush}" /></Viewbox>
     <TextBlock Text="{loc:Text Redux_Backups_1086310b}" VerticalAlignment="Center" FontWeight="Medium" />
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{loc:Text Minimize_d72e311c}" AutomationProperties.Name="{loc:Text Minimize_d72e311c}"><Viewbox><Path Data="{StaticResource Redux.Icon.WindowMinimize}" /></Viewbox></Button>
     <Button x:Name="CloseWindowButton" Style="{StaticResource CaptionButton}" Click="Action_Click" ToolTip="{loc:Text Cancel_and_close_ca9ce210}" AutomationProperties.Name="{loc:Text Cancel_and_close_ca9ce210}"><Viewbox><Path Data="{StaticResource Redux.Icon.Close}" /></Viewbox></Button>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Margin="24,12,24,22" Orientation="Vertical">
    <Grid Margin="0,0,0,18">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border x:Name="OperationIcon" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ReduxAccentSoftBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
      <Viewbox Margin="11"><Path x:Name="OperationGlyph" Data="{StaticResource Redux.Icon.Save}" Stroke="{DynamicResource ReduxAccentHoverBrush}" /></Viewbox>
     </Border>
     <StackPanel Grid.Column="1" Orientation="Vertical">
      <TextBlock x:Name="Heading" Text="{loc:Text Preparing_snapshot_0bf2310e}" FontSize="{DynamicResource Redux.FontSize.20}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="Description" Text="{loc:Text Redux_will_reopen_when_the_operation_finishes_2cd898a7}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
     </StackPanel>
    </Grid>
    <Border Background="{DynamicResource ReduxSurfaceBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
     <StackPanel Orientation="Vertical">
      <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <TextBlock x:Name="Details" Text="{loc:Text Waiting_for_Redux_to_close_89ac8f68}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </ScrollViewer>
      <ProgressBar x:Name="Progress" Style="{StaticResource ReduxProgressBarStyle}" IsIndeterminate="True" Margin="0,14,0,0" AutomationProperties.Name="{loc:Text Snapshot_progress_559a37b8}" />
      <TextBlock x:Name="ProgressSummary" Text="{loc:Text Preparing_5d1fa38b}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="SafetyHint" Text="{loc:Text You_can_cancel_while_the_snapshot_is_being_prepared_3d629d34}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,14" />
    <Button x:Name="ActionButton" HorizontalAlignment="Right" MinWidth="112" Style="{StaticResource ReduxOperationButtonStyle}" Click="Action_Click">
     <StackPanel Orientation="Horizontal">
      <Viewbox x:Name="ActionIcon" Width="14" Height="14" Margin="0,0,7,0"><Path Data="{StaticResource Redux.Icon.Close}" /></Viewbox>
      <TextBlock x:Name="ActionLabel" Text="{loc:Text Cancel_19766ed6}" VerticalAlignment="Center" />
     </StackPanel>
    </Button>
   </StackPanel>
  </Grid>
 </Border>
</Window>
