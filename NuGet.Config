<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- A NuGet.Config inherited from a parent directory points restores at a local
       relay that is not always running. Clearing the inherited sources keeps builds
       working outside that environment. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
