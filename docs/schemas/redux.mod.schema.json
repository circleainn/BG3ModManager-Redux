{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raincloudsfollow/BG3ModManager-Redux/blob/main/docs/schemas/redux.mod.schema.json",
  "title": "BG3 Mod Manager Redux creator manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestType"
  ],
  "oneOf": [
    {
      "required": [
        "moduleUuid",
        "nexus"
      ],
      "not": {
        "required": [
          "mod"
        ]
      }
    },
    {
      "required": [
        "mod"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "moduleUuid"
            ]
          },
          {
            "required": [
              "nexus"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 2048
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestType": {
      "const": "bg3-redux-mod"
    },
    "moduleUuid": {
      "type": "string",
      "format": "uuid"
    },
    "nexus": {
      "$ref": "#/$defs/compactNexus"
    },
    "mod": {
      "$ref": "#/$defs/mod"
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "mod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authors",
        "modules"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonBlankString"
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^[hH][tT][tT][pP][sS]?://[^/@\\s]+(?:/|$)"
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/module"
          }
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "projectId"
      ],
      "properties": {
        "service": {
          "enum": [
            "nexus",
            "modio"
          ]
        },
        "projectId": {
          "type": "integer",
          "minimum": 1
        },
        "fileId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "compactNexus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId"
      ],
      "properties": {
        "projectId": {
          "type": "integer",
          "minimum": 1
        },
        "fileId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "name",
        "folder"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "$ref": "#/$defs/nonBlankString"
        },
        "folder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\\\/:*?\"<>|]+$"
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "pak": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[^\\u0000-\\u001f\\\\/:*?\"<>|]+\\.[pP][aA][kK]$"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "$ref": "#/$defs/nonBlankString"
        },
        "minimumVersion": {
          "type": "string",
          "maxLength": 128
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
