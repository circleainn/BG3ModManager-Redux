<Window x:Class="ReduxModDatabaseTool.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redux Mod Database Reviewer"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="150" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="24"
                   FontWeight="SemiBold"
                   Text="Redux Mod Database Reviewer" />
        <TextBlock Margin="0,5,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Review tester reports without placing database-writing tools in Redux packages." />
      </StackPanel>
      <Border Grid.Column="1"
              Padding="10,5"
              VerticalAlignment="Top"
              Background="{StaticResource AccentSoftBrush}"
              BorderBrush="{StaticResource AccentBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <TextBlock Foreground="{StaticResource AccentBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="MAINTAINER UTILITY" />
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Padding="14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,12,10"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Contribution report" />
        <TextBox x:Name="ReportPathBox"
                 Grid.Column="1"
                 Margin="0,0,10,10"
                 TextChanged="InputPath_Changed" />
        <Button Grid.Column="2"
                Margin="0,0,0,10"
                Click="BrowseReport_Click"
                Content="Browse..." />

        <TextBlock Grid.Row="1"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Redux database" />
        <TextBox x:Name="DatabasePathBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="0,0,10,0"
                 TextChanged="InputPath_Changed" />
        <Button Grid.Row="1"
                Grid.Column="2"
                Click="BrowseDatabase_Click"
                Content="Browse..." />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <WrapPanel x:Name="SummaryPanel" VerticalAlignment="Center">
        <TextBlock x:Name="SummaryText"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Choose a contribution report to begin." />
      </WrapPanel>
      <Button x:Name="ReviewButton"
              Grid.Column="1"
              Style="{StaticResource PrimaryButtonStyle}"
              Click="Review_Click"
              Content="Review report" />
    </Grid>

    <Border Grid.Row="3"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="ReviewGrid"
                  ItemsSource="{Binding ReviewItems}"
                  AutoGenerateColumns="False"
                  AlternationCount="2"
                  SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Width="48"
                                    Header="Use"
                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <DataGridCheckBoxColumn.ElementStyle>
                <Style TargetType="CheckBox">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                </Style>
              </DataGridCheckBoxColumn.ElementStyle>
            </DataGridCheckBoxColumn>
            <DataGridTextColumn Width="150"
                                Header="Classification"
                                Binding="{Binding StatusLabel}" />
            <DataGridTextColumn Width="105"
                                Header="Nexus ID"
                                Binding="{Binding NexusIdText}" />
            <DataGridTextColumn Width="220"
                                Header="Project"
                                Binding="{Binding ProjectName}" />
            <DataGridTextColumn Width="85"
                                Header="Packages"
                                Binding="{Binding PackageCount}" />
            <DataGridTextColumn Width="*"
                                Header="Review note"
                                Binding="{Binding Reason}" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Margin="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   IsHitTestVisible="False"
                   Text="{Binding EmptyStateText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasReviewItems}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,13,0,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="Proposed database changes" />
      <TextBlock x:Name="PreviewStateText"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource MutedTextBrush}"
                 Text="Nothing previewed" />
    </Grid>

    <TextBox x:Name="OutputBox"
             Grid.Row="5"
             AcceptsReturn="True"
             IsReadOnly="True"
             FontFamily="Cascadia Mono, Consolas"
             FontSize="12"
             HorizontalScrollBarVisibility="Auto"
             VerticalScrollBarVisibility="Auto"
             Text="Review a report, select independently confirmed candidate projects, then preview the exact database update." />

    <Grid Grid.Row="6" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource MutedTextBrush}"
                 Text="The bundled database is never changed during report review." />
      <Button x:Name="PreviewButton"
              Grid.Column="1"
              Margin="0,0,10,0"
              Click="PreviewSelected_Click"
              Content="Preview selected"
              IsEnabled="False" />
      <Button x:Name="ApplyButton"
              Grid.Column="2"
              Style="{StaticResource PrimaryButtonStyle}"
              Click="ApplySelected_Click"
              Content="Apply approved batch"
              IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
